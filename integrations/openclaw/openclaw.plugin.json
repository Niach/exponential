{
  "id": "exponential",
  "name": "Exponential",
  "description": "Exponential's issue tracker in OpenClaw: issues, boards, comments, pull requests and coding runs over MCP, with interactive MCP Apps views for the issue list and a run's report.",
  "version": "0.1.0",
  "categories": ["productivity"],
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false
  },
  "skills": ["./skills"],
  "mcpServers": {
    "exponential": {
      "url": "https://app.exponential.at/api/mcp",
      "transport": "streamable-http",
      "headers": {
        "Authorization": "Bearer ${EXPONENTIAL_API_KEY}"
      },
      "requestTimeoutMs": 60000
    }
  }
}
