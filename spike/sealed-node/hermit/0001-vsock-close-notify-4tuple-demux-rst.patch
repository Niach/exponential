diff --git a/src/fd/socket/vsock.rs b/src/fd/socket/vsock.rs
index 949a471..7328c2d 100644
--- a/src/fd/socket/vsock.rs
+++ b/src/fd/socket/vsock.rs
@@ -421,6 +421,37 @@ impl ObjectInterface for Socket {
 
 impl Drop for Socket {
 	fn drop(&mut self) {
+		// sealed-node patch: tell the peer the connection is gone. Upstream
+		// only forgets the port, so the peer never sees EOF and keeps the
+		// half-dead connection open. The map lock is released before the
+		// driver lock is taken (the RX path takes driver, then map).
+		let peer = {
+			let guard = VSOCK_MAP.lock();
+			guard.get_socket(self.port).and_then(|raw| {
+				matches!(raw.state, VsockState::Connected | VsockState::Shutdown)
+					.then_some((raw.remote_cid, raw.remote_port, raw.fwd_cnt))
+			})
+		};
+		if let Some((remote_cid, remote_port, fwd_cnt)) = peer {
+			const HEADER_SIZE: usize = mem::size_of::<Hdr>();
+			let mut driver_guard = hardware::get_vsock_driver().unwrap().lock();
+			let local_cid = driver_guard.get_cid();
+			let port = self.port;
+			driver_guard.send_packet(HEADER_SIZE, |buffer| {
+				let hdr = unsafe { &mut *buffer.as_mut_ptr().cast::<Hdr>() };
+				hdr.src_cid = le64::from_ne(local_cid);
+				hdr.dst_cid = le64::from_ne(remote_cid.into());
+				hdr.src_port = le32::from_ne(port);
+				hdr.dst_port = le32::from_ne(remote_port);
+				hdr.len = le32::from_ne(0);
+				hdr.type_ = le16::from_ne(Type::Stream.into());
+				hdr.op = le16::from_ne(Op::Shutdown.into());
+				// VIRTIO_VSOCK_SHUTDOWN_RCV | VIRTIO_VSOCK_SHUTDOWN_SEND
+				hdr.flags = le32::from_ne(3);
+				hdr.buf_alloc = le32::from_ne(crate::executor::vsock::RAW_SOCKET_BUFFER_SIZE as u32);
+				hdr.fwd_cnt = le32::from_ne(fwd_cnt);
+			});
+		}
 		let mut guard = VSOCK_MAP.lock();
 		guard.remove_socket(self.port);
 	}
