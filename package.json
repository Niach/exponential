{
  "name": "exponential",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "backend": "docker compose up -d && bun --filter @exp/web dev",
    "ios": "cd apps/ios && tuist generate",
    "ios:test": "cd apps/ios && tuist install && tuist generate --no-open && tuist test ExpCore && tuist test ExpUI",
    "android": "cd apps/android && ./gradlew :app:installProductionDebug && adb shell am start -n at.exponential/com.exponential.app.MainActivity",

    "dev": "bun --filter @exp/web dev",
    "build": "bun --filter @exp/widget build && bun --filter @exp/web build && bun --filter @exp/marketing build",
    "build:web": "bun --filter @exp/web build",
    "start": "bun --filter @exp/web start",
    "test": "bun --filter @exp/web test",
    "test:e2e": "bun --filter @exp/web test:e2e",
    "typecheck": "bun --filter @exp/web --filter @exp/view-catalog --filter @exp/shots --filter @exp/styleguide typecheck",
    "migrate": "bun --filter @exp/web migrate",
    "migrate:generate": "bun --filter @exp/web migrate:generate",
    "psql": "bun --filter @exp/web psql",

    "dev:marketing": "bun --filter @exp/marketing dev",
    "build:marketing": "bun --filter @exp/marketing build",
    "movie:studio": "cd apps/marketing && remotion studio src/movie/remotion/entry.ts",
    "movie:render": "cd apps/marketing && remotion render src/movie/remotion/entry.ts ClosedLoop out/closed-loop.mp4 --crf 16",
    "screenshots:store": "bun run --filter @exp/marketing screenshots:store",
    "screenshots:social": "bun run --filter @exp/web screenshots:social",
    "shots": "bun run --filter @exp/shots capture",
    "shots:index": "bun run --filter @exp/shots index",
    "shots:affected": "bun run --filter @exp/shots affected",
    "shots:check": "bun --filter @exp/styleguide build -- --check",
    "test:shots": "bun --filter @exp/view-catalog test && bun --filter @exp/shots test",
    "dev:styleguide": "bun --filter @exp/styleguide dev",
    "build:styleguide": "bun --filter @exp/styleguide build",
    "social:generate": "bun run --filter @exp/marketing social:generate",
    "movie:still": "cd apps/marketing && remotion still src/movie/remotion/entry.ts ClosedLoop",
    "movie:poster": "cd apps/marketing && remotion still src/movie/remotion/entry.ts ClosedLoop public/posters/loop-poster.webp --frame=0",
    "movie:poster:portrait": "cd apps/marketing && remotion still src/movie/remotion/entry.ts ClosedLoop-Portrait public/posters/loop-poster-portrait.webp --frame=0 --scale=0.5",

    "dev:widget": "bun --filter @exp/widget dev",
    "build:widget": "bun --filter @exp/widget build",
    "test:widget": "bun --filter @exp/widget test",

    "dev:push-relay": "bun --filter @exp/push-relay dev",
    "start:push-relay": "bun --filter @exp/push-relay start",
    "dev:steer-relay": "bun --filter @exp/steer-relay dev",
    "start:steer-relay": "bun --filter @exp/steer-relay start",
    "test:steer-relay": "bun --filter @exp/steer-relay test && bun --filter @exp/steer-ticket test",

    "dev:desktop": "cd apps/desktop && EXP_INSTANCE_URL=http://localhost:3000 cargo run -p app",
    "build:desktop": "cd apps/desktop && cargo build --release -p app",
    "appimage:desktop": "cd apps/desktop && cargo build --release -p app && ./scripts/build-appimage.sh production",
    "macapp:desktop": "cd apps/desktop && cargo build --release -p app && ./scripts/build-macos-app.sh production",
    "test:desktop": "cd apps/desktop && cargo test",
    "clean:desktop": "cd apps/desktop && cargo clean",

    "android:build": "cd apps/android && ./gradlew :app:assembleProductionDebug",
    "android:install": "cd apps/android && ./gradlew :app:installProductionDebug",

    "backend:up": "docker compose up -d",
    "backend:down": "docker compose down",
    "backend:clear": "docker compose down -v",
    "storage:init": "bash scripts/garage-init.sh",
    "notices": "bun run --filter @exp/licenses generate",
    "notices:collect:rust": "bun run --filter @exp/licenses collect:rust",
    "notices:collect:npm": "bun run --filter @exp/licenses collect:npm",
    "notices:collect:ios": "bun run --filter @exp/licenses collect:ios",
    "notices:collect:android": "bun run --filter @exp/licenses collect:android",
    "lint": "bun --filter '*' lint",
    "lint:check": "bun --filter '*' lint:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.2",
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "^9.32.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.6.2",
    "typescript": "^5.7.2"
  }
}
