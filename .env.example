# Exponential environment — the CANONICAL variable reference.
#
# The web app reads env from apps/web/.env, which is a symlink to the repo
# root .env (create it with `ln -s ../../.env apps/web/.env`). Defaults below
# target the local dev backend (`bun run backend`); image-based self-hosters
# start from the much smaller selfhost/.env.example instead and come here for
# the optional subsystems.
#
# Three bands: REQUIRED CORE (the app won't run right without them),
# OPTIONAL SUBSYSTEMS (off until configured), CLOUD-ONLY (leave unset when
# self-hosting).

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED CORE
# ═══════════════════════════════════════════════════════════════════════════

# --- Database ------------------------------------------------------------
# PostgreSQL connection string (needs wal_level=logical for Electric).
# Default matches the dev docker-compose.yaml.
DATABASE_URL=postgresql://postgres:password@localhost:54321/exponential

# --- Auth core -----------------------------------------------------------
# 32+ char secret used by Better Auth to sign sessions (openssl rand -hex 32).
BETTER_AUTH_SECRET=
# Base URL of the app — OAuth callbacks and links are built from it.
BETTER_AUTH_URL=http://localhost:5173
# Comma-separated origins Better Auth accepts requests from.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173

# --- ElectricSQL ---------------------------------------------------------
# Electric sync service URL (default: the dev compose service).
ELECTRIC_URL=http://localhost:30000

# --- S3-compatible attachment storage ------------------------------------
# Any S3-compatible provider works — Hetzner Object Storage, MinIO,
# Cloudflare R2, AWS S3, Garage, ... The client uses path-style addressing
# (forcePathStyle) and streams attachments server-side, so the endpoint never
# needs to be browser-reachable. The bucket is auto-created at first use when
# the key has create permission; otherwise create it up front.
# Dev: the compose stack bundles Garage — `bun run storage:init` prints keys.
S3_ENDPOINT=http://localhost:3900
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=exponential-attachments
S3_REGION=garage

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL SUBSYSTEMS — off until configured
# ═══════════════════════════════════════════════════════════════════════════

# --- Cloud mode (EXP-364) -------------------------------------------------
# Opt-IN marker for the managed cloud (app/next.exponential.at). 'true'
# enables billing, plan limits, and the hardcoded in-app feedback widget.
# Leave unset when self-hosting — that IS self-hosted mode (billing off,
# every plan limit unlocked). Replaced the opt-out SELF_HOSTED flag.
# CLOUD_INSTANCE=true
# Override the in-app feedback widget key on cloud instances whose widget
# config row differs from the hardcoded prod key (staging).
# FEEDBACK_WIDGET_KEY=

# --- Authentication toggles ----------------------------------------------
# Disable email/password sign-in (default: enabled).
# AUTH_PASSWORD_ENABLED=false
# Public password sign-up. Default: enabled in dev, DISABLED in production
# (invite/OAuth only). Set 'true' to open registration on a production
# instance (recommended together with an email transport so verification +
# password-reset emails work), 'false' to force-disable anywhere.
# AUTH_SIGNUP_ENABLED=true

# --- OIDC providers (multi-provider) ---------------------------------------
# JSON array, one entry per provider.
# Each entry: { id, name, clientId, clientSecret, discoveryUrl, scopes?, adminGroups?, groupsClaim? }
# `id` is used as the provider key and also as the accounts.providerId value.
# `name` is the label shown on the login/register buttons.
# `adminGroups` (optional): list of group names whose members are auto-promoted
#   to global admin. Re-evaluated on every login (so removing a user from the
#   group revokes admin). When set, scopes default to
#   ["openid","profile","email","groups"] unless overridden.
# `groupsClaim` (optional, default "groups"): dotted path into the OIDC profile
#   where group names live. Example: "realm_access.roles" for Keycloak.
# Authorized redirect URI (per provider): ${BETTER_AUTH_URL}/api/auth/oauth2/callback/<id>
# OIDC_PROVIDERS='[
#   {"id":"authentik","name":"Authentik","clientId":"...","clientSecret":"...","discoveryUrl":"https://auth.example.com/application/o/app/.well-known/openid-configuration","adminGroups":["exponential-admins"]},
#   {"id":"keycloak","name":"Keycloak","clientId":"...","clientSecret":"...","discoveryUrl":"https://kc.example.com/realms/main/.well-known/openid-configuration","adminGroups":["admin"],"groupsClaim":"realm_access.roles"}
# ]'

# Legacy single-provider OIDC vars (still supported when OIDC_PROVIDERS is unset).
# AUTH_OIDC_ENABLED=true
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISCOVERY_URL=https://auth.example.com/application/o/app/.well-known/openid-configuration
# OIDC_PROVIDER_ID=authentik

# --- Google login ----------------------------------------------------------
# Setting these enables "Sign in with Google" on the login/register pages.
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Show "Sign in with Google" on login/register (requires the client vars above).
# GOOGLE_LOGIN_ENABLED=true

# --- Outbound email (SMTP or Amazon SES) -----------------------------------
# ONE sender handles all outgoing mail: password reset + verification, invite
# emails, the notification digest, helpdesk reporter magic links, and the
# contact form. With neither transport set, every send is a logged no-op —
# in-app + push notifications still work, and the UI hides the affordances
# that depend on email (e.g. "Forgot password?").
#
# SMTP (the straightforward self-host option; used when AWS_SES_REGION is
# unset — SES wins when both are configured). SMTP_PORT defaults to 587
# (STARTTLS); SMTP_SECURE defaults to true for port 465 (implicit TLS), false
# otherwise. SMTP_USER/SMTP_PASS are optional (unauthenticated relays).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
#
# Amazon SES (SESv2 API): setting AWS_SES_REGION enables the transport;
# credentials ride the standard AWS chain (IAM user allowed ses:SendEmail).
# EMAIL_FROM must be a verified identity (domain) in that SES region, and the
# account must be out of the SES sandbox.
# AWS_SES_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Sender + Reply-To (both transports):
# EMAIL_FROM="Exponential <noreply@example.com>"
# Monitored default Reply-To on every outbound email (per-send replyTo wins).
# EMAIL_REPLY_TO=support@example.com

# --- GitHub App (coding flow) ----------------------------------------------
# OPTIONAL — needed only for coding (cloud AND self-host): teams CONNECT
# GitHub accounts (App installations) from team settings → Repositories. The
# server mints short-lived per-repo installation tokens just-in-time to open
# PRs + read diffs; desktop coding sessions use the same per-repo token to
# clone/push. No broad user token is stored.
#
# A board's repository is optional: issue tracking works with no App at all,
# and the coding features simply stay off until a board has a repository. The
# App gate fires only when CONNECTING a repository — without GITHUB_APP_ID /
# GITHUB_APP_SLUG / GITHUB_APP_PRIVATE_KEY that flow surfaces "This instance
# has no GitHub App configured".
#
# Create a GitHub App at https://github.com/settings/apps
# (Settings → Developer settings → GitHub Apps → New GitHub App):
#   - Setup URL: ${BETTER_AUTH_URL}/api/integrations/github/setup
#     and tick "Redirect on update" (repo-grant changes round-trip through it)
#   - Callback URL (OAuth, for the team claim flow):
#     ${BETTER_AUTH_URL}/api/integrations/github/callback
#   - Webhook URL: ${BETTER_AUTH_URL}/api/webhooks/github
#   - Permissions: Contents (read/write), Pull requests (read/write),
#     Metadata (read); subscribe to the Pull request event. (installation /
#     installation_repositories events are delivered to GitHub Apps
#     automatically once the webhook is Active — they are not listed under
#     "Subscribe to events".)
#   - Leave "Request user authorization (OAuth) during installation"
#     UNCHECKED — the team claim flow triggers OAuth itself.
# GITHUB_APP_ID is the numeric App ID; GITHUB_APP_SLUG is the App's URL slug
# (used to build the install link). GITHUB_APP_PRIVATE_KEY is the App's PEM
# private key, base64-encoded (so the multi-line PEM survives env/compose):
#   base64 -w0 your-app.private-key.pem
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=
# GitHub App OAuth client credentials (STRONGLY RECOMMENDED) — power the
# team "Connect GitHub" claim flow: a single mobile-friendly authorize
# screen instead of GitHub's install/configure page. The user token is used
# once (to enumerate the user's installations) and DISCARDED — never stored.
# Generate a client secret on the App's settings page. Unset → the connect
# flow falls back to the install-page round-trip.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GitHub webhook HMAC secret — PR-merge detection via the App webhook. Servers
# GitHub cannot reach (self-hosted behind NAT) skip the webhook and set
# GITHUB_POLLING=true to run an outbound merge cron instead (decoupled from
# CLOUD_INSTANCE).
# GITHUB_WEBHOOK_SECRET=
# GITHUB_POLLING=true

# --- Push notifications (via push-relay service) ----------------------------
# Forwards FCM pushes to mobile devices. PUSH_RELAY_URL is the relay's base
# URL (cloud: https://push.exponential.at). PUSH_RELAY_SECRET must match
# between the web app and the relay (sent as the x-relay-secret header; the
# relay refuses to start without it — URL without secret means every push is
# rejected with 401).
#
# NOTE FOR SELF-HOSTERS: the STORE-INSTALLED mobile apps are compiled against
# Exponential's first-party Firebase project — a self-hosted relay cannot
# reach their device tokens. Mobile push on self-host only works if you build
# the mobile apps yourself against your own Firebase project; the relay
# process (apps/push-relay) then needs FIREBASE_SERVICE_ACCOUNT_JSON (read by
# the relay only, never the web app).
# PUSH_RELAY_URL=
# PUSH_RELAY_SECRET=

# --- Steer relay (remote start + live watch/steer) ---------------------------
# Outbound WebSocket hub. Unset ⇒ the whole subsystem is off (mintTicket
# returns disabled; local coding is unaffected), mirroring how PUSH_RELAY_URL
# unset disables push.
# STEER_RELAY_URL is the relay base the desktop + clients dial (cloud:
# wss://steer.exponential.at; LAN self-host: ws://relay.lan:4002). The web app
# derives the http(s) origin from it for its server-to-server relay calls.
# STEER_RELAY_SECRET is the shared HS256 secret: the web app signs relay tickets
# and authenticates its /devices, /start, /kill calls with it; the relay verifies
# ticket signatures with the same value. Must match between web app and relay.
# STEER_RELAY_URL=
# STEER_RELAY_SECRET=

# --- Feedback widget rate limits ---------------------------------------------
# In-process token buckets for the public widget submit endpoint.
# WIDGET_RATE_LIMIT_PER_KEY_HOURLY=60
# WIDGET_RATE_LIMIT_KEY_BURST=10
# WIDGET_RATE_LIMIT_PER_IP_HOURLY=60
# WIDGET_RATE_LIMIT_IP_BURST=5
# Per reporter address (submissions carrying an email can trigger outbound
# mail to it — this bucket stops mail-bombing a typed-in address):
# WIDGET_RATE_LIMIT_PER_EMAIL_HOURLY=6
# WIDGET_RATE_LIMIT_EMAIL_BURST=3

# --- Helpdesk reporter routes (magic-link read/reply) ------------------------
# Rate limits for the anonymous /api/support/* routes (in-process buckets):
# SUPPORT_RATE_LIMIT_READ_HOURLY=300
# SUPPORT_RATE_LIMIT_READ_BURST=30
# SUPPORT_RATE_LIMIT_REPLY_IP_HOURLY=30
# SUPPORT_RATE_LIMIT_REPLY_IP_BURST=5
# SUPPORT_RATE_LIMIT_REPLY_THREAD_HOURLY=30
# SUPPORT_RATE_LIMIT_REPLY_THREAD_BURST=5
# Live-chat poll (~5s per visible tab; also the presence heartbeat that
# suppresses "new reply" emails while the reporter is watching):
# SUPPORT_RATE_LIMIT_POLL_HOURLY=1440
# SUPPORT_RATE_LIMIT_POLL_BURST=90

# --- Contact form -------------------------------------------------------------
# Where POST /api/contact (the marketing site's contact/enterprise form)
# delivers inquiries via the configured email transport. Defaults to
# support@exponential.at. With no transport configured the endpoint answers
# 503 so the form can fall back to a mailto link.
# CONTACT_EMAIL_TO=
# Rate limits: per-IP plus a global backstop bounding total sends.
# CONTACT_RATE_LIMIT_PER_IP_HOURLY=10
# CONTACT_RATE_LIMIT_IP_BURST=3
# CONTACT_RATE_LIMIT_GLOBAL_HOURLY=30
# CONTACT_RATE_LIMIT_GLOBAL_BURST=10

# --- Server hardening / bootstrap ---------------------------------------------
# 'true' to emit CSP/HSTS etc. from the Bun server. Recommended in production
# when the app is served directly (reverse proxies that already set these can
# leave it off).
# SECURITY_HEADERS_ENABLED=true
# Comma-separated emails auto-promoted to global admin at startup.
# INITIAL_ADMIN_EMAILS=admin@example.com
# Bun runtime knob (not app config): cap on simultaneous outbound fetch()
# calls, default 256. The Electric shape proxy holds a long-poll fetch per
# shape per synced client, so the default saturates at ~16 clients and stalls
# all other outbound fetches. Read by Bun at process start — the official
# Docker image bakes it via ENV; if you run the compiled server yourself,
# export it in the actual process environment rather than relying on this file.
# BUN_CONFIG_MAX_HTTP_REQUESTS=65336

# --- Mobile app links ----------------------------------------------------------
# SHA-256 signing-cert fingerprints served in /.well-known/assetlinks.json so
# Android verifies https issue/invite links and opens them in the native app.
# Comma-separated colon-hex, from Play Console → App integrity → app signing
# key certificate (Play App Signing — NOT the local upload keystore). Unset ⇒
# the route 404s and links keep opening in the browser. The iOS counterpart
# (/.well-known/apple-app-site-association) is static and needs no env.
# ANDROID_APP_LINK_FINGERPRINTS=AA:BB:...,CC:DD:...

# --- Dev / debugging -------------------------------------------------------------
# Set to "1" to hide the TanStack Router devtools panel.
# DISABLE_ROUTER_DEVTOOLS=1
# Same toggle, but read at build time by Vite.
# VITE_DISABLE_ROUTER_DEVTOOLS=1

# ═══════════════════════════════════════════════════════════════════════════
# CLOUD-ONLY — leave unset when self-hosting
# ═══════════════════════════════════════════════════════════════════════════

# --- Electric Cloud credentials ---------------------------------------------
# Only when using hosted Electric (dashboard.electric-sql.cloud) instead of
# the bundled Electric container.
# ELECTRIC_SOURCE_ID=
# ELECTRIC_SECRET=

# --- Creem billing ------------------------------------------------------------
# Create products at https://creem.io/dashboard and note the product IDs.
# Team monthly = €15/seat/mo; Team yearly = €12/seat/mo billed annually
# (€144/seat/yr). Only read when CLOUD_INSTANCE=true (billing is off
# otherwise anyway).
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_TEAM_PRODUCT_ID=
# CREEM_TEAM_YEARLY_PRODUCT_ID=

# --- SES bounce/complaint webhook ----------------------------------------------
# Admin console → Email. Subscribe an SNS topic (attached to the SES
# identity's Bounce + Complaint notifications) via HTTPS to
# ${BETTER_AUTH_URL}/api/webhooks/ses?secret=${SES_WEBHOOK_SECRET} — the route
# auto-confirms the subscription. Unset: the webhook answers 503 and bounce
# tracking is off. The suppress action additionally needs the IAM user to be
# allowed ses:PutSuppressedDestination.
# SES_WEBHOOK_SECRET=

# --- Sign in with Apple -----------------------------------------------------------
# REQUIRED for the iOS App Store when Google login is enabled (guideline 4.8).
# APPLE_CLIENT_ID is the Apple *Services ID* (not the app bundle id), created
# in the Apple Developer portal with "Sign in with Apple" enabled and
# ${BETTER_AUTH_URL}/api/auth/callback/apple registered as a Return URL.
# The client secret is an ES256 JWT Apple caps at 6 months — provide the SIWA
# .p8 key instead (base64 -w0 AuthKey_XXX.p8, like GITHUB_APP_PRIVATE_KEY) and
# the server mints a fresh secret at every boot. A static APPLE_CLIENT_SECRET
# is still honored (and wins) if you prefer minting it yourself.
# APPLE_APP_BUNDLE_IDENTIFIER is optional: only needed if the iOS app ever
# exchanges a native ASAuthorization idToken directly.
# APPLE_CLIENT_ID=
# APPLE_PRIVATE_KEY=
# APPLE_KEY_ID=
# APPLE_TEAM_ID=
# APPLE_CLIENT_SECRET=
# APPLE_LOGIN_ENABLED=true
# APPLE_APP_BUNDLE_IDENTIFIER=at.exponential

# --- Minimum client versions --------------------------------------------------------
# Native clients send `x-client-version: <platform>/<version>` on every
# request; when a platform's MIN var is set and a client compares below it,
# tRPC + shape requests answer HTTP 426 and the app shows its blocking update
# screen. Unset = gate off (fail-open — clients shipped before the header
# existed keep working). LATEST is informational only (GET /api/version + the
# 426 body), it drives no blocking.
# Values are ALWAYS the marketing version (Android versionName, iOS
# CFBundleShortVersionString, desktop tag version — e.g. 0.13.3), NEVER an
# Android versionCode or iOS build number: `40` is a numerically valid value
# that would instantly 426 every header-sending client.
# CLIENT_MIN_VERSION_ANDROID=
# CLIENT_MIN_VERSION_IOS=
# CLIENT_MIN_VERSION_DESKTOP=
# CLIENT_LATEST_VERSION_ANDROID=
# CLIENT_LATEST_VERSION_IOS=
# CLIENT_LATEST_VERSION_DESKTOP=
