{
  "setup": "bun install --ignore-scripts",
  "ci": {
    "workflows": [
      "test.yml"
    ]
  },
  "generated": [
    {
      "name": "changelog",
      "paths": [
        "apps/web/src/lib/changelog.ts",
        "apps/desktop/crates/ui/src/changelog.rs"
      ],
      "strategy": "prepend-union"
    },
    {
      "name": "migrations",
      "paths": [
        "apps/web/src/db/out/*.sql",
        "apps/web/src/db/out/meta/**"
      ],
      "strategy": "renumber",
      "command": "bun run migrate:generate",
      "verify": [
        "apps/web/src/db/out/*.sql"
      ]
    },
    {
      "name": "contract bindings",
      "paths": [
        "**/DomainContract.generated.*",
        "**/contract.generated.rs",
        "**/SettingsNav.generated.*"
      ],
      "strategy": "regenerate",
      "command": "bun run --filter @exp/domain-contract generate"
    },
    {
      "name": "icon bindings",
      "paths": [
        "packages/icons/src/generated.ts",
        "**/icons.generated.*",
        "**/AppIcons.generated.swift",
        "**/ExpIcons.generated.kt",
        "apps/desktop/assets/icons/**",
        "apps/ios/Exponential/Assets.xcassets/lucide-*/**"
      ],
      "strategy": "regenerate",
      "command": "bun run --filter @exp/icons generate"
    },
    {
      "name": "eUI catalog and skills",
      "paths": [
        "packages/exponential-ui/src/catalog.generated.ts",
        "packages/exponential-ui/generated/**",
        "packages/exponential-ui/docs/*.generated.json",
        "packages/exponential-ui/catalog/*.schema.json",
        "packages/exponential-ui/conformance/manifest.json",
        "packages/exponential-ui/skills/**",
        "apps/desktop/crates/eui-core/src/generated/**",
        "packages/exponential-ui/fixtures/catalog-components.json",
        "packages/exponential-ui/fixtures/catalog-macros.json",
        "packages/exponential-ui/fixtures/catalog-basic-map.json",
        "packages/exponential-ui/fixtures/catalog-extension.json",
        "packages/exponential-ui/fixtures/kitchen-sink.expanded.json",
        "packages/exponential-ui/fixtures/prompt-budget.json",
        "packages/exponential-ui/fixtures/bind-time.json",
        "packages/exponential-ui/fixtures/style-conditions.json",
        "packages/exponential-ui/fixtures/code-tokens.json",
        "packages/exponential-ui/fixtures/text-shimmer.json",
        "packages/exponential-ui/fixtures/voice-wave.json",
        "packages/exponential-ui/fixtures/qr-code.json",
        "packages/exponential-ui/fixtures/zoom.json",
        "packages/exponential-ui/fixtures/specimens.json"
      ],
      "strategy": "regenerate",
      "command": "bun run --filter @exponential_app/eui generate && bun run --filter @exponential_app/eui generate:skills"
    },
    {
      "name": "lockfiles",
      "paths": [
        "bun.lock",
        "apps/desktop/Cargo.lock",
        "apps/ede/Cargo.lock"
      ],
      "strategy": "regenerate",
      "command": "bun install --lockfile-only --ignore-scripts && cargo update --workspace --manifest-path apps/desktop/Cargo.toml && cargo update --workspace --manifest-path apps/ede/Cargo.toml"
    },
    {
      "name": "shots index",
      "paths": [
        "shots/index.json"
      ],
      "strategy": "json-union"
    },
    {
      "name": "shots",
      "paths": [
        "shots/**/*.webp"
      ],
      "strategy": "take-later"
    },
    {
      "name": "npm licence inventory",
      "paths": [
        "packages/licenses/inventory/npm-*.json"
      ],
      "strategy": "regenerate",
      "command": "bun install --ignore-scripts && bun run notices:collect:npm"
    },
    {
      "name": "rust licence inventory",
      "paths": [
        "packages/licenses/inventory/rust.json",
        "packages/licenses/inventory/rust-excluded.json",
        "packages/licenses/inventory/rust-runner-*.json"
      ],
      "strategy": "regenerate",
      "command": "CARGO_HTTP_MULTIPLEXING=false CARGO_NET_RETRY=10 bun run notices:collect:rust"
    },
    {
      "name": "licence notices",
      "paths": [
        "**/NOTICES.txt"
      ],
      "strategy": "regenerate",
      "command": "bun run notices"
    }
  ],
  "lockfiles": {
    "paths": [
      "**/Cargo.lock",
      "bun.lock",
      "**/package-lock.json",
      "**/Package.resolved",
      "**/gradle.lockfile",
      "**/libs.versions.toml"
    ],
    "manifests": [
      {
        "paths": [
          "**/Cargo.toml"
        ],
        "lock": "Cargo.lock"
      },
      {
        "paths": [
          "**/package.json"
        ],
        "lock": "bun.lock"
      },
      {
        "paths": [
          "**/package.json"
        ],
        "lock": "package-lock.json"
      },
      {
        "paths": [
          "**/Package.swift"
        ],
        "lock": "Package.resolved"
      },
      {
        "paths": [
          "**/build.gradle.kts"
        ],
        "lock": "gradle.lockfile"
      },
      {
        "paths": [
          "**/build.gradle.kts"
        ],
        "lock": "libs.versions.toml"
      }
    ]
  }
}
