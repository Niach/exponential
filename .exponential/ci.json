{
  "$comment": "The dogfood of #EXP-1617 (#EXP-1812): the cheap legs of the Actions `gate` only. `web unit` (4 vitest shards) is dropped: on mint, a loaded shared desktop (load 66 on 32 cores, the runner at SCHED_IDLE, 1 slot, 10G cap) each shard took 17-30 min and died on vitest worker timeouts, vs ~4 min on Actions. Heavy legs need a dedicated runner device; Actions keeps running them.",
  "version": 1,
  "name": "ecode",
  "on": {
    "pull_request": {},
    "push": {
      "branches": [
        "master"
      ]
    },
    "manual": {}
  },
  "env": {
    "CI": "true"
  },
  "jobs": {
    "typecheck": {
      "name": "ecode typecheck",
      "runsOn": [
        "linux"
      ],
      "timeoutMin": 30,
      "steps": [
        {
          "name": "Install",
          "run": "export PATH=\"$HOME/.bun/bin:$PATH\"\nbun install --frozen-lockfile"
        },
        {
          "name": "Typecheck",
          "run": "export PATH=\"$HOME/.bun/bin:$PATH\"\nbun run typecheck"
        }
      ]
    },
    "contract-ts": {
      "name": "ecode contract-ts",
      "runsOn": [
        "linux"
      ],
      "timeoutMin": 30,
      "steps": [
        {
          "name": "Install",
          "run": "export PATH=\"$HOME/.bun/bin:$PATH\"\nbun install --frozen-lockfile"
        },
        {
          "name": "Contract tests",
          "run": "export PATH=\"$HOME/.bun/bin:$PATH\"\nbun test ./src",
          "workingDirectory": "packages/domain-contract"
        }
      ]
    },
    "merge-train": {
      "name": "ecode merge-train",
      "runsOn": [
        "linux"
      ],
      "timeoutMin": 30,
      "steps": [
        {
          "name": "Install",
          "run": "export PATH=\"$HOME/.bun/bin:$PATH\"\nbun install --frozen-lockfile"
        },
        {
          "name": "Merge train engine",
          "run": "export PATH=\"$HOME/.bun/bin:$PATH\"\nbun run test:merge-train"
        }
      ]
    },
    "release-scripts": {
      "name": "ecode release-scripts",
      "runsOn": [
        "linux"
      ],
      "timeoutMin": 10,
      "steps": [
        {
          "name": "Tag keeping",
          "run": "bash scripts/release/test-tagkeep.sh"
        }
      ]
    },
    "rewrite-gaps": {
      "name": "ecode rewrite-gaps",
      "runsOn": [
        "linux"
      ],
      "timeoutMin": 30,
      "steps": [
        {
          "name": "Install",
          "run": "export PATH=\"$HOME/.bun/bin:$PATH\"\nbun install --frozen-lockfile"
        },
        {
          "name": "Rewrite gaps",
          "run": "export PATH=\"$HOME/.bun/bin:$PATH\"\nbun test eval/gaps.test.ts",
          "workingDirectory": "packages/exponential-ui"
        }
      ]
    }
  }
}
