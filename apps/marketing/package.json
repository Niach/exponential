{
  "name": "@exp/marketing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/ui-demos.tsx && bun run gen:ui && vite",
    "build": "bun run scripts/ui-demos.tsx && bun run gen:ui && tsc --noEmit && vite build && bun run scripts/prerender.tsx",
    "typecheck": "bun run scripts/ui-demos.tsx && bun run gen:ui && tsc --noEmit",
    "gen:ui": "bun run ui/scripts/guide-sources.ts && bun run ui/scripts/shot-index.ts",
    "test": "bun run gen:ui && bun test ./ui/src",
    "check:guides": "bun run ./ui/guides/check.ts all",
    "screenshots:ui": "bun run ui/scripts/screenshots.ts",
    "screenshots:store": "bun scripts/store/render-store-screenshots.tsx",
    "screenshots:pop-sidecars": "bun scripts/store/pop-sidecars.ts",
    "social:generate": "bun scripts/generate-social.tsx",
    "preview": "vite preview"
  },
  "dependencies": {
    "@exp/site-shell": "workspace:*",
    "@exp/ui": "workspace:*",
    "@exp/view-catalog": "workspace:*",
    "@exponential_app/eui": "workspace:*",
    "@exponential_app/eui-bench": "workspace:*",
    "@exponential_app/eui-react": "workspace:*",
    "lucide-react": "^0.544.0",
    "motion": "^12.39.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.54.2",
    "png-to-ico": "^3.0.1",
    "satori": "^0.26.0",
    "typescript": "^5.7.2",
    "vite": "7.3.3"
  }
}
