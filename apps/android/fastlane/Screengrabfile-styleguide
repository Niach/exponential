# screengrab configuration for the STYLEGUIDE capture suite (EXP-566).
#
# Same machinery as fastlane/Screengrabfile, pointed at
# StyleguideScreenshotsTest instead of the store flow: 24 shots
# (sg_sign-in … sg_onboarding) of the plain app surfaces, used as the
# cross-platform design reference rather than as Play listing assets. The shot
# names are a byte-exact contract shared with the other clients — never rename
# one without changing it everywhere.
#
# `bundle exec fastlane styleguide_screenshots shots:sg_reviews,sg_search`
# narrows a run to those ids (EXP-642); the navigation still runs in full.
#
# fastlane's screengrab action ALWAYS auto-loads `fastlane/Screengrabfile`
# (Screengrab.screengrabfile_name is hardcoded, and there is no config-path
# option or env var), so this file is NOT picked up by name. The
# `styleguide_screenshots` lane evaluates it through fastlane_core's own
# ConfigurationFile and passes the result to screengrab as explicit action
# arguments, which take precedence over the auto-loaded store config.
#
# Prereqs are the store suite's minus live steer TRAFFIC — no shot here watches
# a live session, but since EXP-642 three of them DO need the relay stub, which
# is what registers the demo user's own device row:
#   1. A running, seeded local backend reachable from the emulator:
#        bun run backend:up && bun dev
#        bun run seed:screenshots                                    (from apps/web)
#   2. The relay stub left running for the whole capture:
#        bun run screenshots:desktop                                 (from apps/web)
#      Without it sg_machine-settings (gated `isMine && registered`) and the two
#      sg_start-coding-* shots have no machine row to open.
#   3. An English-locale phone emulator booted (only one device attached).
#   4. Both APKs built: bundle exec fastlane styleguide_screenshots does this
#      for you.
#
# Output lands in fastlane/styleguide-screenshots/en-US/images/phoneScreenshots/
# (sg_*.png). Nothing uploads these to Play — they are raw reference captures.

# The production flavor's applicationId (debug build keeps the same id).
app_package_name("at.exponential")
tests_package_name("at.exponential.test")

# Only run the styleguide flow, not the store flow or any other test.
use_tests_in_classes(["com.exponential.app.StyleguideScreenshotsTest"])

locales(["en-US"])

# Wipe the old screenshots for the captured locales before writing new ones.
clear_previous_screenshots(true)

# Stable filenames (sg_sign-in.png, …) so the reference set stays diffable.
use_timestamp_suffix(false)

# Reinstall to clear app data between runs — the test drives the full
# first-launch flow (instance picker → login) and needs a signed-out app. It
# also keeps the newcomer account the last shot (sg_onboarding) adds from
# leaking into the next run.
reinstall_app(true)

# productionDebug variant, built via `fastlane styleguide_screenshots` (paths
# are relative to apps/android, where fastlane runs).
app_apk_path("app/build/outputs/apk/production/debug/app-production-debug.apk")
tests_apk_path("app/build/outputs/apk/androidTest/production/debug/app-production-debug-androidTest.apk")

# screengrab nests <locale>/images/phoneScreenshots under this root.
output_directory("fastlane/styleguide-screenshots")

test_instrumentation_runner("androidx.test.runner.AndroidJUnitRunner")
