# fastlane lanes for the Exponential Android app (apps/android).
#
# Runs locally on a Mac (or any machine with the Android SDK + JDK 17). CI wiring is
# optional sugar on top.
#
# Signing is driven by the RELEASE_* gradle properties / env vars that
# app/build.gradle.kts reads via releaseProp(). When RELEASE_STORE_FILE is unset the
# release build stays UNSIGNED (fallback) so `build` still produces artifacts before a
# keystore exists — you just cannot upload an unsigned .aab to Play.

default_platform(:android)

# Matches the `production` product flavor (flavorDimensions "env") — the only flavor
# that ships to the public Play listing. gradle() concatenates flavor + build_type into
# task names like `bundleProductionRelease` / `assembleProductionRelease`.
PRODUCTION_FLAVOR = "Production".freeze
# `staging` product flavor → the at.exponential.staging Play app (internal testing only,
# co-installs next to production because of the `.staging` applicationId suffix).
STAGING_FLAVOR = "Staging".freeze
STAGING_PACKAGE = "at.exponential.staging".freeze

platform :android do
  desc "Build a release App Bundle (.aab) + APK for the production flavor. " \
       "Signed when RELEASE_STORE_FILE is set; UNSIGNED fallback otherwise."
  lane :build do
    unless ENV["RELEASE_STORE_FILE"]
      UI.important("RELEASE_STORE_FILE is unset — producing an UNSIGNED release build.")
      UI.important("Set RELEASE_STORE_FILE / RELEASE_STORE_PASSWORD / RELEASE_KEY_ALIAS / " \
                   "RELEASE_KEY_PASSWORD to sign.")
    end

    # App Bundle (.aab) — the Play upload artifact.
    gradle(
      task: "bundle",
      flavor: PRODUCTION_FLAVOR,
      build_type: "Release",
    )
    UI.success("AAB: #{lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]}")

    # APK — for sideload / direct-download distribution.
    gradle(
      task: "assemble",
      flavor: PRODUCTION_FLAVOR,
      build_type: "Release",
    )
    UI.success("APK: #{lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]}")
  end

  # Distribution runs through the CLOSED testing track (Google-Groups testers),
  # not internal. This app's closed track is the console's default closed track
  # "Alpha" — API identifier `alpha` (verified: build 15 lives there; `beta` is
  # empty). A custom closed track would use its exact name — override via
  # PLAY_TRACK.
  CLOSED_TRACK = ENV["PLAY_TRACK"] || "alpha"

  desc "Build + upload the production .aab to the Play closed testing track."
  lane :closed do
    build
    upload_to_play_store(
      track: CLOSED_TRACK,
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      json_key: ENV.fetch("SUPPLY_JSON_KEY"),
      release_status: "draft",
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Build + upload the STAGING flavor (.aab) to the at.exponential.staging Play " \
       "INTERNAL testing track. The app record must already exist in the Play Console " \
       "(the Play API cannot create apps) and the service account must have access. Signs " \
       "from the RELEASE_* env like `build`; needs SUPPLY_JSON_KEY. Override the rollout " \
       "state with PLAY_RELEASE_STATUS (default 'completed' = immediately live to testers)."
  lane :internal do
    unless ENV["RELEASE_STORE_FILE"]
      UI.user_error!("RELEASE_STORE_FILE unset — the .aab must be signed to upload to Play.")
    end
    gradle(task: "bundle", flavor: STAGING_FLAVOR, build_type: "Release")
    UI.success("Staging AAB: #{lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]}")
    upload_to_play_store(
      package_name: STAGING_PACKAGE,
      track: "internal",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      json_key: ENV.fetch("SUPPLY_JSON_KEY"),
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  # The screenshot tests read the backend URL from the `instanceUrl`
  # instrumentation argument; default is http://10.0.2.2:5173 (host loopback
  # from the emulator).
  def screenshot_launch_arguments
    ENV["SCREENGRAB_INSTANCE_URL"]&.then { |url| ["instanceUrl #{url}"] }
  end

  # screengrab ALWAYS auto-loads `fastlane/Screengrabfile` — the filename is
  # hardcoded in Screengrab.screengrabfile_name and there is no config-path
  # option or env var to point it elsewhere. To run a second suite we evaluate
  # its config file through fastlane_core's own ConfigurationFile and hand the
  # resulting options to the action explicitly: explicit action arguments win
  # over anything the auto-loaded Screengrabfile set.
  def screengrab_options_from(config_file_name)
    require "screengrab"
    path = File.expand_path(config_file_name, __dir__)
    UI.user_error!("No screengrab config at #{path}") unless File.exist?(path)
    empty = FastlaneCore::Configuration.create(Screengrab::Options.available_options, {})
    FastlaneCore::ConfigurationFile.new(empty, path, nil, true).options
  end

  desc "Capture Play Store screenshots on a booted emulator via screengrab. " \
       "Needs the seeded local backend running (see fastlane/Screengrabfile); " \
       "override the instance URL with SCREENGRAB_INSTANCE_URL. Raw captures land " \
       "in fastlane/screenshots-raw/ — follow up with `bun run screenshots:store` " \
       "(repo root) before sync_store, which composites the Play set (EXP-580)."
  lane :screenshots do
    gradle(
      tasks: [":app:assembleProductionDebug", ":app:assembleProductionDebugAndroidTest"],
    )

    # Everything else (APK paths, package name, locales, output dir) comes from
    # fastlane/Screengrabfile.
    launch_arguments = screenshot_launch_arguments
    if launch_arguments
      screengrab(launch_arguments: launch_arguments)
    else
      screengrab
    end
  end

  desc "Capture the STYLEGUIDE reference screenshots (EXP-566) on a booted emulator: " \
       "11 sg_* shots of the plain app surfaces, into fastlane/styleguide-screenshots/. " \
       "Same seeded local backend as `screenshots` (no steer relay needed); override " \
       "the instance URL with SCREENGRAB_INSTANCE_URL. Config lives in " \
       "fastlane/Screengrabfile-styleguide."
  lane :styleguide_screenshots do
    gradle(
      tasks: [":app:assembleProductionDebug", ":app:assembleProductionDebugAndroidTest"],
    )

    options = screengrab_options_from("Screengrabfile-styleguide")
    launch_arguments = screenshot_launch_arguments
    options[:launch_arguments] = launch_arguments if launch_arguments
    screengrab(options)
  end

  # Release notes are en-US only: changelogs/<vc>.txt lives under en-US and Play
  # falls back to it for every other locale. Never add a changelogs/default.txt
  # (per-locale or en-US) — supply uploads it for any release without a <vc>.txt,
  # which shipped the generic listing blurb as "What's new" to non-English users.
  # Newest committed changelogs/<versionCode>.txt. supply's metadata push needs an
  # explicit version code to anchor per-locale changelogs — without one it aborts on
  # the first localized listing (cs-CZ et al.) that has no changelogs dir.
  def newest_changelog_version_code
    Dir.glob(File.expand_path("metadata/android/en-US/changelogs/[0-9]*.txt"))
       .map { |f| File.basename(f, ".txt").to_i }.max
  end

  desc "Promote the current closed-testing build to the production track (no new binary). " \
       "Defaults version_code to the newest changelogs/<vc>.txt; override with version_code:NN."
  lane :production do |options|
    version_code = options[:version_code] || newest_changelog_version_code
    UI.user_error!("No changelogs/<versionCode>.txt found — pass version_code:NN.") unless version_code
    upload_to_play_store(
      track: CLOSED_TRACK,
      track_promote_to: "production",
      version_code: version_code,
      json_key: ENV.fetch("SUPPLY_JSON_KEY"),
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: true,
      # Screenshots are NOT version-controlled (EXP-348, matching iOS) — they only
      # exist locally after a `screenshots` run and in the Play listing. Push them
      # explicitly via `sync_store` after regenerating; promoting a build must not
      # clobber the listing with whatever happens to sit in the working tree.
      skip_upload_screenshots: true,
    )
  end

  desc "Upload listing metadata + freshly generated screenshots to Play WITHOUT " \
       "touching binaries or track states. Run `fastlane screenshots` first — the " \
       "phoneScreenshots dir is gitignored (EXP-348), so this lane pushes whatever " \
       "the last screengrab run produced. supply's metadata path must anchor to an " \
       "EXISTING release, so the lane targets the closed track (the only track with " \
       "releases so far) and defaults version_code to the newest changelogs/<vc>.txt; " \
       "override with `fastlane sync_store version_code:NN`."
  lane :sync_store do |options|
    screenshot_dir = File.expand_path("metadata/android/en-US/images/phoneScreenshots")
    shots = Dir.glob("#{screenshot_dir}/*.png")
    UI.user_error!("No screenshots in #{screenshot_dir} — run `fastlane screenshots` first.") if shots.empty?
    version_code = options[:version_code] || newest_changelog_version_code
    UI.user_error!("No changelogs/<versionCode>.txt found — pass version_code:NN.") unless version_code
    UI.message("Uploading #{shots.length} phone screenshots + listing metadata (anchor release #{version_code} on #{CLOSED_TRACK}).")
    upload_to_play_store(
      track: CLOSED_TRACK,
      version_code: version_code,
      json_key: ENV.fetch("SUPPLY_JSON_KEY"),
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: false,
    )
  end
end
