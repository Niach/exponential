<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="exponential_secure_prefs.xml" />
        <!-- Keystore-sealed install secrets (EXP-1435, EXP-1457, EXP-1459 tree keys): never leave the device. -->
        <exclude domain="sharedpref" path="exp_push_key.xml" />
        <exclude domain="sharedpref" path="exp_enet_identity.xml" />
        <exclude domain="sharedpref" path="exp_tree_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="exponential_secure_prefs.xml" />
        <!-- Keystore-sealed install secrets (EXP-1435, EXP-1457, EXP-1459 tree keys): never leave the device. -->
        <exclude domain="sharedpref" path="exp_push_key.xml" />
        <exclude domain="sharedpref" path="exp_enet_identity.xml" />
        <exclude domain="sharedpref" path="exp_tree_keys.xml" />
    </device-transfer>
</data-extraction-rules>
