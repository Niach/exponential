<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- #EXP-1639: a running session as a promoted Live Update (API 36+). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- NEW-69: a voice call streams the microphone to the voice device,
         under a microphone foreground service while it runs. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:name=".ExponentialApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Exponential"
        android:usesCleartextTraffic="true">

        <!-- #LOGS-2: Sentry starts by hand in Observability.kt, only when a DSN
             was built in; its auto-init provider never runs. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
        <provider
            android:name="io.sentry.android.core.SentryInitProvider"
            android:authorities="${applicationId}.SentryInitProvider"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Exponential.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth return (REV-13): a custom scheme can never be an App Link
                 (autoVerify only works for http/https), so any co-installed app
                 declaring this same scheme+host filter can win the implicit-intent
                 resolution. That is safe because the link carries only a
                 single-use, short-TTL PKCE code — useless without the in-app
                 code_verifier that /api/mobile-oauth-exchange requires — never
                 the session token. (Pre-PKCE servers still send a raw token;
                 that legacy path is deprecated server-side.) -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="exponential" android:host="oauth-return" />
            </intent-filter>

            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="exponential" android:host="issue" />
            </intent-filter>

            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="exponential" android:host="invite" />
            </intent-filter>

            <!-- agent_message push taps (EXP-801): the My Work inbox. The
                 foreground FcmService has always built this ACTION_VIEW
                 intent; without a filter for it the tap resolved to nothing
                 (EXP-980 found it while adding the run host below). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="exponential" android:host="inbox" />
            </intent-filter>

            <!-- session_blocked push taps (EXP-980): the run that hit the wall. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="exponential" android:host="session" />
            </intent-filter>

            <!-- agent_signed_out push taps (#EXP-1534): that device's settings. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="exponential" android:host="device" />
            </intent-filter>

            <!-- App Links (EXP-92): verified https links open the app instead of
                 the mobile web. Host is per-flavor (production app.exponential.at,
                 staging next.exponential.at); verification needs the host to serve
                 /.well-known/assetlinks.json with this build's signing cert (env
                 ANDROID_APP_LINK_FINGERPRINTS on the web app — Play App Signing
                 key for store installs). Only the shapes the app can render
                 are claimed (issue detail, sessions, the Agent page, chats, app screens +
                 invites; never boards or settings: public board visitors and web-only
                 pages stay on the web, #EXP-1674); AppNavHost applies the one open rule. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${appLinkHost}" />
                <!-- Only the current /t/{team}/boards/{board}/issues/{id} form
                     is claimed (the great rename, EXP-180): the legacy /w/ and
                     /projects/ routes are dead on the web (no redirects), so
                     claiming them would swallow links nothing can render. -->
                <data android:pathPattern="/t/.*/boards/.*/issues/.*" />
                <data android:pathPattern="/t/.*/issues/.*" />
                <data android:pathPattern="/t/.*/agent" />
                <data android:pathPattern="/t/.*/chats" />
                <data android:pathPattern="/t/.*/sessions/.*" />
                <!-- VAPP-218: an app screen (`/t/{team}/apps/{app}/{screen}`). -->
                <data android:pathPattern="/t/.*/apps/.*/.*" />
                <data android:pathPrefix="/invite/" />
            </intent-filter>

            <!-- Fired by the server's post-GitHub-App-install page so the connect
                 flow returns into the app instead of continuing in the browser. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="exponential" android:host="github-connected" />
            </intent-filter>

            <!-- Share target (EXP-1635): anything shared lands on Share to; the
                 chat path takes every type, New issue takes text and images. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- EXP-1635: text selected in any app, the same flow with text only. -->
            <intent-filter android:label="@string/process_text_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- #EXP-1638: the long-press statics; EXP-1635: the sharing
                 shortcuts' <share-target> (DirectShareShortcuts). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- EXP-297: hands cached issue attachments to external viewers and
             share targets as content:// URIs. Not exported; every consumer
             gets a per-intent read grant (FLAG_GRANT_READ_URI_PERMISSION). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <service
            android:name=".data.call.VoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- #EXP-1641: a push's notification actions (answer, approve, reply),
             run without opening the app. Only this app's PendingIntents reach it. -->
        <receiver
            android:name=".data.push.NotificationActionReceiver"
            android:exported="false" />

        <service
            android:name=".data.push.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Only reached against a server whose push relay predates EXP-264:
             those sent notification-type FCM messages, which the FCM SDK
             renders itself with the app backgrounded (FcmService is never
             called), falling back to the launcher icon — not alpha-safe for
             the status bar (EXP-143). Its tap arrives as launcher-intent
             extras, which MainActivity.handlePushExtras still routes. The
             current relay is data-only, so FcmService builds both the
             notification and its deep link. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />

    </application>

</manifest>
