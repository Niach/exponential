[
  {
    "name": "rule 1: blockers decide a node that has not started",
    "snapshot": {
      "workflow": {
        "id": "wf-1",
        "status": "running",
        "integrationBranch": "exp/wf-abcdef12",
        "maxParallel": 0
      },
      "nodes": [
        { "id": "a", "issueId": "i-a", "kind": "contract", "state": "blocked", "wave": 0, "lane": 0 },
        { "id": "b", "issueId": "i-b", "kind": "leaf", "state": "blocked", "wave": 1, "lane": 0 },
        { "id": "c", "issueId": "i-c", "kind": "leaf", "state": "ready", "wave": 1, "lane": 1 }
      ],
      "edges": [["a", "b"], ["a", "c"]],
      "integrationBranchExists": true,
      "nowMs": 1000
    },
    "expected": [
      { "kind": "setNodeState", "nodeId": "a", "state": "ready" },
      { "kind": "setNodeState", "nodeId": "c", "state": "blocked" }
    ]
  },
  {
    "name": "rule 1: a skipped blocker releases its dependents",
    "snapshot": {
      "workflow": {
        "id": "wf-1",
        "status": "running",
        "integrationBranch": "exp/wf-abcdef12",
        "maxParallel": 0
      },
      "nodes": [
        { "id": "a", "issueId": "i-a", "kind": "leaf", "state": "skipped", "wave": 0, "lane": 0 },
        { "id": "b", "issueId": "i-b", "kind": "leaf", "state": "landed", "wave": 0, "lane": 1 },
        { "id": "c", "issueId": "i-c", "kind": "leaf", "state": "blocked", "wave": 1, "lane": 0 }
      ],
      "edges": [["a", "c"], ["b", "c"]],
      "integrationBranchExists": true,
      "nowMs": 1000
    },
    "expected": [{ "kind": "setNodeState", "nodeId": "c", "state": "ready" }]
  },
  {
    "name": "rule 1: a failed node blocks its dependents, an independent branch goes on",
    "snapshot": {
      "workflow": {
        "id": "wf-1",
        "status": "running",
        "integrationBranch": "exp/wf-abcdef12",
        "maxParallel": 3
      },
      "nodes": [
        {
          "id": "a",
          "issueId": "i-a",
          "kind": "leaf",
          "state": "failed",
          "wave": 0,
          "lane": 0,
          "sessionId": "s-a",
          "attempt": 2
        },
        { "id": "b", "issueId": "i-b", "kind": "leaf", "state": "blocked", "wave": 1, "lane": 0 },
        { "id": "c", "issueId": "i-c", "kind": "leaf", "state": "blocked", "wave": 0, "lane": 1 }
      ],
      "edges": [["a", "b"]],
      "sessions": { "s-a": { "live": false } },
      "integrationBranchExists": true,
      "nowMs": 1000
    },
    "expected": [
      { "kind": "setNodeState", "nodeId": "c", "state": "ready" },
      { "kind": "startNode", "nodeId": "c", "attempt": 1, "baseBranch": "exp/wf-abcdef12" }
    ]
  },
  {
    "name": "rule 1: a live session reads running, needs_input and rate limited",
    "snapshot": {
      "workflow": {
        "id": "wf-1",
        "status": "running",
        "integrationBranch": "exp/wf-abcdef12",
        "maxParallel": 0
      },
      "nodes": [
        {
          "id": "a",
          "issueId": "i-a",
          "kind": "leaf",
          "state": "ready",
          "wave": 0,
          "lane": 0,
          "sessionId": "s-a",
          "attempt": 1
        },
        {
          "id": "b",
          "issueId": "i-b",
          "kind": "leaf",
          "state": "running",
          "wave": 0,
          "lane": 1,
          "sessionId": "s-b",
          "attempt": 1
        },
        {
          "id": "c",
          "issueId": "i-c",
          "kind": "leaf",
          "state": "running",
          "wave": 0,
          "lane": 2,
          "sessionId": "s-c",
          "attempt": 1
        }
      ],
      "sessions": {
        "s-a": { "live": true },
        "s-b": { "live": true, "needsInput": true },
        "s-c": { "live": true, "blocked": true, "blockedResetsAtMs": 9000 }
      },
      "integrationBranchExists": true,
      "nowMs": 1000
    },
    "expected": [
      { "kind": "setNodeState", "nodeId": "a", "state": "running" },
      { "kind": "setNodeState", "nodeId": "b", "state": "waiting", "note": "Needs an answer" },
      { "kind": "setNodeState", "nodeId": "c", "state": "waiting", "note": "Rate limited" }
    ]
  },
