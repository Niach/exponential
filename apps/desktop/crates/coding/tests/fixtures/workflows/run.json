    "expected": [
      {
        "kind": "setNodeState",
        "nodeId": "a",
        "state": "running",
        "note": "Waiting for the account's reset"
      },
      {
        "kind": "nudge",
        "sessionId": "s-a",
        "key": "500",
        "text": "The rate limit has reset. Continue where you left off."
      }
    ]
  },
