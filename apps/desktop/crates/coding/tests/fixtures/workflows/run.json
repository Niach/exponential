          "wave": 0,
          "lane": 0,
          "sessionId": "s-a",
          "attempt": 1
        }
      ],
      "sessions": { "s-a": { "live": true, "blocked": true, "blockedResetsAtMs": 500 } },
      "integrationBranchExists": true,
      "nowMs": 1000
