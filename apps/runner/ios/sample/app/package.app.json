{
  "formatVersion": 6,
  "id": "acme.album",
  "name": "Album",
  "version": "1.0.0",
  "catalogId": "https://ui.exponential.at/catalogs/core/v1",
  "functions": [
    "records_*",
    "app_navigate",
    "photos_pick"
  ],
  "sources": [
    "records:*"
  ],
  "records": {
    "note": {
      "title": "Note",
      "schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        }
      }
    }
  },
  "capabilities": [
    {
      "id": "photos.read",
      "why": "Pick the photos for an album."
    }
  ],
  "screens": [
    {
      "template": "notes",
      "title": "Notes",
      "icon": "ui-file"
    },
    {
      "template": "photos",
      "title": "Photos",
      "icon": "image"
    }
  ],
  "templates": {
    "notes": {
      "data": {
        "notes": {
          "rows": [],
          "count": 0
        }
      },
      "bindings": [
        {
          "path": "/notes",
          "source": "records:note?limit=100"
        }
      ],
      "components": [
        {
          "id": "root",
          "component": "Page",
          "title": "Notes",
          "children": [
            "list"
          ],
          "slots": {
            "trailing": "add"
          }
        },
        {
          "id": "add",
          "component": "Button",
          "label": "Note",
          "icon": "ui-add",
          "variant": "outline",
          "on": {
            "press": {
              "functionCall": {
                "@call": "records_upsert",
                "args": {
                  "kind": "note",
                  "data": {
                    "text": "A page for the summer album"
                  }
                }
              }
            }
          }
        },
        {
          "id": "list",
          "component": "List",
          "divided": true,
          "children": {
            "componentId": "row",
            "path": "/notes/rows",
            "key": "id"
          }
        },
        {
          "id": "row",
          "component": "Row",
          "title": {
            "@path": "text"
          },
          "icon": "ui-file"
        }
      ]
    },
    "photos": {
      "components": [
        {
          "id": "root",
          "component": "Page",
          "title": "Photos",
          "children": [
            "pick"
          ]
        },
        {
          "id": "pick",
          "component": "Button",
          "label": "Pick photos",
          "icon": "image",
          "on": {
            "press": {
              "functionCall": {
                "@call": "photos_pick",
                "args": {
                  "limit": 5
                }
              }
            }
          }
        }
      ]
    }
  }
}
