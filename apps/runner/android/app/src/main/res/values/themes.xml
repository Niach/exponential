<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No chrome: no action bar; the window paints genUI's dark background until the first frame. -->
    <style name="Runner" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/runner_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
