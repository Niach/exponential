{
  "$comment": "EXP-1604: THE four specimens of the `motion` styleguide entry, read by the web entry (motion.tsx) and the desktop twin (apps/desktop/crates/ui/src/styleguide/entries/motion.rs) so they cannot drift: a spinner, a success check drawing on (once, holding the check; its poster is the finished check), a themed illustration (`$color` tokens) shown in light AND dark, and a Motion scrubbed by a Slider through the bound `progress` (data `/progress`). `cases` paint in the app's mode; `illustration` paints twice, once per mode.",
  "data": { "progress": 0.4 },
  "cases": {
    "id": "sg-motion",
    "component": "Stack",
    "props": { "direction": "horizontal", "gap": "xl", "align": "start", "wrap": true },
    "children": [
      {
        "id": "sg-motion-spinner-case",
        "component": "Stack",
        "props": { "direction": "vertical", "gap": "xs", "align": "center" },
        "children": [
          {
            "id": "sg-motion-spinner",
            "component": "Motion",
            "props": {
              "label": "Loading",
              "size": [48, 48],
              "duration": 1000,
              "layers": [
                {
                  "type": "shape",
                  "transform": { "position": [24, 24], "rotation": { "keys": [{ "t": 0, "v": 0 }, { "t": 1000, "v": 360 }] } },
                  "shapes": [
                    { "type": "ellipse", "size": [36, 36] },
                    { "type": "trim", "end": 70 },
                    { "type": "stroke", "color": "$color.primary", "width": 4, "cap": "round" }
                  ]
                }
              ]
            }
          },
          { "id": "sg-motion-spinner-label", "component": "Text", "props": { "text": "Spinner", "variant": "caption" } }
        ]
      },
      {
        "id": "sg-motion-success-case",
        "component": "Stack",
        "props": { "direction": "vertical", "gap": "xs", "align": "center" },
        "children": [
          {
            "id": "sg-motion-success",
            "component": "Motion",
            "props": {
              "label": "Done",
              "loop": false,
              "poster": 1199,
              "size": [64, 64],
              "duration": 1200,
              "layers": [
                {
                  "type": "shape",
                  "id": "check",
                  "shapes": [
                    { "type": "path", "d": "M20 33 L28 41 L44 24" },
                    { "type": "trim", "end": { "keys": [{ "t": 0, "v": 0 }, { "t": 450, "v": 0, "ease": "ease-out" }, { "t": 800, "v": 100 }] } },
                    { "type": "stroke", "color": "$color.success", "width": 5, "cap": "round", "join": "round" }
                  ]
                },
                {
                  "type": "shape",
                  "id": "ring",
                  "transform": { "position": [32, 32], "rotation": -90 },
                  "shapes": [
                    { "type": "ellipse", "size": [52, 52] },
                    { "type": "trim", "end": { "keys": [{ "t": 0, "v": 0, "ease": "ease-in-out" }, { "t": 500, "v": 100 }] } },
                    { "type": "stroke", "color": "$color.success", "width": 4, "cap": "round" }
                  ]
                }
              ]
            }
          },
          { "id": "sg-motion-success-label", "component": "Text", "props": { "text": "Success", "variant": "caption" } }
        ]
      },
      {
        "id": "sg-motion-scrub-case",
        "component": "Stack",
        "props": { "direction": "vertical", "gap": "xs", "align": "stretch" },
        "style": { "width": "200px" },
        "children": [
          {
            "id": "sg-motion-scrub",
            "component": "Motion",
            "props": {
              "progress": { "path": "/progress" },
              "label": "Upload progress",
              "size": [200, 48],
              "duration": 1000,
              "layers": [
                {
                  "type": "shape",
                  "id": "dot",
                  "transform": { "position": { "keys": [{ "t": 0, "v": [12, 24] }, { "t": 1000, "v": [188, 24] }] } },
                  "shapes": [
                    { "type": "ellipse", "size": [16, 16] },
                    { "type": "fill", "color": "$color.primary" }
                  ]
                },
                {
                  "type": "shape",
                  "id": "fill",
                  "shapes": [
                    { "type": "path", "d": "M12 24 L188 24" },
                    { "type": "trim", "end": { "keys": [{ "t": 0, "v": 0 }, { "t": 1000, "v": 100 }] } },
                    { "type": "stroke", "color": "$color.primary", "width": 6, "cap": "round" }
                  ]
                },
                {
                  "type": "shape",
                  "id": "track",
                  "shapes": [
                    { "type": "path", "d": "M12 24 L188 24" },
                    { "type": "stroke", "color": "$color.muted", "width": 6, "cap": "round" }
                  ]
                }
              ]
            }
          },
          {
            "id": "sg-motion-scrub-slider",
            "component": "Slider",
            "props": { "label": "Progress", "min": 0, "max": 1, "step": 0.01, "value": { "path": "/progress" } }
          },
          { "id": "sg-motion-scrub-label", "component": "Text", "props": { "text": "Scrubbed by progress", "variant": "caption" } }
        ]
      }
    ]
  },
  "illustration": {
    "id": "sg-motion-illustration",
    "component": "Motion",
    "props": {
      "label": "Empty inbox",
      "size": [160, 120],
      "duration": 2000,
      "layers": [
        {
          "type": "shape",
          "id": "spark",
          "transform": {
            "position": [118, 30],
            "scale": { "keys": [{ "t": 0, "v": [100, 100], "ease": "ease-in-out" }, { "t": 1000, "v": [70, 70], "ease": "ease-in-out" }, { "t": 2000, "v": [100, 100] }] },
            "rotation": { "keys": [{ "t": 0, "v": 0 }, { "t": 2000, "v": 90 }] }
          },
          "shapes": [
            { "type": "star", "points": 4, "outerRadius": 10, "innerRadius": 3 },
            { "type": "fill", "color": "$color.primary" }
          ]
        },
        {
          "type": "shape",
          "id": "letter",
          "transform": {
            "position": { "keys": [{ "t": 0, "v": [80, 52], "ease": "ease-in-out" }, { "t": 1000, "v": [80, 44], "ease": "ease-in-out" }, { "t": 2000, "v": [80, 52] }] }
          },
          "shapes": [
            {
              "type": "group",
              "shapes": [
                { "type": "path", "d": "M-22 -12 L0 4 L22 -12" },
                { "type": "stroke", "color": "$color.mutedForeground", "width": 2, "cap": "round", "join": "round" }
              ]
            },
            { "type": "rect", "size": [48, 32], "radius": 4 },
            { "type": "fill", "color": "$color.card" },
            { "type": "stroke", "color": "$color.border", "width": 2 }
          ]
        },
        {
          "type": "shape",
          "id": "tray",
          "shapes": [
            { "type": "path", "d": "M28 70 L52 70 L60 82 L100 82 L108 70 L132 70 L132 100 Q132 106 126 106 L34 106 Q28 106 28 100 Z" },
            { "type": "fill", "color": "$color.muted" },
            { "type": "stroke", "color": "$color.border", "width": 2, "join": "round" }
          ]
        }
      ]
    }
  }
}
