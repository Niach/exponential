{
  "$comment": "#EDE-65: THE specimen of the `box-hover` styleguide entry, read by the web entry (box-hover.tsx) and the desktop twin (apps/desktop/crates/ui/src/styleguide/entries/box_hover.rs) so they cannot drift: three Box tiles whose `on.hover` sets /selected to the tile (fired as the pointer enters, like Motion's hover, no payload); the selected tile paints `$color.accent` behind its label, the eDE Alt-Tab switcher's hover-select. `data` seeds /selected = `b`.",
  "data": {
    "selected": "b"
  },
  "tiles": {
    "id": "box_hover",
    "component": "Stack",
    "props": {
      "direction": "horizontal",
      "gap": "sm"
    },
    "children": [
      {
        "id": "tile_a",
        "component": "Box",
        "style": {
          "position": "relative",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "center",
          "width": 96,
          "height": 64,
          "borderRadius": "$radius.md",
          "borderWidth": 1,
          "borderColor": "$color.border"
        },
        "on": {
          "hover": {
            "functionCall": {
              "@call": "set",
              "args": {
                "path": "/selected",
                "value": "a"
              }
            }
          }
        },
        "children": [
          {
            "id": "tile_a_selected",
            "component": "Box",
            "style": {
              "position": "absolute",
              "inset": 0,
              "borderRadius": "$radius.md",
              "backgroundColor": "$color.accent"
            },
            "visible": {
              "@call": "eq",
              "args": {
                "a": {
                  "@path": "/selected"
                },
                "b": "a"
              }
            }
          },
          {
            "id": "tile_a_label",
            "component": "Text",
            "props": {
              "text": "Files"
            }
          }
        ]
      },
      {
        "id": "tile_b",
        "component": "Box",
        "style": {
          "position": "relative",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "center",
          "width": 96,
          "height": 64,
          "borderRadius": "$radius.md",
          "borderWidth": 1,
          "borderColor": "$color.border"
        },
        "on": {
          "hover": {
            "functionCall": {
              "@call": "set",
              "args": {
                "path": "/selected",
                "value": "b"
              }
            }
          }
        },
        "children": [
          {
            "id": "tile_b_selected",
            "component": "Box",
            "style": {
              "position": "absolute",
              "inset": 0,
              "borderRadius": "$radius.md",
              "backgroundColor": "$color.accent"
            },
            "visible": {
              "@call": "eq",
              "args": {
                "a": {
                  "@path": "/selected"
                },
                "b": "b"
              }
            }
          },
          {
            "id": "tile_b_label",
            "component": "Text",
            "props": {
              "text": "Terminal"
            }
          }
        ]
      },
      {
        "id": "tile_c",
        "component": "Box",
        "style": {
          "position": "relative",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "center",
          "width": 96,
          "height": 64,
          "borderRadius": "$radius.md",
          "borderWidth": 1,
          "borderColor": "$color.border"
        },
        "on": {
          "hover": {
            "functionCall": {
              "@call": "set",
              "args": {
                "path": "/selected",
                "value": "c"
              }
            }
          }
        },
        "children": [
          {
            "id": "tile_c_selected",
            "component": "Box",
            "style": {
              "position": "absolute",
              "inset": 0,
              "borderRadius": "$radius.md",
              "backgroundColor": "$color.accent"
            },
            "visible": {
              "@call": "eq",
              "args": {
                "a": {
                  "@path": "/selected"
                },
                "b": "c"
              }
            }
          },
          {
            "id": "tile_c_label",
            "component": "Text",
            "props": {
              "text": "Browser"
            }
          }
        ]
      }
    ]
  }
}
