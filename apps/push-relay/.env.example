# Firebase service account key JSON (single-line string). Needed for FCM
# installs.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Operator secret shared with the web app (its PUSH_RELAY_SECRET): gates only
# /stats and /healthz?deep=1, which the admin performance page reads. Unset =
# those answer 404; the push API never needs it.
PUSH_RELAY_SECRET=

# The push API's store (EXP-1428; see README.md). One SQLite file: put it on
# a persistent volume. The Docker image sets /app/data/push-relay.sqlite. The
# relay refuses to start when it cannot open it.
# PUSH_RELAY_DB_PATH=./data/push-relay.sqlite
# APNs provider token auth (all three, or APNs installs are refused with 503).
# APNS_KEY_P8=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# Comma list of the bundle ids an APNs install may register for.
# APNS_TOPICS=
# The visible alert the iOS Notification Service Extension replaces.
# PUSH_PLACEHOLDER_TITLE=New message
# PUSH_PLACEHOLDER_BODY=

# Set to 'true' ONLY when a trusted reverse proxy that appends the real client
# address to X-Forwarded-For fronts the relay — it keys the failed-auth and
# registration rate limits by that address. Off by default: forwarded headers
# from unknown peers are client-forgeable and are ignored (the limits then key
# by the socket address).
# TRUST_PROXY=true

# Port to listen on (default: 4001)
# PORT=4001
