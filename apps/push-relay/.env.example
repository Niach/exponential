# Firebase service account key JSON (single-line string). Needed for v1 and
# for accountless FCM installs.
FIREBASE_SERVICE_ACCOUNT_JSON=

# v1 (/send): shared secret between the web app and this relay. Must equal
# PUSH_RELAY_SECRET on the web app. Unset = the v1 routes answer 404 (an open
# v1 would let anyone push operator-signed notifications to harvested device
# tokens); the relay then runs accountless-only, and refuses to start when
# the accountless store is unavailable too.
PUSH_RELAY_SECRET=

# Accountless mode (/v2, EXP-1428; see README.md). One SQLite file: put it on
# a persistent volume. The Docker image sets /app/data/push-relay.sqlite.
# PUSH_RELAY_DB_PATH=./data/push-relay.sqlite
# PUSH_RELAY_ACCOUNTLESS=false
# APNs provider token auth (all three, or APNs installs are refused with 503).
# APNS_KEY_P8=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# Comma list of the bundle ids an APNs install may register for.
# APNS_TOPICS=
# The visible alert the iOS Notification Service Extension replaces.
# PUSH_PLACEHOLDER_TITLE=New message
# PUSH_PLACEHOLDER_BODY=

# Set to 'true' ONLY when a trusted reverse proxy that appends the real client
# address to X-Forwarded-For fronts the relay — it keys the failed-auth and
# registration rate limits by that address. Off by default: forwarded headers
# from unknown peers are client-forgeable and are ignored (v1 then shares one
# bucket; v2 keys by the socket address).
# TRUST_PROXY=true

# Port to listen on (default: 4001)
# PORT=4001
