---
/* P2P's product page. The docs: /docs/sdk/p2p/. */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro"
import Diagram from "../../components/libraries/Diagram.astro"
import { NET_CHANNELS, NET_PATHS } from "../../components/libraries/trees.ts"
import PlatformShots from "../../components/PlatformShots.astro"
import "../../styles/libraries-other.css"
---

<StarlightPage
  frontmatter={{
    title: `P2P`,
    description: `Peer-to-peer, end-to-end encrypted tunnels between every Exponential client: desktop, phone, server and browser. Built on iroh.`,
    template: `splash`,
    hero: {
      tagline: `Encrypted tunnels between all your devices.`,
      actions: [
        { text: `Get started`, link: `/docs/sdk/p2p/guides/`, icon: `right-arrow` },
        { text: `Docs`, link: `/docs/sdk/p2p/`, variant: `minimal` },
      ],
    },
  }}
>
  <h2>Steer from your phone</h2>
  <PlatformShots view="steering" platforms={[`ios`, `android`]} />

  <h2>Direct where it can, relayed where it must</h2>
  <Diagram id="net-paths" tree={NET_PATHS} />

  <h2>Five channels</h2>
  <Diagram id="net-channels" tree={NET_CHANNELS} />

  <h2>End-to-end encrypted</h2>
  <PlatformShots view="sealed-locked" platforms={[`ios`, `android`]} />
</StarlightPage>
