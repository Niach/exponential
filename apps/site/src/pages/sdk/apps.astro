---
/* Apps' product page: one package, painted by genUI on every platform.
   Facts: docs/spec/apps.md (its mocks are public/eapps/*.webp, sources in
   apps/marketing/scripts/eapps-mocks/). What the spec marks 🆕/❌ (triggers,
   the agent executor) stays off this page until it ships. The docs:
   /docs/sdk/apps/. */
import { Code } from "@astrojs/starlight/components"
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro"
import Diagram from "../../components/libraries/Diagram.astro"
import Figure from "../../components/libraries/Figure.astro"
import { APPS_EXECUTORS, APPS_FLOW, APPS_PARTS } from "../../components/libraries/trees.ts"
import PlatformShots from "../../components/PlatformShots.astro"
import EuiSurface from "../../components/eui/EuiSurface.tsx"
import "../../styles/libraries-other.css"

/* Hours, trimmed to what reads at a glance. */
const PACKAGE = `{
  "formatVersion": 5,
  "id": "acme.hours",
  "name": "Hours",
  "records": {
    "entry": { "schema": { "date": "date", "hours": "number" } }
  },
  "templates": {
    "month": { "components": [ Chart, Table, … ],
      "bindings": [{ "path": "/entries", "source": "records:entry?mine=1" }] }
  },
  "functions": ["records.*"],
  "exposes": [{ "name": "log_hours", … }]
}`

/* How it works, as genUI's Stepper. */
const STEPS = {
  id: `steps`,
  component: `Stepper`,
  props: {
    orientation: `vertical`,
    current: 3,
    steps: [{ label: `Describe it` }, { label: `Preview it on every screen` }, { label: `Publish it to the team` }, { label: `Your agents use it too` }],
  },
}
---

<StarlightPage
  frontmatter={{
    title: `Apps`,
    description: `Ask an agent for an app. It writes one package of data, and genUI paints it on web, desktop, iOS and Android.`,
    template: `splash`,
    hero: {
      tagline: `Ask for an app. It runs on every screen.`,
      actions: [
        { text: `Read the docs`, link: `/docs/sdk/apps/`, icon: `right-arrow` },
        { text: `Build one`, link: `/docs/sdk/apps/build/`, variant: `minimal` },
      ],
    },
  }}
>
  <div class="lib-pair">
    <Figure src="/eapps/time-tracker.webp" alt="Hours on the web: a month of hours as a bar chart and a table" width={2360} height={1232} />
    <Figure src="/eapps/time-tracker-phone.webp" alt="Hours on a phone: one row per day and a Log hours button" width={780} height={824} />
  </div>

  <h2>One package of data</h2>
  <div class="lib-code"><Code code={PACKAGE} lang="js" title="hours.app.json" /></div>
  <Diagram id="apps-parts" tree={APPS_PARTS} />

  <h2>The same package on every platform</h2>
  <PlatformShots view="app" platforms={[`web`, `ios`, `android`]} />

  <h2>Run by the host and the server</h2>
  <Diagram id="apps-executors" tree={APPS_EXECUTORS} />

  <h2>Data in, tools out</h2>
  <Diagram id="apps-flow" tree={APPS_FLOW} />
  <Figure src="/eapps/admin-console.webp" alt="An admin console over Stripe, GitHub and Home Assistant, each member connected with their own account" width={2560} height={1080} />

  <h2>Your agents use it too</h2>
  <Figure src="/eapps/mcp-consent.webp" alt="Claude Code asks to use the team's apps: Off, Read only or Full per app, and the upstreams each needs" width={1240} height={1568} max="28rem" />

  <h2>How it works</h2>
  <div class="lib-steps not-content">
    <EuiSurface id="steps" tree={STEPS} />
    <Figure src="/shots/app-draft/web.webp" alt="A new app's editor: the chat with the agent beside the live preview" width={1800} height={1200} />
  </div>
</StarlightPage>
