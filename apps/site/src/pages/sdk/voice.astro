---
/* Voice's product page. The docs: /docs/sdk/voice/. */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro"
import Diagram from "../../components/libraries/Diagram.astro"
import Figure from "../../components/libraries/Figure.astro"
import { TALK_CALL, TALK_CAPSULES, TALK_NUMBERS } from "../../components/libraries/trees.ts"
import "../../styles/libraries-other.css"
---

<StarlightPage
  frontmatter={{
    title: `Voice`,
    description: `Speech in and out for your agents on your own computer, in English and German: push to talk, spoken replies in your voice, calls and a wake word. Open source.`,
    template: `splash`,
    hero: {
      tagline: `Talk to your agents.`,
      actions: [
        { text: `Install`, link: `/docs/sdk/voice/guides/install/`, icon: `right-arrow` },
        { text: `Docs`, link: `/docs/sdk/voice/`, variant: `minimal` },
      ],
    },
  }}
>
  <h2>Hold a key, speak</h2>
  <Diagram id="talk-capsules" tree={TALK_CAPSULES} />

  <h2>Call your agent</h2>
  <Diagram id="talk-call" tree={TALK_CALL} />

  <h2>Replies in your voice</h2>
  <Figure src="/shots/settings-assistant/web.webp" alt="Settings → Assistant → Voice on the web: voice device, agent, language, voice file and transcript" width={1800} height={1200} />

  <h2>On your own GPU</h2>
  <Diagram id="talk-numbers" tree={TALK_NUMBERS} />
</StarlightPage>
