---
/* genUI's product page: a headline and a visual per section. Product pages
   live in src/pages (StarlightPage = the docs' header, search and theme);
   the docs collection, and so llms.txt, stays reference-only. */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro"
import catalog from "@exponential_app/eui/catalog/core.catalog.json"
import manifest from "@exponential_app/eui/conformance/manifest.json"
import EuiSurface from "../../components/eui/EuiSurface.tsx"
import { DEPLOY_CARD, MOTION_GALLERY, SETTINGS_DATA, SETTINGS_FORM, THEME_CARD } from "../../components/eui/trees.ts"
import PlatformShots from "../../components/PlatformShots.astro"
import EuiCatalogue from "../../components/eui/EuiCatalogue.astro"

const components = Object.values(catalog.components).filter((c) => !(c as { hidden?: boolean }).hidden).length
const THEMES = [`neutral`, `exponential`, `playful`, `orange`]
const cases = manifest.suites.reduce((n, s) => n + s.cases, 0).toLocaleString(`en-US`)
---

<StarlightPage
  frontmatter={{
    title: `genUI`,
    description: `Agents send interfaces as data; React, Solid, web components, SwiftUI, Compose and gpui paint them natively.`,
    template: `splash`,
    hero: {
      tagline: `Agents send UI as data. Every platform paints it natively.`,
      actions: [
        { text: `Get started`, link: `/docs/sdk/genui/guides/`, icon: `right-arrow` },
        { text: `Components`, link: `/docs/sdk/genui/reference/components/`, variant: `minimal` },
        { text: `Playground`, link: `/docs/sdk/genui/tools/playground/`, variant: `minimal` },
      ],
    },
  }}
>
  <h2>Native on every platform</h2>
  <PlatformShots view="exponential-ui-demo" platforms={[`ios`, `android`]} eager />

  <h2>HTML at build time</h2>
  <div class="exp-live">
    <EuiSurface id="deploy" tree={DEPLOY_CARD} />
  </div>

  <h2>Live where it's touched</h2>
  <div class="exp-live">
    <EuiSurface client:visible id="settings" tree={SETTINGS_FORM} data={SETTINGS_DATA} />
  </div>

  <h2>One file per theme</h2>
  <div class="eui-themes">
    {
      THEMES.map((theme) => (
        <div class="exp-live">
          <EuiSurface id={`theme-${theme}`} tree={THEME_CARD} theme={theme} />
        </div>
      ))
    }
  </div>
  <p><a href="/docs/sdk/genui/tools/theme-builder/">Theme builder</a></p>

  <h2><a class="eui-h2-link" href="/sdk/motion/">Motion</a></h2>
  <div class="exp-live">
    <EuiSurface client:visible id="motion" tree={MOTION_GALLERY} />
  </div>

  <h2 id="components">{components} components</h2>
  <p><a href="/docs/sdk/genui/reference/components/">Every variant, prop and state</a></p>
  <EuiCatalogue />

  <h2>{cases} conformance cases</h2>
  <p><a href="/docs/sdk/genui/reference/conformance/">Every renderer, every change.</a></p>
</StarlightPage>
