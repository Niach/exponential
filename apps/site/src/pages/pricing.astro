---
/* Pricing: the plans (genUI, a billing switch), the comparison as a genUI
   Table, the questions as a genUI Accordion. */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro"
import EuiSurface from "../components/eui/EuiSurface.tsx"
import PricingPlans from "../components/landing/PricingPlans.tsx"
import { COMPARISON, EVERY_PLAN_INCLUDES } from "../components/landing/plans.ts"
import { PRICING_PRODUCT, seoHead } from "../components/landing/seo.ts"

const TABLE = {
  id: `compare`,
  component: `Table`,
  props: {
    columns: [
      { key: `label`, label: `` },
      { key: `exponential`, label: `Exponential` },
      { key: `linear`, label: `Linear` },
    ],
    rows: COMPARISON.map((row, i) => ({ id: `c${i}`, ...row })),
    rowKey: `id`,
  },
}

const FAQ = [
  { q: `Is there a free plan?`, a: `Yes: three seats with the full product, for as long as you like.` },
  { q: `What does Team cost?`, a: `€12 per seat a month billed yearly, €15 billed monthly. Everything is included.` },
  { q: `Do agents cost extra?`, a: `Agents run on your own machine with your own Claude or Codex subscription. We bill seats only.` },
  { q: `Can we self-host?`, a: `Yes, free for everyone, with one docker compose. The source is Apache-2.0.` },
  { q: `Do you offer SSO, an SLA or a DPA?`, a: `Yes, with Enterprise Support. Write to us from the contact page.` },
]
const ACCORDION = {
  id: `faq`,
  component: `Accordion`,
  props: { items: FAQ.map((f, i) => ({ title: f.q, value: `q${i}` })), value: { "@path": `/open` } },
  children: FAQ.map((f, i) => ({ id: `faq_a${i}`, component: `Text`, props: { text: f.a, variant: `muted` } })),
}
---

<StarlightPage
  frontmatter={{
    title: `Free for teams of three`,
    description: `Free for teams of three. One Team plan at €12/seat/mo billed yearly (€15 monthly) with everything included. Local AI agents free on every plan. Self-host free for everyone, open source under Apache-2.0.`,
    template: `splash`,
    head: seoHead({ title: `Pricing · Exponential`, ogImage: `/og/og-pricing.png`, jsonLd: [PRICING_PRODUCT] }),
    hero: { tagline: `One plan after that. Agents are free everywhere.` },
  }}
>
  <div class="exp-landing">
    <section class="exp-band exp-band-first not-content" id="plans">
      <PricingPlans client:visible />
      <p class="exp-fine">{EVERY_PLAN_INCLUDES}</p>
    </section>

    <section class="exp-band not-content" id="compare">
      <div class="exp-band-head">
        <h2>Exponential and Linear</h2>
      </div>
      <div class="exp-reveal"><EuiSurface id="compare" tree={TABLE} /></div>
    </section>

    <section class="exp-band exp-faq not-content" id="faq">
      <h2>Questions</h2>
      <EuiSurface client:visible id="faq" tree={ACCORDION} data={{ open: `q0` }} />
    </section>
  </div>
</StarlightPage>
