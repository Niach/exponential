---
/* Starlight's footer (pagination, edit link on docs pages), the closing
   band outside the docs, then the one site footer, on every page. */
import Default from "@astrojs/starlight/components/Footer.astro"
import CtaBand from "./landing/CtaBand.astro"
import SiteFooter from "./landing/SiteFooter.astro"

const docs = Astro.locals.starlightRoute.hasSidebar
---

<Default />
{!docs && <CtaBand />}
<SiteFooter />
