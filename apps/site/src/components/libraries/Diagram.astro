---
/* An eUI tree rendered at build time inside the site's live-surface frame. */
import type { NestedNode } from "@exponential_app/eui"
import Eui from "../eui/Eui.astro"
import { LIB_ICONS } from "./icons.ts"

interface Props {
  id: string
  tree: NestedNode
}
const { id, tree } = Astro.props
---

<div class="exp-live lib-diagram">
  <Eui id={id} tree={tree} icons={LIB_ICONS} />
</div>
