---
/* One picture on a product page: a shot from the store or a file under
   public/ (the Apps mocks), in genUI's Window like every framed visual. */
import Framed from "../landing/Framed.astro"

interface Props {
  src: string
  alt: string
  width: number
  height: number
  /** Narrow pictures (phones, dialogs) stay this wide at most. */
  max?: string
}
const { src, alt, width, height, max } = Astro.props
const id = src.replace(/\.\w+$/, ``).replace(/[^a-z0-9]+/gi, `-`).replace(/^-|-$/g, ``)
---

<div class="lib-figure not-content" style={max ? `max-width:${max}` : undefined}>
  <Framed id={id} src={src} alt={alt} width={width} height={height} />
</div>
