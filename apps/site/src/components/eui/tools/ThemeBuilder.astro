---
/* The theme builder (packages/exponential-ui/builder) for the docs page:
   its standalone page's body as prerendered markup with its scoped CSS
   (`.xb`, this page only); the script below loads the builder's module and
   wires it up (the
   preview is the real React renderer, rooted by the builder itself). The
   builder's own Light/Dark follows the site's theme switch. Nothing renders
   for /llms*.txt (route ends in .txt). */
import "../../../../../../packages/exponential-ui/builder/builder.css"

const llms = Astro.url.pathname.endsWith(`.txt`)
const importPlaceholder = `:root {\n  --background: oklch(1 0 0);\n  --primary: oklch(0.55 0.2 260);\n  --radius: 0.625rem;\n}\n.dark { … }`
---

{
  !llms && (
    <div class="xb eui-builder not-content" data-mode="dark" data-eui-builder>
      <header class="bar">
        <strong>Theme</strong>
        <label>
          Base <select id="base" />
        </label>
        <span class="seg">
          <button type="button" data-set-mode="light">Light</button>
          <button type="button" data-set-mode="dark">Dark</button>
        </span>
        <label>
          Width{` `}
          <select id="width">
            <option value="390">390 · phone</option>
            <option value="600">600</option>
            <option value="900" selected>900</option>
            <option value="1200">1200</option>
          </select>
        </label>
        <span class="grow" />
        <button type="button" id="do-import">Import CSS / JSON…</button>
        <button type="button" id="reset">Reset</button>
        <button type="button" id="do-export" class="primary">Export JSON</button>
      </header>
      <main class="layout">
        <aside id="panel" class="panel">
          <p class="eui-builder-loading">Loading the builder…</p>
        </aside>
        <section class="stage">
          <div id="issues" class="issues" hidden />
          <textarea id="export" class="mono export" rows={12} hidden readonly />
          <div id="preview" class="preview" />
        </section>
      </main>
      <dialog id="import" class="import">
        <h2>Import</h2>
        <p>
          Paste a shadcn <code>globals.css</code> (v4 oklch or v3 HSL triplets), a tweakcn export, or an eUI theme JSON. Colours, the radius ladder, fonts and shadows become overrides on the current base.
        </p>
        <textarea id="import-text" class="mono" rows={14} spellcheck="false" placeholder={importPlaceholder} />
        <pre id="import-report" class="mono" />
        <div class="actions">
          <button type="button" id="import-close">Close</button>
          <button type="button" id="import-apply" class="primary">Apply</button>
        </div>
      </dialog>
    </div>
  )
}

<script>
  const root = document.querySelector<HTMLElement>(`[data-eui-builder]`)
  if (root) {
    void import(`../../../../../../packages/exponential-ui/builder/mount`).then((m) => {
      m.mountBuilder(root, root)
      root.dataset.ready = `true`
      // The builder's Light/Dark follows the site's theme switch (a click on its own buttons still overrides until the next switch).
      const follow = () => {
        const mode = document.documentElement.dataset.theme === `light` ? `light` : `dark`
        root.querySelector<HTMLButtonElement>(`[data-set-mode="${mode}"]`)?.click()
      }
      follow()
      new MutationObserver(follow).observe(document.documentElement, { attributes: true, attributeFilter: [`data-theme`] })
    })
  }
</script>
