---
/* A desktop picture with a phone picture over its corner: the landing
   pages' one visual. Sources default to the shot store. */
interface Pic {
  src: string
  width: number
  height: number
  alt: string
}
interface Props {
  desktop: Pic
  phone?: Pic
  /** Above the fold: load eagerly. */
  eager?: boolean
}
const { desktop, phone, eager = false } = Astro.props
const loading = eager ? `eager` : `lazy`
---

<figure class:list={[`exp-duo`, { "has-phone": phone }]}>
  <img class="exp-duo-desktop" src={desktop.src} width={desktop.width} height={desktop.height} alt={desktop.alt} loading={loading} decoding="async" />
  {phone && <img class="exp-duo-phone" src={phone.src} width={phone.width} height={phone.height} alt={phone.alt} loading={loading} decoding="async" />}
</figure>
