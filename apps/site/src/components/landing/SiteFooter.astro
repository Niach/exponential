---
/* The site footer of every page: the logo and the social marks, one column
   per group of landing/nav.ts, then the legal bar. */
import { Icon } from "@astrojs/starlight/components"
import { FOOTER } from "./nav.ts"
import { LINKS } from "./links.ts"
---

<footer class="exp-site-footer not-content">
  <div class="exp-site-footer-top">
    <div class="exp-site-footer-brand">
      <a class="exp-site-footer-logo" href="/"><img src="/logo-light.svg" alt="" width="24" height="24" />Exponential</a>
      <a class="exp-site-footer-social" href={LINKS.github.repo} aria-label="GitHub"><Icon name="github" size="1.25rem" /></a>
    </div>
    <nav aria-label="Footer">
      {
        FOOTER.map((group) => (
          <div>
            <h2>{group.title}</h2>
            <ul>
              {group.items.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
  <div class="exp-site-footer-legal">
    <p>© 2026 Exponential · <a href={LINKS.github.license}>Apache-2.0</a></p>
    <p><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></p>
  </div>
</footer>
