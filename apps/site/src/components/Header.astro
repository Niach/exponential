---
/* The one header of the whole site: Starlight's own parts plus the site
   nav the landing pages had (docs, libraries, pricing, blog, download). */
import Default from "@astrojs/starlight/components/Header.astro"

const NAV = [
  { label: `Docs`, href: `/docs/` },
  { label: `eUI`, href: `/ui/` },
  { label: `Libraries`, href: `/docs/libraries/eui/` },
  { label: `Pricing`, href: `/pricing/` },
  { label: `Blog`, href: `/blog/` },
  { label: `Download`, href: `/download/` },
]
const path = Astro.url.pathname
---

<div class="exp-header">
  <Default />
  <nav class="exp-nav sl-hidden lg:sl-flex" aria-label="Site">
    {NAV.map((item) => <a href={item.href} aria-current={path.startsWith(item.href) ? `page` : undefined}>{item.label}</a>)}
  </nav>
</div>

<style>
  .exp-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
  }
  .exp-header > :global(.header) {
    flex: 1;
    min-width: 0;
  }
  .exp-nav {
    order: -1;
    display: none;
  }
  @media (min-width: 72rem) {
    .exp-nav {
      display: flex;
      order: 0;
      gap: 1.1rem;
      font-size: var(--sl-text-sm);
    }
  }
  .exp-nav a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .exp-nav a:hover,
  .exp-nav a[aria-current="page"] {
    color: var(--sl-color-white);
  }
</style>
