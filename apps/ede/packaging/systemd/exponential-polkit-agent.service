# The authentication prompt for admin actions (polkit): eDE's own sealed
# agent (#EDE-17, `exponential-sealed polkit`), registered with polkitd for the
# session; the password goes through polkit-agent-helper-1.
[Unit]
Description=Exponential Desktop polkit authentication agent (exponential-sealed)
PartOf=graphical-session.target exponential-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStart=/usr/bin/exponential-sealed polkit
Restart=on-failure
RestartSec=2
Slice=session.slice
