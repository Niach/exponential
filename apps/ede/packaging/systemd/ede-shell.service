# The shell (#EDE-10): the panel and its popups, drawn from the genUI
# documents in ~/.config/ede/ui (factory copies in /usr/share/ede/ui), run
# under the ede-ui supervisor (#EDE-9: every edit a commit, frame-ack
# watchdog, crash revert, factory fallback). ede-session.target starts it
# once the compositor is up; WAYLAND_DISPLAY and EDE_SAFE_MODE come from
# `ede-session --ready`, which imports the compositor's environment.
# The supervisor restarts a crashed shell itself; this unit covers the
# supervisor, and a supervisor that gave up (ten quick shell exits) comes
# back after a pause so a fixed document is picked up without a re-login.
[Unit]
Description=eDE shell (the genUI panel under the ede-ui supervisor)
Documentation=https://github.com/Niach/exponential/tree/master/apps/ede
PartOf=graphical-session.target ede-session.target
After=graphical-session.target ede-theme.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/ede-ui supervise -- /usr/bin/ede-shell
Restart=always
RestartSec=2
Slice=session.slice
Environment=RUST_LOG=info,wgpu_core=warn,wgpu_hal=warn
