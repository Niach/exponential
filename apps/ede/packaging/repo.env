# The package repositories (#EDE-34): the ONE place the host name lives.
# Read by the packaging scripts, the publish job (build-ede.yml) and the
# site's install docs (apps/site/src/lib/desktop-repo.ts). Moving the host:
# change PKG_HOST, bump PKG_REPO_VERSION, publish, and keep the old host
# serving (or redirecting) until the installs have updated: the
# exponential-repo package rewrites every install's source to the new host.
PKG_HOST=pkg.exponential.at
# Bumped whenever the host or the key changes: a new exponential-repo.
PKG_REPO_VERSION=1
# The signing key (repo/exponential.asc; the secret half is the PKG_SIGNING_KEY secret).
PKG_KEY_FPR=B7E65605732EF0364DB1F80C376730B0A8028ADC
# apt suites: noble = Ubuntu 24.04 and Linux Mint 22 (with the bundled
# Xwayland 24.1); resolute = Ubuntu 26.04 and trixie = Debian 13 (the distro's).
PKG_APT_SUITES="noble resolute trixie"
# How many versions of each package the repositories keep.
PKG_KEEP=3
