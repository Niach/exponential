# Exponential Desktop's factory notification centre (#EDE-12): the taskbar's bell opens it as a popup
# surface with every notification the shell has heard this session and (#EDE-65) every signed-in
# account's unread Exponential inbox entries (the IDE's grouping, all teams; `app` = the team), merged
# newest first (/notifications/list). A press on a row opens it (ede_notify_open: a desktop
# notification's default action when the app gave one, then it closes, #EDE-196; an inbox entry marks
# read and hands off to the Exponential app on its issue or session); its close removes a desktop
# notification and marks an inbox entry read (the inbox has no archive); Clear all does both for every
# row (ede_notify_clear).
surface("notification-center", extensions={ede: {popup: {parent: "taskbar", anchor: "bell", placement: "top-end", size: {width: 380, height: 480}}, functions: ["ede_notify_open", "ede_notify_close", "ede_notify_action", "ede_notify_clear"]}})
$/notifications/count = 0
$/notifications/list = []
$/notifications/toasts = []
root = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm", padding: "$spacing.sm", height: 480, backgroundColor: "$color.popover", borderWidth: 1, borderColor: "$color.border", borderRadius: "$radius.md"}, children=[center_head, center_scroll])
center_head = Stack(direction="horizontal", gap="sm", align="center", justify="between", children=[center_title, center_clear])
center_title = Heading(text="Notifications", level="h4")
center_clear = Button(label="Clear all", variant="ghost", size="sm", on={press: ede_notify_clear()}, visible=not(value=eq(a=$/notifications/count, b=0)))
center_scroll = ScrollArea(maxHeight=410, children=[center_list, entry, center_empty])
center_list = List(gap="none", divided=true, children=_template($/notifications/list, entry, key="id"))
entry = Row(title=$summary, subtitle=$body, meta=$at, density="compact", pressable=true, slots={leading: "entry_icon", trailing: "entry_close"}, on={press: ede_notify_open(id=$id)})
entry_icon = Image(src=$icon, alt=$app, fit="contain", width=24, height=24, fallback="nav-notifications")
entry_close = Button(label="Close", icon="ui-close", variant="ghost", size="icon", on={press: ede_notify_close(id=$id)})
center_empty = Text(text="No notifications", variant="muted", align="center", visible=eq(a=$/notifications/count, b=0))
