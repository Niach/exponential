# Exponential Desktop's factory start menu (#EDE-52, #EDE-258): Cinnamon's menu carrying the IDE's
# sidebar tree, opened from the taskbar's Exponential button bottom-left (or Super) as a popup surface
# above it, 860×620, with the keyboard. A narrow left sidebar holds the favourites (the taskbar's pins,
# /shell/startMenu/favourites, ede_launch) at the top and lock / log out / power at the bottom. The main
# column has the search box on top (/shell/startMenu/query) beside the person (/user), then two columns:
# the CATEGORIES (/shell/startMenu/nav/categories, uicore shell.json startMenuNav: the holder's tree roots
# Assistant, Home, Needs you, Chats, Drafts, Devices, each team, then Local (sidebar-tree.json edeLocal),
# then the app groups; a hairline before the teams and before the apps) and the CONTENTS
# (/shell/startMenu/nav/rows: the selected category's nested items, boards, folders, agents, apps,
# sessions, devices, or its apps; while the box has text the ranked results Places, Settings, Apps,
# Issues, each group headed). As in Cinnamon, hovering a category switches to it (ede_start_menu
# {category}), a press on a row opens it (ede_start_menu {open: <row id>}: a page opens as its own window
# through the holder's focus-or-open, an app launches, a Settings module opens, an issue opens in its
# window), and Enter in the box opens the selected row ({activate}). The keyboard (the shell's, #EDE-92):
# Up and Down move the selection in the focused column (in the categories they switch the category),
# Right and Left move between the columns while the box is empty, Escape closes the menu. The Assistant
# category shows the global Assistant's recent messages (/shell/startMenu/assistant, the holder's feed)
# and a composer into it ({ask: <text>}). No team switcher and no rail on eDE (#EDE-238): the tree is
# the navigation.
surface("start-menu", extensions={ede: {popup: {parent: "taskbar", anchor: "start", placement: "top-start", size: {width: 860, height: 620}}, functions: ["ede_launch", "ede_lock", "ede_logout", "ede_power", "ede_open_document", "ede_start_menu"]}})
$/shell/startMenu/assistant = null
$/shell/startMenu/ask = ""
$/shell/startMenu/favourites = []
$/shell/startMenu/nav = {category: "", categories: [], assistant: false, rows: []}
$/shell/startMenu/open = false
$/shell/startMenu/query = ""
$/user/host = ""
$/user/login = ""
$/user/name = ""
root = Box(style={display: "flex", flexDirection: "row", width: 860, height: 620, backgroundColor: "$color.popover", borderWidth: 1, borderColor: "$color.border", borderRadius: "$radius.xl", overflow: "hidden"}, children=[side, main])
side = Box(style={display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "space-between", width: 60, flexShrink: 0, paddingTop: "$spacing.md", paddingBottom: "$spacing.md", backgroundColor: "$color.background", borderRightWidth: 1, borderColor: "$color.border"}, children=[favourites, power_column])
favourites = List(gap="xs", children=_template($/shell/startMenu/favourites, favourite, key="id"))
favourite = Tooltip(content=$name, side="right", children=[favourite_button])
favourite_button = Box(style={display: "flex", alignItems: "center", justifyContent: "center", width: 40, height: 40, borderRadius: "$radius.md"}, pressable=true, children=[favourite_icon, favourite_glyph], on={press: ede_launch(app=$id)})
favourite_icon = Image(src=$icon, alt=$name, fit="contain", width=24, height=24, fallback="nav-apps", visible=cond(if=$icon, then=true, else=false))
favourite_glyph = Icon(name="nav-apps", size="default", visible=not(value=cond(if=$icon, then=true, else=false)))
power_column = Stack(direction="vertical", gap="xs", align="center", children=[lock, logout, power])
lock = Button(label="Lock screen", icon="ede-lock", variant="ghost", size="icon", on={press: ede_lock()})
logout = Button(label="Log out", icon="nav-sign-out", variant="ghost", size="icon", on={press: ede_logout()})
power = Menu(items=[{label: "Suspend", value: "suspend", icon: "ede-suspend"}, {label: "Restart", value: "reboot", icon: "ui-refresh"}, {label: "Shut down", value: "poweroff", icon: "ede-power", destructive: true}], side="right", align="end", children=[power_button], on={select: ede_power(action=$value)})
power_button = Button(label="Power", icon="ede-power", variant="ghost", size="icon")
main = Box(style={display: "flex", flexDirection: "column", flexGrow: 1, minWidth: 0}, children=[top, columns])
top = Box(style={display: "flex", flexDirection: "row", alignItems: "center", gap: "$spacing.md", padding: "$spacing.md"}, children=[search, top_fill, person])
search = Input(label="Search", name="query", type="search", variant="box", placeholder="Search", value=$/shell/startMenu/query, on={submit: ede_start_menu(activate=true)}, style={width: 300})
top_fill = Box(style={flexGrow: 1})
person = Row(title=$/user/name, subtitle=$/user/host, density="compact", slots={trailing: "person_avatar"})
person_avatar = Avatar(name=$/user/name, size="default", seed=$/user/login)
columns = Box(style={display: "flex", flexDirection: "row", flexGrow: 1, minHeight: 0, paddingLeft: "$spacing.sm", paddingRight: "$spacing.sm", paddingBottom: "$spacing.sm", gap: "$spacing.sm"}, children=[categories_scroll, contents])
categories_scroll = ScrollArea(direction="vertical", style={width: 250, flexShrink: 0}, children=[categories, category])
categories = List(gap="none", children=_template($/shell/startMenu/nav/categories, category, key="id"))
category = Box(style={display: "flex", flexDirection: "column"}, children=[category_separator, category_row], on={hover: ede_start_menu(category=$id)})
category_separator = Separator(style={marginTop: 4, marginBottom: 4}, visible=$separator)
category_row = Row(title=$title, selected=$selected, density="compact", pressable=true, slots={leading: "category_lead", trailing: "category_count"}, on={press: ede_start_menu(category=$id)})
category_lead = Box(style={display: "flex", alignItems: "center", justifyContent: "center", width: 20, height: 20}, children=[category_avatar, category_icon])
category_avatar = Avatar(name=$title, src=$image, size="sm", seed=$id, visible=eq(a=$kind, b="team"))
category_icon = Icon(name=$icon, size="default", visible=not(value=eq(a=$kind, b="team")))
category_count = Box(children=[category_attention, category_muted])
category_attention = CountBadge(count=$count, tone="attention", visible=eq(a=$tone, b="attention"))
category_muted = CountBadge(count=$count, tone="muted", visible=not(value=eq(a=$tone, b="attention")))
contents = Box(style={display: "flex", flexDirection: "column", flexGrow: 1, minWidth: 0, paddingLeft: "$spacing.sm", borderLeftWidth: 1, borderColor: "$color.border"}, children=[rows_scroll, assistant])
rows_scroll = ScrollArea(direction="vertical", style={flexGrow: 1, minHeight: 0}, children=[rows, row, no_rows], visible=not(value=$/shell/startMenu/nav/assistant))
rows = List(gap="none", children=_template($/shell/startMenu/nav/rows, row, key="id"))
row = Box(style={display: "flex", flexDirection: "column"}, children=[row_heading, row_item])
row_heading = Text(text=$heading, variant="caption", style={paddingLeft: "$spacing.sm", paddingTop: "$spacing.sm"}, visible=cond(if=$heading, then=true, else=false))
row_item = Row(title=$title, identifier=$identifier, subtitle=$subtitle, icon=$icon, depth=$depth, selected=$selected, density="default", pressable=true, slots={leading: "row_image", trailing: "row_count"}, on={press: ede_start_menu(open=$id)})
row_image = Image(src=$image, alt=$title, fit="contain", width=24, height=24, fallback="nav-apps", visible=cond(if=$image, then=true, else=false))
row_count = Box(children=[row_attention, row_muted])
row_attention = CountBadge(count=$count, tone="attention", visible=eq(a=$tone, b="attention"))
row_muted = CountBadge(count=$count, tone="muted", visible=not(value=eq(a=$tone, b="attention")))
no_rows = EmptyState(icon="ui-empty-search", title="No results", size="list", visible=eq(a=len(value=$/shell/startMenu/nav/rows), b=0))
assistant = Box(style={display: "flex", flexDirection: "column", flexGrow: 1, minHeight: 0}, children=[assistant_scroll, assistant_composer_box], visible=$/shell/startMenu/nav/assistant)
assistant_scroll = ScrollArea(direction="vertical", style={flexGrow: 1, minHeight: 0}, children=[assistant_messages, assistant_message, assistant_empty])
assistant_messages = List(gap="sm", children=_template($/shell/startMenu/assistant/messages, assistant_message, key="id"), style={paddingTop: "$spacing.xs", paddingRight: "$spacing.xs"})
assistant_message = Box(style={display: "flex", flexDirection: "column"}, children=[assistant_out, assistant_answer])
assistant_out = MessageBubble(text=$text, side="out", visible=$out)
assistant_answer = Markdown(text=$text, visible=$answer)
assistant_empty = EmptyState(icon="brand-exponential", title="Ask the Assistant", size="list", visible=cond(if=$/shell/startMenu/assistant/empty, then=true, else=false))
assistant_composer_box = Box(style={paddingTop: "$spacing.sm", paddingRight: "$spacing.xs"}, children=[assistant_composer])
assistant_composer = Composer(placeholder="Ask the Assistant…", value=$/shell/startMenu/ask, attachments=false, style={width: "100%"}, on={submit: ede_start_menu(ask=$/shell/startMenu/ask)})
