{
  "$comment": "Exponential Desktop's factory panel (#EDE-10, #EDE-12): a genUI document the shell draws as a top layer-shell surface. Installed to /usr/share/exponential-desktop/ui; a person's or agent's copy in ~/.config/exponential-desktop/ui/panel.json wins. The header says how the surface sits on the screen (#EDE-8) and which host functions it may call (ede.focus: the taskbar; ede.tray: a tray item); root is the nested authoring form of the core catalog; data holds what the shell feeds it (time, the task list, the tray items, the notification count). The first button opens menu.json as the panel's popup, the bell opens notification-center.json, a tray item with a menu opens tray-menu.json.",
  "surface": {
    "layer": "top",
    "anchor": [
      "top",
      "left",
      "right"
    ],
    "size": {
      "height": 40
    },
    "exclusiveZone": 40,
    "keyboard": "on-demand",
    "functions": [
      "ede.focus",
      "ede.tray"
    ]
  },
  "root": {
    "id": "panel",
    "component": "Box",
    "style": {
      "display": "flex",
      "flexDirection": "row",
      "alignItems": "center",
      "justifyContent": "space-between",
      "height": 40,
      "paddingLeft": "$spacing.sm",
      "paddingRight": "$spacing.md",
      "backgroundColor": "$color.popover",
      "borderBottomWidth": 1,
      "borderColor": "$color.border"
    },
    "children": [
      {
        "id": "left",
        "component": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          {
            "id": "menu",
            "component": "Button",
            "props": {
              "label": "Exponential",
              "variant": "ghost",
              "size": "sm",
              "icon": "brand-exponential"
            },
            "on": {
              "press": {
                "event": {
                  "name": "menu"
                }
              }
            }
          },
          {
            "id": "tasks",
            "component": "Stack",
            "props": {
              "direction": "horizontal",
              "gap": "xs",
              "align": "center"
            },
            "template": {
              "component": "task",
              "path": "/windows",
              "key": "id"
            },
            "children": []
          },
          {
            "id": "task",
            "component": "Button",
            "props": {
              "label": {
                "path": "title"
              },
              "variant": "ghost",
              "size": "sm"
            },
            "on": {
              "press": {
                "functionCall": {
                  "call": "ede.focus",
                  "args": {
                    "window": {
                      "path": "id"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      {
        "id": "right",
        "component": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "xs",
          "align": "center"
        },
        "children": [
          {
            "id": "tray",
            "component": "Stack",
            "props": {
              "direction": "horizontal",
              "gap": "xs",
              "align": "center"
            },
            "template": {
              "component": "tray-item",
              "path": "/tray",
              "key": "service"
            },
            "children": []
          },
          {
            "id": "tray-item",
            "component": "Box",
            "props": {
              "pressable": true
            },
            "style": {
              "display": "flex",
              "alignItems": "center",
              "justifyContent": "center",
              "width": 28,
              "height": 28,
              "borderRadius": "$radius.sm"
            },
            "on": {
              "press": {
                "functionCall": {
                  "call": "ede.tray",
                  "args": {
                    "service": {
                      "path": "service"
                    }
                  }
                }
              }
            },
            "children": [
              {
                "id": "tray-icon",
                "component": "Image",
                "props": {
                  "src": {
                    "path": "icon"
                  },
                  "alt": {
                    "path": "title"
                  },
                  "width": 18,
                  "height": 18,
                  "fit": "contain",
                  "fallback": "nav-apps"
                }
              }
            ]
          },
          {
            "id": "bell",
            "component": "Button",
            "props": {
              "icon": "nav-notifications",
              "variant": "ghost",
              "size": "icon",
              "label": "Notifications"
            },
            "on": {
              "press": {
                "event": {
                  "name": "bell"
                }
              }
            }
          },
          {
            "id": "bell-count",
            "component": "Badge",
            "props": {
              "text": {
                "path": "/notifications/count"
              },
              "variant": "secondary"
            },
            "visible": {
              "call": "not",
              "args": {
                "value": {
                  "call": "eq",
                  "args": {
                    "a": {
                      "path": "/notifications/count"
                    },
                    "b": 0
                  }
                }
              }
            }
          },
          {
            "id": "clock",
            "component": "Text",
            "props": {
              "text": {
                "path": "/time"
              },
              "variant": "body"
            }
          }
        ]
      }
    ]
  },
  "data": {
    "time": "00:00",
    "windows": [],
    "tray": [],
    "notifications": {
      "count": 0
    }
  }
}
