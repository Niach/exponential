{
  "$comment": "eDE's factory panel (#EDE-10, #EDE-12): a genUI document the shell draws as a top layer-shell surface. Installed to /usr/share/ede/ui; a person's or agent's copy in ~/.config/ede/ui/panel.json wins. The header says how the surface sits on the screen (#EDE-8) and which host functions it may call (ede.focus: the taskbar); root is the nested authoring form of the core catalog; data holds what the shell feeds it (time, the task list). The first button opens menu.json as the panel's popup.",
  "surface": {
    "layer": "top",
    "anchor": [
      "top",
      "left",
      "right"
    ],
    "size": {
      "height": 40
    },
    "exclusiveZone": 40,
    "keyboard": "on-demand",
    "functions": [
      "ede.focus"
    ]
  },
  "root": {
    "id": "panel",
    "component": "Box",
    "style": {
      "display": "flex",
      "flexDirection": "row",
      "alignItems": "center",
      "justifyContent": "space-between",
      "height": 40,
      "paddingLeft": "$spacing.sm",
      "paddingRight": "$spacing.md",
      "backgroundColor": "$color.card",
      "borderBottomWidth": 1,
      "borderColor": "$color.border"
    },
    "children": [
      {
        "id": "left",
        "component": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          {
            "id": "menu",
            "component": "Button",
            "props": {
              "label": "Exponential",
              "variant": "ghost",
              "size": "sm",
              "icon": "nav-apps"
            },
            "on": {
              "press": {
                "event": {
                  "name": "menu"
                }
              }
            }
          },
          {
            "id": "tasks",
            "component": "Stack",
            "props": {
              "direction": "horizontal",
              "gap": "xs",
              "align": "center"
            },
            "template": {
              "component": "task",
              "path": "/windows",
              "key": "id"
            },
            "children": []
          },
          {
            "id": "task",
            "component": "Button",
            "props": {
              "label": {
                "path": "title"
              },
              "variant": "ghost",
              "size": "sm"
            },
            "on": {
              "press": {
                "functionCall": {
                  "call": "ede.focus",
                  "args": {
                    "window": {
                      "path": "id"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      {
        "id": "clock",
        "component": "Text",
        "props": {
          "text": {
            "path": "/time"
          },
          "variant": "body"
        }
      }
    ]
  },
  "data": {
    "time": "00:00",
    "windows": []
  }
}
