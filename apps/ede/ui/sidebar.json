{
  "$comment": "Exponential Desktop's factory sidebar (#EDE-44): the IDE's left column as a top layer surface on the left edge, 272 px (the shell re-opens it at 56 px as the icon rail when /shell/rail is set: Sidebar's rail mode draws every Row as a tile with a tooltip). Top: the desktop/team switcher (#EDE-56: its sections, Local desktops first then one per connected account with its teams, from /shell/switcher/sections; New local desktop, Share as a team, Connect Exponential), the inbox, search and new buttons, the rail toggle. Nav: Needs you, Chats (they open the Exponential app). Sections: Pinned (the taskbar's pins), Workspaces (badges with the window counts), Active (sessions, when there are any). Bottom-left: the Exponential start button (the start menu, start-menu.json anchored here) and the chat button (chat.json). The host functions: ede.rail, ede.sidebar, ede.pin/unpin, ede.taskbar, ede.workspace, ede.start_menu, ede.chat, ede.launch, ede.switcher.",
  "surface": {
    "layer": "top",
    "anchor": [
      "top",
      "left",
      "bottom"
    ],
    "size": {
      "width": 272
    },
    "exclusiveZone": 272,
    "keyboard": "on-demand",
    "functions": [
      "ede.rail",
      "ede.sidebar",
      "ede.taskbar",
      "ede.workspace",
      "ede.start_menu",
      "ede.chat",
      "ede.launch",
      "ede.switcher",
      "ede.open_document"
    ]
  },
  "root": {
    "id": "sidebar-root",
    "component": "Box",
    "style": {
      "display": "flex",
      "flexDirection": "column",
      "height": "100%",
      "paddingTop": "$spacing.sm",
      "paddingBottom": "$spacing.sm",
      "paddingLeft": "$spacing.xs",
      "paddingRight": "$spacing.xs",
      "backgroundColor": "$color.background"
    },
    "children": [
      {
        "id": "sidebar",
        "component": "Sidebar",
        "props": {
          "width": 264,
          "rail": true,
          "collapsed": {
            "path": "/shell/rail"
          },
          "collapseBelow": "never"
        },
        "slots": {
          "sidebar": {
            "id": "column",
            "component": "Box",
            "style": {
              "display": "flex",
              "flexDirection": "column",
              "gap": "$spacing.xs",
              "flexGrow": 1,
              "minHeight": 0
            },
            "children": [
              {
                "id": "header",
                "component": "Stack",
                "props": {
                  "direction": "horizontal",
                  "gap": "xs",
                  "align": "center"
                },
                "visible": {
                  "call": "not",
                  "args": {
                    "value": {
                      "path": "/shell/rail"
                    }
                  }
                },
                "children": [
                  {
                    "id": "switcher",
                    "component": "Box",
                    "props": {
                      "pressable": true
                    },
                    "style": {
                      "display": "flex",
                      "flexDirection": "row",
                      "alignItems": "center",
                      "gap": "$spacing.sm",
                      "height": 40,
                      "paddingLeft": "$spacing.xs",
                      "paddingRight": "$spacing.xs",
                      "borderRadius": "$radius.md",
                      "flexGrow": 1,
                      "minWidth": 0
                    },
                    "children": [
                      {
                        "id": "switcher-avatar",
                        "component": "Avatar",
                        "props": {
                          "name": {
                            "path": "/shell/switcher/current/name"
                          },
                          "size": "default"
                        }
                      },
                      {
                        "id": "switcher-name",
                        "component": "Text",
                        "props": {
                          "text": {
                            "path": "/shell/switcher/current/name"
                          },
                          "variant": "label",
                          "lines": 1
                        }
                      },
                      {
                        "id": "switcher-chevron",
                        "component": "Icon",
                        "props": {
                          "name": "nav-team-switcher",
                          "size": "sm",
                          "tone": "neutral"
                        }
                      }
                    ]
                  },
                  {
                    "id": "inbox",
                    "component": "Button",
                    "props": {
                      "icon": "nav-inbox",
                      "variant": "ghost",
                      "size": "icon",
                      "label": "Inbox"
                    },
                    "on": {
                      "press": {
                        "functionCall": {
                          "call": "ede.launch",
                          "args": {
                            "app": "at.exponential"
                          }
                        }
                      }
                    }
                  },
                  {
                    "id": "search",
                    "component": "Button",
                    "props": {
                      "icon": "nav-search",
                      "variant": "ghost",
                      "size": "icon",
                      "label": "Search"
                    },
                    "on": {
                      "press": {
                        "functionCall": {
                          "call": "ede.start_menu",
                          "args": {
                            "toggle": true
                          }
                        }
                      }
                    }
                  },
                  {
                    "id": "new",
                    "component": "Button",
                    "props": {
                      "icon": "nav-create-issue",
                      "variant": "default",
                      "size": "icon",
                      "label": "New issue"
                    },
                    "on": {
                      "press": {
                        "functionCall": {
                          "call": "ede.launch",
                          "args": {
                            "app": "at.exponential"
                          }
                        }
                      }
                    }
                  },
                  {
                    "id": "rail-collapse",
                    "component": "Button",
                    "props": {
                      "icon": "nav-rail-collapse",
                      "variant": "ghost",
                      "size": "icon",
                      "label": "Collapse the sidebar"
                    },
                    "on": {
                      "press": {
                        "functionCall": {
                          "call": "ede.rail"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "id": "switcher-menu",
                "component": "Popover",
                "props": {
                  "anchor": "switcher",
                  "side": "bottom",
                  "align": "start"
                },
                "children": [
                  {
                    "id": "switcher-list",
                    "component": "Box",
                    "style": {
                      "display": "flex",
                      "flexDirection": "column",
                      "gap": "$spacing.xxs",
                      "width": 240,
                      "padding": "$spacing.xs"
                    },
                    "children": [
                      {
                        "id": "switcher-sections",
                        "component": "List",
                        "props": {
                          "gap": "xs"
                        },
                        "template": {
                          "component": "switcher-section",
                          "path": "/shell/switcher/sections",
                          "key": "id"
                        },
                        "children": []
                      },
                      {
                        "id": "switcher-section",
                        "component": "Box",
                        "style": {
                          "display": "flex",
                          "flexDirection": "column",
                          "gap": "$spacing.xxs"
                        },
                        "children": [
                          {
                            "id": "switcher-section-label",
                            "component": "Text",
                            "props": {
                              "text": {
                                "path": "label"
                              },
                              "variant": "caption",
                              "lines": 1
                            }
                          },
                          {
                            "id": "switcher-entries",
                            "component": "List",
                            "props": {
                              "gap": "none"
                            },
                            "template": {
                              "component": "switcher-entry",
                              "path": "entries",
                              "key": "id"
                            },
                            "children": []
                          },
                          {
                            "id": "switcher-entry",
                            "component": "Row",
                            "props": {
                              "title": {
                                "path": "name"
                              },
                              "density": "compact",
                              "pressable": true,
                              "selected": {
                                "path": "current"
                              }
                            },
                            "slots": {
                              "leading": {
                                "id": "switcher-entry-avatar",
                                "component": "Avatar",
                                "props": {
                                  "name": {
                                    "path": "name"
                                  },
                                  "size": "sm"
                                }
                              }
                            },
                            "on": {
                              "press": {
                                "functionCall": {
                                  "call": "ede.switcher",
                                  "args": {
                                    "action": "pick",
                                    "kind": {
                                      "path": "kind"
                                    },
                                    "id": {
                                      "path": "id"
                                    },
                                    "account": {
                                      "path": "account"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        ]
                      },
                      {
                        "id": "switcher-sep",
                        "component": "Separator"
                      },
                      {
                        "id": "switcher-new",
                        "component": "Row",
                        "props": {
                          "title": "New local desktop",
                          "icon": "ui-add",
                          "density": "compact",
                          "pressable": true
                        },
                        "on": {
                          "press": {
                            "functionCall": {
                              "call": "ede.switcher",
                              "args": {
                                "action": "new"
                              }
                            }
                          }
                        }
                      },
                      {
                        "id": "switcher-share",
                        "component": "Row",
                        "props": {
                          "title": "Share as a team…",
                          "icon": "ui-share",
                          "density": "compact",
                          "pressable": true
                        },
                        "on": {
                          "press": {
                            "functionCall": {
                              "call": "ede.switcher",
                              "args": {
                                "action": "share"
                              }
                            }
                          }
                        }
                      },
                      {
                        "id": "switcher-connect",
                        "component": "Row",
                        "props": {
                          "title": "Connect Exponential",
                          "icon": "brand-exponential",
                          "density": "compact",
                          "pressable": true
                        },
                        "on": {
                          "press": {
                            "functionCall": {
                              "call": "ede.switcher",
                              "args": {
                                "action": "connect"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "header-rail",
                "component": "Stack",
                "props": {
