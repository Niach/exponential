                          }
                        }
                      }
                    }
                  },
                  {
                    "id": "nav-chats",
                    "component": "Row",
                    "props": {
                      "title": "Chats",
                      "icon": "nav-threads",
                      "density": "compact",
                      "pressable": true
                    },
                    "on": {
                      "press": {
                        "functionCall": {
                          "call": "ede.launch",
                          "args": {
                            "app": "at.exponential"
                          }
                        }
                      }
                    }
                  }
                ]
              },
              {
                "id": "scroll",
                "component": "ScrollArea",
                "style": {
                  "flexGrow": 1,
                  "minHeight": 0
                },
                "children": [
                  {
                    "id": "sections",
                    "component": "Box",
                    "style": {
                      "display": "flex",
                      "flexDirection": "column",
                      "gap": "$spacing.sm"
                    },
                    "children": [
                      {
                        "id": "pinned",
                        "component": "Box",
                        "style": {
                          "display": "flex",
                          "flexDirection": "column",
                          "gap": "$spacing.xxs"
                        },
                        "children": [
                          {
                            "id": "pinned-head",
                            "component": "Box",
                            "props": {
                              "pressable": true
                            },
                            "style": {
                              "display": "flex",
                              "flexDirection": "row",
                              "alignItems": "center",
                              "gap": "$spacing.xs",
                              "height": 24,
                              "paddingLeft": "$spacing.xs",
                              "paddingRight": "$spacing.xs",
                              "borderRadius": "$radius.md"
                            },
                            "on": {
                              "press": {
                                "event": {
                                  "name": "sidebar"
                                }
                              }
                            },
                            "children": [
                              {
                                "id": "pinned-open",
                                "component": "Icon",
                                "props": {
                                  "name": "ui-chevron-down",
                                  "size": "sm",
                                  "tone": "neutral"
                                },
                                "visible": {
                                  "path": "/shell/sidebar/pinnedOpen"
                                }
                              },
                              {
                                "id": "pinned-closed",
                                "component": "Icon",
                                "props": {
                                  "name": "ui-chevron-right",
                                  "size": "sm",
                                  "tone": "neutral"
                                },
                                "visible": {
                                  "call": "not",
                                  "args": {
                                    "value": {
                                      "path": "/shell/sidebar/pinnedOpen"
                                    }
                                  }
                                }
                              },
                              {
                                "id": "pinned-title",
                                "component": "Text",
                                "props": {
                                  "text": "Pinned",
                                  "variant": "caption"
                                }
                              }
                            ],
                            "visible": {
                              "call": "not",
                              "args": {
                                "value": {
                                  "path": "/shell/rail"
                                }
                              }
                            }
                          },
                          {
                            "id": "pinned-list",
                            "component": "List",
                            "props": {
                              "gap": "none"
                            },
                            "template": {
                              "component": "pinned-row",
                              "path": "/shell/sidebar/pinned",
                              "key": "app"
                            },
                            "children": [
                              {
                                "id": "pinned-row",
                                "component": "Row",
                                "props": {
                                  "title": {
                                    "path": "name"
                                  },
                                  "density": "compact",
                                  "pressable": true,
                                  "selected": {
                                    "path": "focused"
                                  }
                                },
                                "slots": {
                                  "leading": {
                                    "id": "pinned-icon",
                                    "component": "Image",
                                    "props": {
                                      "src": {
                                        "path": "icon"
                                      },
                                      "alt": {
                                        "path": "name"
                                      },
                                      "width": 16,
                                      "height": 16,
                                      "fit": "contain",
                                      "fallback": "nav-apps"
                                    }
                                  }
                                },
                                "on": {
                                  "press": {
                                    "functionCall": {
                                      "call": "ede.taskbar",
                                      "args": {
                                        "app": {
                                          "path": "app"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            ],
                            "visible": {
                              "call": "or",
                              "args": {
                                "values": [
                                  {
                                    "path": "/shell/rail"
                                  },
                                  {
                                    "call": "and",
                                    "args": {
                                      "values": [
                                        {
                                          "path": "/shell/sidebar/pinnedOpen"
                                        },
                                        {
                                          "call": "not",
                                          "args": {
                                            "value": {
                                              "call": "eq",
                                              "args": {
                                                "a": {
                                                  "call": "len",
                                                  "args": {
                                                    "value": {
                                                      "path": "/shell/sidebar/pinned"
                                                    }
                                                  }
                                                },
                                                "b": 0
                                              }
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        ],
                        "visible": {
                          "call": "not",
                          "args": {
                            "value": {
                              "call": "eq",
                              "args": {
                                "a": {
                                  "call": "len",
                                  "args": {
                                    "value": {
                                      "path": "/shell/sidebar/pinned"
                                    }
                                  }
                                },
                                "b": 0
                              }
                            }
                          }
                        }
                      },
