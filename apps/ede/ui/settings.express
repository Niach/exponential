# Exponential Desktop's factory settings (#EDE-47, the merged Settings window of the IDE look):
# #EDE-65: Settings open INTO the sidebar like the IDE's: one on-demand top layer over the rail and
# the ground, above the taskbar (the menu's Settings rows open it with ede_open_document, the close
# button closes it): the settings nav takes the sidebar's place, wider while open (shell-layout.json
# settingsWidth 272, the IDE's settings column, on the same black), and the page sits on the ground's
# rounded panel (panelMargin 10, panelRadius 12, the ground's fill), no tile overview. The nav: This
# device (Display, Sound, Network, Bluetooth, Power, Themes, Keyboard, Mouse & Touchpad, Date & Time,
# Users, Notifications, Workspaces, Windows, Startup apps, Default apps, then the folded Coding group:
# Tools, Coding CLIs, Worktrees, Sessions, the IDE's This device group), Personal (Account, Devices,
# Security, What's new, About) and Team, headed by the shell's switcher (/shell/switcher/current; its
# sections as a Popover: Local desktops, then one per connected account with its teams, #EDE-56): a
# Local desktop shows General, Agents, Apps; a team entry shows the IDE's groups from
# settings-nav.json (Team, Boards, Agents, Apps), which eDE has none of yet (#EDE-54). Picking an
# entry here sets /settings/team only: the shell's desktop stays. Pages bind what the shell feeds:
# /services/<domain> (#EDE-13), /outputs, /config, /user, /shell, /date, /notifications, and /pages
# (#EDE-47: the layouts, Date & Time, Startup apps, Default apps, Workspaces, Windows, Mouse &
# Touchpad). Controls are two-way bound and call a host function with the new value: ede_service
# {domain, action, args}, ede_output {name, mode?, scale?}, ede_config {theme}, ede_settings {page,
# key, value} (compositor.toml's [keyboard] and [windows], the XDG autostart overrides, xdg-mime
# default, timedatectl). A setting the machine cannot apply yet is a read-only value row (Mouse &
# Touchpad, the workspace count, the 24-hour clock), never a dead control; the Exponential rows
# (Notifications' email/push, Coding, Devices, Security, a team's pages) are honest empty states until
# the Exponential app runs on this desktop. #EDE-57: a Local desktop's General page shares it as a
# team: Share as a team… asks for the team name and, with several accounts, the account (ede_share
# {action: start|run|cancel, name?, account?}; the host feeds /sharing {state
# idle|needsAccount|picking|running|done|failed, accounts, summary, progress, label, teamName,
# error}), uploads through the team import API and the desktop becomes that team (archived here for 30
# days).
surface("settings", extensions={ede: {layer: "top", anchor: ["top", "left", "right", "bottom"], exclusiveZone: -1, margin: {bottom: 48}, keyboard: "on-demand", onDemand: true, functions: ["set", "ede_service", "ede_output", "ede_config", "ede_settings", "ede_launch", "ede_switcher", "ede_workspace", "ede_notify_clear", "ede_close_document", "ede_share"]}})
$/config/diagnostics/send = true
$/config/keyboard/layout = "us"
$/config/keyboard/repeat_delay = 400
$/config/keyboard/repeat_rate = 30
$/config/theme/bridge = true
$/config/theme/summary = ""
$/date = ""
$/notifications/count = 0
$/outputs = []
$/pages/datetime/clock = "24-hour"
$/pages/datetime/ntp = false
$/pages/datetime/timeZone = ""
$/pages/datetime/zones = []
$/pages/defaults/roles = []
$/pages/keyboard/layouts = []
$/pages/mouse/naturalText = "Off"
$/pages/mouse/scrollText = "Two fingers"
$/pages/mouse/speedText = "Default"
$/pages/mouse/tapText = "Off"
$/pages/startup/entries = []
$/pages/windows/altTab = "Most recent first"
$/pages/windows/corner_px = 120
$/pages/windows/edge_tiling = true
$/pages/windows/edge_tiling_px = 4
$/pages/windows/panel_margin = 10
$/pages/windows/snap_threshold = 12
$/pages/windows/titleBar = "Maximize"
$/pages/workspaces/listedText = "4"
$/pages/workspaces/maxText = "9"
$/pages/workspaces/wrapText = "On"
$/services = {}
$/settings/codingOpen = false
$/settings/deviceOpen = true
$/settings/page = "display"
$/settings/personalOpen = true
$/settings/switcherOpen = false
$/settings/team/id = ""
$/settings/team/kind = ""
$/settings/team/name = ""
$/share/account = ""
$/share/name = ""
$/sharing/accounts = []
$/sharing/error = ""
$/sharing/label = ""
$/sharing/progress = 0
$/sharing/state = "idle"
$/sharing/summary = ""
$/sharing/teamName = ""
$/shell/sidebar/workspaces = []
$/shell/switcher/current/id = "local"
$/shell/switcher/current/kind = "local"
$/shell/switcher/current/name = "Local"
$/shell/switcher/entries = [{kind: "local", id: "local", name: "Local", current: true}]
$/user/login = ""
$/user/name = ""
root = Box(style={display: "flex", flexDirection: "column", width: 1280, height: 672, backgroundColor: "$color.background"}, children=[shell])
shell = Sidebar(width=272, collapseBelow="never", children=[page_frame], slots={sidebar: "nav"}, style={flexGrow: 1, minHeight: 0})
page_frame = Box(style={display: "flex", flexDirection: "column", flexGrow: 1, minHeight: 0, minWidth: 0, paddingTop: 10, paddingRight: 10, paddingBottom: 10, paddingLeft: 10}, children=[page_panel])
page_panel = Box(style={display: "flex", flexDirection: "column", flexGrow: 1, minHeight: 0, borderRadius: "$radius.lg", borderWidth: 1, borderColor: "$color.border", backgroundColor: "$color.muted"}, children=[page_scroll])
page_scroll = ScrollArea(style={flexGrow: 1, minHeight: 0}, children=[page_column])
page_column = Box(style={display: "flex", flexDirection: "column", paddingTop: "$spacing.sm", paddingRight: "$spacing.md", paddingBottom: "$spacing.md", paddingLeft: "$spacing.xs"}, children=[page_display, page_sound, page_network, page_bluetooth, page_power, page_themes, page_keyboard, page_mouse, page_datetime, page_users, page_notifications, page_workspaces, page_windows, page_startup, page_defaults, page_tools, page_coding_clis, page_worktrees, page_sessions, page_devices, page_security, page_local_agents, page_local_apps, page_account, page_whats_new, page_about, page_local_general, page_team_general, page_team_members, page_team_issues, page_team_labels, page_team_statuses, page_team_repositories, page_team_prompts, page_team_widget, page_team_storage, page_team_archived_boards, page_team_agents, page_team_mcp, page_team_skills, page_team_apps])
page_display = Stack(direction="vertical", gap="md", children=[page_display_title, outputs, output, no_outputs], visible=eq(a=$/settings/page, b="display"))
page_display_title = Heading(text="Display", level="h3")
outputs = Stack(direction="vertical", gap="md", children=_template($/outputs, output, key="name"))
output = Section(title=$name, caption=$summary, children=[mode, scale])
mode = Select(label="Resolution", name="mode", options=$modeOptions, value=$current, on={change: ede_output(mode=$current, name=$name)})
scale = ChoiceTiles(name="scale", options=[{label: "100%", value: "1"}, {label: "125%", value: "1.25"}, {label: "150%", value: "1.5"}, {label: "200%", value: "2"}], value=$scaleText, columns=4, on={change: ede_output(name=$name, scale=$scaleText)})
no_outputs = Text(text="No display", variant="muted", visible=eq(a=len(value=$/outputs), b=0))
page_sound = Stack(direction="vertical", gap="md", children=[page_sound_title, sound_off, volume, mute, mic, sinks_section, sources_section, streams_section], visible=eq(a=$/settings/page, b="sound"))
page_sound_title = Heading(text="Sound", level="h3")
sound_off = Alert(title="Sound is not available", message=$/services/sound/reason, type="warning", visible=not(value=cond(if=$/services/sound/available, then=true, else=false)))
volume = Slider(label="Output volume", min=0, max=100, step=1, value=$/services/sound/volume, icon="media-volume-up", showValue=true, on={change: ede_service(action="set_volume", args={percent: $/services/sound/volume}, domain="sound")})
mute = Switch(label="Mute output", name="mute", checked=$/services/sound/muted, on={change: ede_service(action="mute", args={on: $/services/sound/muted}, domain="sound")})
mic = Slider(label="Input volume", min=0, max=100, step=1, value=$/services/sound/micVolume, icon="call-unmute", showValue=true, on={change: ede_service(action="set_mic_volume", args={percent: $/services/sound/micVolume}, domain="sound")})
sinks_section = Section(title="Output devices", children=[sinks, sink])
sinks = List(gap="none", divided=true, children=_template($/services/sound/sinks, sink, key="id"))
sink = Row(title=$name, meta=$volume, selected=$default, density="compact", pressable=true, on={press: ede_service(action="set_default", args={id: $id}, domain="sound")})
sources_section = Section(title="Input devices", children=[sources, source, no_sources])
sources = List(gap="none", divided=true, children=_template($/services/sound/sources, source, key="id"))
source = Row(title=$name, meta=$volume, selected=$default, density="compact", pressable=true, on={press: ede_service(action="set_default_source", args={id: $id}, domain="sound")})
no_sources = Text(text="No input device", variant="muted", visible=eq(a=len(value=$/services/sound/sources), b=0))
streams_section = Section(title="Applications", children=[streams, stream, no_streams])
streams = List(gap="none", divided=true, children=_template($/services/sound/streams, stream, key="id"))
stream = Row(title=$app, subtitle=$name, meta=$volume, density="compact")
no_streams = Text(text="Nothing is playing", variant="muted", visible=eq(a=len(value=$/services/sound/streams), b=0))
page_network = Stack(direction="vertical", gap="md", children=[page_network_title, network_off, wifi, wired_section, aps_section, vpn_section], visible=eq(a=$/settings/page, b="network"))
page_network_title = Heading(text="Network", level="h3")
network_off = Alert(title="Network is not available", message=$/services/network/reason, type="warning", visible=not(value=cond(if=$/services/network/available, then=true, else=false)))
wifi = Switch(label="Wi-Fi", name="wifi", checked=$/services/network/wifiEnabled, on={change: ede_service(action="wifi_enable", args={on: $/services/network/wifiEnabled}, domain="network")})
wired_section = Section(title="Wired", children=[wired, wired_device, no_wired])
wired = List(gap="none", divided=true, children=_template($/services/network/wired, wired_device, key="path"))
wired_device = Row(title=$interface, subtitle=$connection, meta=$state, icon="ede-wired", density="compact")
no_wired = Text(text="No wired connection", variant="muted", visible=eq(a=len(value=$/services/network/wired), b=0))
aps_section = Section(title="Wi-Fi networks", children=[aps, ap, no_aps])
aps = List(gap="none", divided=true, children=_template($/services/network/accessPoints, ap, key="ssid"))
ap = Row(title=$ssid, meta=$strength, selected=$active, density="compact", pressable=true, on={press: ede_service(action="connect", args={ssid: $ssid}, domain="network")})
no_aps = Text(text="No Wi-Fi network in reach", variant="muted", visible=eq(a=len(value=$/services/network/accessPoints), b=0))
vpn_section = Section(title="VPN", children=[vpns, vpn, no_vpn])
vpns = List(gap="none", divided=true, children=_template($/services/network/vpn, vpn, key="id"))
vpn = Row(title=$name, meta=$type, selected=$active, density="compact", pressable=true, on={press: ede_service(action="vpn_connect", args={id: $id}, domain="network")})
no_vpn = Text(text="No VPN", variant="muted", visible=eq(a=len(value=$/services/network/vpn), b=0))
page_bluetooth = Stack(direction="vertical", gap="md", children=[page_bluetooth_title, bluetooth_off, bt_power, bt_section, bt_discover], visible=eq(a=$/settings/page, b="bluetooth"))
page_bluetooth_title = Heading(text="Bluetooth", level="h3")
bluetooth_off = Alert(title="Bluetooth is not available", message=$/services/bluetooth/reason, type="warning", visible=not(value=cond(if=$/services/bluetooth/available, then=true, else=false)))
bt_power = Switch(label="Bluetooth", name="bluetooth", checked=$/services/bluetooth/powered, on={change: ede_service(action="power", args={on: $/services/bluetooth/powered}, domain="bluetooth")})
bt_section = Section(title="Devices", loading=$/services/bluetooth/discovering, children=[bt_devices, bt_device, no_bt])
bt_devices = List(gap="none", divided=true, children=_template($/services/bluetooth/devices, bt_device, key="path"))
bt_device = Row(title=$name, subtitle=$address, selected=$connected, density="compact", pressable=true, on={press: ede_service(action="connect", args={device: $path}, domain="bluetooth")})
no_bt = Text(text="No paired device", variant="muted", visible=eq(a=len(value=$/services/bluetooth/devices), b=0))
bt_discover = Button(label="Discover", icon="nav-search", variant="outline", on={press: ede_service(action="discover", domain="bluetooth")})
page_power = Stack(direction="vertical", gap="md", children=[page_power_title, power_off, battery, profile, power_actions], visible=eq(a=$/settings/page, b="power"))
page_power_title = Heading(text="Power", level="h3")
power_off = Alert(title="Power is not available", message=$/services/power/reason, type="warning", visible=not(value=cond(if=$/services/power/available, then=true, else=false)))
battery = Row(title="Battery", value=$/services/power/batteryText, icon="ede-battery")
profile = ChoiceTiles(name="profile", options=[{label: "Power saver", value: "power-saver"}, {label: "Balanced", value: "balanced"}, {label: "Performance", value: "performance"}], value=$/services/power/profile, columns=3, on={change: ede_service(action="set_profile", args={profile: $/services/power/profile}, domain="power")})
power_actions = Stack(direction="horizontal", gap="sm", children=[suspend, reboot, poweroff])
suspend = Button(label="Suspend", icon="ede-suspend", variant="outline", on={press: ede_service(action="suspend", domain="power")})
reboot = Button(label="Restart", icon="ui-refresh", variant="outline", on={press: ede_service(action="reboot", domain="power")})
poweroff = Button(label="Shut down", icon="ede-power", variant="outline", on={press: ede_service(action="poweroff", domain="power")})
page_themes = Stack(direction="vertical", gap="md", children=[page_themes_title, theme_bridge, theme_summary, theme_open], visible=eq(a=$/settings/page, b="themes"))
page_themes_title = Heading(text="Themes", level="h3")
theme_bridge = Switch(label="Theme GTK and Qt apps to match", name="bridge", checked=$/config/theme/bridge, on={change: ede_config(theme={bridge: $/config/theme/bridge})})
theme_summary = Row(title="Resolved", value=$/config/theme/summary, density="compact")
theme_open = Button(label="Open the shell's documents", icon="ui-folder", variant="outline", on={press: ede_launch(command="xdg-open ~/.config/exponential-desktop/ui")})
page_keyboard = Stack(direction="vertical", gap="md", children=[page_keyboard_title, layout, repeat, delay], visible=eq(a=$/settings/page, b="keyboard"))
page_keyboard_title = Heading(text="Keyboard", level="h3")
layout = Select(label="Layout", name="layout", options=$/pages/keyboard/layouts, value=$/config/keyboard/layout, searchable=true, on={change: ede_settings(key="layout", page="keyboard", value=$/config/keyboard/layout)})
repeat = Slider(label="Repeat rate", min=10, max=60, step=5, value=$/config/keyboard/repeat_rate, endLabel="per second", on={change: ede_settings(key="repeat_rate", page="keyboard", value=$/config/keyboard/repeat_rate)})
delay = Slider(label="Repeat delay", min=150, max=1000, step=50, value=$/config/keyboard/repeat_delay, endLabel="ms", on={change: ede_settings(key="repeat_delay", page="keyboard", value=$/config/keyboard/repeat_delay)})
page_mouse = Stack(direction="vertical", gap="sm", children=[page_mouse_title, mouse_speed, mouse_natural, mouse_scroll, mouse_tap], visible=eq(a=$/settings/page, b="mouse"))
page_mouse_title = Heading(text="Mouse & Touchpad", level="h3")
mouse_speed = Row(title="Pointer speed", value=$/pages/mouse/speedText, density="compact")
mouse_natural = Row(title="Natural scrolling", value=$/pages/mouse/naturalText, density="compact")
mouse_scroll = Row(title="Scrolling", value=$/pages/mouse/scrollText, density="compact")
mouse_tap = Row(title="Tap to click", value=$/pages/mouse/tapText, density="compact")
page_datetime = Stack(direction="vertical", gap="md", children=[page_datetime_title, ntp, timezone, clock_format, calendar], visible=eq(a=$/settings/page, b="datetime"))
page_datetime_title = Heading(text="Date & Time", level="h3")
ntp = Switch(label="Set the time automatically", name="ntp", checked=$/pages/datetime/ntp, on={change: ede_settings(key="ntp", page="datetime", value=$/pages/datetime/ntp)})
timezone = Select(label="Time zone", name="timeZone", options=$/pages/datetime/zones, value=$/pages/datetime/timeZone, searchable=true, on={change: ede_settings(key="timeZone", page="datetime", value=$/pages/datetime/timeZone)})
clock_format = Row(title="Clock", value=$/pages/datetime/clock, density="compact")
calendar = DatePicker(name="calendar", value=$/date, inline=true)
page_users = Stack(direction="vertical", gap="md", children=[page_users_title, me, users_tool], visible=eq(a=$/settings/page, b="users"))
page_users_title = Heading(text="Users", level="h3")
me = Row(title=$/user/name, subtitle=$/user/login, icon="settings-account")
users_tool = Button(label="Manage users", icon="settings-members", variant="outline", on={press: ede_launch(command="cinnamon-settings user || gnome-control-center user-accounts")})
page_notifications = Stack(direction="vertical", gap="md", children=[page_notifications_title, notifications_desktop, notifications_exponential], visible=eq(a=$/settings/page, b="notifications"))
page_notifications_title = Heading(text="Notifications", level="h3")
notifications_desktop = Section(title="This desktop", children=[toasts, toasts_count, toasts_clear])
toasts = Row(title="Toasts", value="Top right", density="compact")
toasts_count = Row(title="In the centre", value=$/notifications/count, density="compact")
toasts_clear = Button(label="Clear all", icon="ui-clear", variant="outline", on={press: ede_notify_clear()})
notifications_exponential = Section(title="Exponential", caption="Not connected", children=[pref_assigned, pref_comments, pref_mentions, pref_status, pref_pr_opened, pref_pr_merged, pref_reporter, pref_blocked, pref_signed_out, notifications_connect])
pref_assigned = SettingsRow(label="Assigned to you", stackBelow="never", children=[pref_assigned_channels])
pref_assigned_channels = Stack(direction="horizontal", gap="md", align="center", justify="end", children=[pref_assigned_email, pref_assigned_push])
pref_assigned_email = Switch(label="Email", name="assigned-email", checked=false, disabled=true, size="compact")
pref_assigned_push = Switch(label="Push", name="assigned-push", checked=false, disabled=true, size="compact")
pref_comments = SettingsRow(label="Comments", stackBelow="never", children=[pref_comments_channels])
pref_comments_channels = Stack(direction="horizontal", gap="md", align="center", justify="end", children=[pref_comments_email, pref_comments_push])
pref_comments_email = Switch(label="Email", name="comments-email", checked=false, disabled=true, size="compact")
pref_comments_push = Switch(label="Push", name="comments-push", checked=false, disabled=true, size="compact")
pref_mentions = SettingsRow(label="Mentions", stackBelow="never", children=[pref_mentions_channels])
pref_mentions_channels = Stack(direction="horizontal", gap="md", align="center", justify="end", children=[pref_mentions_email, pref_mentions_push])
pref_mentions_email = Switch(label="Email", name="mentions-email", checked=false, disabled=true, size="compact")
pref_mentions_push = Switch(label="Push", name="mentions-push", checked=false, disabled=true, size="compact")
pref_status = SettingsRow(label="Status changes", stackBelow="never", children=[pref_status_channels])
pref_status_channels = Stack(direction="horizontal", gap="md", align="center", justify="end", children=[pref_status_email, pref_status_push])
pref_status_email = Switch(label="Email", name="status-email", checked=false, disabled=true, size="compact")
pref_status_push = Switch(label="Push", name="status-push", checked=false, disabled=true, size="compact")
pref_pr_opened = SettingsRow(label="Pull request opened", stackBelow="never", children=[pref_pr_opened_channels])
pref_pr_opened_channels = Stack(direction="horizontal", gap="md", align="center", justify="end", children=[pref_pr_opened_email, pref_pr_opened_push])
pref_pr_opened_email = Switch(label="Email", name="pr-opened-email", checked=false, disabled=true, size="compact")
pref_pr_opened_push = Switch(label="Push", name="pr-opened-push", checked=false, disabled=true, size="compact")
pref_pr_merged = SettingsRow(label="Pull request merged", stackBelow="never", children=[pref_pr_merged_channels])
pref_pr_merged_channels = Stack(direction="horizontal", gap="md", align="center", justify="end", children=[pref_pr_merged_email, pref_pr_merged_push])
pref_pr_merged_email = Switch(label="Email", name="pr-merged-email", checked=false, disabled=true, size="compact")
pref_pr_merged_push = Switch(label="Push", name="pr-merged-push", checked=false, disabled=true, size="compact")
pref_reporter = SettingsRow(label="Reporter replies", stackBelow="never", children=[pref_reporter_channels])
pref_reporter_channels = Stack(direction="horizontal", gap="md", align="center", justify="end", children=[pref_reporter_email, pref_reporter_push])
pref_reporter_email = Switch(label="Email", name="reporter-email", checked=false, disabled=true, size="compact")
pref_reporter_push = Switch(label="Push", name="reporter-push", checked=false, disabled=true, size="compact")
pref_blocked = SettingsRow(label="Blocked sessions", stackBelow="never", children=[pref_blocked_channels])
pref_blocked_channels = Stack(direction="horizontal", gap="md", align="center", justify="end", children=[pref_blocked_email, pref_blocked_push])
pref_blocked_email = Switch(label="Email", name="blocked-email", checked=false, disabled=true, size="compact")
pref_blocked_push = Switch(label="Push", name="blocked-push", checked=false, disabled=true, size="compact")
pref_signed_out = SettingsRow(label="Signed-out agents", stackBelow="never", children=[pref_signed_out_channels])
pref_signed_out_channels = Stack(direction="horizontal", gap="md", align="center", justify="end", children=[pref_signed_out_email, pref_signed_out_push])
pref_signed_out_email = Switch(label="Email", name="signed-out-email", checked=false, disabled=true, size="compact")
pref_signed_out_push = Switch(label="Push", name="signed-out-push", checked=false, disabled=true, size="compact")
notifications_connect = Button(label="Connect Exponential", icon="brand-exponential", variant="outline", on={press: ede_switcher(action="connect")})
page_workspaces = Stack(direction="vertical", gap="md", children=[page_workspaces_title, workspaces_list, workspaces_shown, workspaces_max, workspaces_wrap], visible=eq(a=$/settings/page, b="workspaces"))
page_workspaces_title = Heading(text="Workspaces", level="h3")
workspaces_list = Section(title="Open", children=[workspace_rows, workspace_row])
workspace_rows = List(gap="none", divided=true, children=_template($/shell/workspaces/rows, workspace_row, key="index"))
workspace_row = Row(title=$label, meta=$countText, icon="ede-workspaces", selected=$active, density="compact", pressable=true, on={press: ede_workspace(index=$index)})
workspaces_shown = Row(title="Always shown", value=$/pages/workspaces/listedText, density="compact")
workspaces_max = Row(title="At most", value=$/pages/workspaces/maxText, density="compact")
workspaces_wrap = Row(title="Wrap around", value=$/pages/workspaces/wrapText, density="compact")
page_windows = Stack(direction="vertical", gap="md", children=[page_windows_title, edge_tiling, snap, panel_margin, titlebar, alt_tab], visible=eq(a=$/settings/page, b="windows"))
page_windows_title = Heading(text="Windows", level="h3")
edge_tiling = Switch(label="Tile at the screen edges", name="edge_tiling", checked=$/pages/windows/edge_tiling, on={change: ede_settings(key="edge_tiling", page="windows", value=$/pages/windows/edge_tiling)})
snap = Slider(label="Snap to edges within", min=0, max=32, step=2, value=$/pages/windows/snap_threshold, endLabel="px", on={change: ede_settings(key="snap_threshold", page="windows", value=$/pages/windows/snap_threshold)})
panel_margin = Slider(label="Panel margin", min=0, max=24, step=2, value=$/pages/windows/panel_margin, endLabel="px", on={change: ede_settings(key="panel_margin", page="windows", value=$/pages/windows/panel_margin)})
titlebar = Row(title="Title bar double-click", value=$/pages/windows/titleBar, density="compact")
alt_tab = Row(title="Alt-Tab", value=$/pages/windows/altTab, density="compact")
page_startup = Stack(direction="vertical", gap="md", children=[page_startup_title, startup_list, startup_entry, no_startup], visible=eq(a=$/settings/page, b="startup"))
page_startup_title = Heading(text="Startup apps", level="h3")
startup_list = List(gap="none", divided=true, children=_template($/pages/startup/entries, startup_entry, key="id"))
startup_entry = Switch(label=$name, name="enabled", checked=$enabled, on={change: ede_settings(key=$id, page="startup", value=$enabled)})
no_startup = Text(text="No startup app", variant="muted", visible=eq(a=len(value=$/pages/startup/entries), b=0))
page_defaults = Stack(direction="vertical", gap="md", children=[page_defaults_title, defaults_list, default_role], visible=eq(a=$/settings/page, b="defaults"))
page_defaults_title = Heading(text="Default apps", level="h3")
defaults_list = Stack(direction="vertical", gap="md", children=_template($/pages/defaults/roles, default_role, key="id"))
default_role = SettingsRow(label=$label, stackBelow="never", children=[default_app])
default_app = Select(name="app", options=$options, placeholder="Not set", value=$value, on={change: ede_settings(key=$id, page="defaults", value=$value)})
page_tools = Stack(direction="vertical", gap="md", children=[page_tools_title, tools_empty], visible=eq(a=$/settings/page, b="tools"))
page_tools_title = Heading(text="Tools", level="h3")
tools_empty = EmptyState(icon="settings-tools", title="No tools on this desktop", description="The Exponential app keeps the repos root, the branch prefix and the terminal shell.", actionLabel="Connect Exponential", on={press: ede_switcher(action="connect")})
page_coding_clis = Stack(direction="vertical", gap="md", children=[page_coding_clis_title, coding_clis_empty], visible=eq(a=$/settings/page, b="coding-clis"))
page_coding_clis_title = Heading(text="Coding CLIs", level="h3")
coding_clis_empty = EmptyState(icon="settings-agents", title="No coding CLI on this desktop", description="The Exponential app signs the coding CLIs in.", actionLabel="Connect Exponential", on={press: ede_switcher(action="connect")})
page_worktrees = Stack(direction="vertical", gap="md", children=[page_worktrees_title, worktrees_empty], visible=eq(a=$/settings/page, b="worktrees"))
page_worktrees_title = Heading(text="Worktrees", level="h3")
worktrees_empty = EmptyState(icon="settings-local-repos", title="No worktrees on this desktop", description="The Exponential app clones repositories and keeps their worktrees.", actionLabel="Connect Exponential", on={press: ede_switcher(action="connect")})
page_sessions = Stack(direction="vertical", gap="md", children=[page_sessions_title, sessions_empty], visible=eq(a=$/settings/page, b="sessions"))
page_sessions_title = Heading(text="Sessions", level="h3")
sessions_empty = EmptyState(icon="settings-sessions", title="No sessions on this desktop", description="Coding sessions run in the Exponential app.", actionLabel="Connect Exponential", on={press: ede_switcher(action="connect")})
page_devices = Stack(direction="vertical", gap="md", children=[page_devices_title, devices_empty], visible=eq(a=$/settings/page, b="devices"))
page_devices_title = Heading(text="Devices", level="h3")
devices_empty = EmptyState(icon="nav-devices", title="No devices", description="Devices show once an account is connected.", actionLabel="Connect Exponential", on={press: ede_switcher(action="connect")})
page_security = Stack(direction="vertical", gap="md", children=[page_security_title, security_empty], visible=eq(a=$/settings/page, b="security"))
page_security_title = Heading(text="Security", level="h3")
security_empty = EmptyState(icon="settings-api", title="No API keys", description="API keys and sign-in methods come with an account.", actionLabel="Connect Exponential", on={press: ede_switcher(action="connect")})
page_local_agents = Stack(direction="vertical", gap="md", children=[page_local_agents_title, local_agents_empty], visible=eq(a=$/settings/page, b="local-agents"))
page_local_agents_title = Heading(text="Agents", level="h3")
local_agents_empty = EmptyState(icon="settings-agents", title="No agents on a local desktop", description="Agents come with a team. Share this desktop as a team to add one.", actionLabel="Connect Exponential", on={press: ede_switcher(action="connect")})
page_local_apps = Stack(direction="vertical", gap="md", children=[page_local_apps_title, local_apps_empty], visible=eq(a=$/settings/page, b="local-apps"))
page_local_apps_title = Heading(text="Apps", level="h3")
local_apps_empty = EmptyState(icon="nav-apps", title="No apps on a local desktop", description="Apps come with a team. Share this desktop as a team to add one.", actionLabel="Connect Exponential", on={press: ede_switcher(action="connect")})
page_account = Stack(direction="vertical", gap="md", children=[page_account_title, account_me, account_exponential, account_list, account_row, account_connect], visible=eq(a=$/settings/page, b="account"))
page_account_title = Heading(text="Account", level="h3")
account_me = Row(title=$/user/name, subtitle=$/user/login, icon="settings-account")
account_exponential = Row(title="Exponential", value="Not signed in", icon="brand-exponential", density="compact", visible=eq(a=len(value=$/accounts), b=0))
account_list = List(gap="none", children=_template($/accounts, account_row, key="id"), visible=not(value=eq(a=len(value=$/accounts), b=0)))
account_row = Row(title=$email, subtitle=$instance, icon="brand-exponential", density="compact")
account_connect = Button(label="Connect Exponential", icon="brand-exponential", variant="outline", on={press: ede_switcher(action="connect")})
page_whats_new = Stack(direction="vertical", gap="md", children=[page_whats_new_title, whats_new_version, whats_new_open], visible=eq(a=$/settings/page, b="whats-new"))
page_whats_new_title = Heading(text="What's new", level="h3")
whats_new_version = Row(title="Exponential Desktop", value=$/services/about/ede, icon="brand-exponential", density="compact")
whats_new_open = Button(label="Open the changelog", icon="nav-changelog", variant="outline", on={press: ede_switcher(action="connect")})
page_about = Stack(direction="vertical", gap="sm", children=[page_about_title, about_host, about_kernel, about_cpu, about_memory, about_ede, about_diagnostics, checks_section, updates_section, printers_section], visible=eq(a=$/settings/page, b="about"))
page_about_title = Heading(text="About", level="h3")
about_host = Row(title=$/services/about/hostname, subtitle=$/services/about/os, icon="settings-about")
about_kernel = Row(title="Kernel", value=$/services/about/kernel, density="compact")
about_cpu = Row(title="Processor", value=$/services/about/cpu, density="compact")
about_memory = Row(title="Memory", value=$/services/about/memoryText, density="compact")
about_ede = Row(title="Exponential Desktop", value=$/services/about/ede, density="compact")
about_diagnostics = Switch(label="Send diagnostics", name="send", checked=$/config/diagnostics/send, on={change: ede_config(diagnostics={send: $/config/diagnostics/send})})
checks_section = Section(title="System check", children=[checks, check, checks_run])
checks = List(gap="none", divided=true, children=_template($/services/about/checks, check, key="name"))
check = Row(title=$name, subtitle=$detail, meta=$status, density="compact")
checks_run = Button(label="Check again", icon="ui-refresh", variant="outline", on={press: ede_service(action="check", domain="about")})
updates_section = Section(title="Updates", children=[updates_count, updates_actions])
updates_count = Row(title="Available", value=$/services/updates/countText, density="compact")
updates_actions = Stack(direction="horizontal", gap="sm", children=[refresh, upgrade, software])
refresh = Button(label="Check again", icon="ui-refresh", variant="outline", on={press: ede_service(action="refresh", domain="updates")})
upgrade = Button(label="Install all", icon="settings-import", on={press: ede_service(action="upgrade", domain="updates")})
software = Button(label="Software", icon="nav-apps", variant="ghost", on={press: ede_launch(command="mintinstall || gnome-software")})
printers_section = Section(title="Printers", children=[printer_list, printer, no_printers, printers_tool])
printer_list = List(gap="none", divided=true, children=_template($/services/printers/printers, printer, key="name"))
printer = Row(title=$name, meta=$state, selected=$default, density="compact")
no_printers = Text(text="No printer", variant="muted", visible=eq(a=len(value=$/services/printers/printers), b=0))
printers_tool = Button(label="Add a printer", icon="ui-add", variant="outline", on={press: ede_launch(command="system-config-printer")})
page_local_general = Stack(direction="vertical", gap="md", children=[page_local_general_title, local_identity, local_kind, local_share, share_needs_account, share_pick, share_running, share_done, share_failed], visible=eq(a=$/settings/page, b="local-general"))
page_local_general_title = Heading(text="General", level="h3")
local_identity = Box(style={display: "flex", flexDirection: "row", alignItems: "center", gap: "$spacing.md"}, children=[local_avatar_current, local_avatar_picked, local_name_current, local_name_picked])
local_avatar_current = Avatar(name=$/shell/switcher/current/name, size="lg", visible=eq(a=$/settings/team/kind, b=""))
local_avatar_picked = Avatar(name=$/settings/team/name, size="lg", visible=not(value=eq(a=$/settings/team/kind, b="")))
local_name_current = Text(text=$/shell/switcher/current/name, variant="title", visible=eq(a=$/settings/team/kind, b=""))
local_name_picked = Text(text=$/settings/team/name, variant="title", visible=not(value=eq(a=$/settings/team/kind, b="")))
local_kind = Row(title="Kind", value="Local desktop", density="compact")
local_share = Button(label="Share as a team…", icon="ui-share", variant="outline", on={press: ede_share(action="start")}, visible=eq(a=$/sharing/state, b="idle"))
share_needs_account = Stack(direction="vertical", gap="sm", children=[share_needs_account_text, share_connect, share_needs_account_cancel], visible=eq(a=$/sharing/state, b="needsAccount"))
share_needs_account_text = Text(text="Sharing makes this desktop a team of your Exponential account. Connect one first.", variant="muted")
share_connect = Button(label="Connect Exponential", icon="brand-exponential", variant="outline", on={press: ede_switcher(action="connect")})
share_needs_account_cancel = Button(label="Cancel", variant="ghost", on={press: ede_share(action="cancel")})
share_pick = Stack(direction="vertical", gap="md", children=[share_name, share_account, share_summary, share_actions], visible=eq(a=$/sharing/state, b="picking"))
share_name = Input(label="Team name", name="name", type="text", placeholder="The desktop's name", value=$/share/name)
share_account = Select(label="Account", name="account", options=$/sharing/accounts, value=$/share/account, visible=not(value=eq(a=len(value=$/sharing/accounts), b=1)))
share_summary = Text(text=$/sharing/summary, variant="muted")
share_actions = Stack(direction="horizontal", gap="sm", align="center", children=[share_run, share_cancel])
share_run = Button(label="Share", icon="ui-share", variant="default", on={press: ede_share(account=$/share/account, action="run", name=$/share/name)})
share_cancel = Button(label="Cancel", variant="ghost", on={press: ede_share(action="cancel")})
share_running = Stack(direction="vertical", gap="sm", children=[share_progress, share_progress_label], visible=eq(a=$/sharing/state, b="running"))
share_progress = Progress(value=$/sharing/progress, max=100, label="Sharing")
share_progress_label = Text(text=$/sharing/label, variant="muted")
share_done = Stack(direction="vertical", gap="sm", children=[share_done_text, share_done_team, share_done_hint, share_done_close], visible=eq(a=$/sharing/state, b="done"))
share_done_text = Text(text="Now the team", variant="muted")
share_done_team = Text(text=$/sharing/teamName, variant="title", lines=1)
share_done_hint = Text(text="Its issues, comments, sessions and files are in the team now; the desktop's file stays here for 30 days.", variant="body")
share_done_close = Button(label="Done", variant="default", on={press: ede_share(action="cancel")})
share_failed = Stack(direction="vertical", gap="sm", children=[share_error, share_retry], visible=eq(a=$/sharing/state, b="failed"))
share_error = Alert(title="Could not share the desktop", message=$/sharing/error, type="error")
share_retry = Button(label="Try again", variant="outline", on={press: ede_share(action="start")})
page_team_general = Stack(direction="vertical", gap="md", children=[page_team_general_title, team_general_empty], visible=eq(a=$/settings/page, b="team-general"))
