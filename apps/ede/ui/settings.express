# Exponential Desktop's System Settings (#EDE-273, #EDE-241 P6.1): Mint's cinnamon-settings. ONE
# normal window of the shell (a `window` surface: eDE's frame, its own taskbar entry under the start
# menu's System Settings, a single instance: asked again it comes to the front). The grid: Cinnamon's
# categories (Appearance, Preferences, Hardware, then Exponential and Administration) as icon tiles,
# the search in the header filters them live by name and keywords, Enter opens the first; a module
# opens in the same window with the back button (Alt+Left too) and its page is a centred column of
# framed groups. What the window shows is uicore's system-settings.json (the catalogue, the grid, the
# navigation); the shell feeds /settings {module, query, title, inModule, kind, command, empty, grid}
# and takes ede_settings_nav {action: open|back|query|submit|link}. `~/settings/<module>` (the start
# menu's search, an applet's link, the panel menu) opens a module directly. A later module is listed
# and its page says so; a Mint tool's module (Administration, Printers) launches the tool, and says
# it is not installed when it is missing. Pages bind what the shell feeds: /services/<domain>
# (#EDE-13), /outputs, /config, /user, /shell, /notifications, /accounts, /installs, /sharing and
# /pages (#EDE-47). Controls are two-way bound and call a host function with the new value:
# ede_service {domain, action, args}, ede_output {name, mode?, scale?} or {action: keep|revert}
# (#EDE-250), ede_config {theme, display, diagnostics}, ede_settings {page, key, value}. A setting
# the machine cannot apply yet is a read-only value row, never a dead control.
surface("settings", extensions={ede: {window: {title: "System Settings", appId: "at.exponential.settings", size: {width: 1040, height: 700}}, functions: ["set", "ede_account", "ede_service", "ede_output", "ede_config", "ede_settings", "ede_settings_nav", "ede_launch", "ede_switcher", "ede_workspace", "ede_notify_clear", "ede_share"]}})
$/accounts = []
$/account/signingOut = false
$/config/diagnostics/send = true
$/config/display/fractional_scaling = false
$/config/display/xwayland_native_scaling = true
$/config/keyboard/layout = "us"
$/config/keyboard/repeat_delay = 400
$/config/keyboard/repeat_rate = 30
$/config/theme = {bridge: true, summary: "", gtk: "", icons: "", cursor: "", font: "", monospace: "", font_size: 10, fontSizeText: "10", options: {gtk: [], icons: [], cursor: [], font: [], monospace: [], fontSize: []}}
$/display/confirm = {open: false, name: "", seconds: 0, caption: ""}
$/installs/code = ""
$/installs/waiting = false
$/notifications/count = 0
$/outputs = []
$/pages/datetime/clock = "24-hour"
$/pages/datetime/ntp = false
$/pages/datetime/timeZone = ""
$/pages/datetime/zones = []
$/pages/defaults/roles = []
$/pages/keyboard/layouts = []
$/pages/mouse/naturalText = "Off"
$/pages/mouse/scrollText = "Two fingers"
$/pages/mouse/speedText = "Default"
$/pages/mouse/tapText = "Off"
$/pages/startup/entries = []
$/pages/windows/altTab = "Most recent first"
$/pages/windows/edge_tiling = true
$/pages/windows/panel_margin = 10
$/pages/windows/snap_threshold = 12
$/pages/windows/titleBar = "Maximize"
$/pages/workspaces/listedText = "4"
$/pages/workspaces/maxText = "9"
$/pages/workspaces/wrapText = "On"
$/pages/hotcorners = {corners: [], fullscreen: false}
$/pages/screensaver = {lockAfter: "600", options: [], onSuspend: true, locker: ""}
$/pages/users/list = []
$/services = {}
$/settings = {module: "", query: "", tab: "", title: "System Settings", inModule: false, kind: "", command: "", empty: false, grid: {appearance: {modules: []}, preferences: {modules: []}, hardware: {modules: []}, exponential: {modules: []}, administration: {modules: []}}}
$/share/account = ""
$/share/name = ""
$/sharing = {state: "idle", accounts: [], summary: "", progress: 0, label: "", teamName: "", error: ""}
$/shell/switcher/current = {kind: "local", id: "local", name: "Local"}
$/shell/workspaces/rows = []
$/signOut/open = false
$/user/login = ""
$/user/name = ""
root = Box(style={display: "flex", flexDirection: "column", width: "100%", height: "100%", backgroundColor: "$color.background"}, children=[header, body])
header = Box(style={display: "flex", flexDirection: "row", alignItems: "center", gap: "$spacing.sm", height: 48, flexShrink: 0, paddingLeft: "$spacing.sm", paddingRight: "$spacing.sm", backgroundColor: "$color.background", borderBottomWidth: 1, borderColor: "$color.border"}, children=[back, header_title, header_fill, tabs_sound, tabs_windows, tabs_keyboard, search, header_fill_end, header_balance])
tabs_sound = Segmented(items=[{label: "Output", value: "output"}, {label: "Input", value: "input"}, {label: "Applications", value: "applications"}], value=$/settings/tab, size="sm", visible=eq(a=$/settings/module, b="sound"), on={change: ede_settings_nav(action="tab", tab=$/settings/tab)})
tabs_windows = Segmented(items=[{label: "Titlebar", value: "titlebar"}, {label: "Behavior", value: "behavior"}, {label: "Alt-Tab", value: "alt-tab"}], value=$/settings/tab, size="sm", visible=eq(a=$/settings/module, b="windows"), on={change: ede_settings_nav(action="tab", tab=$/settings/tab)})
tabs_keyboard = Segmented(items=[{label: "Typing", value: "typing"}, {label: "Layouts", value: "layouts"}], value=$/settings/tab, size="sm", visible=eq(a=$/settings/module, b="keyboard"), on={change: ede_settings_nav(action="tab", tab=$/settings/tab)})
back = Button(label="All settings", icon="ui-back", variant="ghost", size="icon", visible=$/settings/inModule, on={press: ede_settings_nav(action="back")})
header_title = Text(text=$/settings/title, variant="label", style={width: 220}, visible=$/settings/inModule)
header_fill = Box(style={flexGrow: 1})
search = Input(label="Search", name="query", type="search", variant="box", placeholder="Search", value=$/settings/query, size="sm", style={width: 320}, visible=not(value=$/settings/inModule), on={change: ede_settings_nav(action="query", query=$/settings/query), submit: ede_settings_nav(action="submit")})
header_fill_end = Box(style={flexGrow: 1})
header_balance = Box(style={width: 220}, visible=$/settings/inModule)
body = ScrollArea(direction="vertical", style={flexGrow: 1, minHeight: 0, backgroundColor: "$color.card"}, children=[grid, no_results, modules])
grid = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.xl", padding: "$spacing.xl"}, children=[cat_appearance, cat_preferences, cat_hardware, cat_exponential, cat_administration], visible=not(value=$/settings/inModule))
cat_appearance = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm"}, children=[cat_appearance_h, cat_appearance_g], visible=not(value=eq(a=len(value=$/settings/grid/appearance/modules), b=0)))
cat_appearance_h = Box(style={paddingBottom: "$spacing.xs", borderBottomWidth: 1, borderColor: "$color.border"}, children=[cat_appearance_t])
cat_appearance_t = Text(text="Appearance", variant="title")
cat_appearance_g = Box(style={display: "flex", flexDirection: "row", flexWrap: "wrap", gap: "$spacing.xs"}, children=_template($/settings/grid/appearance/modules, tile_appearance, key="id"))
tile_appearance = Box(style={display: "flex", flexDirection: "column", alignItems: "center", gap: "$spacing.xs", width: 104, paddingTop: "$spacing.sm", paddingBottom: "$spacing.sm", borderRadius: "$radius.lg", cursor: "pointer", ":hover": {backgroundColor: "$color.accent"}}, pressable=true, children=[tile_appearance_i, tile_appearance_n, tile_appearance_l], on={press: ede_settings_nav(action="open", module=$id)})
tile_appearance_i = Box(style={display: "flex", alignItems: "center", justifyContent: "center", width: 48, height: 48, borderRadius: "$radius.lg", backgroundColor: "$color.muted"}, children=[tile_appearance_g])
tile_appearance_g = Icon(name=$icon, size="lg")
tile_appearance_n = Text(text=$name, variant="caption", lines=2, align="center", visible=not(value=$later))
tile_appearance_l = Text(text=$name, variant="caption", lines=2, align="center", style={color: "$color.mutedForeground"}, visible=$later)
cat_preferences = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm"}, children=[cat_preferences_h, cat_preferences_g], visible=not(value=eq(a=len(value=$/settings/grid/preferences/modules), b=0)))
cat_preferences_h = Box(style={paddingBottom: "$spacing.xs", borderBottomWidth: 1, borderColor: "$color.border"}, children=[cat_preferences_t])
cat_preferences_t = Text(text="Preferences", variant="title")
cat_preferences_g = Box(style={display: "flex", flexDirection: "row", flexWrap: "wrap", gap: "$spacing.xs"}, children=_template($/settings/grid/preferences/modules, tile_preferences, key="id"))
tile_preferences = Box(style={display: "flex", flexDirection: "column", alignItems: "center", gap: "$spacing.xs", width: 104, paddingTop: "$spacing.sm", paddingBottom: "$spacing.sm", borderRadius: "$radius.lg", cursor: "pointer", ":hover": {backgroundColor: "$color.accent"}}, pressable=true, children=[tile_preferences_i, tile_preferences_n, tile_preferences_l], on={press: ede_settings_nav(action="open", module=$id)})
tile_preferences_i = Box(style={display: "flex", alignItems: "center", justifyContent: "center", width: 48, height: 48, borderRadius: "$radius.lg", backgroundColor: "$color.muted"}, children=[tile_preferences_g])
tile_preferences_g = Icon(name=$icon, size="lg")
tile_preferences_n = Text(text=$name, variant="caption", lines=2, align="center", visible=not(value=$later))
tile_preferences_l = Text(text=$name, variant="caption", lines=2, align="center", style={color: "$color.mutedForeground"}, visible=$later)
cat_hardware = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm"}, children=[cat_hardware_h, cat_hardware_g], visible=not(value=eq(a=len(value=$/settings/grid/hardware/modules), b=0)))
cat_hardware_h = Box(style={paddingBottom: "$spacing.xs", borderBottomWidth: 1, borderColor: "$color.border"}, children=[cat_hardware_t])
cat_hardware_t = Text(text="Hardware", variant="title")
cat_hardware_g = Box(style={display: "flex", flexDirection: "row", flexWrap: "wrap", gap: "$spacing.xs"}, children=_template($/settings/grid/hardware/modules, tile_hardware, key="id"))
tile_hardware = Box(style={display: "flex", flexDirection: "column", alignItems: "center", gap: "$spacing.xs", width: 104, paddingTop: "$spacing.sm", paddingBottom: "$spacing.sm", borderRadius: "$radius.lg", cursor: "pointer", ":hover": {backgroundColor: "$color.accent"}}, pressable=true, children=[tile_hardware_i, tile_hardware_n, tile_hardware_l], on={press: ede_settings_nav(action="open", module=$id)})
tile_hardware_i = Box(style={display: "flex", alignItems: "center", justifyContent: "center", width: 48, height: 48, borderRadius: "$radius.lg", backgroundColor: "$color.muted"}, children=[tile_hardware_g])
tile_hardware_g = Icon(name=$icon, size="lg")
tile_hardware_n = Text(text=$name, variant="caption", lines=2, align="center", visible=not(value=$later))
tile_hardware_l = Text(text=$name, variant="caption", lines=2, align="center", style={color: "$color.mutedForeground"}, visible=$later)
cat_exponential = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm"}, children=[cat_exponential_h, cat_exponential_g], visible=not(value=eq(a=len(value=$/settings/grid/exponential/modules), b=0)))
cat_exponential_h = Box(style={paddingBottom: "$spacing.xs", borderBottomWidth: 1, borderColor: "$color.border"}, children=[cat_exponential_t])
cat_exponential_t = Text(text="Exponential", variant="title")
cat_exponential_g = Box(style={display: "flex", flexDirection: "row", flexWrap: "wrap", gap: "$spacing.xs"}, children=_template($/settings/grid/exponential/modules, tile_exponential, key="id"))
tile_exponential = Box(style={display: "flex", flexDirection: "column", alignItems: "center", gap: "$spacing.xs", width: 104, paddingTop: "$spacing.sm", paddingBottom: "$spacing.sm", borderRadius: "$radius.lg", cursor: "pointer", ":hover": {backgroundColor: "$color.accent"}}, pressable=true, children=[tile_exponential_i, tile_exponential_n, tile_exponential_l], on={press: ede_settings_nav(action="open", module=$id)})
tile_exponential_i = Box(style={display: "flex", alignItems: "center", justifyContent: "center", width: 48, height: 48, borderRadius: "$radius.lg", backgroundColor: "$color.muted"}, children=[tile_exponential_g])
tile_exponential_g = Icon(name=$icon, size="lg")
tile_exponential_n = Text(text=$name, variant="caption", lines=2, align="center", visible=not(value=$later))
tile_exponential_l = Text(text=$name, variant="caption", lines=2, align="center", style={color: "$color.mutedForeground"}, visible=$later)
cat_administration = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm"}, children=[cat_administration_h, cat_administration_g], visible=not(value=eq(a=len(value=$/settings/grid/administration/modules), b=0)))
cat_administration_h = Box(style={paddingBottom: "$spacing.xs", borderBottomWidth: 1, borderColor: "$color.border"}, children=[cat_administration_t])
cat_administration_t = Text(text="Administration", variant="title")
cat_administration_g = Box(style={display: "flex", flexDirection: "row", flexWrap: "wrap", gap: "$spacing.xs"}, children=_template($/settings/grid/administration/modules, tile_administration, key="id"))
tile_administration = Box(style={display: "flex", flexDirection: "column", alignItems: "center", gap: "$spacing.xs", width: 104, paddingTop: "$spacing.sm", paddingBottom: "$spacing.sm", borderRadius: "$radius.lg", cursor: "pointer", ":hover": {backgroundColor: "$color.accent"}}, pressable=true, children=[tile_administration_i, tile_administration_n, tile_administration_l], on={press: ede_settings_nav(action="open", module=$id)})
tile_administration_i = Box(style={display: "flex", alignItems: "center", justifyContent: "center", width: 48, height: 48, borderRadius: "$radius.lg", backgroundColor: "$color.muted"}, children=[tile_administration_g])
tile_administration_g = Icon(name=$icon, size="lg")
tile_administration_n = Text(text=$name, variant="caption", lines=2, align="center", visible=not(value=$later))
tile_administration_l = Text(text=$name, variant="caption", lines=2, align="center", style={color: "$color.mutedForeground"}, visible=$later)
no_results = EmptyState(icon="search-x", title="No results", size="list", visible=$/settings/empty)
modules = Box(style={display: "flex", flexDirection: "row", justifyContent: "center", padding: "$spacing.xl"}, children=[module_column], visible=$/settings/inModule)
module_column = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.xl", width: 640}, children=[mod_themes, mod_font_selection, mod_backgrounds, mod_date_and_time, mod_general, mod_hot_corners, mod_panel, mod_privacy, mod_screensaver, mod_notifications, mod_preferred_applications, mod_startup_applications, mod_window_tiling, mod_windows, mod_workspaces, mod_bluetooth, mod_display, mod_keyboard, mod_mouse_and_touchpad, mod_network, mod_power_management, mod_sound, mod_system_info, mod_account, mod_share_desktop, mod_connect, mod_later, mod_missing, mod_users])
themes_main = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm"}, children=[themes_main_t, themes_main_f])
themes_main_t = Text(text="Themes", variant="title")
themes_main_f = Box(style={display: "flex", flexDirection: "column", borderWidth: 1, borderColor: "$color.border", borderRadius: "$radius.lg", backgroundColor: "$color.background", overflow: "hidden"}, children=[theme_desktop, themes_main_s1, theme_gtk, themes_main_s2, theme_icons, themes_main_s3, theme_cursor])
theme_desktop = Row(title="Desktop", value="Rerusted", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52})
themes_main_s1 = Separator()
theme_gtk = SettingsRow(label="Applications", stackBelow="never", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52}, children=[theme_gtk_c])
theme_gtk_c = Select(name="theme_gtk_c", options=$/config/theme/options/gtk, value=$/config/theme/gtk, style={width: 240}, on={change: ede_config(theme={gtk: $/config/theme/gtk})})
themes_main_s2 = Separator()
theme_icons = SettingsRow(label="Icons", stackBelow="never", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52}, children=[theme_icons_c])
theme_icons_c = Select(name="theme_icons_c", options=$/config/theme/options/icons, value=$/config/theme/icons, style={width: 240}, on={change: ede_config(theme={icons: $/config/theme/icons})})
themes_main_s3 = Separator()
theme_cursor = SettingsRow(label="Mouse pointer", stackBelow="never", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52}, children=[theme_cursor_c])
theme_cursor_c = Select(name="theme_cursor_c", options=$/config/theme/options/cursor, value=$/config/theme/cursor, style={width: 240}, on={change: ede_config(theme={cursor: $/config/theme/cursor})})
themes_bridge = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm"}, children=[themes_bridge_t, themes_bridge_f])
themes_bridge_t = Text(text="Settings", variant="title")
themes_bridge_f = Box(style={display: "flex", flexDirection: "column", borderWidth: 1, borderColor: "$color.border", borderRadius: "$radius.lg", backgroundColor: "$color.background", overflow: "hidden"}, children=[theme_bridge, themes_bridge_s1, theme_summary])
theme_bridge = SettingsRow(label="Theme GTK and Qt apps to match", stackBelow="never", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52}, children=[theme_bridge_c])
theme_bridge_c = Switch(label="", name="bridge", checked=$/config/theme/bridge, on={change: ede_config(theme={bridge: $/config/theme/bridge})})
themes_bridge_s1 = Separator()
theme_summary = Row(title="Resolved", value=$/config/theme/summary, style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52})
themes_frames = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm"}, children=[themes_frames_t, themes_frames_f])
themes_frames_t = Text(text="Window frames", variant="title")
themes_frames_f = Box(style={display: "flex", flexDirection: "column", borderWidth: 1, borderColor: "$color.border", borderRadius: "$radius.lg", backgroundColor: "$color.background", overflow: "hidden"}, children=[theme_frames])
theme_frames = Row(title="Title bars", value="Drawn by Exponential Desktop", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52})
themes_documents = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm"}, children=[themes_documents_t, themes_documents_f])
themes_documents_t = Text(text="Shell", variant="title")
themes_documents_f = Box(style={display: "flex", flexDirection: "column", borderWidth: 1, borderColor: "$color.border", borderRadius: "$radius.lg", backgroundColor: "$color.background", overflow: "hidden"}, children=[theme_open])
theme_open = SettingsRow(label="The shell's documents", stackBelow="never", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52}, children=[theme_open_c])
theme_open_c = Button(label="Open", icon="ui-folder", variant="outline", on={press: ede_launch(command="xdg-open ~/.config/exponential-desktop/ui")})
mod_themes = Stack(direction="vertical", gap="xl", children=[themes_main, themes_bridge, themes_frames, themes_documents], visible=eq(a=$/settings/module, b="themes"))
fonts_main = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm"}, children=[fonts_main_t, fonts_main_f])
fonts_main_t = Text(text="Font Selection", variant="title")
fonts_main_f = Box(style={display: "flex", flexDirection: "column", borderWidth: 1, borderColor: "$color.border", borderRadius: "$radius.lg", backgroundColor: "$color.background", overflow: "hidden"}, children=[font_default, fonts_main_s1, font_mono, fonts_main_s2, font_size])
font_default = SettingsRow(label="Default font", stackBelow="never", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52}, children=[font_default_c])
font_default_c = Select(name="font_default_c", options=$/config/theme/options/font, value=$/config/theme/font, searchable=true, style={width: 220}, on={change: ede_config(theme={font: $/config/theme/font})})
fonts_main_s1 = Separator()
font_mono = SettingsRow(label="Monospace font", stackBelow="never", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52}, children=[font_mono_c])
font_mono_c = Select(name="font_mono_c", options=$/config/theme/options/monospace, value=$/config/theme/monospace, searchable=true, style={width: 220}, on={change: ede_config(theme={monospace: $/config/theme/monospace})})
fonts_main_s2 = Separator()
font_size = SettingsRow(label="Text size", stackBelow="never", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52}, children=[font_size_c])
font_size_c = Select(name="font_size_c", options=$/config/theme/options/fontSize, value=$/config/theme/fontSizeText, style={width: 120}, on={change: ede_config(theme={font_size: $/config/theme/fontSizeText})})
mod_font_selection = Stack(direction="vertical", gap="xl", children=[fonts_main], visible=eq(a=$/settings/module, b="font-selection"))
backgrounds_main = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm"}, children=[backgrounds_main_t, backgrounds_main_f])
backgrounds_main_t = Text(text="Background", variant="title")
backgrounds_main_f = Box(style={display: "flex", flexDirection: "column", borderWidth: 1, borderColor: "$color.border", borderRadius: "$radius.lg", backgroundColor: "$color.background", overflow: "hidden"}, children=[background_picture, backgrounds_main_s1, background_colour])
background_picture = Row(title="Picture", value="None", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52})
backgrounds_main_s1 = Separator()
background_colour = Row(title="Colour", value="The theme's background", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52})
mod_backgrounds = Stack(direction="vertical", gap="xl", children=[backgrounds_main], visible=eq(a=$/settings/module, b="backgrounds"))
datetime_main = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm"}, children=[datetime_main_t, datetime_main_f])
datetime_main_t = Text(text="Date and Time", variant="title")
datetime_main_f = Box(style={display: "flex", flexDirection: "column", borderWidth: 1, borderColor: "$color.border", borderRadius: "$radius.lg", backgroundColor: "$color.background", overflow: "hidden"}, children=[ntp, datetime_main_s1, timezone])
ntp = SettingsRow(label="Network time", stackBelow="never", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52}, children=[ntp_c])
ntp_c = Switch(label="", name="ntp", checked=$/pages/datetime/ntp, on={change: ede_settings(key="ntp", page="datetime", value=$/pages/datetime/ntp)})
