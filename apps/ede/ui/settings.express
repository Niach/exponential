users_group_s1 = Separator()
users_manage = SettingsRow(label="Users and Groups is not installed", stackBelow="never", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52}, children=[users_manage_c])
users_manage_c = Button(label="Manage users", icon="settings-members", variant="outline", on={press: ede_launch(command="cinnamon-settings user || gnome-control-center user-accounts")})
