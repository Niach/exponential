datetime_format_t = Text(text="Format", variant="title")
datetime_format_f = Box(style={display: "flex", flexDirection: "column", borderWidth: 1, borderColor: "$color.border", borderRadius: "$radius.lg", backgroundColor: "$color.background", overflow: "hidden"}, children=[clock_format])
clock_format = Row(title="Clock", value=$/pages/datetime/clock, style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52})
mod_date_and_time = Stack(direction="vertical", gap="xl", children=[datetime_main, datetime_format], visible=eq(a=$/settings/module, b="date-and-time"))
general_scaling = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm"}, children=[general_scaling_t, general_scaling_f])
general_scaling_t = Text(text="Scaling", variant="title")
general_scaling_f = Box(style={display: "flex", flexDirection: "column", borderWidth: 1, borderColor: "$color.border", borderRadius: "$radius.lg", backgroundColor: "$color.background", overflow: "hidden"}, children=[general_scale, general_scaling_s1, general_fractional, general_scaling_s2, general_x11])
general_scale = SettingsRow(label="User interface scaling: per display", stackBelow="never", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52}, children=[general_scale_c])
