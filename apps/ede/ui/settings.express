local_share = SettingsRow(label="Share it as a team", stackBelow="never", style={paddingLeft: "$spacing.md", paddingRight: "$spacing.md", minHeight: 52}, children=[local_share_c], visible=eq(a=$/sharing/state, b="idle"))
local_share_c = Button(label="Share as a team…", icon="ui-share", variant="outline", on={press: ede_share(action="start")})
mod_share_desktop = Stack(direction="vertical", gap="xl", children=[device_desktop, share_flow], visible=eq(a=$/settings/module, b="share-desktop"))
share_flow = Stack(direction="vertical", gap="md", children=[share_needs_account, share_pick, share_running, share_done, share_failed], visible=not(value=eq(a=$/sharing/state, b="idle")))
share_needs_account = Stack(direction="vertical", gap="sm", children=[share_needs_account_text, share_connect, share_needs_account_cancel], visible=eq(a=$/sharing/state, b="needsAccount"))
share_needs_account_text = Text(text="Sharing makes this desktop a team of your Exponential account. Connect one first.", variant="muted")
share_connect = Button(label="Connect Exponential", icon="brand-exponential", variant="outline", on={press: ede_switcher(action="connect")})
share_needs_account_cancel = Button(label="Cancel", variant="ghost", on={press: ede_share(action="cancel")})
share_pick = Stack(direction="vertical", gap="md", children=[share_name, share_account, share_summary, share_actions], visible=eq(a=$/sharing/state, b="picking"))
share_name = Input(label="Team name", name="name", type="text", placeholder="The desktop's name", value=$/share/name)
share_account = Select(label="Account", name="account", options=$/sharing/accounts, value=$/share/account, visible=not(value=eq(a=len(value=$/sharing/accounts), b=1)))
share_summary = Text(text=$/sharing/summary, variant="muted")
share_actions = Stack(direction="horizontal", gap="sm", align="center", children=[share_run, share_cancel])
