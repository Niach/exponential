nav = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.xs", flexGrow: 1, minHeight: 0, paddingTop: "$spacing.sm", paddingLeft: "$spacing.xs", paddingRight: "$spacing.xs"}, children=[nav_head, nav_rule, nav_scroll])
nav_head = Box(style={display: "flex", flexDirection: "row", alignItems: "center", gap: "$spacing.sm", height: 40, paddingLeft: "$spacing.sm", paddingRight: "$spacing.xs", flexShrink: 0}, children=[nav_head_icon, nav_head_title, close])
nav_head_icon = Icon(name="nav-settings", size="sm")
nav_head_title = Text(text="Settings", variant="label", lines=1, style={flexGrow: 1, minWidth: 0})
close = Button(label="Close", icon="ui-close", variant="ghost", size="icon", on={press: ede_close_document(name="settings")})
nav_rule = Separator()
nav_scroll = ScrollArea(style={flexGrow: 1, minHeight: 0}, children=[nav_groups])
nav_groups = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm"}, children=[nav_device, nav_personal, nav_team])
nav_device = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.xxs"}, children=[nav_device_head, nav_display, nav_sound, nav_network, nav_bluetooth, nav_power, nav_themes, nav_keyboard, nav_mouse, nav_datetime, nav_users, nav_notifications, nav_workspaces, nav_windows, nav_startup, nav_defaults, nav_coding, nav_tools, nav_coding_clis, nav_worktrees, nav_sessions])
nav_device_head = Box(style={display: "flex", flexDirection: "row", alignItems: "center", gap: "$spacing.xs", height: 24, paddingLeft: "$spacing.xs", paddingRight: "$spacing.xs", borderRadius: "$radius.md"}, pressable=true, children=[nav_device_open, nav_device_closed, nav_device_title], on={press: set(path="/settings/deviceOpen", value=not(value=cond(if=$/settings/deviceOpen, then=true, else=false)))})
nav_device_open = Icon(name="ui-chevron-down", size="sm", tone="neutral", visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_device_closed = Icon(name="ui-chevron-right", size="sm", tone="neutral", visible=not(value=cond(if=$/settings/deviceOpen, then=true, else=false)))
nav_device_title = Text(text="This device", variant="caption")
nav_display = Row(title="Display", icon="ede-brightness", selected=eq(a=$/settings/page, b="display"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="display")}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_sound = Row(title="Sound", icon="media-volume-up", selected=eq(a=$/settings/page, b="sound"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="sound")}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_network = Row(title="Network", icon="ede-wifi", selected=eq(a=$/settings/page, b="network"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="network")}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_bluetooth = Row(title="Bluetooth", icon="ede-bluetooth", selected=eq(a=$/settings/page, b="bluetooth"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="bluetooth")}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_power = Row(title="Power", icon="ede-battery", selected=eq(a=$/settings/page, b="power"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="power")}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_themes = Row(title="Themes", icon="editor-text-format", selected=eq(a=$/settings/page, b="themes"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="themes")}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_keyboard = Row(title="Keyboard", icon="coding-command", selected=eq(a=$/settings/page, b="keyboard"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="keyboard")}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_mouse = Row(title="Mouse & Touchpad", icon="ui-device", selected=eq(a=$/settings/page, b="mouse"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="mouse")}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_datetime = Row(title="Date & Time", icon="ui-clock", selected=eq(a=$/settings/page, b="datetime"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="datetime")}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_users = Row(title="Users", icon="settings-members", selected=eq(a=$/settings/page, b="users"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="users")}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_notifications = Row(title="Notifications", icon="settings-notifications", selected=eq(a=$/settings/page, b="notifications"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="notifications")}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_workspaces = Row(title="Workspaces", icon="ede-workspaces", selected=eq(a=$/settings/page, b="workspaces"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="workspaces")}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_windows = Row(title="Windows", icon="ede-window", selected=eq(a=$/settings/page, b="windows"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="windows")}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_startup = Row(title="Startup apps", icon="action-run", selected=eq(a=$/settings/page, b="startup"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="startup")}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_defaults = Row(title="Default apps", icon="nav-apps", selected=eq(a=$/settings/page, b="defaults"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="defaults")}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_coding = Row(title="Coding", icon="settings-tools", density="compact", pressable=true, slots={trailing: "nav_coding_chevrons"}, on={press: set(path="/settings/codingOpen", value=not(value=cond(if=$/settings/codingOpen, then=true, else=false)))}, visible=cond(if=$/settings/deviceOpen, then=true, else=false))
nav_coding_chevrons = Box(style={display: "flex", flexDirection: "row", alignItems: "center"}, children=[nav_coding_open, nav_coding_closed])
nav_coding_open = Icon(name="ui-chevron-down", size="sm", tone="neutral", visible=cond(if=$/settings/codingOpen, then=true, else=false))
nav_coding_closed = Icon(name="ui-chevron-right", size="sm", tone="neutral", visible=not(value=cond(if=$/settings/codingOpen, then=true, else=false)))
nav_tools = Row(title="Tools", icon="settings-tools", selected=eq(a=$/settings/page, b="tools"), density="compact", pressable=true, depth=1, on={press: set(path="/settings/page", value="tools")}, visible=and(values=[cond(if=$/settings/deviceOpen, then=true, else=false), cond(if=$/settings/codingOpen, then=true, else=false)]))
nav_coding_clis = Row(title="Coding CLIs", icon="settings-agents", selected=eq(a=$/settings/page, b="coding-clis"), density="compact", pressable=true, depth=1, on={press: set(path="/settings/page", value="coding-clis")}, visible=and(values=[cond(if=$/settings/deviceOpen, then=true, else=false), cond(if=$/settings/codingOpen, then=true, else=false)]))
nav_worktrees = Row(title="Worktrees", icon="settings-local-repos", selected=eq(a=$/settings/page, b="worktrees"), density="compact", pressable=true, depth=1, on={press: set(path="/settings/page", value="worktrees")}, visible=and(values=[cond(if=$/settings/deviceOpen, then=true, else=false), cond(if=$/settings/codingOpen, then=true, else=false)]))
nav_sessions = Row(title="Sessions", icon="settings-sessions", selected=eq(a=$/settings/page, b="sessions"), density="compact", pressable=true, depth=1, on={press: set(path="/settings/page", value="sessions")}, visible=and(values=[cond(if=$/settings/deviceOpen, then=true, else=false), cond(if=$/settings/codingOpen, then=true, else=false)]))
nav_personal = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.xxs"}, children=[nav_personal_head, nav_account, nav_devices, nav_security, nav_whats_new, nav_about])
nav_personal_head = Box(style={display: "flex", flexDirection: "row", alignItems: "center", gap: "$spacing.xs", height: 24, paddingLeft: "$spacing.xs", paddingRight: "$spacing.xs", borderRadius: "$radius.md"}, pressable=true, children=[nav_personal_open, nav_personal_closed, nav_personal_title], on={press: set(path="/settings/personalOpen", value=not(value=cond(if=$/settings/personalOpen, then=true, else=false)))})
nav_personal_open = Icon(name="ui-chevron-down", size="sm", tone="neutral", visible=cond(if=$/settings/personalOpen, then=true, else=false))
nav_personal_closed = Icon(name="ui-chevron-right", size="sm", tone="neutral", visible=not(value=cond(if=$/settings/personalOpen, then=true, else=false)))
nav_personal_title = Text(text="Personal", variant="caption")
nav_account = Row(title="Account", icon="settings-account", selected=eq(a=$/settings/page, b="account"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="account")}, visible=cond(if=$/settings/personalOpen, then=true, else=false))
nav_devices = Row(title="Devices", icon="nav-devices", selected=eq(a=$/settings/page, b="devices"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="devices")}, visible=cond(if=$/settings/personalOpen, then=true, else=false))
nav_security = Row(title="Security", icon="settings-api", selected=eq(a=$/settings/page, b="security"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="security")}, visible=cond(if=$/settings/personalOpen, then=true, else=false))
nav_whats_new = Row(title="What's new", icon="nav-changelog", selected=eq(a=$/settings/page, b="whats-new"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="whats-new")}, visible=cond(if=$/settings/personalOpen, then=true, else=false))
nav_about = Row(title="About", icon="settings-about", selected=eq(a=$/settings/page, b="about"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="about")}, visible=cond(if=$/settings/personalOpen, then=true, else=false))
nav_team = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.xxs"}, children=[switcher, switcher_menu, nav_local_general, nav_local_agents, nav_local_apps, nav_team_team_label, nav_team_general, nav_team_members, nav_team_issues, nav_team_labels, nav_team_statuses, nav_team_repositories, nav_team_prompts, nav_team_widget, nav_team_storage, nav_team_boards_label, nav_team_archived_boards, nav_team_agents_label, nav_team_agents, nav_team_mcp, nav_team_skills, nav_team_apps_label, nav_team_apps])
switcher = Box(style={display: "flex", flexDirection: "row", alignItems: "center", gap: "$spacing.sm", height: 40, paddingLeft: "$spacing.xs", paddingRight: "$spacing.xs", borderRadius: "$radius.md"}, pressable=true, children=[switcher_avatar_current, switcher_avatar_picked, switcher_name_current, switcher_name_picked, switcher_chevron])
switcher_avatar_current = Avatar(name=$/shell/switcher/current/name, size="default", visible=eq(a=$/settings/team/kind, b=""))
switcher_avatar_picked = Avatar(name=$/settings/team/name, size="default", visible=not(value=eq(a=$/settings/team/kind, b="")))
switcher_name_current = Text(text=$/shell/switcher/current/name, variant="label", lines=1, style={flexGrow: 1, minWidth: 0}, visible=eq(a=$/settings/team/kind, b=""))
switcher_name_picked = Text(text=$/settings/team/name, variant="label", lines=1, style={flexGrow: 1, minWidth: 0}, visible=not(value=eq(a=$/settings/team/kind, b="")))
switcher_chevron = Icon(name="nav-team-switcher", size="sm", tone="neutral")
switcher_menu = Popover(open=$/settings/switcherOpen, side="bottom", align="start", anchor=switcher, children=[switcher_list])
switcher_list = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.xxs", width: 240, padding: "$spacing.xs"}, children=[switcher_sections, switcher_section, switcher_sep, switcher_connect])
switcher_sections = List(gap="xs", children=_template($/shell/switcher/sections, switcher_section, key="id"))
switcher_section = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.xxs"}, children=[switcher_section_label, switcher_entries, switcher_entry])
switcher_section_label = Text(text=$label, variant="caption", lines=1)
switcher_entries = List(gap="none", children=_template($entries, switcher_entry, key="id"))
switcher_entry = Row(title=$name, selected=$current, density="compact", pressable=true, slots={leading: "switcher_entry_avatar"}, on={press: set(path="/settings/team", value={kind: $kind, id: $id, name: $name, account: $account})})
switcher_entry_avatar = Avatar(name=$name, size="sm")
switcher_sep = Separator()
switcher_connect = Row(title="Connect Exponential", icon="brand-exponential", density="compact", pressable=true, on={press: ede_switcher(action="connect")})
nav_local_general = Row(title="General", icon="settings-general", selected=eq(a=$/settings/page, b="local-general"), density="compact", pressable=true, depth=0, on={press: set(path="/settings/page", value="local-general")}, visible=or(values=[eq(a=$/settings/team/kind, b="local"), and(values=[eq(a=$/settings/team/kind, b=""), eq(a=$/shell/switcher/current/kind, b="local")])]))
