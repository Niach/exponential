ide_active_delete_placed_menu = Menu(items=[{label: "Open", value: "open", icon: "ui-arrow-right"}, {label: "Open in new tab", value: "open-new-tab", icon: "ui-external-link"}, {kind: "separator"}, {label: "Copy link", value: "copy-link", icon: "ui-link"}, {kind: "separator"}, {label: "Delete", value: "delete", icon: "ui-delete", destructive: true}], side="bottom", align="start", openOn="contextmenu", children=[ide_active_delete_placed_row], on={select: Event("ide_menu", {kind: "active-session", id: $session, team: $team})}, visible=and(values=[eq(a=$kind, b="active"), eq(a=$menu, b="active-delete-placed")]))
ide_active_delete_placed_row = Row(title=$title, icon=$icon, selected=$selected, density="compact", pressable=true, slots={trailing: "ide_active_delete_placed_trailing"}, on={press: Event("ide_open", {kind: "active", id: $session})})
ide_active_delete_placed_trailing = Stack(direction="horizontal", gap="xs", align="center", children=[ide_active_delete_placed_device], visible=not(value=cond(if=$/shell/rail, then=true, else=false)))
ide_active_delete_placed_device = Icon(name=$deviceIcon, size="sm", visible=cond(if=$deviceIcon, then=true, else=false))
ide_active_keep_menu = Menu(items=[{label: "Open", value: "open", icon: "ui-arrow-right"}, {label: "Open in new tab", value: "open-new-tab", icon: "ui-external-link"}, {kind: "separator"}, {label: "Copy link", value: "copy-link", icon: "ui-link"}, {label: "Add to sidebar", value: "add-to-sidebar", icon: "ui-add"}], side="bottom", align="start", openOn="contextmenu", children=[ide_active_keep_row], on={select: Event("ide_menu", {kind: "active-session", id: $session, team: $team})}, visible=and(values=[eq(a=$kind, b="active"), eq(a=$menu, b="active")]))
ide_active_keep_row = Row(title=$title, icon=$icon, selected=$selected, density="compact", pressable=true, slots={trailing: "ide_active_keep_trailing"}, on={press: Event("ide_open", {kind: "active", id: $session})})
ide_active_keep_trailing = Stack(direction="horizontal", gap="xs", align="center", children=[ide_active_keep_device], visible=not(value=cond(if=$/shell/rail, then=true, else=false)))
ide_active_keep_device = Icon(name=$deviceIcon, size="sm", visible=cond(if=$deviceIcon, then=true, else=false))
ide_active_keep_placed_menu = Menu(items=[{label: "Open", value: "open", icon: "ui-arrow-right"}, {label: "Open in new tab", value: "open-new-tab", icon: "ui-external-link"}, {kind: "separator"}, {label: "Copy link", value: "copy-link", icon: "ui-link"}], side="bottom", align="start", openOn="contextmenu", children=[ide_active_keep_placed_row], on={select: Event("ide_menu", {kind: "active-session", id: $session, team: $team})}, visible=and(values=[eq(a=$kind, b="active"), eq(a=$menu, b="active-placed")]))
ide_active_keep_placed_row = Row(title=$title, icon=$icon, selected=$selected, density="compact", pressable=true, slots={trailing: "ide_active_keep_placed_trailing"}, on={press: Event("ide_open", {kind: "active", id: $session})})
ide_active_keep_placed_trailing = Stack(direction="horizontal", gap="xs", align="center", children=[ide_active_keep_placed_device], visible=not(value=cond(if=$/shell/rail, then=true, else=false)))
ide_active_keep_placed_device = Icon(name=$deviceIcon, size="sm", visible=cond(if=$deviceIcon, then=true, else=false))
ide_prs = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.xxs"}, children=[ide_prs_head, ide_prs_tree], visible=not(value=eq(a=len(value=$/shell/ide/prs), b=0)))
ide_prs_head = Box(style={display: "flex", flexDirection: "row", alignItems: "center", height: 24, paddingLeft: "$spacing.xs"}, children=[ide_prs_label], visible=not(value=cond(if=$/shell/rail, then=true, else=false)))
ide_prs_label = Text(text="Pull requests", variant="caption", style={flexGrow: 1, color: "$color.mutedForeground"})
ide_prs_tree = List(gap="none", divided=false, children=[])
ide_getting_started = Menu(items=[{label: "Open", value: "open", icon: "ui-arrow-right"}], side="top", align="start", openOn="contextmenu", children=[ide_getting_started_row], on={select: Event("ide_menu", {kind: "getting-started", id: "getting-started"})}, visible=cond(if=$/shell/ide/gettingStarted, then=true, else=false))
ide_getting_started_row = Row(title="Getting started", icon="nav-getting-started", density="compact", pressable=true, on={press: Event("ide_open", {kind: "getting-started", id: "getting-started"})})
corner = Stack(direction="horizontal", gap="xs", align="center", children=[ide_account_context, ide_computer, ide_settings])
ide_account_context = Menu(items=[{label: "What's new", value: "whats_new", icon: "nav-changelog"}, {label: "About", value: "about", icon: "settings-about"}, {kind: "separator"}, {label: "Sign out", value: "sign_out", icon: "nav-sign-out"}], side="top", align="start", openOn="contextmenu", children=[ide_account], on={select: Event("ide_account", {})}, style={flexGrow: 1, minWidth: 0})
ide_account = Menu(items=[{label: "What's new", value: "whats_new", icon: "nav-changelog"}, {label: "About", value: "about", icon: "settings-about"}, {kind: "separator"}, {label: "Sign out", value: "sign_out", icon: "nav-sign-out"}], side="top", align="start", children=[ide_account_trigger], on={select: Event("ide_account", {})}, style={flexGrow: 1, minWidth: 0})
ide_account_trigger = Box(style={display: "flex", flexDirection: "row", alignItems: "center", gap: "$spacing.sm", height: 36, paddingLeft: "$spacing.xs", paddingRight: "$spacing.xs", borderRadius: "$radius.md", flexGrow: 1, minWidth: 0}, pressable=true, children=[ide_account_avatar, ide_account_name, ide_account_chevron])
ide_account_avatar = Icon(name=$/shell/ide/me, style={width: 24, height: 24}, visible=cond(if=$/shell/ide/me, then=true, else=false))
ide_account_name = Text(text=$/shell/ide/meName, variant="body", lines=1, style={flexGrow: 1, minWidth: 0})
ide_account_chevron = Icon(name="nav-team-switcher", size="sm", tone="neutral")
ide_computer = Icon(name=$/shell/ide/computer, style={width: 32, height: 32}, visible=cond(if=$/shell/ide/computer, then=true, else=false))
ide_settings = Button(label="Settings", icon="nav-settings", variant="ghost", size="icon", on={press: Event("ide_open", {kind: "settings", id: "settings"})})
