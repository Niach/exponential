# Exponential Desktop's factory Needs you list (#EDE-65): the taskbar's Needs you tray button (shown
# only while something waits, its badge the count) opens it as a popup surface: every plan, question
# and ready PR waiting on the person across all the teams of the shell's signed-in accounts
# (/needsYou/rows, the IDE's needs-you.express fold per team, the team's rows by team name), each row
# titled by what waits, its chat and team under it, its age as the meta. A press hands off to the
# Exponential app on that chat (ede_needs_you_open: exponential://session/<id>?opens=…&message=…).
# #EDE-226, on top (install-trust.json's parts, the app's Needs you): the installs waiting for this
# install's approval (/installs/rows: the Row with the code, the Badge, Approve and Remove under it;
# ede_install passes the press and the code to the app), or this install waiting (the page EmptyState,
# its code in the description's place: EmptyState takes no binding there).
surface("needs-you", extensions={ede: {popup: {parent: "taskbar", anchor: "needs_you", placement: "top-end", size: {width: 380, height: 360}}, functions: ["ede_install", "ede_needs_you_open"]}})
$/installs/code = ""
$/installs/count = 0
$/installs/rows = []
$/installs/waiting = false
$/needsYou/count = 0
$/needsYou/rows = []
root = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm", padding: "$spacing.sm", height: 360, backgroundColor: "$color.popover", borderWidth: 1, borderColor: "$color.border", borderRadius: "$radius.md"}, children=[needs_title, needs_scroll])
needs_title = Heading(text="Needs you", level="h4")
needs_scroll = ScrollArea(maxHeight=300, children=[install_waiting, install_list, needs_list])
install_waiting = Box(style={display: "flex", flexDirection: "column", alignItems: "center", gap: "$spacing.md", paddingBottom: "$spacing.xl3"}, children=[install_waiting_state, install_waiting_code], visible=cond(if=$/installs/waiting, then=true, else=false))
install_waiting_state = EmptyState(icon="ui-private", title="Waiting for approval", style={paddingBottom: 0})
install_waiting_code = Text(text=$/installs/code, variant="muted", align="center")
install_list = Section(children=_template($/installs/rows, install_item, key="id"), visible=not(value=eq(a=$/installs/count, b=0)))
install_item = Stack(direction="vertical", gap="sm", children=[install_row, install_actions])
install_row = Row(title=$title, subtitle=$code, slots={trailing: "install_badge"})
install_badge = Badge(text=$badge, variant="secondary")
install_actions = Stack(direction="horizontal", gap="sm", children=[install_approve, install_remove])
install_approve = Button(label="Approve", size="sm", on={press: ede_install(action="approve", id=$id, code=$code)})
install_remove = Button(label="Remove", size="sm", variant="ghost", on={press: ede_install(action="remove", id=$id, code=$code)})
needs_list = List(gap="none", divided=true, children=_template($/needsYou/rows, needs_row, key="id"))
needs_row = Row(title=$title, subtitle=$subtitle, meta=$meta, icon=$icon, density="compact", pressable=true, on={press: ede_needs_you_open(id=$id)})
