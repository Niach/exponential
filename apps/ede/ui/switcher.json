{
  "$comment": "Exponential Desktop's factory window switcher (#EDE-12, Mint's \"Icons and thumbnails\" look #EDE-65): hold Alt, Tab / Shift+Tab (or the arrow keys) cycle the current workspace's windows most recent first, Alt+` only the focused app's; the popup shows centred after 100 ms (a quick Alt+Tab flips to the previous window without it), releasing Alt focuses the selected window (a minimized one is restored), Escape cancels, a click picks a tile. The shell feeds /switcher: windows [{id, title, app, icon, minimized, selected, thumbnail}] (live thumbnails at about 5 fps captured over ede-protocol into Image; protected windows show no picture) and title (the selected window's, under the tiles); it sizes the surface's width to the tiles (208 px each, sm gaps, lg padding).",
  "surface": {
    "layer": "overlay",
    "size": {
      "width": 760,
      "height": 204
    },
    "onDemand": true,
    "functions": [
      "ede_select"
    ]
  },
  "root": {
    "id": "switcher",
    "component": "Box",
    "style": {
      "display": "flex",
      "flexDirection": "column",
      "alignItems": "center",
      "gap": "$spacing.md",
      "padding": "$spacing.lg",
      "height": 204,
      "backgroundColor": "$color.popover",
      "borderWidth": 1,
      "borderColor": "$color.border",
      "borderRadius": "$radius.lg"
    },
    "children": [
      {
        "id": "tiles",
        "component": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "align": "center",
          "justify": "center"
        },
        "template": {
          "component": "tile",
          "path": "/switcher/windows",
          "key": "id"
        },
        "children": []
      },
      {
        "id": "tile",
        "component": "Box",
        "props": {
          "pressable": true
        },
        "style": {
          "position": "relative",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "center",
          "padding": "$spacing.sm",
          "width": 208,
          "height": 136,
          "borderRadius": "$radius.md"
        },
        "on": {
          "press": {
            "functionCall": {
              "@call": "ede_select",
              "args": {
                "window": {
                  "@path": "id"
                }
              }
            }
          }
        },
        "children": [
          {
            "id": "tile_selected",
            "component": "Box",
            "style": {
              "position": "absolute",
              "inset": 0,
              "borderRadius": "$radius.md",
              "backgroundColor": "$color.accent"
            },
            "visible": {
              "@call": "cond",
              "args": {
                "if": {
                  "@path": "selected"
                },
                "then": true,
                "else": false
              }
            }
          },
          {
            "id": "thumb_frame",
            "component": "Box",
            "style": {
              "position": "relative",
              "width": 192,
              "height": 120
            },
            "children": [
              {
                "id": "thumb",
                "component": "Image",
                "props": {
                  "src": {
                    "@path": "thumbnail"
                  },
                  "alt": {
                    "@path": "title"
                  },
                  "width": 192,
                  "height": 120,
                  "fit": "contain",
                  "fallback": "ede-window"
                }
              },
              {
                "id": "app_icon",
                "component": "Image",
                "style": {
                  "position": "absolute",
                  "left": 80,
                  "bottom": 0
                },
                "props": {
                  "src": {
                    "@path": "icon"
                  },
                  "alt": {
                    "@path": "app"
                  },
                  "width": 32,
                  "height": 32,
                  "fit": "contain",
                  "fallback": "nav-apps"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "title",
        "component": "Text",
        "props": {
          "text": {
            "@path": "/switcher/title"
          },
          "lines": 1,
          "align": "center"
        },
        "style": {
          "width": "100%"
        }
      }
    ]
  },
  "data": {
    "switcher": {
      "windows": [],
      "title": ""
    }
  }
}
