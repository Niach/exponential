{
  "$comment": "Exponential Desktop's factory menu (#EDE-10, #EDE-12): the launcher. It opens from the panel's first button (or Super) as its own popup surface, an xdg_popup child of the panel's layer surface, and takes the keyboard while open. The shell feeds /apps (the installed desktop entries, filtered by /query as the person types) and answers the host functions the header allows: ede.launch, ede.lock, ede.logout, ede.power, ede.open_document (the settings).",
  "surface": {"popup": {"parent": "panel", "anchor": "menu", "placement": "bottom-start", "size": {"width": 360, "height": 520}}, "functions": ["ede.launch", "ede.lock", "ede.logout", "ede.power", "ede.open_document"]},
  "root": {
    "id": "menu",
    "component": "Box",
    "style": {"display": "flex", "flexDirection": "column", "gap": "$spacing.sm", "padding": "$spacing.sm", "height": 520, "backgroundColor": "$color.popover", "borderWidth": 1, "borderColor": "$color.border", "borderRadius": "$radius.md"},
    "children": [
      {"id": "search", "component": "Input", "props": {"type": "search", "name": "query", "label": "Search apps", "placeholder": "Search apps", "value": {"path": "/query"}}},
      {"id": "apps-scroll", "component": "ScrollArea", "props": {"maxHeight": 390}, "children": [
        {"id": "apps", "component": "List", "props": {"gap": "none"}, "template": {"component": "app", "path": "/apps", "key": "id"}, "children": []},
        {"id": "app", "component": "Row", "props": {"title": {"path": "name"}, "subtitle": {"path": "comment"}, "pressable": true, "density": "compact"},
          "slots": {"leading": {"id": "app-icon", "component": "Image", "props": {"src": {"path": "icon"}, "alt": {"path": "name"}, "width": 24, "height": 24, "fit": "contain", "fallback": "nav-apps"}}},
          "on": {"press": {"functionCall": {"call": "ede.launch", "args": {"command": {"path": "exec"}}}}}},
        {"id": "no-apps", "component": "Text", "props": {"text": "No app matches", "variant": "muted", "align": "center"}, "visible": {"call": "eq", "args": {"a": {"call": "len", "args": {"value": {"path": "/apps"}}}, "b": 0}}}
      ]},
      {"id": "menu-sep", "component": "Separator"},
      {"id": "power", "component": "Stack", "props": {"direction": "horizontal", "gap": "xs", "align": "center", "justify": "end"}, "children": [
        {"id": "menu-settings", "component": "Button", "props": {"icon": "nav-settings", "variant": "ghost", "size": "icon", "label": "Settings"}, "on": {"press": {"functionCall": {"call": "ede.open_document", "args": {"name": "settings"}}}}},
        {"id": "menu-lock", "component": "Button", "props": {"icon": "ede-lock", "variant": "ghost", "size": "icon", "label": "Lock"}, "on": {"press": {"functionCall": {"call": "ede.lock"}}}},
        {"id": "menu-logout", "component": "Button", "props": {"icon": "nav-sign-out", "variant": "ghost", "size": "icon", "label": "Log out"}, "on": {"press": {"functionCall": {"call": "ede.logout"}}}},
        {"id": "menu-suspend", "component": "Button", "props": {"icon": "ede-suspend", "variant": "ghost", "size": "icon", "label": "Suspend"}, "on": {"press": {"functionCall": {"call": "ede.power", "args": {"action": "suspend"}}}}},
        {"id": "menu-restart", "component": "Button", "props": {"icon": "ui-refresh", "variant": "ghost", "size": "icon", "label": "Restart"}, "on": {"press": {"functionCall": {"call": "ede.power", "args": {"action": "reboot"}}}}},
        {"id": "menu-poweroff", "component": "Button", "props": {"icon": "ede-power", "variant": "ghost", "size": "icon", "label": "Shut down"}, "on": {"press": {"functionCall": {"call": "ede.power", "args": {"action": "poweroff"}}}}}
      ]}
    ]
  },
  "data": {"query": "", "apps": []}
}
