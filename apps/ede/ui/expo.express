# Exponential Desktop's factory Expo (#EDE-49): Ctrl+Alt+Up opens it as an overlay in the middle of
# the screen (onDemand: the shell opens and closes it on the compositor's expo.toggle hotkey), one
# tile per workspace (/expo: the label, the window count, the active one outlined, each window as a
# live thumbnail captured over ede-protocol while it is open); a press on a tile switches to that
# workspace (ede_workspace) and closes the overlay, a press on a thumbnail focuses that window.
surface("expo", extensions={ede: {layer: "overlay", size: {width: 960, height: 520}, onDemand: true, functions: ["ede_workspace", "ede_focus"]}})
$/expo/workspaces = []
root = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.md", padding: "$spacing.lg", width: 960, height: 520, backgroundColor: "$color.popover", borderWidth: 1, borderColor: "$color.border", borderRadius: "$radius.lg"}, children=[expo_title, tiles])
expo_title = Heading(text="Workspaces", level="h4")
tiles = Grid(columns=2, gap="md", children=_template($/expo/workspaces, tile, key="index"))
tile = Box(style={position: "relative", display: "flex", flexDirection: "column", gap: "$spacing.xs", padding: "$spacing.sm", minHeight: 200, borderRadius: "$radius.md", borderWidth: 1, borderColor: "$color.border", backgroundColor: "$color.muted"}, pressable=true, children=[tile_active, tile_head, tile_windows, tile_empty], on={press: ede_workspace(index=$index)})
tile_active = Box(style={position: "absolute", inset: 0, borderRadius: "$radius.md", borderWidth: 2, borderColor: "$color.primary"}, visible=cond(if=$active, then=true, else=false))
tile_head = Stack(direction="horizontal", gap="sm", align="center", justify="between", children=[tile_label, tile_count])
tile_label = Text(text=$label, variant="label")
tile_count = Text(text=$countText, variant="muted")
tile_windows = Stack(direction="horizontal", gap="xs", align="start", wrap=true, children=_template($windows, tile_window, key="id"))
tile_window = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.xxs", width: 104}, pressable=true, children=[tile_thumb, tile_window_title], on={press: ede_focus(window=$id)})
tile_thumb = Image(src=$thumbnail, alt=$title, fit="contain", width=104, height=58, fallback="ede-window")
tile_window_title = Text(text=$title, variant="caption", lines=1)
tile_empty = Text(text="No windows", variant="muted", visible=eq(a=len(value=$windows), b=0))
