# Exponential Desktop's factory Scale (#EDE-49): Ctrl+Alt+Down opens it as an overlay in the middle of
# the screen (onDemand, on the compositor's scale.toggle hotkey): the active workspace's windows tiled
# as live thumbnails (/scale: captured over ede-protocol while it is open) with a title chip under
# each and a close badge; a press focuses the window and closes the overlay.
surface("scale", extensions={ede: {layer: "overlay", size: {width: 960, height: 520}, onDemand: true, functions: ["ede_focus", "ede_close"]}})
$/scale/label = "Workspace 1"
$/scale/windows = []
root = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.md", padding: "$spacing.lg", width: 960, height: 520, backgroundColor: "$color.popover", borderWidth: 1, borderColor: "$color.border", borderRadius: "$radius.lg"}, children=[scale_title, scale_windows, scale_empty])
scale_title = Heading(text=$/scale/label, level="h4")
scale_windows = Stack(direction="horizontal", gap="md", align="start", wrap=true, children=_template($/scale/windows, scale_window, key="id"))
scale_window = Box(style={position: "relative", display: "flex", flexDirection: "column", gap: "$spacing.xs", padding: "$spacing.xs", width: 296, borderRadius: "$radius.md"}, pressable=true, children=[scale_focused, scale_thumb, scale_foot], on={press: ede_focus(window=$id)})
scale_focused = Box(style={position: "absolute", inset: 0, borderRadius: "$radius.md", backgroundColor: "$color.accent"}, visible=cond(if=$focused, then=true, else=false))
scale_thumb = Image(src=$thumbnail, alt=$title, fit="contain", width=280, height=158, fallback="ede-window")
scale_foot = Stack(direction="horizontal", gap="xs", align="center", children=[scale_chip, scale_spacer, scale_close])
scale_chip = Chip(label=$title)
scale_spacer = Box(style={flexGrow: 1})
scale_close = Button(label="Close", icon="ui-close", variant="ghost", size="icon", on={press: ede_close(window=$id)})
scale_empty = EmptyState(icon="ede-window", title="No open windows", size="list", visible=eq(a=len(value=$/scale/windows), b=0))
