{
  "$comment": "Exponential Desktop's factory tray menu (#EDE-12): a tray item's dbusmenu (com.canonical.dbusmenu over the session bus), opened as a popup above the taskbar's tray area when the item has one (an item without a menu is activated instead). /traymenu holds the item and its rows, one submenu level flattened; a row press sends the item its clicked event (ede_tray_menu).",
  "surface": {
    "popup": {
      "parent": "taskbar",
      "anchor": "tray",
      "placement": "top-end",
      "size": {
        "width": 280,
        "height": 360
      }
    },
    "functions": [
      "ede_tray_menu"
    ]
  },
  "root": {
    "id": "traymenu",
    "component": "Box",
    "style": {
      "display": "flex",
      "flexDirection": "column",
      "gap": "$spacing.xs",
      "padding": "$spacing.sm",
      "backgroundColor": "$color.popover",
      "borderWidth": 1,
      "borderColor": "$color.border",
      "borderRadius": "$radius.md"
    },
    "children": [
      {
        "id": "traymenu_title",
        "component": "Text",
        "props": {
          "text": {
            "@path": "/traymenu/title"
          },
          "variant": "caption"
        }
      },
      {
        "id": "traymenu_scroll",
        "component": "ScrollArea",
        "props": {
          "maxHeight": 310
        },
        "children": [
          {
            "id": "traymenu_list",
            "component": "List",
            "props": {
              "gap": "none"
            },
            "template": {
              "component": "traymenu_row",
              "path": "/traymenu/items",
              "key": "id"
            },
            "children": []
          },
          {
            "id": "traymenu_row",
            "component": "Box",
            "children": [
              {
                "id": "traymenu_sep",
                "component": "Separator",
                "visible": {
                  "@call": "cond",
                  "args": {
                    "if": {
                      "@path": "separator"
                    },
                    "then": true,
                    "else": false
                  }
                }
              },
              {
                "id": "traymenu_entry",
                "component": "Row",
                "props": {
                  "title": {
                    "@path": "label"
                  },
                  "density": "compact",
                  "pressable": true,
                  "selected": {
                    "@path": "checked"
                  }
                },
                "visible": {
                  "@call": "not",
                  "args": {
                    "value": {
                      "@call": "cond",
                      "args": {
                        "if": {
                          "@path": "separator"
                        },
                        "then": true,
                        "else": false
                      }
                    }
                  }
                },
                "on": {
                  "press": {
                    "functionCall": {
                      "@call": "ede_tray_menu",
                      "args": {
                        "service": {
                          "@path": "/traymenu/service"
                        },
                        "id": {
                          "@path": "id"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "data": {
    "traymenu": {
      "service": "",
      "title": "",
      "items": []
    }
  }
}
