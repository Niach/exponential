# Exponential Desktop's factory version history (#EDE-53): the start menu's Version history entry
# opens it as an on-demand top layer surface in the middle of the screen: every edit of the shell's
# documents is a commit in ~/.config/exponential-desktop/ui (exponential-ui, #EDE-9), listed newest
# first (/history), with Undo (the newest edit reverted, ede_history undo) and Reset to factory (every
# document back as it ships, the edits stay in the history).
surface("history", extensions={ede: {layer: "top", size: {width: 720, height: 480}, keyboard: "on-demand", onDemand: true, functions: ["ede_history", "ede_close_document"]}})
$/history/entries = []
root = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.sm", padding: "$spacing.md", width: 720, height: 480, backgroundColor: "$color.popover", borderWidth: 1, borderColor: "$color.border", borderRadius: "$radius.lg"}, children=[history_head, history_scroll])
history_head = Stack(direction="horizontal", gap="sm", align="center", justify="between", children=[history_title, history_actions])
history_title = Heading(text="Version history", level="h3")
history_actions = Stack(direction="horizontal", gap="xs", align="center", children=[history_undo, history_reset, history_close])
history_undo = Button(label="Undo", icon="ui-undo", variant="outline", size="sm", on={press: ede_history(action="undo")})
history_reset = Button(label="Reset to factory", icon="ui-refresh", variant="outline", size="sm", on={press: ede_history(action="reset")})
history_close = Button(label="Close", icon="ui-close", variant="ghost", size="icon", on={press: ede_close_document(name="history")})
history_scroll = ScrollArea(style={flexGrow: 1, minHeight: 0}, children=[history_list, history_row, history_empty])
history_list = List(gap="none", divided=true, children=_template($/history/entries, history_row, key="id"))
history_row = Row(title=$summary, identifier=$short, meta=$at, icon="ui-history", density="compact")
history_empty = EmptyState(icon="ui-history", title="No edits yet", size="list", visible=eq(a=len(value=$/history/entries), b=0))
