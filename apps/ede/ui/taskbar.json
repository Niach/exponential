{
  "$comment": "Exponential Desktop's factory taskbar (#EDE-48): Mint's grouped window list as a 48 px top layer surface along the bottom edge, to the right of the sidebar (the shell opens the sidebar first, so its exclusive zone takes the left edge). Left: one icon-only 40 px button per app (/shell/taskbar/buttons: the pinned apps first, then the running ones), a dot under a running app, a wider one under the focused app, dimmed when every window is minimized; a click does what Mint's does (ede_taskbar: launch, focus, minimize, or the group's previews), the context menu pins, unpins and closes (ede_taskbar_menu), hovering a running app opens its previews as a popup (a hosted Popover: live thumbnails of the group's windows from /previews, a click focuses). Right: the applets (network, sound, Bluetooth, battery: each opens its popup document anchored here, #EDE-43), the tray items, Needs you (#EDE-65: only while something waits on the person across the signed-in accounts' teams, /needsYou/count as its badge; it opens needs-you.json), the bell (notification-center.json: the desktop's notifications and the accounts' unread inbox merged) and the clock.",
  "surface": {
    "layer": "top",
    "anchor": [
      "bottom",
      "left",
      "right"
    ],
    "size": {
      "height": 48
    },
    "exclusiveZone": 48,
    "functions": [
      "ede_taskbar",
      "ede_taskbar_menu",
      "ede_previews",
      "ede_focus",
      "ede_close",
      "ede_tray"
    ]
  },
  "root": {
    "id": "taskbar",
    "component": "Box",
    "style": {
      "display": "flex",
      "flexDirection": "row",
      "alignItems": "center",
      "justifyContent": "space-between",
      "height": 48,
      "paddingLeft": "$spacing.sm",
      "paddingRight": "$spacing.sm",
      "backgroundColor": "$color.background"
    },
    "children": [
      {
        "id": "buttons",
        "component": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "xs",
          "align": "center"
        },
        "template": {
          "component": "group",
          "path": "/shell/taskbar/buttons",
          "key": "app"
        },
        "children": [
          {
            "id": "group",
            "component": "Menu",
            "props": {
              "openOn": "contextmenu",
              "side": "top",
              "align": "start",
              "items": [
                {
                  "label": "Pin to the taskbar",
                  "value": "pin",
                  "icon": "ui-pin"
                },
                {
                  "label": "Unpin from the taskbar",
                  "value": "unpin",
                  "icon": "ui-unpin"
                },
                {
                  "kind": "separator"
                },
                {
                  "label": "Close",
                  "value": "close",
                  "icon": "ui-close"
                }
              ]
            },
            "on": {
              "select": {
                "functionCall": {
                  "@call": "ede_taskbar_menu",
                  "args": {
                    "app": {
                      "@path": "app"
                    },
                    "value": {
                      "@path": "value"
                    }
                  }
                }
              }
            },
            "children": [
              {
                "id": "previews",
                "component": "Popover",
                "props": {
                  "openOn": "hover",
                  "side": "top",
                  "align": "center"
                },
                "on": {
                  "change": {
                    "functionCall": {
                      "@call": "ede_previews",
                      "args": {
                        "app": {
                          "@path": "app"
                        },
                        "open": {
                          "@path": "open"
                        }
                      }
                    }
                  }
                },
                "slots": {
                  "trigger": {
                    "id": "button",
                    "component": "Box",
                    "props": {
                      "pressable": true
                    },
                    "style": {
                      "position": "relative",
                      "display": "flex",
                      "flexDirection": "column",
                      "alignItems": "center",
                      "justifyContent": "center",
                      "width": 40,
                      "height": 40,
                      "borderRadius": "$radius.md"
                    },
                    "on": {
                      "press": {
                        "functionCall": {
                          "@call": "ede_taskbar",
                          "args": {
                            "app": {
                              "@path": "app"
                            }
                          }
                        }
                      }
                    },
                    "children": [
                      {
                        "id": "focus_bg",
                        "component": "Box",
                        "style": {
                          "position": "absolute",
                          "inset": 0,
                          "borderRadius": "$radius.md",
                          "backgroundColor": "$color.accent"
                        },
                        "visible": {
                          "@call": "cond",
                          "args": {
                            "if": {
                              "@path": "focused"
                            },
                            "then": true,
                            "else": false
                          }
                        }
                      },
                      {
                        "id": "button_icon",
                        "component": "Image",
                        "props": {
                          "src": {
                            "@path": "icon"
                          },
                          "alt": {
                            "@path": "name"
                          },
                          "width": 24,
                          "height": 24,
                          "fit": "contain",
                          "fallback": "nav-apps"
                        },
                        "visible": {
                          "@call": "not",
                          "args": {
                            "value": {
                              "@call": "cond",
                              "args": {
                                "if": {
                                  "@path": "minimized"
                                },
                                "then": true,
                                "else": false
                              }
                            }
                          }
                        }
                      },
                      {
                        "id": "button_icon_dim",
                        "component": "Image",
                        "props": {
                          "src": {
                            "@path": "icon"
                          },
                          "alt": {
                            "@path": "name"
                          },
                          "width": 24,
                          "height": 24,
                          "fit": "contain",
                          "fallback": "nav-apps"
                        },
                        "style": {
                          "opacity": 0.5
                        },
                        "visible": {
                          "@call": "cond",
                          "args": {
                            "if": {
                              "@path": "minimized"
                            },
                            "then": true,
                            "else": false
                          }
                        }
                      },
                      {
                        "id": "running_focused",
                        "component": "Box",
                        "style": {
                          "height": 2,
                          "width": 20,
                          "marginTop": 3,
                          "borderRadius": "$radius.full",
                          "backgroundColor": "$color.primary"
                        },
                        "visible": {
                          "@call": "cond",
                          "args": {
                            "if": {
                              "@path": "focused"
                            },
                            "then": true,
                            "else": false
                          }
                        }
                      },
                      {
                        "id": "running",
                        "component": "Box",
                        "style": {
                          "height": 2,
                          "width": 8,
                          "marginTop": 3,
                          "borderRadius": "$radius.full",
                          "backgroundColor": "$color.mutedForeground"
                        },
                        "visible": {
                          "@call": "and",
                          "args": {
                            "values": [
                              {
                                "@call": "cond",
                                "args": {
                                  "if": {
                                    "@path": "running"
                                  },
                                  "then": true,
                                  "else": false
                                }
                              },
                              {
                                "@call": "not",
                                "args": {
                                  "value": {
                                    "@call": "cond",
                                    "args": {
                                      "if": {
                                        "@path": "focused"
                                      },
                                      "then": true,
                                      "else": false
                                    }
                                  }
                                }
                              }
                            ]
                          }
                        }
                      },
                      {
                        "id": "not_running",
                        "component": "Box",
                        "style": {
                          "height": 2,
                          "marginTop": 3
                        },
                        "visible": {
                          "@call": "not",
                          "args": {
                            "value": {
                              "@call": "cond",
                              "args": {
                                "if": {
                                  "@path": "running"
                                },
                                "then": true,
                                "else": false
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                },
                "children": [
                  {
                    "id": "previews_box",
                    "component": "Stack",
                    "props": {
                      "direction": "horizontal",
                      "gap": "sm",
                      "align": "start"
                    },
                    "style": {
                      "padding": "$spacing.sm"
                    },
                    "template": {
                      "component": "preview",
                      "path": "/previews/windows",
                      "key": "id"
                    },
                    "children": [
                      {
                        "id": "preview",
                        "component": "Box",
                        "props": {
                          "pressable": true
                        },
                        "style": {
                          "position": "relative",
                          "display": "flex",
                          "flexDirection": "column",
                          "gap": "$spacing.xs",
                          "padding": "$spacing.xs",
                          "width": 200,
                          "borderRadius": "$radius.md"
                        },
                        "on": {
                          "press": {
                            "functionCall": {
                              "@call": "ede_focus",
                              "args": {
                                "window": {
                                  "@path": "id"
                                }
                              }
                            }
                          }
                        },
                        "children": [
                          {
                            "id": "preview_bg",
                            "component": "Box",
                            "style": {
                              "position": "absolute",
                              "inset": 0,
                              "borderRadius": "$radius.md",
                              "backgroundColor": "$color.accent"
                            },
                            "visible": {
                              "@call": "cond",
                              "args": {
                                "if": {
                                  "@path": "focused"
                                },
                                "then": true,
                                "else": false
                              }
                            }
                          },
                          {
                            "id": "preview_head",
                            "component": "Stack",
                            "props": {
                              "direction": "horizontal",
                              "gap": "xs",
                              "align": "center"
                            },
                            "children": [
                              {
                                "id": "preview_title",
                                "component": "Text",
                                "props": {
                                  "text": {
                                    "@path": "title"
                                  },
                                  "variant": "caption",
                                  "lines": 1
                                },
                                "style": {
                                  "flexGrow": 1,
                                  "minWidth": 0
                                }
                              },
                              {
                                "id": "preview_close",
                                "component": "Button",
                                "props": {
                                  "icon": "ui-close",
                                  "variant": "ghost",
                                  "size": "icon",
                                  "label": "Close"
                                },
                                "on": {
                                  "press": {
                                    "functionCall": {
                                      "@call": "ede_close",
                                      "args": {
                                        "window": {
                                          "@path": "id"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            ]
                          },
                          {
                            "id": "preview_thumb",
                            "component": "Image",
                            "props": {
                              "src": {
                                "@path": "thumbnail"
                              },
                              "alt": {
                                "@path": "title"
                              },
                              "width": 184,
                              "height": 110,
                              "fit": "contain",
                              "fallback": "ede-window"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "right",
        "component": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "xs",
          "align": "center"
        },
        "children": [
          {
            "id": "tray",
            "component": "Stack",
            "props": {
              "direction": "horizontal",
              "gap": "xs",
              "align": "center"
            },
            "template": {
              "component": "tray_item",
              "path": "/tray",
              "key": "service"
            },
            "children": []
          },
          {
            "id": "tray_item",
            "component": "Box",
            "props": {
              "pressable": true
            },
            "style": {
              "display": "flex",
              "alignItems": "center",
              "justifyContent": "center",
              "width": 32,
              "height": 32,
              "borderRadius": "$radius.sm"
            },
            "on": {
              "press": {
                "functionCall": {
                  "@call": "ede_tray",
                  "args": {
                    "service": {
                      "@path": "service"
                    }
                  }
                }
              }
            },
            "children": [
              {
                "id": "tray_icon",
                "component": "Image",
                "props": {
                  "src": {
                    "@path": "icon"
                  },
                  "alt": {
                    "@path": "title"
                  },
                  "width": 18,
                  "height": 18,
                  "fit": "contain",
                  "fallback": "nav-apps"
                }
              }
            ]
          },
          {
            "id": "applet_network",
            "component": "Button",
            "props": {
              "icon": {
                "@path": "/applets/network/icon"
              },
              "variant": "ghost",
              "size": "icon",
              "label": "Network"
            },
            "on": {
              "press": {
                "event": {
                  "name": "applet"
                }
              }
            }
          },
          {
            "id": "applet_sound",
            "component": "Button",
            "props": {
              "icon": {
                "@path": "/applets/sound/icon"
              },
              "variant": "ghost",
              "size": "icon",
              "label": "Sound"
            },
            "on": {
              "press": {
                "event": {
                  "name": "applet"
                }
              }
            }
          },
          {
            "id": "applet_bluetooth",
            "component": "Button",
            "props": {
              "icon": "ede-bluetooth",
              "variant": "ghost",
              "size": "icon",
              "label": "Bluetooth"
            },
            "visible": {
              "@call": "cond",
              "args": {
                "if": {
                  "@path": "/applets/bluetooth/show"
                },
                "then": true,
                "else": false
              }
            },
            "on": {
              "press": {
                "event": {
                  "name": "applet"
                }
              }
            }
          },
          {
            "id": "applet_battery",
            "component": "Button",
            "props": {
              "icon": {
                "@path": "/applets/battery/icon"
              },
              "variant": "ghost",
              "size": "icon",
              "label": "Battery"
            },
            "visible": {
              "@call": "cond",
              "args": {
                "if": {
                  "@path": "/applets/battery/show"
                },
                "then": true,
                "else": false
              }
            },
            "on": {
              "press": {
                "event": {
                  "name": "applet"
                }
              }
            }
          },
          {
            "id": "needs_you",
            "component": "Button",
            "props": {
              "icon": "nav-needs-you",
              "variant": "ghost",
              "size": "icon",
              "label": "Needs you"
            },
            "visible": {
              "@call": "not",
              "args": {
                "value": {
                  "@call": "eq",
                  "args": {
                    "a": {
                      "@path": "/needsYou/count"
                    },
                    "b": 0
                  }
                }
              }
            },
            "on": {
              "press": {
                "event": {
                  "name": "needs_you"
                }
              }
            }
          },
          {
            "id": "needs_you_count",
            "component": "Badge",
            "props": {
              "text": {
                "@path": "/needsYou/count"
              },
              "variant": "default"
            },
            "visible": {
              "@call": "not",
              "args": {
                "value": {
                  "@call": "eq",
                  "args": {
                    "a": {
                      "@path": "/needsYou/count"
                    },
                    "b": 0
                  }
                }
              }
            }
          },
          {
            "id": "bell",
            "component": "Button",
            "props": {
              "icon": "nav-notifications",
              "variant": "ghost",
              "size": "icon",
              "label": "Notifications"
            },
            "on": {
              "press": {
                "event": {
                  "name": "bell"
                }
              }
            }
          },
          {
            "id": "bell_count",
            "component": "Badge",
            "props": {
              "text": {
                "@path": "/notifications/count"
              },
              "variant": "secondary"
            },
            "visible": {
              "@call": "not",
              "args": {
                "value": {
                  "@call": "eq",
                  "args": {
                    "a": {
                      "@path": "/notifications/count"
                    },
                    "b": 0
                  }
                }
              }
            }
          },
          {
            "id": "clock",
            "component": "Button",
            "props": {
              "label": {
                "@path": "/time"
              },
              "variant": "ghost",
              "size": "sm"
            },
            "on": {
              "press": {
                "event": {
                  "name": "clock"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "data": {
    "time": "00:00",
    "tray": [],
    "notifications": {
      "count": 0
    },
    "previews": {
      "app": null,
      "windows": []
    },
    "applets": {
      "network": {
        "icon": "ede-wifi"
      },
      "sound": {
        "icon": "media-volume-up"
      },
      "bluetooth": {
        "show": false
      },
      "battery": {
        "show": false,
        "icon": "ede-battery"
      }
    },
    "shell": {
      "taskbar": {
        "buttons": []
      }
    },
    "needsYou": {
      "count": 0
    }
  }
}
