{
  "name": "@exp/web",
  "private": true,
  "version": "0.20.54",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:capture": "NODE_OPTIONS='--max-http-header-size=131072 --unhandled-rejections=warn' DISABLE_TANSTACK_DEVTOOLS=1 vite dev",
    "start": "node .output/server/index.mjs",
    "build": "vite build && bun run scripts/fix-server-trace.ts",
    "smoke:server": "bun scripts/smoke-server.ts",
    "migrate": "drizzle-kit migrate",
    "migrate:generate": "drizzle-kit generate",
    "migrate:contract": "bun scripts/apply-contract-steps.ts",
    "backfill:default-branches": "bun scripts/backfill-default-branches.ts",
    "check:device-shares": "bun scripts/check-device-shares.ts",
    "audit:device-first-seen": "bun scripts/audit-device-first-seen.ts",
    "seed:screenshots": "bun scripts/seed-screenshots.ts",
    "screenshots:ids": "bun scripts/screenshot-ids.ts",
    "screenshots:prune-devices": "bun scripts/screenshot-prune-devices.ts",
    "screenshots:desktop": "bun scripts/screenshot-desktop.ts",
    "screenshots:social": "bun scripts/capture-social-shots.ts",
    "capture:views": "bun scripts/capture-views.ts",
    "psql": "dotenvx run -- sh -c 'psql \"$DATABASE_URL\"'",
    "serve": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint .",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
