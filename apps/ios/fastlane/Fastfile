# fastlane lanes for the Exponential iOS app (apps/ios), layered on top of Tuist.
#
# Runs locally on a Mac with Xcode + Tuist. No CI Mac runner is required for launch.
#
# The Xcode project/workspace is NOT committed (Tuist-generated), so `build` regenerates
# it first. Non-interactive uploads authenticate with an App Store Connect API key read
# from env (ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH).

require "shellwords"

default_platform(:ios)

# snapshot hardcodes its config-file name to "Snapfile" (Snapshot.snapfile_name,
# consumed by Snapshot::DetectValues) — there is no configuration_path option.
# Make the name overridable so `styleguide_screenshots` can load
# fastlane/Snapfile-styleguide instead. FastlaneCore resolves it against
# ./fastlane/, so a bare basename is all that is needed. Unset = "Snapfile",
# i.e. every other lane is untouched.
require "snapshot"
module ::Snapshot
  class << self
    def snapfile_name
      ENV["SNAPFILE_NAME"] || "Snapfile"
    end
  end
end

# ── EXP-1267: fast, fail-fast, parallel-safe capture lanes ───────────────────
#
# `screenshots` (store) and `styleguide_screenshots` may run AT THE SAME TIME,
# next to the Android lanes. Stock snapshot cannot: it kills Simulator.app and
# shuts down EVERY booted simulator before each run, files every lane's PNGs
# through ONE cache dir (~/Library/Caches/tools.fastlane/screenshots, which its
# collector empties), builds into a fresh temp DerivedData every time, and
# relaunches a failed run up to 20 times when xcodebuild exits non-65. So:
#
# - every lane runs on simulators of its OWN, "<model> exp-<tag>" (created on
#   first use, kept between runs — no erase; the app's DEBUG-only
#   `-uiTestingReset` seam gives each launch a fresh-install state instead,
#   and the suites reuse a cached sign-in, see ExponentialUITests/
#   ScreenshotFlow.swift `ScreenshotSession`). SnapshotHelper strips the
#   " exp-<tag>" suffix, so the PNGs keep their canonical
#   "iPhone 17 Pro Max-<shot>.png" names;
# - only the lane's own simulators are ever shut down, and only when their
#   locale / appearance prefs actually have to change;
# - the store lane keeps fastlane's default cache dir (the pop-rect sidecars
#   live there, `bun run screenshots:pop-sidecars` reads them); the styleguide
#   lane gets ~/Library/Caches/tools.fastlane/exp-<tag>;
# - every lane builds into its own persistent DerivedData,
#   apps/ios/build/shots-dd-<tag> (incremental after the first run);
# - a failed run is retried at most ONCE (Snapfile `number_of_retries(1)`),
#   whatever the exit code.
#
# Env knobs (all optional):
#   SNAPSHOT_LANE_TAG       simulator/DerivedData/cache tag, default "store" /
#                           "styleguide" — set a distinct one per worktree when
#                           two checkouts run the SAME lane at once.
#   SNAPSHOT_DERIVED_DATA   override the lane's DerivedData path.
#   SNAPSHOT_INSTANCE_URL   the backend (see Snapfile).
#
# Concurrent invocation (from apps/ios, each in its own process):
#   LC_ALL=en_US.UTF-8 bundle exec fastlane screenshots
#   LC_ALL=en_US.UTF-8 bundle exec fastlane styleguide_screenshots
# The first run of each lane builds the app (minutes); later runs only build
# what changed.
require "json"
require "fileutils"

module ::ExpSnapshotLanes
  module_function

  def snapshot_root
    File.expand_path("..", __dir__) # apps/ios
  end

  def tag(default)
    raw = ENV["SNAPSHOT_LANE_TAG"].to_s.strip
    raw = default if raw.empty?
    raw.gsub(/[^A-Za-z0-9_-]/, "-")
  end

  def derived_data(tag)
    ENV["SNAPSHOT_DERIVED_DATA"].to_s.strip.empty? ? File.join(snapshot_root, "build", "shots-dd-#{tag}") : File.expand_path(ENV["SNAPSHOT_DERIVED_DATA"])
  end

  # The GRDB "Copy Module Map" phase dies on read-only products left behind
  # by an earlier build; make them writable before every build.
  def unlock_products(derived_data)
    products = File.join(derived_data, "Build", "Products")
    system("chmod", "-R", "u+w", products) if File.directory?(products)
  end

  def simctl_json(*args)
    out = `xcrun simctl list -j #{args.join(' ')}`
    # EXP-644: never parse simctl's JSON in the process locale.
    JSON.parse(out.force_encoding("UTF-8"))
  end

  # The iOS runtime the lane's simulators are created on: the Snapfile's
  # pinned version when it is installed, else the newest iOS runtime.
  def runtime(preferred_version)
    runtimes = simctl_json("runtimes")["runtimes"].select do |r|
      r["isAvailable"] && r["identifier"].to_s.include?("SimRuntime.iOS-")
    end
    UI.user_error!("No iOS simulator runtime installed") if runtimes.empty?
    pinned = runtimes.find { |r| r["version"].to_s.start_with?(preferred_version.to_s) } if preferred_version
    unless pinned
      newest = runtimes.max_by { |r| Gem::Version.new(r["version"]) }
      UI.important("iOS #{preferred_version} runtime not installed, lane simulators use iOS #{newest['version']}") if preferred_version
      return newest
    end
    pinned
  end

  # "<model> exp-<tag>" on `runtime`, created from the model's device type on
  # first use. Returns the simulator NAME (what snapshot's `devices` takes).
  def simulator(model, tag, runtime)
    name = "#{model} exp-#{tag}"
    devices = simctl_json("devices", "available")["devices"][runtime["identifier"]] || []
    return name if devices.any? { |d| d["name"] == name }
    type = simctl_json("devicetypes")["devicetypes"].find { |t| t["name"] == model }
    UI.user_error!("No simulator device type named '#{model}'") unless type
    UI.message("Creating lane simulator '#{name}' (#{runtime['name']})")
    output = `xcrun simctl create #{name.shellescape} #{type['identifier'].shellescape} #{runtime['identifier'].shellescape} 2>&1`
    UI.user_error!("simctl create '#{name}' failed: #{output}") unless $?.success?
    name
  end

  # Point snapshot's cache dir (language/locale/launch-argument files + the
  # PNG drop its collector empties) at `dir` for this process, and tell the
  # UI-test runner (SnapshotHelper `EXP_SNAPSHOT_CACHE_DIR`) the same.
  def with_cache_dir(dir)
    return yield if dir.nil?
    previous = [Snapshot::CACHE_DIR, Snapshot::SCREENSHOTS_DIR]
    set = lambda do |cache, shots|
      Snapshot.send(:remove_const, :CACHE_DIR)
      Snapshot.send(:remove_const, :SCREENSHOTS_DIR)
      Snapshot.const_set(:CACHE_DIR, cache)
      Snapshot.const_set(:SCREENSHOTS_DIR, shots)
    end
    FileUtils.mkdir_p(dir)
    set.call(dir, File.join(dir, "screenshots"))
    ENV["TEST_RUNNER_EXP_SNAPSHOT_CACHE_DIR"] = dir
    yield
  ensure
    if dir
      set.call(*previous)
      ENV.delete("TEST_RUNNER_EXP_SNAPSHOT_CACHE_DIR")
    end
  end

  def plist_value(path, key)
    return nil unless File.exist?(path)
    json = `plutil -extract #{key.shellescape} json -o - #{path.shellescape} 2>/dev/null`
    $?.success? ? JSON.parse(json) : nil
  rescue JSON::ParserError
    nil
  end
end

require "snapshot"
module ::Snapshot
  class SimulatorLauncherBase
    # Stock: `killall Simulator` + `simctl shutdown booted` (EVERY simulator,
    # a parallel lane's included), then rewrite the locale/appearance plists.
    # Here: touch only this lane's devices, and shut one down only when a plist
    # it reads at boot actually has to change.
    def prepare_simulators_for_launch(device_types, language: nil, locale: nil)
      Fixes::SimulatorZoomFix.patch
      Fixes::HardwareKeyboardFix.patch
      Fixes::SharedPasteboardFix.patch

      device_types.each do |type|
        udid = TestCommandGenerator.device_udid(type)
        UI.user_error!("No simulator named '#{type}'") unless udid
        prefs = "#{ENV['HOME']}/Library/Developer/CoreSimulator/Devices/#{udid}/data/Library/Preferences"
        wanted_locale = locale || language.to_s.sub("-", "_")
        stale = launcher_config.erase_simulator
        if launcher_config.localize_simulator
          global = File.join(prefs, ".GlobalPreferences.plist")
          stale ||= ExpSnapshotLanes.plist_value(global, "AppleLocale") != wanted_locale ||
                    Array(ExpSnapshotLanes.plist_value(global, "AppleLanguages")).first != language
        end
        unless launcher_config.dark_mode.nil?
          style = File.join(prefs, "com.apple.uikitservices.userInterfaceStyleMode.plist")
          stale ||= ExpSnapshotLanes.plist_value(style, "UserInterfaceStyleMode") != (launcher_config.dark_mode ? 2 : 1)
        end
        if stale
          UI.message("Shutting down #{type} to apply its locale/appearance")
          Helper.backticks("xcrun simctl shutdown #{udid} 2>/dev/null", print: FastlaneCore::Globals.verbose?)
          erase_simulator(type) if launcher_config.erase_simulator
          localize_simulator(type, language, locale) if launcher_config.localize_simulator
          interface_style(type, launcher_config.dark_mode) unless launcher_config.dark_mode.nil?
        end
        uninstall_app(type) if launcher_config.reinstall_app && !launcher_config.erase_simulator
        disable_slide_to_type(type) if launcher_config.disable_slide_to_type
      end

      unless launcher_config.headless
        simulator_path = File.join(Helper.xcode_path, "Applications", "Simulator.app")
        Helper.backticks("open -a #{simulator_path} -g", print: FastlaneCore::Globals.verbose?)
      end
    end
  end

  # Stock relaunches a run whose xcodebuild exited non-65 up to 20 times
  # ("simulator failure") before `number_of_retries` even applies. Spend that
  # budget up front: every failure goes straight to the Snapfile's retries.
  module ExpFailFast
    def take_screenshots_simultaneously
      self.current_number_of_retries_due_to_failing_simulator = 19
      super
    end
  end
  SimulatorLauncher.prepend(ExpFailFast)
end

WORKSPACE = "Exponential.xcworkspace".freeze
SCHEME = "Exponential".freeze # production target (bundle id at.exponential)
IPA_PATH = "build/Exponential.ipa".freeze

# Staging target — internal TestFlight only, co-installs under a distinct bundle id.
STAGING_SCHEME = "Exponential-Staging".freeze
STAGING_BUNDLE_ID = "at.exponential.staging".freeze
STAGING_IPA_PATH = "build/Exponential-Staging.ipa".freeze

# The capture lanes' device MODELS (each lane runs on its own "<model>
# exp-<tag>" clone, see ExpSnapshotLanes). The Snapfiles list the same models
# for a bare `fastlane snapshot`.
STORE_DEVICES = ["iPhone 17 Pro Max", "iPad Pro 13-inch (M5)"].freeze
STYLEGUIDE_DEVICES = ["iPhone 17 Pro Max"].freeze

# EXP-642: `fastlane screenshots shots:01_board,02_issue-detail` narrows a
# capture run to those shot ids — what the "Refresh app screenshots" automation
# uses when a diff only touched a couple of views. xcodebuild forwards ONLY
# TEST_RUNNER_-prefixed variables into the UI-test runner process (with the
# prefix stripped), so the suites read it as EXP_SHOTS. Navigation always runs;
# only the capture is skipped, so a subset run is narrower, not faster.
def apply_shot_subset(options)
  ids = options[:shots].to_s.split(/[,\s]+/).reject(&:empty?)
  return if ids.empty?
  UI.message("EXP_SHOTS: capturing only #{ids.join(', ')}")
  ENV["TEST_RUNNER_EXP_SHOTS"] = ids.join(",")
end

# EXP-627: merge the per-shot pop-out rect sidecars the UI test wrote
# (`<simulator>-pop-<shot>.json`, see ExponentialUITests/PopRects.swift) into the
# form-keyed `pop-<shot>.json` the store compositor reads. Best effort: a
# missing script or a bun-less machine must never fail a capture run — the
# compositor falls back to its hand-tuned crops.
def merge_pop_sidecars(platform)
  # `sh` runs from the fastlane/ dir; the repo root is three levels up.
  root = File.expand_path("../../..", __dir__)
  sh("cd #{root.shellescape} && bun run screenshots:pop-sidecars -- --platform #{platform}")
rescue StandardError => e
  UI.important("Pop-rect sidecar merge skipped: #{e.message}")
end

def asc_api_key
  # App Store Connect API key (Users & Access → Integrations → App Store Connect API).
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
  )
end

# The demo-account password is NOT in git (public repo). deliver only touches
# review fields whose file exists, so absent file = ASC keeps its stored value;
# export ASC_REVIEW_DEMO_PASSWORD to (re)write it as part of a metadata push.
def materialize_review_demo_password
  password = ENV["ASC_REVIEW_DEMO_PASSWORD"]
  return unless password && !password.empty?
  File.write("metadata/review_information/demo_password.txt", password)
end

platform :ios do
  desc "Regenerate the Tuist project and build a signed App Store archive (.ipa)."
  lane :build do
    # On CI (build-ios.yml) the cloud-managed signing cert must land in an
    # unlocked temp keychain — without this the upload fails with altool's
    # "Invalid Signature. Code failed to satisfy specified code requirement(s)".
    setup_ci if ENV["CI"]
    # `sh` runs from the fastlane/ dir, so step up to apps/ios to regenerate the project.
    sh("cd .. && tuist generate --no-open")

    # Hand the ASC API key to xcodebuild so automatic signing can mint the
    # cloud-managed Distribution certificate + App Store profiles headlessly
    # (first run on a fresh Mac has neither).
    auth_xcargs = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{File.expand_path(ENV.fetch('ASC_KEY_PATH'))}",
      "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
    ].join(" ")

    gym(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "Exponential.ipa",
      xcargs: auth_xcargs, # gym forwards these to -exportArchive too
    )
  end

  desc "Regenerate the Tuist project and capture App Store screenshots (snapshot)."
  desc "Needs the seeded local backend (apps/web `bun run seed:screenshots`) at"
  desc "http://localhost:5173 — override with SNAPSHOT_INSTANCE_URL, but it MUST match"
  desc "the server's BETTER_AUTH_URL: better-auth rejects any other origin and the run"
  desc "then dies 120s later on the misleading \"Issue list never synced\"."
  desc "It ALSO needs live steering: 04_steering fails with \"The relay never"
  desc "replayed the transcript\" without `docker compose --profile steer up -d`"
  desc "(repo root) AND `cd apps/web && bun run screenshots:desktop` LEFT RUNNING"
  desc "for the whole capture — it is a live stand-in desktop, not a one-shot"
  desc "seeder. Check with `curl localhost:4002/healthz`: one device, one room."
  desc "Captures land RAW in fastlane/screenshots-raw/; follow up with"
  desc "`bun run screenshots:store` (repo root) to composite them into"
  desc "fastlane/screenshots/ before sync_store — EXP-580."
  desc "`shots:01_board,02_issue-detail` narrows the run to those shot ids (EXP-642)."
  lane :screenshots do |options|
    sh("cd .. && tuist generate --no-open")
    # The sign-in flow types into text fields — make sure the simulators show
    # the software keyboard instead of assuming a connected hardware keyboard.
    sh("defaults write com.apple.iphonesimulator ConnectHardwareKeyboard -bool false || true")
    apply_shot_subset(options)
    tag = ExpSnapshotLanes.tag("store")
    runtime = ExpSnapshotLanes.runtime("26.5")
    derived_data = ExpSnapshotLanes.derived_data(tag)
    ExpSnapshotLanes.unlock_products(derived_data)
    begin
      # The store lane keeps fastlane's default cache dir: PopRects.swift
      # writes the pop-out sidecars beside it, where screenshots:pop-sidecars
      # reads them.
      snapshot(
        devices: STORE_DEVICES.map { |model| ExpSnapshotLanes.simulator(model, tag, runtime) },
        derived_data_path: derived_data,
      )
    ensure
      ENV.delete("TEST_RUNNER_EXP_SHOTS")
    end
    merge_pop_sidecars("ios")
  end

  desc "Regenerate the Tuist project and capture the STYLEGUIDE screenshots (EXP-566):"
  desc "the 29 cross-platform `sg_*` surface shots from"
  desc "ExponentialUITests/StyleguideScreenshots.swift, iPhone only, into"
  desc "fastlane/screenshots-styleguide/. Same seeded backend as `screenshots` and no"
  desc "steer TRAFFIC, but it DOES need `cd apps/web && bun run screenshots:desktop`"
  desc "since EXP-642:"
  desc "sg_machine-settings and the three sg_chat* shots photograph the demo"
  desc "user's own registered device row. Never uploaded to ASC."
  desc "`shots:sg_reviews,sg_search` narrows the run to those shot ids (EXP-642)."
  lane :styleguide_screenshots do |options|
    sh("cd .. && tuist generate --no-open")
    # The sign-in flow types into text fields — make sure the simulators show
    # the software keyboard instead of assuming a connected hardware keyboard.
    sh("defaults write com.apple.iphonesimulator ConnectHardwareKeyboard -bool false || true")
    apply_shot_subset(options)
    # Load fastlane/Snapfile-styleguide instead of fastlane/Snapfile (see the
    # Snapshot.snapfile_name override at the top of this file).
    ENV["SNAPFILE_NAME"] = "Snapfile-styleguide"
    tag = ExpSnapshotLanes.tag("styleguide")
    runtime = ExpSnapshotLanes.runtime("26.5")
    derived_data = ExpSnapshotLanes.derived_data(tag)
    ExpSnapshotLanes.unlock_products(derived_data)
    begin
      # The three settings that differ from the store lane are ALSO passed
      # explicitly: values given to the action win over the config file, so the
      # run stays correct even if the Snapfile selection above ever regresses
      # and the store Snapfile gets loaded instead.
      ExpSnapshotLanes.with_cache_dir(File.expand_path("~/Library/Caches/tools.fastlane/exp-#{tag}")) do
        snapshot(
          devices: STYLEGUIDE_DEVICES.map { |model| ExpSnapshotLanes.simulator(model, tag, runtime) },
          output_directory: "fastlane/screenshots-styleguide",
          only_testing: ["ExponentialUITests/StyleguideScreenshots"],
          derived_data_path: derived_data,
        )
      end
    ensure
      ENV.delete("SNAPFILE_NAME")
      ENV.delete("TEST_RUNNER_EXP_SHOTS")
    end
  end

  desc "Build + upload to TestFlight (pilot). Internal-only by default (fast: skips the"
  desc "processing wait). `fastlane beta external:true` also distributes to the external"
  desc "group (TESTFLIGHT_EXTERNAL_GROUP, default 'External Testers') — this waits for"
  desc "build processing, attaches the What-to-Test changelog (TESTFLIGHT_CHANGELOG env,"
  desc "falling back to metadata/en-US/release_notes.txt), and auto-submits the build for"
  desc "Beta App Review. The external group + TestFlight Test Information must already"
  desc "exist in App Store Connect (create the group under External Testing, and fill the"
  desc "TestFlight Test Information incl. the Beta App Review contact + demo account)."
  lane :beta do |options|
    build
    pilot_args = {
      api_key: asc_api_key,
      ipa: IPA_PATH,
    }
    if options[:external]
      pilot_args.merge!(
        distribute_external: true,
        groups: [ENV.fetch("TESTFLIGHT_EXTERNAL_GROUP", "External Testers")],
        # Apple requires a What-to-Test changelog on externally distributed builds.
        # Lanes run with fastlane/ as the working directory, so the metadata
        # path is NOT prefixed with fastlane/.
        changelog: ENV["TESTFLIGHT_CHANGELOG"] ||
          File.read("metadata/en-US/release_notes.txt").strip,
        # No skip_waiting_for_build_processing here: pilot can only assign the
        # external group (and submit for Beta App Review) once processing finishes.
      )
    else
      pilot_args.merge!(
        skip_waiting_for_build_processing: true,
        distribute_external: false,
      )
    end
    pilot(**pilot_args)
  end

  desc "Build the Exponential-Staging scheme (bundle id at.exponential.staging) as a signed"
  desc "App Store archive. Mirrors `build` but for the staging app / TestFlight internal."
  lane :build_staging do
    sh("cd .. && tuist generate --no-open")
    auth_xcargs = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{File.expand_path(ENV.fetch('ASC_KEY_PATH'))}",
      "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
    ].join(" ")
    gym(
      workspace: WORKSPACE,
      scheme: STAGING_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "Exponential-Staging.ipa",
      xcargs: auth_xcargs,
    )
  end

  desc "Build + upload the staging app to TestFlight INTERNAL testing (no external group, no"
  desc "Beta App Review). Requires the ASC record for at.exponential.staging to exist first"
  desc "(scripts/create-staging-app.sh) plus the ASC_* env. Internal testers install it via"
  desc "TestFlight alongside production (distinct bundle id)."
  lane :beta_staging do
    build_staging
    pilot(
      api_key: asc_api_key,
      ipa: STAGING_IPA_PATH,
      app_identifier: STAGING_BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end

  desc "Distribute the LATEST already-uploaded build to External Testers + Beta App"
  desc "Review WITHOUT rebuilding — use when `beta` already uploaded the build (a build"
  desc "number can only be uploaded once, so re-running `beta external:true` would be"
  desc "rejected as a duplicate)."
  lane :beta_external do
    args = {
      api_key: asc_api_key,
      app_identifier: "at.exponential",
      # distribute_only has no ipa to infer the platform from, so pilot would
      # prompt for it (and crash in non-interactive mode) — pin it.
      app_platform: "ios",
      distribute_only: true,
      distribute_external: true,
      groups: [ENV.fetch("TESTFLIGHT_EXTERNAL_GROUP", "External Testers")],
      changelog: ENV["TESTFLIGHT_CHANGELOG"] ||
        File.read("metadata/en-US/release_notes.txt").strip,
    }
    # "Latest build" resolves to the PREVIOUS build while the fresh upload is
    # still processing — pin the target via env to distribute the right one.
    args[:app_version] = ENV["TESTFLIGHT_APP_VERSION"] if ENV["TESTFLIGHT_APP_VERSION"]
    args[:build_number] = ENV["TESTFLIGHT_BUILD_NUMBER"] if ENV["TESTFLIGHT_BUILD_NUMBER"]
    pilot(**args)
  end

  desc "Upload listing metadata + screenshots to App Store Connect WITHOUT building."
  desc "Metadata lives in fastlane/metadata/, screenshots in fastlane/screenshots/."
  desc "VERIFY THE PER-SET COUNT AFTERWARDS (EXP-821): deliver's verification pass can"
  desc "race Apple's processing, decide shots are missing and re-upload them, leaving"
  desc "duplicates in the set. overwrite_screenshots does not prevent it — the retry"
  desc "runs after the delete — so its \"Successfully uploaded all screenshots\" line"
  desc "is not proof. Delete duplicates via the API before submitting."
  lane :sync_store do
    materialize_review_demo_password
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true, # skip the interactive HTML preview
      run_precheck_before_submit: false,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Upload listing metadata ONLY (no binary, no screenshots). Use when copy changes"
  desc "between releases — `sync_store` would also push fastlane/screenshots/, which is"
  desc "wrong whenever those are known-stale."
  lane :sync_metadata do
    materialize_review_demo_password
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true, # skip the interactive HTML preview
      run_precheck_before_submit: false,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Build + upload to App Store Connect (deliver). Does NOT auto-submit for review."
  lane :release do
    build
    materialize_review_demo_password
    deliver(
      api_key: asc_api_key,
      ipa: IPA_PATH,
      submit_for_review: false,
      force: true, # skip the interactive HTML preview
      skip_screenshots: true,
      skip_metadata: false,
      precheck_include_in_app_purchases: false,
    )
  end
end

# ── Signing bootstrap (match) — COMMENTED until account setup (masterplan §13) ──────
#
# Signing is intentionally NOT wired here yet. At Apple-account setup we decide between:
#
#   (a) match — Distribution cert + App Store profiles stored in a private git repo,
#       shared across machines/CI. Seed once with `bundle exec fastlane match appstore`,
#       then add this to `build` BEFORE the gym call:
#
#         match(
#           type: "appstore",
#           app_identifier: "at.exponential",
#           git_url: ENV.fetch("MATCH_GIT_URL"),
#           readonly: true,
#         )
