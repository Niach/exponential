# fastlane snapshot config — automated App Store screenshots.
#
# Run via `bundle exec fastlane screenshots` from apps/ios (regenerates the Tuist
# project first). Requires the seeded local backend at http://localhost:5173
# (apps/web `bun run seed:screenshots`); override the target instance with the
# SNAPSHOT_INSTANCE_URL env var (read by ExponentialUITests/StoreScreenshots.swift).
# Whatever you point it at, the URL must be the one the server's BETTER_AUTH_URL
# names — better-auth rejects any other origin ("Invalid origin: …" in the dev
# server log): the suite's HTTP sign-in fails (logged as "EXP-1267 session:
# could not sign … in over HTTP"), the login-UI fallback fails the same way, and
# the run dies on "Tab bar never appeared" / "Issue list never synced" (EXP-821). In particular http://127.0.0.1:5173 is NOT a synonym for
# http://localhost:5173 here.
#
# It ALSO requires live steering to be genuinely on — three of the eight shots
# need it, and without it the issue detail reads "Live steering is unavailable on
# this instance" (EXP-393), or 04_steering fails with "The relay never replayed
# the transcript". Bring up the relay (`docker compose --profile steer up -d` at
# the repo root), export STEER_RELAY_URL=ws://localhost:4002 plus the matching
# STEER_RELAY_SECRET for the web server, and leave `cd apps/web && bun run
# screenshots:desktop` running for the whole capture — it is a live stand-in
# desktop, not a one-shot seeder.
#
# STEER_RELAY_SECRET has to be in the RELAY's own environment too: a filtered
# `bun --filter @exp/steer-relay start` does not inject the repo-root .env, and
# without the secret the relay boots but answers 503 everywhere except /healthz.
# `curl localhost:4002/healthz` should report one device and one room once the
# stub is up.
#
# PARALLEL (EXP-1267): this lane, `fastlane styleguide_screenshots` and the
# Android lanes can run at the same time — each iOS lane on its own simulators,
# DerivedData and snapshot cache dir. From apps/ios, one process each:
#   LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 bundle exec fastlane screenshots
#   LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 bundle exec fastlane styleguide_screenshots
# Only one store lane per machine at a time: its pop-rect sidecars live in
# fastlane's default cache dir (see the Fastfile header for SNAPSHOT_LANE_TAG).
#
# Captures land RAW in fastlane/screenshots-raw/. Afterwards run
# `bun run screenshots:store` from the repo root BEFORE `sync_store`: the
# compositor renders the finished store slides (headline + bezel panels,
# EXP-580) from those raw captures into fastlane/screenshots/, which is what
# deliver uploads.

# xcodebuild only forwards TEST_RUNNER_-prefixed env vars into the UI-test
# runner process (prefix stripped) — a bare SNAPSHOT_INSTANCE_URL on the
# fastlane invocation never reaches ProcessInfo in the test (EXP-348: the
# test silently fell back to localhost:5173). Bridge it here so the
# documented variable works.
if ENV["SNAPSHOT_INSTANCE_URL"] && !ENV["TEST_RUNNER_SNAPSHOT_INSTANCE_URL"]
  ENV["TEST_RUNNER_SNAPSHOT_INSTANCE_URL"] = ENV["SNAPSHOT_INSTANCE_URL"]
end

# One 6.9" iPhone + one 13" iPad — the two required App Store screenshot slots.
# Names must match simulators from `xcrun simctl list devices available`.
# EXP-1267: these are the MODELS. `fastlane screenshots` / `fastlane
# styleguide_screenshots` run them on lane-owned clones ("<model> exp-<tag>",
# see the Fastfile's ExpSnapshotLanes), so the lanes never share a simulator;
# a bare `fastlane snapshot` uses the plain simulators named here.
devices([
  "iPhone 17 Pro Max",
  "iPad Pro 13-inch (M5)",
])

# Both devices exist twice (release + Xcode-beta runtimes); pin the release
# runtime — the beta runtime's XCTest flags internally-caught errors as
# failures and its status bar/chrome may drift.
ios_version("26.5")

languages(["en-US"])

# Set the SYSTEM language/locale too, not just the app's — the iPad status
# bar renders the date in the simulator locale (it showed "Mittwoch 8. Juli"
# on a German-locale host).
localize_simulator(true)

workspace("Exponential.xcworkspace")
scheme("Exponential")

# The scheme's test action holds BOTH capture suites; the store lane must run
# only its own, or every run would also drive the 11 styleguide shots.
only_testing(["ExponentialUITests/StoreScreenshots"])

# Relative to apps/ios (fastlane's working dir) → apps/ios/fastlane/screenshots-raw.
# RAW captures only: `bun run screenshots:store` composites them into
# fastlane/screenshots/, which is the directory deliver uploads.
output_directory("fastlane/screenshots-raw")
clear_previous_screenshots(true)

# Clean 9:41 status bar in every shot.
override_status_bar(true)

# The flow signs into a live backend and waits on Electric sync — run this
# lane's devices one at a time. EXP-1267: fail fast — every wait in the suite
# is bounded to seconds (ScreenshotFlow.swift `Wait`), and a failed run is
# retried ONCE (the Fastfile also stops snapshot's own up-to-20 relaunches on
# non-65 exits). The OTHER lanes may run concurrently (see the Fastfile).
concurrent_simulators(false)
number_of_retries(1)
# A failed attempt otherwise stalls up to 10 minutes in `simctl diagnose`
# (the sysdiagnose xcodebuild collects on failure) before the retry starts.
xcargs("-collect-test-diagnostics never")

# EXP-1267: never erase (it cost a reboot + a UI sign-in per run). Every launch
# passes the app's DEBUG-only `-uiTestingReset` (fresh-install state: no
# keychain account, cleared defaults, per-user caches kept) and signs in with a
# session the suite reuses across runs, re-validated before each launch and
# re-minted after a reseed; the login UI is only the fallback. See
# ExponentialUITests/ScreenshotFlow.swift `ScreenshotSession`.
erase_simulator(false)

# The Simulator.app window is not needed (and stock snapshot would kill it).
headless(true)

# The app forces dark mode; keep the simulator chrome consistent with it.
dark_mode(true)

stop_after_first_error(true)
skip_open_summary(true)
