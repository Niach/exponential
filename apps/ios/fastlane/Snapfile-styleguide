# fastlane snapshot config — STYLEGUIDE screenshots (EXP-566).
#
# Run via `bundle exec fastlane styleguide_screenshots` from apps/ios. The lane
# points snapshot at this file instead of ./Snapfile (see the Fastfile) and
# additionally pins the three settings that differ, so the run is correct even
# if that selection ever stops working.
#
# Captures the 29 `sg_*` shots from ExponentialUITests/StyleguideScreenshots.swift
# (`sg_sign-in` … `sg_onboarding-devices`) — the cross-platform surface set a
# design review compares against the web, desktop and Android captures of the
# same screens. The names are a contract; see the doc comment on that suite.
#
# Requires the seeded local backend at http://localhost:5173 (apps/web
# `bun run seed:screenshots`); override with SNAPSHOT_INSTANCE_URL, which must
# match the server's BETTER_AUTH_URL (see ./Snapfile). Unlike the store lane it
# needs no steer TRAFFIC, but since EXP-642 it does need the relay stub running
# — `cd apps/web && bun run screenshots:desktop` registers the demo user's OWN
# device row, which is what sg_machine-settings (gated `isMine && registered`)
# and the three sg_chat* shots photograph.
#
# `bundle exec fastlane styleguide_screenshots shots:sg_reviews,sg_search`
# narrows a run to those ids (EXP-642); the navigation still runs in full.
#
# PARALLEL (EXP-1267): safe beside `fastlane screenshots` and the Android lanes
# — its own simulator ("iPhone 17 Pro Max exp-styleguide"), DerivedData
# (apps/ios/build/shots-dd-styleguide) and snapshot cache dir
# (~/Library/Caches/tools.fastlane/exp-styleguide). See the Fastfile header.

# xcodebuild only forwards TEST_RUNNER_-prefixed env vars into the UI-test
# runner process (prefix stripped) — a bare SNAPSHOT_INSTANCE_URL on the
# fastlane invocation never reaches ProcessInfo in the test (EXP-348). Bridge
# it here so the documented variable works, exactly as ./Snapfile does.
if ENV["SNAPSHOT_INSTANCE_URL"] && !ENV["TEST_RUNNER_SNAPSHOT_INSTANCE_URL"]
  ENV["TEST_RUNNER_SNAPSHOT_INSTANCE_URL"] = ENV["SNAPSHOT_INSTANCE_URL"]
end

# One phone only — the styleguide compares SURFACES across clients, not across
# form factors, and the iPad pass would double an already slow run for nothing.
# Name must match a simulator from `xcrun simctl list devices available`.
# EXP-1267: these are the MODELS. `fastlane screenshots` / `fastlane
# styleguide_screenshots` run them on lane-owned clones ("<model> exp-<tag>",
# see the Fastfile's ExpSnapshotLanes), so the lanes never share a simulator;
# a bare `fastlane snapshot` uses the plain simulators named here.
devices([
  "iPhone 17 Pro Max",
])

# The device exists twice (release + Xcode-beta runtimes); pin the release
# runtime — the beta runtime's XCTest flags internally-caught errors as
# failures and its status bar/chrome may drift.
ios_version("26.5")

languages(["en-US"])

# Set the SYSTEM language/locale too, not just the app's.
localize_simulator(true)

workspace("Exponential.xcworkspace")
scheme("Exponential")

# The scheme's test action holds both capture suites — run ONLY this one.
only_testing(["ExponentialUITests/StyleguideScreenshots"])

# Relative to apps/ios (fastlane's working dir) → apps/ios/fastlane/screenshots-styleguide.
output_directory("fastlane/screenshots-styleguide")
clear_previous_screenshots(true)

# Clean 9:41 status bar in every shot.
override_status_bar(true)

# The flow signs into a live backend and waits on Electric sync — run this
# lane's devices one at a time. EXP-1267: fail fast — every wait in the suite
# is bounded to seconds (ScreenshotFlow.swift `Wait`), and a failed run is
# retried ONCE (the Fastfile also stops snapshot's own up-to-20 relaunches on
# non-65 exits). The OTHER lanes may run concurrently (see the Fastfile).
concurrent_simulators(false)
number_of_retries(1)
# A failed attempt otherwise stalls up to 10 minutes in `simctl diagnose`
# (the sysdiagnose xcodebuild collects on failure) before the retry starts.
xcargs("-collect-test-diagnostics never")

# EXP-1267: never erase. sg_sign-in launches with the app's DEBUG-only
# `-uiTestingReset` and NO session (the untouched server chooser), every other
# launch resets the same way and injects a reused session (demo, then the
# newcomer and the starter for the wizard shots), so nothing leaks between
# runs. The login UI is only the fallback. See ExponentialUITests/
# ScreenshotFlow.swift `ScreenshotSession`.
erase_simulator(false)

# The Simulator.app window is not needed (and stock snapshot would kill it).
headless(true)

# The app forces dark mode; keep the simulator chrome consistent with it.
dark_mode(true)

stop_after_first_error(true)
skip_open_summary(true)
