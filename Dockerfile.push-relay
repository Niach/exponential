FROM oven/bun:1 AS builder
WORKDIR /app

# Copy workspace manifests needed for bun install
COPY package.json bun.lock bunfig.toml ./
COPY apps/push-relay/package.json apps/push-relay/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json
# Stub out other workspace package.json files so bun install resolves correctly
COPY apps/web/package.json apps/web/package.json
COPY apps/marketing/package.json apps/marketing/package.json
COPY packages/db-schema/package.json packages/db-schema/package.json
COPY packages/design-tokens/package.json packages/design-tokens/package.json
COPY packages/domain-contract/package.json packages/domain-contract/package.json
COPY packages/electric-protocol/package.json packages/electric-protocol/package.json
COPY packages/emoji/package.json packages/emoji/package.json
COPY packages/icons/package.json packages/icons/package.json
COPY packages/licenses/package.json packages/licenses/package.json
COPY packages/steer-ticket/package.json packages/steer-ticket/package.json
COPY apps/steer-relay/package.json apps/steer-relay/package.json
COPY packages/widget/package.json packages/widget/package.json

# REV-2: scoped to @exp/push-relay on purpose, same reason as the root
# Dockerfile's EXP-380 filter. Unfiltered, the runtime stage's wholesale
# node_modules copy carried apps/marketing's Remotion — source-available,
# licensed to US on our headcount, no sublicence clause (see
# docs/third-party-licences.md). This image is Coolify-internal rather than
# published, so that was latent rather than live; the filter keeps it that way.
# The stub package.json COPYs above must stay even so — --frozen-lockfile
# validates the full workspace set and fails if one is absent.
RUN bun install --frozen-lockfile --filter '@exp/push-relay'

COPY packages/tsconfig packages/tsconfig
COPY apps/push-relay apps/push-relay

FROM oven/bun:1
WORKDIR /app

COPY --from=builder /app/node_modules node_modules
COPY --from=builder /app/apps/push-relay apps/push-relay
COPY --from=builder /app/packages/tsconfig packages/tsconfig
COPY --from=builder /app/package.json .
COPY --from=builder /app/bunfig.toml .
# EXP-376: Apache-2.0 4(a)/4(d). This image is not published today, but it is
# built from the same Apache-2.0 work as the relay we do publish — carrying the
# files costs nothing and means going public is a workflow change, not a licence
# question.
COPY LICENSE NOTICE ./

EXPOSE 4001

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD bun -e "fetch('http://localhost:4001/healthz').then(r=>process.exit(r.ok?0:1))"

CMD ["bun", "apps/push-relay/src/index.ts"]
