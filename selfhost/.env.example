# Exponential self-host — pair with selfhost/docker-compose.yaml.
# Runbook: https://github.com/Niach/exponential/blob/master/INSTALL.md
# Full variable reference (optional subsystems: email, GitHub App, OIDC, ...):
# https://github.com/Niach/exponential/blob/master/.env.example
# Everything in this file reaches the web container (env_file), so optional
# vars can simply be appended here.

# ── Required: generate each once, keep forever ──────────────────────────────
# openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -hex 32
BETTER_AUTH_SECRET=

# ── Required: S3-compatible attachment storage (bring your own) ─────────────
# Any S3-compatible provider works — Hetzner Object Storage, MinIO,
# Cloudflare R2, AWS S3, Garage, ... The app uses path-style addressing
# (forcePathStyle), streams all attachment traffic server-side (the endpoint
# never needs to be reachable by browsers), and creates the bucket at first
# use when the key has create permission — otherwise create it up front.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=exponential-attachments
S3_REGION=

# ── Domain (defaults serve plain HTTP on http://localhost) ──────────────────
# For a real domain with automatic HTTPS, set BOTH together — DOMAIN is what
# Caddy serves (and gets certificates for), APP_URL is the exact origin the
# app runs auth against. Mismatched values break sign-in.
# DOMAIN=issues.example.com
# APP_URL=https://issues.example.com

# ── Optional ─────────────────────────────────────────────────────────────────
# Pin the image to a release instead of `latest` (which moves on every
# upstream master push): https://github.com/Niach/exponential/tags
# IMAGE_TAG=latest
# Set to false once your accounts exist to close public password sign-up.
# AUTH_SIGNUP_ENABLED=true
# Remote start + live steer (docker compose --profile steer up -d). The same
# two values configure the relay container and the web app. Caddy serves the
# relay under /steer on your app domain, so it shares the site's TLS
# certificate — with DOMAIN set, always use wss:// (the socket carries bearer
# steer tickets and the live terminal stream of your coding sessions; plain
# ws:// is cleartext and only acceptable on a trusted LAN with the default
# no-domain plain-HTTP setup, e.g. ws://your-host/steer).
# STEER_RELAY_URL=wss://issues.example.com/steer
# STEER_RELAY_SECRET=
# The web app's OWN relay calls go to the relay container directly (the
# compose file defaults this to http://steer-relay:4002) instead of out
# through public DNS and back in — needed on routers without hairpin NAT.
# Only override it if you run the relay somewhere else in-network.
# STEER_RELAY_INTERNAL_URL=http://steer-relay:4002
# Optional GitHub personal access token, used ONLY for PUBLIC-repo reads (PR
# diffs, the Reviews queue) on repos your GitHub App is not installed on — it
# raises GitHub's anonymous 60 requests/hour per IP to 5000. No scopes needed.
# GITHUB_TOKEN=

# ── Recommended: minimum client versions ───────────────────────────────────
# Native clients (Android, iOS, desktop, and the headless `exponential` CLI)
# send `x-client-version: <platform>/<version>` on every request; when a
# platform's MIN var is set and a client compares below it, tRPC + shape
# requests answer HTTP 426 and the app shows its blocking update screen.
# Unset = gate off, and an old client then talks to a server that no longer
# speaks its dialect. SET THESE, and raise them at every upgrade to the
# versions the release notes name.
# Values are ALWAYS the marketing version (Android versionName, iOS
# CFBundleShortVersionString, desktop/CLI tag version), NEVER an Android
# versionCode or iOS build number: `40` is a numerically valid value that
# would instantly 426 every client.
# LATEST is informational only (GET /api/version + the 426 body) — it blocks
# nothing, it just tells a gated client which version to update to.
CLIENT_MIN_VERSION_ANDROID=0.14.26
CLIENT_MIN_VERSION_IOS=0.14.24
CLIENT_MIN_VERSION_DESKTOP=0.14.31
CLIENT_MIN_VERSION_CLI=0.14.31
CLIENT_LATEST_VERSION_ANDROID=0.14.26
CLIENT_LATEST_VERSION_IOS=0.14.24
CLIENT_LATEST_VERSION_DESKTOP=0.14.31
CLIENT_LATEST_VERSION_CLI=0.14.31
