# The Mint's CI runners run in this slice (compose.yaml `cgroup_parent`), a
# sibling of user.slice: CPUWeight=idle makes their work SCHED_IDLE against
# the desktop session (no dash in the name: systemd reads `a-b.slice` as b
# INSIDE a.slice, where idle only ranks it against a.slice's own children), so a game or a browser always wins a core and CI takes
# only what nobody else wants (.github/runners/README.md). Install once:
#   sudo cp expci.slice /etc/systemd/system/ && sudo systemctl daemon-reload
[Unit]
Description=Exponential CI runners (idle CPU priority)
Before=slices.target

[Slice]
CPUWeight=idle
IOWeight=10
