# ~/.config/systemd/user/expbg.slice (install-desktop-first.sh)
# Every background thing in Danny's user manager: agent runs (run-*.scope,
# moved here by run-scope-background.conf), their lane builds, emulators and
# gradle daemons, and the mint-ci daemon (ci-daemon-background.conf). A sibling
# of app.slice (games, the browser) and session.slice (pipewire), so idle CPU
# ranks it below them, and one memory budget caps all of it: one agent run with
# gradle + an emulator held 23 GB on 2026-11-13. Expci.slice (root, 20 GB) +
# this (20 GB) leave the desktop and a game >= 22 of the 62 GB.
[Unit]
Description=Exponential background work (agent runs, builds, mint-ci): idle CPU, capped memory
Before=slices.target

[Slice]
CPUWeight=idle
IOWeight=10
MemoryHigh=16G
MemoryMax=20G
ManagedOOMMemoryPressure=kill
ManagedOOMMemoryPressureLimit=80%
