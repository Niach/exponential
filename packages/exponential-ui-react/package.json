{
  "name": "@exponential-at/ui-react",
  "version": "0.1.0",
  "private": true,
  "description": "Exponential UI for React: the reference renderer of the core A2UI catalog on Radix with real CSS, runtime themes, extensions, and the shadcn primitive set the Exponential app shares.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./primitives/*": "./src/primitives/*.tsx",
    "./styles.css": "./dist/exponential-ui-react.css",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "src",
    "dist",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build:css": "bun run ./scripts/build-css.ts",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "dev:harness": "bun ./harness/serve.ts",
    "smoke:pack": "bun run ./scripts/pack-smoke.ts",
    "shots": "bun run ./scripts/shots.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@exponential-at/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@exp/tsconfig": "workspace:*",
    "@tailwindcss/node": "^4.3.0",
    "@tailwindcss/oxide": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.2.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "playwright": "^1.54.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.2",
    "vitest": "4.1.5"
  }
}
