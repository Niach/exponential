exports[`extension fixture renders > An extension macro expands through a core macro into natives, keeping the extension's native 1`] = `"<div class="xui-surface xui-t-THEME xui-s-SURFACE" data-xui-surface="ex" data-xui-mode="dark" data-xui-theme="neutral" dir="ltr"><div class="xui-container"><div class="xui-el xui-n-root xui-t-THEME xui-Box-root xui-Stack-root" data-xui-id="ID" data-xui-c="Box" data-xui-part="Stack/root"><div class="xui-el xui-n-s1 xui-t-THEME xui-Box-root xui-Card-root" data-xui-id="ID" data-xui-c="Box" data-xui-part="Card/root" data-pressable="true" role="button" tabindex="0"><div class="xui-el xui-n-s1_2e_body xui-t-THEME xui-Box-root xui-Card-body" data-xui-id="ID" data-xui-c="Box" data-xui-part="Card/body"><span class="xui-el xui-n-s1_2e_label xui-t-THEME xui-Text-root xui-StatCard-label" data-xui-id="ID" data-xui-c="Text" data-xui-part="StatCard/label" data-m-trend="up" data-r-variant="muted">Open issues</span><div class="xui-el xui-n-s1_2e_row xui-t-THEME xui-Box-root xui-Stack-root" data-xui-id="ID" data-xui-c="Box" data-xui-part="Stack/root"><span class="xui-el xui-n-s1_2e_row_2e_value xui-t-THEME xui-Text-root xui-StatCard-value" data-xui-id="ID" data-xui-c="Text" data-xui-part="StatCard/value" data-m-trend="up" data-r-variant="title">42</span><span class="xui-el xui-n-s1_2e_row_2e_trend xui-t-THEME xui-Icon-root xui-StatCard-trend" data-xui-id="ID" data-xui-c="Icon" data-xui-part="StatCard/trend" data-m-trend="up" data-r-size="sm" data-r-tone="success" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle" aria-hidden="true" data-icon="ui-chevron-up" data-icon-missing="true"><circle cx="12" cy="12" r="10"></circle></svg></span></div><svg class="xui-el xui-n-s1_2e_spark xui-t-THEME xui-Sparkline-root xui-StatCard-spark" data-xui-id="ID" data-xui-c="Sparkline" data-xui-part="StatCard/spark" data-m-trend="up" data-r-tone="primary" data-values="4"></svg></div></div><div class="xui-el xui-n-s2 xui-t-THEME xui-Box-root xui-Card-root" data-xui-id="ID" data-xui-c="Box" data-xui-part="Card/root"><div class="xui-el xui-n-s2_2e_body xui-t-THEME xui-Box-root xui-Card-body" data-xui-id="ID" data-xui-c="Box" data-xui-part="Card/body"><span class="xui-el xui-n-s2_2e_label xui-t-THEME xui-Text-root xui-StatCard-label" data-xui-id="ID" data-xui-c="Text" data-xui-part="StatCard/label" data-m-trend="flat" data-r-variant="muted">Merged</span><div class="xui-el xui-n-s2_2e_row xui-t-THEME xui-Box-root xui-Stack-root" data-xui-id="ID" data-xui-c="Box" data-xui-part="Stack/root"><span class="xui-el xui-n-s2_2e_row_2e_value xui-t-THEME xui-Text-root xui-StatCard-value" data-xui-id="ID" data-xui-c="Text" data-xui-part="StatCard/value" data-m-trend="flat" data-r-variant="title"></span><span class="xui-el xui-n-s2_2e_row_2e_trend xui-t-THEME xui-Icon-root xui-StatCard-trend" data-xui-id="ID" data-xui-c="Icon" data-xui-part="StatCard/trend" data-m-trend="flat" data-r-size="sm" data-r-tone="neutral" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle" aria-hidden="true" data-icon="ui-minus" data-icon-missing="true"><circle cx="12" cy="12" r="10"></circle></svg></span></div></div></div></div></div></div>"`;

exports[`extension fixture renders > An extension native passes through with its props validated 1`] = `"<div class="xui-surface xui-t-THEME xui-s-SURFACE" data-xui-surface="ex" data-xui-mode="dark" data-xui-theme="neutral" dir="ltr"><div class="xui-container"><svg class="xui-el xui-n-root xui-t-THEME xui-Sparkline-root" data-xui-id="ID" data-xui-c="Sparkline" data-r-tone="success" data-values="3"></svg></div></div>"`;
