    "values": [
      "backlog",
      "unstarted",
      "started",
      "completed",
      "cancelled",
      "duplicate"
    ],
    "displayOrder": [
      "backlog",
      "unstarted",
      "started",
      "completed",
      "cancelled",
      "duplicate"
    ],
    "startedMax": 4
  },
