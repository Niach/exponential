    "values": [
      "backlog",
      "in_progress",
      "in_review",
      "done",
      "cancelled",
      "duplicate"
    ],
    "displayOrder": [
      "backlog",
      "in_progress",
      "in_review",
      "done",
      "cancelled",
      "duplicate"
    ]
  },
