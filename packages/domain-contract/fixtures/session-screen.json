  "statusCases": [
    {
      "name": "an idle root",
      "input": [
        {
          "status": "idle",
          "busy": false,
          "needsInput": false,
          "root": true
        }
      ],
      "expected": "idle"
    },
    {
      "name": "an empty tree",
      "input": [],
      "expected": "idle"
    },
    {
      "name": "a busy child makes the tree working",
      "input": [
        {
          "status": "idle",
          "busy": false,
          "needsInput": false,
          "root": true
        },
        {
          "status": "running",
          "busy": true,
          "needsInput": false,
          "root": false
        }
      ],
      "expected": "working"
    },
    {
      "name": "needs input beats working",
      "input": [
        {
          "status": "running",
          "busy": true,
          "needsInput": false,
          "root": true
        },
        {
          "status": "idle",
          "busy": false,
          "needsInput": true,
          "root": false
        }
      ],
      "expected": "needs input"
    },
    {
      "name": "an ended child's flag never counts",
      "input": [
        {
          "status": "idle",
          "busy": false,
          "needsInput": false,
          "root": true
        },
        {
          "status": "ended",
          "busy": false,
          "needsInput": true,
          "root": false
        }
      ],
      "expected": "idle"
    },
    {
      "name": "a queued root",
      "input": [
        {
          "status": "queued",
          "busy": false,
          "needsInput": false,
          "root": true
        }
      ],
      "expected": "queued"
    },
    {
      "name": "an ended root",
      "input": [
        {
          "status": "ended",
          "busy": false,
          "needsInput": false,
          "root": true
        }
      ],
      "expected": "done"
    },
    {
      "name": "an ended root with a live busy child is still working",
      "input": [
        {
          "status": "ended",
          "busy": false,
          "needsInput": false,
          "root": true
        },
        {
          "status": "running",
          "busy": true,
          "needsInput": false,
          "root": false
        }
      ],
      "expected": "working"
    }
  ],
