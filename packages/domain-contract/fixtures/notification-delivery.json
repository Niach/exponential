  "rowsOfRule": "A dismiss case may give `rowsOf` {count, threads? | threadCount?} instead of `rows`: row i (0-based) = {id: `n<i>`, thread: threads[i mod threads.length], or `t<i mod threadCount>`}.",
  "dismissCases": [
    {
      "name": "nothing turned read = no push",
      "input": {
        "rows": [],
        "all": false,
        "teamId": null
      },
      "expected": null
    },
    {
      "name": "a few rows = their ids",
      "input": {
        "rows": [
          {
            "id": "n1",
            "thread": "session:r1"
          },
          {
            "id": "n2",
            "thread": "session:r1"
          }
        ],
        "all": false,
        "teamId": null
      },
      "expected": {
        "type": "dismiss",
        "ids": "n1,n2"
      }
    },
    {
      "name": "a duplicate id goes once",
      "input": {
        "rows": [
          {
            "id": "n1",
            "thread": "issue:i1"
          },
          {
            "id": "n1",
            "thread": "issue:i1"
          }
        ],
        "all": false,
        "teamId": null
      },
      "expected": {
        "type": "dismiss",
        "ids": "n1"
      }
    },
    {
      "name": "over maxIds = the distinct threads",
      "input": {
        "rowsOf": {
          "count": 61,
          "threads": [
            "issue:i1",
            "session:r1"
          ]
        },
        "all": false,
        "teamId": null
      },
      "expected": {
        "type": "dismiss",
        "threads": "issue:i1,session:r1"
      }
    },
    {
      "name": "over maxThreads too = all",
      "input": {
        "rowsOf": {
          "count": 61,
          "threadCount": 31
        },
        "all": false,
        "teamId": null
      },
      "expected": {
        "type": "dismiss",
        "all": "1"
      }
    },
    {
      "name": "mark all read = all",
      "input": {
        "rows": [
          {
            "id": "n1",
            "thread": "issue:i1"
          }
        ],
        "all": true,
        "teamId": null
      },
      "expected": {
        "type": "dismiss",
        "all": "1"
      }
    },
    {
      "name": "one team's mark all read = all of that team",
      "input": {
        "rows": [
          {
            "id": "n1",
            "thread": "issue:i1"
          }
        ],
        "all": true,
        "teamId": "t1"
      },
      "expected": {
        "type": "dismiss",
        "all": "1",
        "teamId": "t1"
      }
    },
    {
      "name": "mark all with nothing unread = no push",
      "input": {
        "rows": [],
        "all": true,
        "teamId": "t1"
      },
      "expected": null
    }
  ],
