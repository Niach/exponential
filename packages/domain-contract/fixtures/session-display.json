    { "name": "idle with a closed PR is done", "status": "running", "needsInput": false, "agentBusy": false, "prState": "closed", "state": "done", "working": false, "statusTone": "sky" },
    { "name": "PR open, idle", "status": "in_review", "needsInput": false, "agentBusy": false, "prState": "open", "state": "review", "working": false, "statusTone": "emerald" },
    { "name": "PR open, follow-up turn", "status": "in_review", "needsInput": false, "agentBusy": true, "prState": "open", "state": "working", "working": true, "statusTone": "muted" },
    { "name": "PR open, asks a question", "status": "in_review", "needsInput": true, "agentBusy": false, "prState": "open", "state": "needs_input", "working": false, "statusTone": "amber" },
