    { "name": "asks a question", "status": "running", "needsInput": true, "agentBusy": false, "prState": null, "state": "needs_input", "working": false, "statusTone": "amber" },
    { "name": "asks mid-turn (needs input beats busy)", "status": "running", "needsInput": true, "agentBusy": true, "prState": null, "state": "needs_input", "working": false, "statusTone": "amber" },
