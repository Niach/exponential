    {
      "name": "no extra space where one is already there",
      "input": {
        "text": "see this",
        "caret": 4,
        "index": 1
      },
      "expected": {
        "text": "see [Image #1] this",
        "caret": 15
      }
    },
    {
      "name": "at the start it gets a trail space",
      "input": {
        "text": "crop it",
        "caret": 0,
        "index": 1
      },
      "expected": {
        "text": "[Image #1] crop it",
        "caret": 11
      }
    },
    {
      "name": "an out-of-range caret clamps to the end",
      "input": {
        "text": "hi",
        "caret": 99,
        "index": 1
      },
      "expected": {
        "text": "hi [Image #1]",
        "caret": 13
      }
    },
    {
      "name": "after a newline no lead space",
