                    },
                    {
                      "label": "iOS",
                      "value": "ios"
                    }
                  ],
                  "value": {
                    "path": "/form/team"
                  }
                }
              },
              {
                "id": "f_labels",
                "component": "Select",
                "props": {
                  "label": "Labels",
                  "name": "labels",
                  "options": [
                    {
                      "label": "bug",
                      "value": "bug"
                    },
                    {
                      "label": "crash",
                      "value": "crash"
                    },
                    {
                      "label": "p1",
                      "value": "p1"
                    }
                  ],
                  "value": {
                    "path": "/form/labels"
                  },
                  "multiple": true
                }
              },
              {
