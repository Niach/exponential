    "now": "now",
    "approve": "Approve",
    "change": "Change",
    "reply": "Reply…",
    "close": "Close",
    "next": "Next",
    "previous": "Previous"
  },
  "ring": { "width": 3, "gap": 6 },
  "progress": { "height": 3, "gap": 4 },
  "viewer": { "width": 440, "height": 760, "radius": 16 },
  "testIds": {
    "ring": "story-ring",
    "viewer": "story-viewer",
    "progress": "story-progress",
    "header": "story-header",
    "next": "story-next",
    "previous": "story-previous"
  },
