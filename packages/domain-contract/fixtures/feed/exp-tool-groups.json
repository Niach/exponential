[
  {
    "name": "a single Exponential call stays a single visible row",
    "feed": [
      {
        "id": 1,
        "kind": "tool",
        "name": "mcp__exponential__exponential_issues_get",
        "toolKind": "other",
        "detail": "EXP-901",
        "settled": true
      }
    ],
    "expected": ["tool@1"]
  },
  {
    "name": "two calls to the same tool are their own group",
    "feed": [
      {
        "id": 1,
        "kind": "tool",
        "name": "mcp__exponential__exponential_issues_get",
        "toolKind": "other",
        "detail": "EXP-901",
        "settled": true
      },
      {
        "id": 2,
        "kind": "tool",
        "name": "mcp__exponential__exponential_issues_get",
        "toolKind": "other",
        "detail": "EXP-944",
        "settled": true
      }
    ],
    "expected": ["expRun@1[1,2]: Read 2 issues"]
  },
  {
    "name": "a running member keeps the progressive caption",
    "feed": [
      {
        "id": 1,
        "kind": "tool",
        "name": "exponential_issues_get",
        "toolKind": "other",
        "settled": true
      },
      {
        "id": 2,
