  "files": {
    "$comment": "EXP-1154: a text entry may carry files (repo-relative paths the topic touched). A group's files come from the SAME entry its text does (the topic's first non-blank text): strings only, trimmed, blanks and duplicates dropped (first position kept), capped at maxFiles; missing or non-array = []. files on a picture or on a blank text are ignored; a picture-only group has []. Mirrored x4: web session-results.ts, desktop session_results.rs, iOS SessionResults.swift, Android SessionResults.kt.",
    "maxFiles": 40,
    "cases": [
      {
        "name": "a text entry's files ride its group",
        "raw": [
          { "topic": "Summary", "label": null, "attachmentId": null, "text": "Did it", "files": ["apps/web/src/a.ts", " packages/ui/src/b.ts ", "", 7, "apps/web/src/a.ts"] },
          { "topic": "nav", "label": "web", "attachmentId": "a1" }
        ],
        "expected": [
          { "topic": "Summary", "files": ["apps/web/src/a.ts", "packages/ui/src/b.ts"] },
          { "topic": "nav", "files": [] }
        ]
      },
      {
        "name": "files follow the winning text, never a later text or a picture",
        "raw": [
          { "topic": "b", "text": "first", "files": ["x.ts"] },
          { "topic": "b", "text": "second", "files": ["y.ts"] },
          { "topic": "c", "label": "web", "attachmentId": "a9", "files": ["z.ts"] },
          { "topic": "d", "text": "  ", "files": ["w.ts"] },
          { "topic": "d", "text": "kept" }
        ],
        "expected": [
          { "topic": "b", "files": ["x.ts"] },
          { "topic": "c", "files": [] },
          { "topic": "d", "files": [] }
        ]
      },
      {
        "name": "a non-array files reads as none",
        "raw": [{ "topic": "t", "text": "hi", "files": "a.ts" }],
        "expected": [{ "topic": "t", "files": [] }]
      }
    ]
  },
