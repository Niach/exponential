{
  "$comment": "EXP-933: the Results face as a REPORT. coding_sessions.results entries are pictures {topic,label,attachmentId,width,height} or a topic's GFM text {topic,label:null,attachmentId:null,text}. parseSessionResultGroups folds both into groups in FIRST-SEEN topic order (either kind opens a topic); a group's text is its FIRST text entry, trimmed at both ends, null without one; pictures keep publish order and the 60-picture cap. A text entry needs a non-blank text; a picture needs topic+label+attachmentId (a picture with a text field is still a picture). issueResultsRun picks the run whose results an ISSUE shows: codingTarget (bound live own run, else newest live own run, else newest own run) when that run has any group, else the NEWEST run on the issue by startedAt (ties: larger id) by ANY member with at least one group, else null. Mirrored by packages/ui session-results.ts + apps/web work-faces.ts, desktop, iOS and Android. EXP-1251/1245: entries may also carry at (server write stamp, ms) and, on a text entry, prUrl; see coverage, prScope and turns.",
  "groups": [
    {
      "name": "null blob",
      "raw": null,
      "expected": []
    },
    {
      "name": "pictures only keep today's grouping",
      "raw": [
        { "topic": "nav", "label": "web", "attachmentId": "a1", "width": 100, "height": 50 },
        { "topic": "nav", "label": "ios", "attachmentId": "a2", "width": null, "height": null },
        { "topic": "chat", "label": "web", "attachmentId": "a3" }
      ],
      "expected": [
        { "topic": "nav", "text": null, "entries": [{ "label": "web", "attachmentId": "a1" }, { "label": "ios", "attachmentId": "a2" }] },
        { "topic": "chat", "text": null, "entries": [{ "label": "web", "attachmentId": "a3" }] }
      ]
    },
    {
      "name": "a summary text first opens the report, text sits on its own topic",
      "raw": [
        { "topic": "Summary", "label": null, "attachmentId": null, "width": null, "height": null, "text": "  ## Done\n- shipped #EXP-1\n  " },
