{
  "$comment": "EXP-933: the Results face as a REPORT. coding_sessions.results entries are pictures {topic,label,attachmentId,width,height} or a topic's GFM text {topic,label:null,attachmentId:null,text}. parseSessionResultGroups folds both into groups in FIRST-SEEN topic order (either kind opens a topic); a group's text is its FIRST text entry, trimmed at both ends, null without one; pictures keep publish order and the 60-picture cap. A text entry needs a non-blank text; a picture needs topic+label+attachmentId (a picture with a text field is still a picture). issueResultsRun picks the run whose results an ISSUE shows: codingTarget (bound live own run, else newest live own run, else newest own run) when that run has any group, else the NEWEST run on the issue by startedAt (ties: larger id) by ANY member with at least one group, else null. Mirrored by packages/ui session-results.ts + apps/web work-faces.ts, desktop, iOS and Android.",
  "groups": [
    {
      "name": "null blob",
      "raw": null,
      "expected": []
    },
    {
      "name": "pictures only keep today's grouping",
      "raw": [
        { "topic": "nav", "label": "web", "attachmentId": "a1", "width": 100, "height": 50 },
        { "topic": "nav", "label": "ios", "attachmentId": "a2", "width": null, "height": null },
        { "topic": "chat", "label": "web", "attachmentId": "a3" }
      ],
      "expected": [
        { "topic": "nav", "text": null, "entries": [{ "label": "web", "attachmentId": "a1" }, { "label": "ios", "attachmentId": "a2" }] },
        { "topic": "chat", "text": null, "entries": [{ "label": "web", "attachmentId": "a3" }] }
      ]
    },
    {
      "name": "a summary text first opens the report, text sits on its own topic",
      "raw": [
        { "topic": "Summary", "label": null, "attachmentId": null, "width": null, "height": null, "text": "  ## Done\n- shipped #EXP-1\n  " },
        { "topic": "nav", "label": null, "attachmentId": null, "text": "The nav bar" },
        { "topic": "nav", "label": "web", "attachmentId": "a1", "width": 100, "height": 50 }
      ],
      "expected": [
        { "topic": "Summary", "text": "## Done\n- shipped #EXP-1", "entries": [] },
        { "topic": "nav", "text": "The nav bar", "entries": [{ "label": "web", "attachmentId": "a1" }] }
      ]
    },
    {
      "name": "text filed after a topic's pictures still attaches to that topic",
      "raw": [
        { "topic": "nav", "label": "web", "attachmentId": "a1" },
        { "topic": "chat", "label": "web", "attachmentId": "a2" },
        { "topic": "nav", "label": null, "attachmentId": null, "text": "Later words" }
      ],
      "expected": [
        { "topic": "nav", "text": "Later words", "entries": [{ "label": "web", "attachmentId": "a1" }] },
        { "topic": "chat", "text": null, "entries": [{ "label": "web", "attachmentId": "a2" }] }
      ]
    },
    {
      "name": "blank text, missing topic and malformed rows drop; the first text of a topic wins",
      "raw": [
        { "topic": "a", "label": null, "attachmentId": null, "text": "   " },
        { "label": null, "attachmentId": null, "text": "no topic" },
        "junk",
        [1],
        { "topic": "b", "text": "first" },
        { "topic": "b", "text": "second" },
        { "topic": "c", "label": "web", "attachmentId": "a9", "text": "ignored on a picture" }
      ],
      "expected": [
        { "topic": "b", "text": "first", "entries": [] },
        { "topic": "c", "text": null, "entries": [{ "label": "web", "attachmentId": "a9" }] }
      ]
    },
    {
      "name": "a JSON string blob parses like the array",
      "raw": "[{\"topic\":\"Summary\",\"label\":null,\"attachmentId\":null,\"text\":\"Hi\"}]",
      "expected": [
        { "topic": "Summary", "text": "Hi", "entries": [] }
      ]
    }
  ],
  "files": {
    "$comment": "EXP-1154: a text entry may carry files (repo-relative paths the topic touched). A group's files come from the SAME entry its text does (the topic's first non-blank text): strings only, trimmed, blanks and duplicates dropped (first position kept), capped at maxFiles; missing or non-array = []. files on a picture or on a blank text are ignored; a picture-only group has []. Mirrored x4: web session-results.ts, desktop session_results.rs, iOS SessionResults.swift, Android SessionResults.kt.",
    "maxFiles": 40,
    "cases": [
      {
        "name": "a text entry's files ride its group",
        "raw": [
          { "topic": "Summary", "label": null, "attachmentId": null, "text": "Did it", "files": ["apps/web/src/a.ts", " packages/ui/src/b.ts ", "", 7, "apps/web/src/a.ts"] },
          { "topic": "nav", "label": "web", "attachmentId": "a1" }
        ],
        "expected": [
          { "topic": "Summary", "files": ["apps/web/src/a.ts", "packages/ui/src/b.ts"] },
          { "topic": "nav", "files": [] }
        ]
      },
      {
        "name": "files follow the winning text, never a later text or a picture",
        "raw": [
          { "topic": "b", "text": "first", "files": ["x.ts"] },
          { "topic": "b", "text": "second", "files": ["y.ts"] },
          { "topic": "c", "label": "web", "attachmentId": "a9", "files": ["z.ts"] },
          { "topic": "d", "text": "  ", "files": ["w.ts"] },
          { "topic": "d", "text": "kept" }
        ],
        "expected": [
          { "topic": "b", "files": ["x.ts"] },
          { "topic": "c", "files": [] },
          { "topic": "d", "files": [] }
        ]
      },
      {
        "name": "a non-array files reads as none",
        "raw": [{ "topic": "t", "text": "hi", "files": "a.ts" }],
        "expected": [{ "topic": "t", "files": [] }]
      }
    ]
  },
  "guide": {
    "$comment": "EXP-1154: the Results face as the GUIDE. guideSections(groups): lead = the FIRST group whose trimmed topic equals 'Summary' case-insensitively (null without one); sections = every other group in order with 1-based index and total (the lead never counts). guideSectionCaption(index,total) = two-digit zero-padded 'NN / NN'. guideFileRows(paths, diffFiles): one row per path in order, counts {additions,deletions} from the diff file whose path matches exactly, else null. Mirrored x4.",
    "sections": [
      { "name": "summary leads wherever it sits", "topics": ["nav", "Summary", "chat"], "lead": "Summary", "sections": [["nav", 1, 2], ["chat", 2, 2]] },
      { "name": "no summary", "topics": ["nav"], "lead": null, "sections": [["nav", 1, 1]] },
      { "name": "case-insensitive, first summary only", "topics": ["SUMMARY", " summary ", "x"], "lead": "SUMMARY", "sections": [[" summary ", 1, 2], ["x", 2, 2]] },
      { "name": "empty", "topics": [], "lead": null, "sections": [] }
    ],
    "captions": [
      { "index": 1, "total": 4, "text": "01 / 04" },
      { "index": 12, "total": 12, "text": "12 / 12" }
    ],
    "fileRows": [
      { "name": "matched and unmatched", "paths": ["a.ts", "b.ts"], "diff": [{ "path": "a.ts", "additions": 3, "deletions": 1 }], "expected": [{ "path": "a.ts", "additions": 3, "deletions": 1 }, { "path": "b.ts", "additions": null, "deletions": null }] },
      { "name": "no diff loaded", "paths": ["a.ts"], "diff": null, "expected": [{ "path": "a.ts", "additions": null, "deletions": null }] }
    ]
  },
  "tiles": {
    "$comment": "EXP-1128: sessionResultIsTall = probed width/height < 1/3 (strict; a phone shot at ~0.46 is never tall). sessionResultTileWidth(entry, 320) = round(320 * aspect): the probed aspect, else 4:3; a TALL picture takes the 4:3 frame too (rendered top-cropped with a Tall badge, opened fit-to-width in a vertical scroll) so it never renders as a sliver. Mirrored ×4: web session-results.ts, desktop session_results.rs, iOS SessionResults.swift, Android SessionResults.kt.",
    "cases": [
      { "name": "landscape web shot", "width": 1600, "height": 900, "tall": false, "widthAt320": 569 },
      { "name": "phone shot never crops", "width": 1170, "height": 2532, "tall": false, "widthAt320": 148 },
      { "name": "exactly 1:3 is not tall", "width": 1080, "height": 3240, "tall": false, "widthAt320": 107 },
      { "name": "full-page desktop capture", "width": 1440, "height": 7696, "tall": true, "widthAt320": 427 },
      { "name": "full-page mobile capture", "width": 780, "height": 25094, "tall": true, "widthAt320": 427 },
      { "name": "unmeasured is the 4:3 frame, not tall", "width": null, "height": null, "tall": false, "widthAt320": 427 },
      { "name": "one side unknown", "width": 800, "height": null, "tall": false, "widthAt320": 427 }
    ]
  },
