      { "name": "no summary", "topics": ["nav"], "lead": null, "sections": [["nav", 1, 1]] },
      { "name": "case-insensitive, first summary only", "topics": ["SUMMARY", " summary ", "x"], "lead": "SUMMARY", "sections": [[" summary ", 1, 2], ["x", 2, 2]] },
      { "name": "empty", "topics": [], "lead": null, "sections": [] }
    ],
    "captions": [
