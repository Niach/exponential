  "tests": {
    "$comment": "parseTestResults: ANSI CSI escapes stripped, CRLF -> LF; the FIRST runner whose summary matches decides the counts: jest `Tests: [n failed, ][n skipped, ][n todo, ][n passed, ]n total`; vitest `Tests  [n failed][ | ][n passed] ... (total)`; cargo `test result: X. n passed; n failed;` (every such line summed); xcodebuild `Executed n tests, with n failures` (the LAST); gradle `n tests completed, n failed`; pytest `=== [n failed][, ][n passed]... in Xs ===`; bun `  n pass` / `  n fail` lines. The suite: every failure line of `(fail) Suite > t` (bun), `FAIL path[ > Suite > t]` (jest/vitest: the Suite, else the file name up to its first `.`), `Class > t FAILED` (gradle: last `.` segment), `FAILED path::t` (pytest: the file name up to its first `.`), `Test Case '-[Mod.Class t]' failed` (xcodebuild), `---- mod::t stdout ----` (cargo: the module); exactly ONE distinct name = the suite, else null. The line exists only for failed >= 1.",
    "title": "Failed: {failed} of {total} {tests}",
    "titleIn": "Failed: {failed} of {total} {tests} in {suite}",
    "test": "test",
    "tests": "tests"
  },
