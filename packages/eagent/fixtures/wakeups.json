              "body": "Next step?",
              "card": null,
              "sealed": false,
              "waking": true
            }
          ],
          "result": {
            "sessionId": "r1",
            "messageId": "m1"
          }
        },
        {
          "event": {
            "kind": "device.consume",
            "at": 61000,
            "data": {
              "sessionId": "r1",
              "messageIds": [
                "m1"
              ]
            }
          },
          "effects": [],
          "result": {
            "sessionId": "r1"
          }
        }
      ],
      "expect": {
        "messages": {
          "m1": {
            "pending": false
          }
        }
      }
    },
