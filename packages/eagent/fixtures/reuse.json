{
  "$comment": "REUSE (lib/sessions/agent-reuse.ts, send.ts agentFreshThread; rules.reuse). Only an AGENT's message (the calling session's tree has an acting agent) into ANOTHER tree's ROOT thread (not a child, not an agent's conversation) with plain text (never an answer, never sealed: a sealed text cannot move trees) can fork. It reuses the thread when it waits on an answer (needsInput) or on the CALLER (#FEED-172: the thread's tree has the last word with the caller, `awaitsCaller`), else while it is live or ended under maxEndedHours, its last turn (else activity, else last write) is under maxIdleHours old and it has fewer than maxChildren sub-sessions. Otherwise a FRESH root starts (id `freshId`) on the target's device with the same message, watched by the caller, and the result's warning says why (copy.freshThread). A person's message never forks. `refusalCases` replay `reuseRefusal(root, children, now, awaitsCaller)` alone (null = reuse).",
  "refusalCases": [
    {
      "name": "a live, recent, small thread is reused",
      "root": {
        "status": "idle",
        "needsInput": false,
        "endedAt": null,
        "lastTurnAt": 356400000,
        "lastActivityAt": 356400000,
        "updatedAt": 356400000
      },
      "children": 0,
      "now": 360000000,
      "expected": null
    },
    {
      "name": "ended under maxEndedHours: reused",
      "root": {
        "status": "ended",
        "needsInput": false,
        "endedAt": 356400000,
        "lastTurnAt": 356400000,
        "lastActivityAt": null,
        "updatedAt": 356400000
      },
      "children": 0,
      "now": 360000000,
      "expected": null
    },
    {
      "name": "ended maxEndedHours ago: refused",
      "root": {
        "status": "ended",
        "needsInput": false,
        "endedAt": 352800000,
        "lastTurnAt": 356400000,
        "lastActivityAt": null,
        "updatedAt": 352800000
      },
      "children": 0,
      "now": 360000000,
      "expected": "it ended more than 2 h ago"
    },
    {
      "name": "ended with no endedAt: its last write counts",
      "root": {
        "status": "ended",
        "needsInput": false,
        "endedAt": null,
        "lastTurnAt": 356400000,
        "lastActivityAt": null,
        "updatedAt": 352800000
      },
      "children": 0,
      "now": 360000000,
      "expected": "it ended more than 2 h ago"
    },
    {
      "name": "last turn maxIdleHours old: refused",
      "root": {
        "status": "idle",
        "needsInput": false,
        "endedAt": null,
        "lastTurnAt": 273600000,
        "lastActivityAt": 359000000,
        "updatedAt": 359000000
      },
      "children": 0,
      "now": 360000000,
      "expected": "its last turn is more than 24 h old"
    },
    {
      "name": "no turn yet: the last activity counts",
      "root": {
        "status": "idle",
        "needsInput": false,
        "endedAt": null,
        "lastTurnAt": null,
        "lastActivityAt": 270000000,
        "updatedAt": 359000000
      },
      "children": 0,
      "now": 360000000,
      "expected": "its last turn is more than 24 h old"
    },
    {
      "name": "neither: the last write counts",
      "root": {
        "status": "idle",
        "needsInput": false,
        "endedAt": null,
        "lastTurnAt": null,
        "lastActivityAt": null,
        "updatedAt": 359000000
      },
      "children": 0,
      "now": 360000000,
      "expected": null
    },
    {
      "name": "maxChildren - 1 sub-sessions: reused",
      "root": {
        "status": "idle",
        "needsInput": false,
        "endedAt": null,
        "lastTurnAt": 356400000,
        "lastActivityAt": null,
        "updatedAt": 356400000
      },
      "children": 7,
      "now": 360000000,
      "expected": null
    },
    {
      "name": "maxChildren sub-sessions: refused",
      "root": {
        "status": "idle",
        "needsInput": false,
        "endedAt": null,
        "lastTurnAt": 356400000,
        "lastActivityAt": null,
        "updatedAt": 356400000
      },
      "children": 8,
      "now": 360000000,
      "expected": "it already has 8 sub-sessions"
    },
    {
      "name": "waiting on an answer: always reused",
      "root": {
        "status": "idle",
        "needsInput": true,
        "endedAt": null,
        "lastTurnAt": 0,
        "lastActivityAt": null,
        "updatedAt": 0
      },
      "children": 8,
      "now": 360000000,
      "expected": null
    },
    {
      "name": "#FEED-172 waiting on the caller: always reused",
      "root": {
        "status": "running",
        "needsInput": false,
        "endedAt": null,
        "lastTurnAt": 0,
        "lastActivityAt": null,
        "updatedAt": 0
      },
      "children": 8,
      "now": 360000000,
      "awaitsCaller": true,
      "expected": null
    }
  ],
  "cases": [
    {
      "name": "an agent's message to a crowded thread starts a fresh one on its device, watched, with a warning",
      "given": {
        "sessions": [
          {
            "id": "a1",
            "agentId": "ag1",
            "deviceId": "d9"
          },
          {
            "id": "r1",
            "deviceId": "d2",
            "lastTurnAt": 356400000,
            "updatedAt": 356400000
          },
          {
            "id": "c1",
            "parentId": "r1",
            "status": "ended",
            "endedAt": 0
          },
          {
            "id": "c2",
            "parentId": "r1",
            "status": "ended",
            "endedAt": 0
          },
          {
            "id": "c3",
            "parentId": "r1",
            "status": "ended",
            "endedAt": 0
          },
          {
            "id": "c4",
            "parentId": "r1",
            "status": "ended",
            "endedAt": 0
          },
          {
            "id": "c5",
            "parentId": "r1",
            "status": "ended",
            "endedAt": 0
          },
          {
            "id": "c6",
            "parentId": "r1",
            "status": "ended",
            "endedAt": 0
          },
          {
            "id": "c7",
            "parentId": "r1"
          },
          {
            "id": "c8",
            "parentId": "c7"
          }
        ]
      },
      "steps": [
        {
          "event": {
            "kind": "send.message",
            "at": 360000000,
            "data": {
              "sessionId": "r1",
              "callerId": "a1",
              "text": "Now do the Android half.",
              "freshId": "r2"
            }
          },
          "effects": [
            {
              "kind": "post",
              "messageId": "m1",
              "to": "r2",
              "authorKind": "agent",
              "authorSessionId": "a1",
              "body": "Now do the Android half.",
              "card": null,
              "sealed": false,
              "waking": true
            },
            {
              "kind": "post",
              "messageId": "m2",
              "to": "a1",
              "authorKind": "system",
              "authorSessionId": null,
              "body": "",
              "card": {
                "kind": "thread_started",
                "sessionId": "r2"
              },
              "sealed": false,
              "waking": false
            }
          ],
          "result": {
            "sessionId": "r2",
            "messageId": "m1",
            "warning": "Started a fresh thread instead of reusing r1: it already has 8 sub-sessions. You watch the new one."
          }
        }
      ],
      "expect": {
        "sessions": {
          "r2": {
            "parentId": null,
            "deviceId": "d2",
            "status": "queued",
            "startedByAgentId": "ag1"
          },
          "a1": {
            "wakeOn": [
              "r2"
            ]
          }
        }
      }
    },
