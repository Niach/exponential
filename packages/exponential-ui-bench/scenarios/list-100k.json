{
  "$comment": "AUTO-GENERATED by packages/exponential-ui-bench/scripts/generate.ts — do not edit (inputs live in src/scenarios.ts). 100,000-row list: fixtures/bench-list.json, the shared list bench: a windowed List over 100,000 generated rows. First paint = bind + window + paint; a scroll step moves one viewport and re-windows; the jump lands on row 50,000. Where data binding and per-row text measurement cost.",
  "id": "list-100k",
  "theme": "neutral",
  "mode": "light",
  "catalogId": "https://ui.exponential.at/catalogs/core/v1",
  "viewport": {
    "width": 390,
    "height": 800
  },
  "surface": {
    "components": [
      {
        "id": "root",
        "component": "List",
        "direction": "vertical",
        "divided": true,
        "style": {
          "height": 800
        },
        "children": {
          "componentId": "bench-row",
          "path": "/rows",
          "key": "id"
        }
      },
      {
        "id": "bench-row",
        "component": "Row",
        "title": {
          "path": "title"
        },
        "meta": {
          "path": "meta"
        },
        "pressable": true
      }
    ]
  },
  "data": {
    "generate": {
      "path": "/rows",
      "count": 100000,
      "item": {
        "id": "r{i}",
        "title": "Row {i}",
        "meta": "{i % 97}"
      }
    }
  },
  "steps": {
    "scroll": {
      "count": 100,
      "by": "viewport"
    },
    "scrollToIndex": {
      "index": 50000,
      "align": "start"
    }
  },
  "metrics": [
    "firstPaintMs",
    "scrollStepMs",
    "scrollToIndexMs",
    "renderedItems",
    "measureCallsPerStep",
    "ffiCallsPerStep",
    "ffiBytesPerStep",
    "memoryMb"
  ]
}
