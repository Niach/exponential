{
  "$comment": "AUTO-GENERATED by packages/exponential-ui-bench/scripts/generate.ts — do not edit (inputs live in src/scenarios.ts). 10,000 template items: A plain column (not a windowed List) with a template over 10,000 items, the catalog's maxTemplateItems: every item is instantiated and bound at once. Then the array is replaced by 10,000 new items. Pure template binding cost, no windowing to hide it.",
  "id": "template-10k",
  "theme": "neutral",
  "mode": "light",
  "catalogId": "https://ui.exponential.at/catalogs/core/v1",
  "viewport": {
    "width": 390,
    "height": 800
  },
  "surface": {
    "components": [
      {
        "id": "root",
        "component": "Box",
        "style": {
          "display": "flex",
          "flexDirection": "column",
          "gap": 2,
          "padding": 8
        },
        "children": {
          "componentId": "item",
          "path": "/items",
          "key": "id"
        }
      },
      {
        "id": "item",
        "component": "Text",
        "text": {
          "path": "title"
        },
        "variant": "muted",
        "lines": 1
      }
    ]
  },
  "data": {
    "generate": {
      "path": "/items",
      "count": 10000,
      "item": {
        "id": "t{i}",
        "title": "Item {i} of ten thousand"
      }
    }
  },
  "steps": {
    "rebind": {
      "path": "/items",
      "count": 10000,
      "item": {
        "id": "u{i}",
        "title": "Updated item {i}"
      }
    }
  },
  "metrics": [
    "firstPaintMs",
    "rebindMs",
    "nodes"
  ]
}
