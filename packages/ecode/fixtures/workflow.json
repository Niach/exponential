    {
      "name": "what the subset refuses",
      "workflow": {
        "name": "x ${{ github.ref }}",
        "on": {
          "schedule": [
            {
              "cron": "0 0 * * *"
            }
          ],
          "push": {
            "branches-ignore": [
              "main"
            ]
          },
          "pull_request": {
            "paths": [
              "a/**"
            ]
          },
          "workflow_dispatch": null
        },
        "defaults": {
          "run": {
            "shell": "bash"
          }
        },
        "env": {
          "GH": "${{ secrets.TOKEN }}"
        },
        "jobs": {
          "my job": {
            "runs-on": "ubuntu-latest",
            "steps": [
              {
                "run": "true"
              }
            ]
          },
          "a": {
            "runs-on": "${{ matrix.os }}",
            "if": "github.event_name == 'push'",
            "container": "node:24",
            "strategy": {
              "matrix": {
                "os": [
                  "ubuntu-latest"
                ],
                "include": [
                  {
                    "os": "macos-latest"
                  }
                ]
              }
            },
            "steps": [
              {
                "uses": "docker/build-push-action@v6"
              },
              {
                "run": "echo ${{ github.sha }}",
                "shell": "pwsh"
              },
              {
                "name": "x",
                "with": {
                  "a": 1
                },
                "run": "true"
              }
            ]
          },
          "b": {
            "steps": "nope"
          }
        }
      },
      "file": null,
      "errors": [
