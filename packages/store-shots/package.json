{
  "name": "@exp/store-shots",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Dev-only picture tooling around exponential.at: the App Store / Play Store screenshot compositor, the social cards, the Apps concept pictures. Nothing it renders is committed except apps/site/public/{social,eapps}.",
  "scripts": {
    "screenshots:store": "bun scripts/store/render-store-screenshots.tsx",
    "screenshots:pop-sidecars": "bun scripts/store/pop-sidecars.ts",
    "social:generate": "bun scripts/generate-social.tsx",
    "eapps:mocks": "bun scripts/eapps-mocks/capture.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.64.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
