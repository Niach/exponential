      "appId": "at.exponential.photobook",
      "client": null,
      "call": { "from": "ui", "name": "bluetooth.scan", "arguments": {} },
      "verdict": { "verdict": "unknown", "capability": null, "tool": null, "scope": null, "reason": "unknownTool" },
      "outcome": null,
      "expected": { "appId": "at.exponential.photobook", "clientId": "ui", "tool": "bluetooth__scan", "status": "denied", "error": "unknownTool", "argsHash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a" }
    },
    {
      "name": "a call whose tool errored is failed",
      "appId": "at.exponential.photobook",
      "client": null,
      "call": { "from": "ui", "name": "print.pdf", "arguments": { "albumId": "a1" } },
      "verdict": { "verdict": "call", "capability": "print", "tool": "pdf", "scope": "print.pdf", "reason": null },
      "outcome": "isError",
      "expected": { "appId": "at.exponential.photobook", "clientId": "ui", "tool": "print__pdf", "status": "failed", "error": null, "argsHash": "sha256:ce39d0a61f73d8feae9df9f8d80691a8a8f891c473b2f9f9744ccb3003228468" }
