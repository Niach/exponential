      "call": { "from": "agent", "name": "photos__pick", "arguments": {} },
      "verdict": { "verdict": "denied", "capability": "photos", "tool": "pick", "scope": "photos.read", "reason": "consentNeeded" },
      "outcome": null,
      "expected": { "appId": "at.exponential.photobook", "clientId": "run-7", "tool": "photos__pick", "status": "denied", "error": "consentNeeded", "argsHash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a" }
    },
    {
