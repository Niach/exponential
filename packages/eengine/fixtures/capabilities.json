      "appId": "at.exponential.photobook",
      "client": null,
      "call": { "from": "ui", "name": "camera.capture", "arguments": {} },
      "verdict": { "verdict": "unavailable", "capability": "camera", "tool": "capture", "scope": "camera.capture", "reason": "unavailable" },
      "outcome": null,
      "expected": { "appId": "at.exponential.photobook", "clientId": "ui", "tool": "camera__capture", "status": "denied", "error": "unavailable", "argsHash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a" }
    }
  ]
}
