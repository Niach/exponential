      "appId": "at.exponential.photobook",
      "client": "run-7",
      "call": { "from": "agent", "name": "photos__delete", "arguments": {} },
      "verdict": { "verdict": "unknown", "capability": null, "tool": null, "scope": null, "reason": "unknownTool" },
      "outcome": null,
      "expected": { "appId": "at.exponential.photobook", "clientId": "run-7", "tool": "photos__delete", "status": "denied", "error": "unknownTool", "argsHash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a" }
    },
