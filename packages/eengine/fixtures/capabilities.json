      "outcome": "ok",
      "expected": { "appId": "at.exponential.photobook", "clientId": "ui", "tool": "photos__pick", "status": "ok", "error": null, "argsHash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a" }
