    { "text": "customer-relationship-management-for-the-sales-team", "expected": "m6eydx" }
  ],
  "splitCases": [
    { "name": "timesheet__list_entries", "expected": { "app": "timesheet", "tool": "list_entries" } },
    { "name": "crm-abcdef__find", "expected": { "app": "crm-abcdef", "tool": "find" } },
    { "name": "exponential_issues", "expected": null },
