              }
            }
          }
        }
      }
    },
    {
      "name": "out of band with upload",
      "files": [
        {
          "id": "a",
          "mimeType": "application/pdf",
          "size": 2097152
        }
      ],
      "declaredUpload": true,
      "expected": null
    }
  ]
}
