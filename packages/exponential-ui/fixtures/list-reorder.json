{
  "$comment": "EXP-1832 (the catalog's List `reorderable` + `maxDepth` + the `move` event): the rules of a reorderable List, HAND-AUTHORED and replayed by packages/exponential-ui/src/list-reorder.test.ts (the TS reference the web renderers use) and apps/desktop/crates/eui-core/tests/list_reorder.rs (the core, so gpui and the natives through the FFI). An item of a reorderable List may carry `depth` (0 = top; the host indents it, e.g. Row `depth`) and `group` (true = a row that holds rows, a folder; folded or not). dropSlot = where a drag drops: `rows` = the RENDERED rows in order with their box along the axis (`top`, `height`), `drag` = the dragged row's key, `at` = the pointer along the axis, `maxDepth` = nesting levels a drop may make (1 = flat). The dragged SUBTREE = the row + the rows right after it that sit deeper; its height = 1 for a group, else its deepest rendered descendant. The row under the pointer takes the drop (above the first = the first, below the last = the last); over the subtree = no drop (null). INTO is allowed when depth + 1 + height < maxDepth: then the row's outer QUARTERS mean before / after and its middle half into; otherwise the upper half = before, lower half = after. `after` an OPEN group (its next row is its child) = `before` that child. BESIDE needs depth + height < maxDepth, else null. `move` = the event's context {id: drag, before | after | into: key}. Every renderer DRAWS the drop: a 2px primary line across the row's edge from its indent (before = its top edge, after = its bottom edge, a small ring at the line's start), into = the row's primary ring + a faint primary fill; the dragged row dims (0.4) and a lifted copy follows the pointer. Pointers drag past the drag threshold (`tabDragThreshold`), touch after a long press (`tabLongPressMs`), as a strip Tabs; Esc cancels; a drop with no slot fires nothing. The host applies the move (the List never reorders its data).",
  "dropSlot": [
    {"name": "flat: upper half = before", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "b", "top": 30, "height": 30}, {"key": "c", "top": 60, "height": 30}, {"key": "d", "top": 90, "height": 30}], "drag": "a", "at": 70, "maxDepth": 1, "expected": {"key": "c", "position": "before"}, "move": {"id": "a", "before": "c"}},
    {"name": "flat: lower half = after", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "b", "top": 30, "height": 30}, {"key": "c", "top": 60, "height": 30}, {"key": "d", "top": 90, "height": 30}], "drag": "a", "at": 80, "maxDepth": 1, "expected": {"key": "c", "position": "after"}, "move": {"id": "a", "after": "c"}},
    {"name": "flat: never into with maxDepth 1", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "b", "top": 30, "height": 30}, {"key": "c", "top": 60, "height": 30}, {"key": "d", "top": 90, "height": 30}], "drag": "d", "at": 45, "maxDepth": 1, "expected": {"key": "b", "position": "after"}, "move": {"id": "d", "after": "b"}},
    {"name": "over the dragged row = no drop", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "b", "top": 30, "height": 30}, {"key": "c", "top": 60, "height": 30}, {"key": "d", "top": 90, "height": 30}], "drag": "b", "at": 40, "maxDepth": 2, "expected": null, "move": null},
    {"name": "above the first row = before the first", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "b", "top": 30, "height": 30}, {"key": "c", "top": 60, "height": 30}, {"key": "d", "top": 90, "height": 30}], "drag": "c", "at": -12, "maxDepth": 1, "expected": {"key": "a", "position": "before"}, "move": {"id": "c", "before": "a"}},
    {"name": "below the last row = after the last", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "b", "top": 30, "height": 30}, {"key": "c", "top": 60, "height": 30}, {"key": "d", "top": 90, "height": 30}], "drag": "a", "at": 500, "maxDepth": 1, "expected": {"key": "d", "position": "after"}, "move": {"id": "a", "after": "d"}},
    {"name": "maxDepth 2: the middle half = into", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "b", "top": 30, "height": 30}, {"key": "c", "top": 60, "height": 30}, {"key": "d", "top": 90, "height": 30}], "drag": "a", "at": 75, "maxDepth": 2, "expected": {"key": "c", "position": "into"}, "move": {"id": "a", "into": "c"}},
    {"name": "maxDepth 2: the top quarter = before", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "b", "top": 30, "height": 30}, {"key": "c", "top": 60, "height": 30}, {"key": "d", "top": 90, "height": 30}], "drag": "a", "at": 66, "maxDepth": 2, "expected": {"key": "c", "position": "before"}, "move": {"id": "a", "before": "c"}},
    {"name": "maxDepth 2: the bottom quarter = after", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "b", "top": 30, "height": 30}, {"key": "c", "top": 60, "height": 30}, {"key": "d", "top": 90, "height": 30}], "drag": "a", "at": 83, "maxDepth": 2, "expected": {"key": "c", "position": "after"}, "move": {"id": "a", "after": "c"}},
    {"name": "into a group", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "f", "top": 30, "height": 30, "group": true}, {"key": "f1", "top": 60, "height": 30, "depth": 1}, {"key": "f2", "top": 90, "height": 30, "depth": 1}, {"key": "b", "top": 120, "height": 30}, {"key": "g", "top": 150, "height": 30, "group": true}, {"key": "c", "top": 180, "height": 30}], "drag": "c", "at": 45, "maxDepth": 2, "expected": {"key": "f", "position": "into"}, "move": {"id": "c", "into": "f"}},
    {"name": "after an open group = before its first child", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "f", "top": 30, "height": 30, "group": true}, {"key": "f1", "top": 60, "height": 30, "depth": 1}, {"key": "f2", "top": 90, "height": 30, "depth": 1}, {"key": "b", "top": 120, "height": 30}, {"key": "g", "top": 150, "height": 30, "group": true}, {"key": "c", "top": 180, "height": 30}], "drag": "c", "at": 58, "maxDepth": 2, "expected": {"key": "f1", "position": "before"}, "move": {"id": "c", "before": "f1"}},
    {"name": "beside a child: a leaf may", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "f", "top": 30, "height": 30, "group": true}, {"key": "f1", "top": 60, "height": 30, "depth": 1}, {"key": "f2", "top": 90, "height": 30, "depth": 1}, {"key": "b", "top": 120, "height": 30}, {"key": "g", "top": 150, "height": 30, "group": true}, {"key": "c", "top": 180, "height": 30}], "drag": "a", "at": 92, "maxDepth": 2, "expected": {"key": "f2", "position": "before"}, "move": {"id": "a", "before": "f2"}},
    {"name": "onto a child: a leaf may not go into it (too deep), so its half decides", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "f", "top": 30, "height": 30, "group": true}, {"key": "f1", "top": 60, "height": 30, "depth": 1}, {"key": "f2", "top": 90, "height": 30, "depth": 1}, {"key": "b", "top": 120, "height": 30}, {"key": "g", "top": 150, "height": 30, "group": true}, {"key": "c", "top": 180, "height": 30}], "drag": "a", "at": 75, "maxDepth": 2, "expected": {"key": "f1", "position": "after"}, "move": {"id": "a", "after": "f1"}},
    {"name": "a group may not go into a row", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "f", "top": 30, "height": 30, "group": true}, {"key": "f1", "top": 60, "height": 30, "depth": 1}, {"key": "f2", "top": 90, "height": 30, "depth": 1}, {"key": "b", "top": 120, "height": 30}, {"key": "g", "top": 150, "height": 30, "group": true}, {"key": "c", "top": 180, "height": 30}], "drag": "g", "at": 135, "maxDepth": 2, "expected": {"key": "b", "position": "after"}, "move": {"id": "g", "after": "b"}},
    {"name": "a group beside a top-level row", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "f", "top": 30, "height": 30, "group": true}, {"key": "f1", "top": 60, "height": 30, "depth": 1}, {"key": "f2", "top": 90, "height": 30, "depth": 1}, {"key": "b", "top": 120, "height": 30}, {"key": "g", "top": 150, "height": 30, "group": true}, {"key": "c", "top": 180, "height": 30}], "drag": "g", "at": 5, "maxDepth": 2, "expected": {"key": "a", "position": "before"}, "move": {"id": "g", "before": "a"}},
    {"name": "a group beside a child = no drop", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "f", "top": 30, "height": 30, "group": true}, {"key": "f1", "top": 60, "height": 30, "depth": 1}, {"key": "f2", "top": 90, "height": 30, "depth": 1}, {"key": "b", "top": 120, "height": 30}, {"key": "g", "top": 150, "height": 30, "group": true}, {"key": "c", "top": 180, "height": 30}], "drag": "g", "at": 65, "maxDepth": 2, "expected": null, "move": null},
    {"name": "a group over its own child = no drop", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "f", "top": 30, "height": 30, "group": true}, {"key": "f1", "top": 60, "height": 30, "depth": 1}, {"key": "f2", "top": 90, "height": 30, "depth": 1}, {"key": "b", "top": 120, "height": 30}, {"key": "g", "top": 150, "height": 30, "group": true}, {"key": "c", "top": 180, "height": 30}], "drag": "f", "at": 65, "maxDepth": 2, "expected": null, "move": null},
    {"name": "a folded group (no children rendered) still counts as a group", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "g", "top": 30, "height": 30, "group": true}, {"key": "b", "top": 60, "height": 30}], "drag": "g", "at": 15, "maxDepth": 2, "expected": {"key": "a", "position": "after"}, "move": {"id": "g", "after": "a"}},
    {"name": "a group dragged after the row above an open group lands before the group", "rows": [{"key": "a", "top": 0, "height": 30}, {"key": "f", "top": 30, "height": 30, "group": true}, {"key": "f1", "top": 60, "height": 30, "depth": 1}, {"key": "f2", "top": 90, "height": 30, "depth": 1}, {"key": "b", "top": 120, "height": 30}, {"key": "g", "top": 150, "height": 30, "group": true}, {"key": "c", "top": 180, "height": 30}], "drag": "g", "at": 20, "maxDepth": 2, "expected": {"key": "a", "position": "after"}, "move": {"id": "g", "after": "a"}},
