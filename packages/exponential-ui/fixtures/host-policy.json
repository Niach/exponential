          "file"
        ]
      },
      "url": "file:///tmp/a.png",
      "expected": {
        "url": "file:///tmp/a.png",
        "headers": {}
      }
    },
    {
      "name": "a data image",
      "options": {},
      "url": "data:image/png;base64,iVBORw0KGgo=",
      "expected": {
        "url": "data:image/png;base64,iVBORw0KGgo=",
        "headers": {}
      }
    },
    {
      "name": "the media host allow-list",
      "options": {
        "hosts": [
          "*.exponential.at"
        ]
      },
      "url": "https://cdn.example/x.png",
      "expected": null
    },
    {
      "name": "an allowed media host",
      "options": {
        "hosts": [
          "*.exponential.at"
        ],
        "rules": [
          {
            "prefix": "https://app.exponential.at/",
            "headers": {
              "authorization": "Bearer t"
            }
          }
        ]
      },
      "url": "https://app.exponential.at/a.png",
      "expected": {
        "url": "https://app.exponential.at/a.png",
        "headers": {
          "authorization": "Bearer t"
        }
      }
    },
    {
      "name": "VAPP-107: a camera on the LAN is denied",
      "options": {},
      "url": "http://192.168.1.10/cam.jpg",
      "expected": null
    },
    {
      "name": "a loopback poster is denied",
      "options": {
        "baseUrl": "http://127.0.0.1:3000"
      },
      "url": "/api/attachments/a1?poster=1",
      "expected": null
    },
    {
      "name": "the dev app opts its own origin in",
      "options": {
        "baseUrl": "http://localhost:3000",
        "allowPrivate": [
          "localhost"
        ],
        "rules": [
          {
