{
  "$comment": "VAPP-91: the pure host rules (catalog/host.json functions, urls, media, sources, negotiation). Inputs hand-written; `expected` filled by the generator from src/host/{policy,sources,package}.ts. VAPP-122: `sourceParams` = sourceWithParams(source, params) → the source URI the `bind` action follows.",
  "functions": [
    {
      "name": "a built-in always runs",
      "policy": {
        "deny": [
          "*"
        ]
      },
      "fn": "formatDate",
      "registered": false,
      "expected": "allow"
    },
    {
      "name": "openUrl is a built-in",
      "fn": "openUrl",
      "registered": false,
      "expected": "allow"
    },
    {
      "name": "an unregistered name",
      "fn": "harness.mcp",
      "registered": false,
      "expected": "not_found"
    },
    {
      "name": "registered, no policy = allow",
      "fn": "harness.toast",
      "registered": true,
      "expected": "allow"
    },
    {
      "name": "a prefix ask",
      "policy": {
        "ask": [
          "harness.*"
        ]
      },
      "fn": "harness.mcp",
      "registered": true,
      "expected": "ask"
    },
    {
      "name": "allow beats ask",
      "policy": {
        "allow": [
          "harness.toast"
        ],
        "ask": [
          "harness.*"
        ]
      },
      "fn": "harness.toast",
      "registered": true,
      "expected": "allow"
    },
    {
      "name": "deny beats allow",
      "policy": {
        "allow": [
          "harness.*"
        ],
        "deny": [
          "harness.mcp"
        ]
      },
      "fn": "harness.mcp",
      "registered": true,
      "expected": "deny"
    },
    {
      "name": "the default when nothing matches",
      "policy": {
        "allow": [
          "harness.toast"
        ],
        "default": "deny"
      },
      "fn": "harness.openIssue",
      "registered": true,
      "expected": "deny"
    },
    {
      "name": "a package allowlist",
      "policy": {
        "allow": [
          "harness.toast",
          "acme.*"
        ],
        "default": "deny"
      },
      "fn": "acme.refresh",
      "registered": true,
      "expected": "allow"
    },
    {
      "name": "a star alone matches everything",
      "policy": {
        "ask": [
          "*"
        ]
      },
      "fn": "x",
      "registered": true,
      "expected": "ask"
    }
  ],
  "combine": [
    {
      "a": "allow",
      "b": "allow",
      "expected": "allow"
    },
    {
      "a": "allow",
      "b": "ask",
      "expected": "ask"
    },
    {
      "a": "allow",
      "b": "deny",
      "expected": "deny"
    },
    {
      "a": "allow",
      "b": "not_found",
      "expected": "not_found"
    },
    {
      "a": "ask",
      "b": "allow",
      "expected": "ask"
    },
    {
      "a": "ask",
      "b": "ask",
      "expected": "ask"
    },
    {
      "a": "ask",
      "b": "deny",
      "expected": "deny"
    },
    {
      "a": "ask",
      "b": "not_found",
      "expected": "not_found"
    },
    {
      "a": "deny",
      "b": "allow",
      "expected": "deny"
    },
    {
      "a": "deny",
      "b": "ask",
      "expected": "deny"
    },
    {
      "a": "deny",
      "b": "deny",
      "expected": "deny"
    },
    {
      "a": "deny",
      "b": "not_found",
      "expected": "not_found"
    },
    {
      "a": "not_found",
      "b": "allow",
      "expected": "not_found"
    },
    {
      "a": "not_found",
      "b": "ask",
      "expected": "not_found"
    },
    {
      "a": "not_found",
      "b": "deny",
      "expected": "not_found"
    },
    {
      "a": "not_found",
      "b": "not_found",
      "expected": "not_found"
    }
  ],
  "urls": [
    {
      "name": "https",
      "url": "https://exponential.at/docs",
      "expected": {
        "allowed": true,
        "url": "https://exponential.at/docs"
      }
    },
    {
      "name": "mailto",
