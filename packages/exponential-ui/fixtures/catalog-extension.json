    {
      "name": "An extension native passes through with its props validated",
      "catalogId": "https://ui.exponential.at/catalogs/example/v1",
      "components": [
        {
          "id": "root",
          "component": "TrendLine",
          "values": [
            2,
            4,
            3
          ],
          "tone": "success"
        }
      ],
      "expected": {
        "root": {
          "id": "root",
          "component": "TrendLine",
          "props": {
            "values": [
              2,
              4,
              3
            ],
            "tone": "success"
          },
          "children": []
        },
        "issues": []
      }
    },
    {
      "name": "A name neither the core nor the extension defines is the placeholder",
      "catalogId": "https://ui.exponential.at/catalogs/example/v1",
      "components": [
        {
          "id": "root",
          "component": "Stack",
          "children": [
            "x"
          ]
        },
        {
          "id": "x",
          "component": "Gauge",
          "value": 1
        }
      ],
      "expected": {
        "root": {
          "id": "root",
          "component": "Box",
          "props": {},
          "children": [
            {
              "id": "x",
              "component": "Unknown",
              "props": {
                "component": "Gauge",
                "catalogId": "https://ui.exponential.at/catalogs/example/v1"
              },
              "children": []
            }
          ],
          "style": {
            "display": "flex",
            "flexDirection": "column",
            "flexWrap": "nowrap",
            "gap": "$spacing.md",
            "alignItems": "stretch",
            "justifyContent": "start"
          },
          "recipe": {
            "macro": "Stack",
            "part": "root",
            "props": {}
          }
        },
        "issues": [
          {
            "id": "x",
            "message": "unknown component Gauge",
            "code": "VALIDATION_FAILED",
            "path": "/components/x/component"
          }
        ]
      }
    },
    {
