                        "macro": "StatCard",
                        "part": "spark",
                        "props": {
                          "trend": "up"
                        }
                      }
                    }
                  ],
                  "style": {
                    "display": "flex",
                    "flexDirection": "column",
                    "gap": "$spacing.md",
                    "padding": "$spacing.lg"
                  },
                  "recipe": {
                    "macro": "Card",
                    "part": "body",
                    "props": {
                      "pressable": true
                    }
                  }
                }
              ],
              "style": {
                "display": "flex",
                "flexDirection": "column",
                "borderRadius": "$radius.xl",
                "overflow": "hidden"
              },
              "recipe": {
                "macro": "Card",
                "part": "root",
                "props": {
                  "pressable": true
                }
              },
              "accessibility": {
                "role": "button"
              },
              "on": {
                "press": {
