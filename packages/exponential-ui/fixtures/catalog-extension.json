              }
            },
            {
              "id": "s2",
              "component": "Box",
              "props": {
                "pressable": false
              },
              "children": [
                {
                  "id": "s2.body",
                  "component": "Box",
                  "props": {},
                  "children": [
                    {
                      "id": "s2.label",
                      "component": "Text",
                      "props": {
                        "text": "Merged",
                        "variant": "muted"
                      },
                      "children": [],
                      "recipe": {
                        "macro": "StatCard",
                        "part": "label",
                        "props": {
                          "trend": "flat"
                        }
                      }
                    },
                    {
                      "id": "s2.row",
                      "component": "Box",
                      "props": {},
                      "children": [
                        {
                          "id": "s2.row.value",
                          "component": "Text",
                          "props": {
                            "text": {
                              "@path": "/merged"
                            },
                            "variant": "title"
                          },
                          "children": [],
                          "recipe": {
                            "macro": "StatCard",
                            "part": "value",
                            "props": {
                              "trend": "flat"
                            }
                          }
                        },
                        {
                          "id": "s2.row.trend",
                          "component": "Icon",
                          "props": {
                            "name": "ui-minus",
                            "size": "sm",
                            "tone": "neutral"
                          },
                          "children": [],
                          "recipe": {
                            "macro": "StatCard",
                            "part": "trend",
