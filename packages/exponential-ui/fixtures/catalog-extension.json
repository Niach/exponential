{
  "$comment": "VAPP-85: the extension mechanism. `extension` is a complete example extension catalog (a native the host paints, a macro with its own template, its own enum); `cases` are hand-written surfaces against the extension's id and against the core id; `expected` is generated by scripts/generate.ts from the TS reference reducer. The Exponential app's own extension (IssueRow, RunRow, IssueChip, …) lives in packages/ui/exponential-ui/extension.json and is validated by @exp/ui's tests through the same defineExtension. Round 9 §5.1: TrendLine declares props named like the envelope mixins (catalogId, accessibility, metadata, checks): bare they are its props, the @ keys stay the envelope.",
  "extension": {
    "id": "https://ui.exponential.at/catalogs/example/v1",
    "name": "Example extension",
    "extends": "https://ui.exponential.at/catalogs/core/v1",
    "enums": {
      "trend": [
        "up",
        "down",
        "flat"
      ]
    },
    "components": {
      "TrendLine": {
        "kind": "native",
        "group": "data",
        "lite": true,
        "children": "none",
        "description": "A tiny inline line chart of recent values, painted by the host.",
        "props": {
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "required": true,
            "description": "The points, oldest first."
          },
          "tone": {
            "type": "enum",
            "enum": "tone",
            "default": "primary",
            "description": "The line colour tone."
          },
          "catalogId": {
            "type": "string",
            "description": "Round 9 §5.1: an ordinary prop named like an envelope mixin."
          },
          "accessibility": {
            "type": "string",
            "description": "Round 9 §5.1: an ordinary prop named like an envelope mixin."
          },
          "metadata": {
            "type": "string",
            "description": "Round 9 §5.1: an ordinary prop named like an envelope mixin."
          },
          "checks": {
            "type": "number",
            "description": "Round 9 §5.1: an ordinary prop named like an envelope mixin."
          }
        },
        "example": {
          "values": [
            1,
            3,
            2,
            5
          ]
        }
      },
      "StatCard": {
        "kind": "macro",
        "group": "data",
        "lite": true,
        "children": "none",
        "description": "A card with a label, a big value and a trend arrow.",
        "props": {
          "label": {
            "type": "string",
            "required": true,
            "description": "What the number is."
          },
          "value": {
            "type": "string",
            "required": true,
            "bindable": true,
            "description": "The formatted number."
          },
          "trend": {
            "type": "enum",
            "enum": "trend",
            "default": "flat",
            "description": "Which way it moved."
          },
          "history": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Recent values for the sparkline."
          }
        },
        "events": [
          "press"
        ],
        "example": {
          "label": "Open issues",
          "value": "42",
          "trend": "up"
        }
      }
    },
    "macros": {
      "StatCard": {
        "recipeProps": [
          "trend"
        ],
        "root": {
          "part": "root",
          "component": "Card",
          "props": {
            "padded": true
          },
          "children": [
            {
              "part": "label",
              "component": "Text",
              "props": {
                "text": "{props.label}",
                "variant": "muted"
              }
            },
            {
              "part": "row",
              "component": "Stack",
              "props": {
                "direction": "horizontal",
                "align": "center",
                "gap": "sm"
              },
              "children": [
                {
                  "part": "value",
                  "component": "Text",
                  "props": {
                    "text": "{props.value}",
                    "variant": "title"
                  }
                },
                {
                  "part": "trend",
                  "component": "Icon",
                  "props": {
                    "name": {
                      "$map": {
                        "from": "props.trend",
                        "cases": {
                          "up": "ui-chevron-up",
                          "down": "ui-chevron-down"
                        },
                        "default": "ui-minus"
                      }
                    },
                    "size": "sm",
                    "tone": {
                      "$map": {
                        "from": "props.trend",
                        "cases": {
                          "up": "success",
                          "down": "danger"
                        },
                        "default": "neutral"
                      }
                    }
                  }
                }
              ]
            },
            {
              "part": "spark",
              "component": "TrendLine",
              "$if": "props.history",
              "props": {
                "values": "{props.history}"
              }
            }
          ]
        }
      }
    }
  },
  "cases": [
    {
      "name": "An extension macro expands through a core macro into natives, keeping the extension's native",
      "catalogId": "https://ui.exponential.at/catalogs/example/v1",
      "components": [
        {
          "id": "root",
          "component": "Stack",
          "direction": "vertical",
          "children": [
            "s1",
            "s2"
          ]
        },
        {
          "id": "s1",
          "component": "StatCard",
          "label": "Open issues",
          "value": "42",
          "trend": "up",
          "history": [
            1,
            3,
            2,
            5
          ],
          "on": {
            "press": {
              "event": {
