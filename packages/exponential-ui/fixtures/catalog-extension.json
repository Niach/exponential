            "id": "x",
            "message": "unknown component TrendLine",
            "code": "VALIDATION_FAILED",
            "path": "/components/x/component"
          }
        ]
      }
    },
    {
      "name": "bare mixin names the component declares are ordinary props, the @ keys the envelope",
      "catalogId": "https://ui.exponential.at/catalogs/example/v1",
      "components": [
        {
          "id": "root",
          "component": "TrendLine",
          "values": [
            1,
            2
          ],
          "catalogId": "c",
          "accessibility": "a",
          "metadata": "m",
          "checks": 3,
          "@catalogId": "https://ui.exponential.at/catalogs/example/v1",
          "@accessibility": {
            "label": "Trend"
          },
          "@metadata": {
            "extensions": {
              "acme": 1
            }
          }
        }
      ],
      "expected": {
        "root": {
          "id": "root",
          "component": "TrendLine",
          "props": {
            "values": [
              1,
              2
            ],
            "catalogId": "c",
            "accessibility": "a",
            "metadata": "m",
            "checks": 3
          },
          "children": [],
          "accessibility": {
            "label": "Trend"
          },
          "metadata": {
            "extensions": {
              "acme": 1
            }
          }
        },
        "issues": []
      }
    },
    {
      "name": "bare mixin names nothing declares are dropped with an issue; @checks needs the check mixin",
      "catalogId": "https://ui.exponential.at/catalogs/example/v1",
      "components": [
        {
          "id": "root",
          "component": "Stack",
          "children": [
            "t",
            "i"
          ],
          "accessibility": {
            "label": "x"
          },
          "catalogId": "c",
          "metadata": {},
          "checks": []
        },
        {
          "id": "t",
          "component": "TrendLine",
          "values": [
            1
          ],
          "@checks": [
            {
              "condition": {
                "@path": "/ok"
              }
            }
          ]
        },
        {
          "id": "i",
          "component": "Input",
          "label": "L",
          "name": "n",
          "value": "",
          "@checks": [
            {
              "condition": {
                "@path": "/ok"
              }
            }
          ]
        }
      ],
      "expected": {
        "root": {
          "id": "root",
          "component": "Box",
          "props": {},
          "children": [
            {
              "id": "t",
              "component": "TrendLine",
              "props": {
                "values": [
                  1
                ]
              },
              "children": []
            },
            {
              "id": "i",
              "component": "Input",
              "props": {
                "label": "L",
                "name": "n",
                "value": "",
                "checks": [
                  {
                    "condition": {
                      "@path": "/ok"
                    }
                  }
                ]
              },
              "children": []
            }
          ],
          "style": {
            "display": "flex",
            "flexDirection": "column",
            "flexWrap": "nowrap",
            "gap": "$spacing.md",
            "alignItems": "stretch",
            "justifyContent": "start"
          },
          "recipe": {
            "macro": "Stack",
            "part": "root",
            "props": {}
          }
        },
        "issues": [
          {
            "id": "root",
            "message": "catalogId is not a declared prop (write @catalogId)",
            "code": "INVALID_MESSAGE",
            "path": "/components/root/catalogId"
          },
          {
            "id": "root",
            "message": "accessibility is not a declared prop (write @accessibility)",
            "code": "INVALID_MESSAGE",
            "path": "/components/root/accessibility"
          },
          {
            "id": "root",
            "message": "metadata is not a declared prop (write @metadata)",
            "code": "INVALID_MESSAGE",
            "path": "/components/root/metadata"
          },
          {
            "id": "root",
            "message": "checks is not a declared prop (write @checks)",
            "code": "INVALID_MESSAGE",
            "path": "/components/root/checks"
          },
          {
            "id": "t",
            "message": "takes no @checks",
            "code": "VALIDATION_FAILED",
            "path": "/components/t/@checks"
          }
        ]
      }
    }
  ]
