                  }
                }
              ],
              "style": {
                "display": "flex",
                "flexDirection": "column",
                "borderRadius": "$radius.xl",
                "overflow": "hidden"
              },
              "recipe": {
                "macro": "Card",
                "part": "root",
                "props": {
