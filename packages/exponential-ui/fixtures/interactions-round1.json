{
  "$comment": "Round 1 review (renderer hardening): interaction semantics every renderer must share, HAND-AUTHORED and replayed by packages/exponential-ui-react/src/interactions-fixture.test.tsx (the reference, jsdom) and apps/desktop/crates/exponential-ui/tests/interactions_fixture.rs (the core, so gpui and the natives through the FFI). numberField: a NumberField bound to /v (value null = /v unseeded), one op (increment / decrement press, commit = type `input` then leave the field, none), then the value at /v and the text the field shows (en-US; `precision` absent = the step's decimals; values round like toFixed, the text like Intl.NumberFormat with that many fraction digits; a stepper on an unset value starts from min when min > 0, else 0; a stepper at its limit is disabled). checks: a Form `f` holding Checkbox `agree` (checked bound to /agreed) with `checks` and a submit Button; submitting gives the failing messages in order (a check WITH a condition fails when it resolves to nothing, null, false or an empty string; 0 passes; a non-string message reads `Invalid value`) and whether `submit` fired. tableSort: an UNBOUND sort of literal rows by one column (`sortRows`: missing values last both ways, two numbers numerically, a number column coerces, a date column by time, booleans as 0/1, the rest by Intl.Collator(locale, {numeric: true, sensitivity: base}); ties keep row order) → the row indexes in display order.",
  "numberField": [
    {
      "name": "step 0.1 increments without float noise",
      "props": {
        "step": 0.1
      },
      "value": 0.2,
      "op": "increment",
      "expect": {
        "value": 0.3,
        "text": "0.3"
      }
    },
    {
      "name": "step 0.1 decrements without float noise",
      "props": {
        "step": 0.1
      },
      "value": 0.3,
      "op": "decrement",
      "expect": {
        "value": 0.2,
        "text": "0.2"
      }
    },
    {
      "name": "step 0.25 shows two decimals",
      "props": {
        "step": 0.25
      },
      "value": 1,
      "op": "increment",
      "expect": {
        "value": 1.25,
        "text": "1.25"
      }
    },
    {
      "name": "precision 0 shows 2.5 as 3 (half away from zero)",
      "props": {
        "precision": 0
      },
      "value": 2.5,
      "op": "none",
      "expect": {
        "value": 2.5,
        "text": "3"
      }
    },
    {
      "name": "precision 0 steps 1.5 to 3 (toFixed rounds 2.5 up)",
      "props": {
        "precision": 0
      },
      "value": 1.5,
      "op": "increment",
      "expect": {
        "value": 3,
        "text": "3"
      }
    },
    {
      "name": "precision 2 shows 0.125 as 0.13",
      "props": {
        "precision": 2
      },
      "value": 0.125,
      "op": "none",
      "expect": {
        "value": 0.125,
        "text": "0.13"
      }
    },
    {
      "name": "the text rounds the shortest decimal: 1.005 shows 1.01",
      "props": {
        "precision": 2
      },
      "value": 1.005,
      "op": "none",
      "expect": {
        "value": 1.005,
        "text": "1.01"
      }
    },
    {
      "name": "the text groups thousands",
      "props": {
        "precision": 1
      },
      "value": 1234.55,
      "op": "none",
      "expect": {
        "value": 1234.55,
        "text": "1,234.6"
      }
    },
    {
      "name": "an unset value with a negative min steps from 0",
      "props": {
        "min": -10
      },
      "value": null,
      "op": "increment",
      "expect": {
        "value": 1,
        "text": "1"
      }
    },
    {
      "name": "an unset value with a positive min steps from min",
      "props": {
        "min": 5
      },
      "value": null,
      "op": "increment",
      "expect": {
        "value": 6,
        "text": "6"
      }
    },
    {
      "name": "the stepper at max is disabled",
      "props": {
        "max": 3
      },
      "value": 3,
      "op": "increment",
      "expect": {
        "value": 3,
        "text": "3"
      }
    },
    {
      "name": "a commit rounds to the step's decimals",
      "props": {
        "step": 0.1
      },
      "value": 1,
      "op": "commit",
      "input": "0.123",
      "expect": {
        "value": 0.1,
        "text": "0.1"
      }
    },
    {
      "name": "a commit clamps to max",
      "props": {
        "min": 0,
        "max": 10
      },
      "value": 5,
      "op": "commit",
      "input": "42",
      "expect": {
        "value": 10,
        "text": "10"
      }
    }
  ],
