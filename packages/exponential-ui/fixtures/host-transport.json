{
  "$comment": "VAPP-91: the wire decoders (catalog/host.json transport). Inputs hand-written; `expected` filled by `bun run --filter @exponential-at/ui generate` from the TS reference (src/host/decoders.ts). Every renderer's conformance runner replays it: feed `chunks` in order through ONE decoder, then end().",
  "jsonl": [
    {
      "name": "one message per line",
      "chunks": [
        "{\"version\": \"v0.9\", \"createSurface\": {\"surfaceId\": \"s1\", \"catalogId\": \"https://ui.exponential.at/catalogs/core/v1\"}}\n{\"version\": \"v0.9\", \"updateComponents\": {\"surfaceId\": \"s1\", \"components\": [{\"id\": \"root\", \"component\": \"Text\", \"text\": \"Hi\"}]}}\n"
      ],
      "expected": {
        "messages": [
          {
            "version": "v0.9",
            "createSurface": {
              "surfaceId": "s1",
              "catalogId": "https://ui.exponential.at/catalogs/core/v1"
            }
          },
          {
            "version": "v0.9",
            "updateComponents": {
              "surfaceId": "s1",
              "components": [
                {
                  "id": "root",
                  "component": "Text",
                  "text": "Hi"
                }
              ]
            }
          }
        ],
        "issues": []
      }
    },
    {
