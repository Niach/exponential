  "currentCases": [
    {
      "name": "no current",
      "highlight": {
        "query": "a"
      },
      "local": -1
    },
    {
      "name": "current in this node",
      "highlight": {
        "query": "a",
        "current": 1
      },
      "local": 1
    },
    {
      "name": "before takes its matches off",
      "highlight": {
        "query": "a",
        "current": 3,
