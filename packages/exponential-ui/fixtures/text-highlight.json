      "query": "aa",
      "ranges": [
        [
          0,
          2
        ],
        [
          2,
          4
        ]
      ],
      "matches": [
        "aa",
        "aa"
      ]
    },
    {
      "name": "astral characters (UTF-16 offsets)",
      "text": "🚀 launch 🚀 Launch",
