  "rules": [
    {
      "group": "switch order",
      "right": "gpui",
      "fix": [
        "react"
      ],
      "decision": "Switch = [label + description column][switch], label first, the track at the END (trailing edge in rtl), like iOS/shadcn settings rows; the whole row toggles. Checkbox and Radio keep the control first."
    },
    {
      "group": "checkbox label overlap",
      "right": "gpui",
      "fix": [
        "react"
      ],
      "decision": "Checkbox = [box][`Checkbox/root` gap][label + description column]; the label never overlaps the box."
    },
    {
      "group": "input placeholder inset",
      "right": "web",
      "fix": [
        "gpui"
      ],
      "decision": "Text inside a field starts at the field's border + `paddingHorizontal` (14 = 1 + 12 + rounding under neutral); no painter padding of its own."
    },
    {
      "group": "accordion count",
      "right": "web",
      "fix": [
        "gpui",
        "react"
      ],
      "decision": "An accordion item's `count` is its own part `Accordion/count` after the title (muted), never concatenated into the title text (`History · 4`)."
    },
    {
      "group": "image fallbacks",
      "right": "contract",
      "fix": [
        "react",
        "gpui"
      ],
      "decision": "`Image/fallback` fills the image box (its recipe colours) with the glyph (`fallback` or `Image.fallback`) at `$control.iconLg`, centred."
    },
    {
      "group": "carousel pages",
      "right": "gpui",
      "fix": [
        "react",
        "contract"
      ],
      "decision": "Only the ACTIVE carousel page is placed; inactive pages are aria-hidden and inert, may stay mounted for swiping, and carry `data-xui-inactive` (the web dump skips them)."
    },
    {
      "group": "rtl bidi",
      "right": "web",
      "fix": [
        "gpui"
      ],
      "decision": "Text shapes with the Unicode Bidi Algorithm, paragraph direction = the NODE's direction (`Hello!` in an rtl box shows `!Hello`)."
    },
    {
      "group": "resp-states line breaks",
      "right": "contract",
      "fix": [
        "survivor"
      ],
      "decision": "Line breaking = UAX #14 on both sides.",
      "reason": "No origin in the 2026-10-08 report; kept as a watch item: two text engines may still break one word differently near a box edge, which the ±1 line tolerance absorbs."
    },
    {
      "group": "coverage",
      "right": "contract",
      "fix": [
        "react"
      ],
      "decision": "Every part a painter lays out is a recipes.json part and carries `data-xui-id=\"<node id>.<part>[.<index or row key>]\"` + `data-xui-part` (the 110 gpui-only ids per kitchen-sink case are those parts); thumbs, the Slider range and decorations are paint parts and are not dumped."
    }
  ],
