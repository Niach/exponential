  "package": {
    "formatVersion": 4,
    "id": "acme.hours",
    "name": "Hours",
    "version": "1.0.0",
    "catalogId": "https://ui.exponential.at/catalogs/core/v1",
    "functions": [
      "harness.toast"
    ],
    "records": {
      "entry": {
        "title": "Entry",
        "schema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "hours": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            "note": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "date",
            "hours"
          ]
        }
      }
    },
    "templates": {
      "month": {
        "components": [
          {
            "id": "root",
            "component": "Stack",
            "children": [
              "total",
              "log"
            ]
          },
          {
            "id": "total",
            "component": "Text",
            "text": {
              "call": "expr",
              "args": {
                "expr": "formatDuration(h, 'h:mm')",
                "vars": {
                  "h": {
                    "path": "/form/hours"
                  }
                },
                "default": null
              }
            }
          },
          {
            "id": "log",
            "component": "Button",
            "on": {
              "press": {
                "functionCall": {
                  "call": "actions.log",
                  "args": {
                    "date": {
                      "path": "/form/date"
                    },
                    "hours": {
                      "path": "/form/hours"
                    }
                  }
                }
              }
            },
            "label": "Log"
          }
        ],
        "data": {
          "form": {
            "date": "2026-11-02",
            "hours": 7.5
          }
        }
      }
    },
    "actions": {
      "log": {
        "params": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "hours": {
              "type": "number"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "date",
            "hours"
          ]
        },
        "steps": [
          {
            "require": "params.hours > 0",
            "message": "Log more than 0 hours"
          },
          {
            "require": "params.hours <= 24",
            "message": "A day has 24 hours"
          },
          {
            "records.upsert": {
              "kind": "entry",
              "data": {
                "date": "params.date",
                "hours": "params.hours",
                "note": "params.note"
              }
            }
          },
          {
            "set": {
              "path": "/form/hours",
              "value": 0
            }
          },
          {
            "call": "harness.toast",
            "args": {
              "message": "'Logged ' + formatDuration(params.hours, 'h:mm')"
            }
          }
        ]
      },
      "move": {
        "params": {
          "type": "object",
          "properties": {
            "entryId": {
              "type": "string"
            },
            "to": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "entryId",
            "to"
          ]
        },
        "steps": [
          {
            "records.upsert": {
              "kind": "entry",
              "id": "params.entryId",
              "data": {
                "date": "params.to"
              }
            }
          }
        ]
      },
      "remove": {
        "params": {
          "type": "object",
          "properties": {
            "entryId": {
              "type": "string"
            }
          },
          "required": [
            "entryId"
          ]
        },
        "steps": [
          {
            "require": "data.locked != true",
            "message": "This month is locked"
          },
          {
            "records.delete": {
              "id": "params.entryId"
            }
          }
        ]
      },
      "swap": {
        "params": {
          "type": "object",
          "properties": {
            "a": {
              "type": "string"
            },
            "b": {
              "type": "string"
            }
          },
          "required": [
            "a",
            "b"
          ]
        },
        "steps": [
          {
            "records.upsert": {
              "kind": "entry",
              "id": "params.a",
              "data": {
                "hours": 8
              }
            }
          },
          {
            "records.delete": {
              "id": "params.b"
            }
          }
        ]
      },
      "count": {
        "steps": [
          {
            "set": {
              "path": "/count",
              "value": "orElse(data.count, 0) + 1"
            }
          },
          {
            "require": "data.count == 0",
            "message": "the steps saw a later count"
          },
          {
            "set": {
              "path": "/seen",
              "value": "data.count"
            }
          }
        ]
      },
      "tenfold": {
        "params": {
          "type": "object",
          "properties": {
            "hours": {
              "type": "number"
            }
          },
          "required": [
            "hours"
          ]
        },
        "steps": [
          {
            "records.upsert": {
              "kind": "entry",
              "data": {
                "date": "today()",
                "hours": "params.hours * 10"
              }
            }
          }
        ]
      },
      "half": {
        "steps": [
          {
            "set": {
              "path": "/x",
              "value": "orElse(data.total, 0) / orElse(data.days, 1)"
            }
          }
        ]
      },
      "whoami": {
        "steps": [
          {
            "require": "me != null",
            "message": "Sign in first"
          },
          {
            "set": {
              "path": "/me",
              "value": "me"
            }
          },
          {
            "set": {
              "path": "/day",
              "value": "today()"
            }
          }
        ]
      },
      "spin": {
        "steps": [
          {
            "set": {
              "path": "/a",
              "value": "orElse(data.xs, []).map(x, x)"
            }
          },
          {
            "set": {
              "path": "/b",
              "value": "orElse(data.xs, []).map(x, x)"
            }
          },
          {
            "set": {
              "path": "/c",
              "value": "orElse(data.xs, []).map(x, x)"
            }
          }
        ]
      },
      "check": {
        "steps": [
          {
            "require": "orElse(data.n, false)",
            "message": "never"
          }
        ]
      },
      "pick": {
        "params": {
          "type": "object",
          "properties": {
            "stage": {
              "type": "string",
              "enum": ["lead", "won"]
            }
          },
          "required": ["stage"]
        },
        "steps": [
          {
            "set": {
              "path": "/form/stage",
              "value": "params.stage"
            }
          }
        ]
      }
    }
  },
