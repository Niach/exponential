  "hostCalls": {
    "package": {
      "formatVersion": 4,
      "id": "acme.steps",
      "name": "Steps",
      "version": "1.0.0",
      "catalogId": "https://ui.exponential.at/catalogs/core/v1",
      "sources": ["records:*"],
      "functions": ["bind", "openUrl"],
      "records": { "entry": { "schema": { "type": "object", "properties": { "day": { "type": "string" } } } } },
      "templates": { "main": { "components": [{ "id": "root", "component": "Stack", "children": [] }], "data": { "rows": [] } } },
      "actions": {
        "refresh": {
          "params": { "type": "object", "properties": { "day": { "type": "string" } }, "required": ["day"] },
          "steps": [{ "call": "bind", "args": { "path": "'/rows'", "source": "'records:entry?day=' + params.day" } }]
        },
        "foreign": { "steps": [{ "call": "bind", "args": { "path": "'/rows'", "source": "'exp:issues'" } }] },
        "open": {
          "params": { "type": "object", "properties": { "url": { "type": "string" } }, "required": ["url"] },
          "steps": [{ "call": "openUrl", "args": { "url": "params.url" } }]
        }
      }
    },
    "cases": [
      { "name": "a bind step re-binds the path", "action": "refresh", "args": { "day": "2026-11-03" }, "bound": { "day": "2026-11-03" }, "opened": [] },
      { "name": "a bind step outside the package's sources is the outcome's error", "action": "foreign", "args": {}, "opened": [], "error": "bind was not allowed" },
      { "name": "an openUrl step opens the url", "action": "open", "args": { "url": "https://docs.example.com/a" }, "opened": ["https://docs.example.com/a"] },
      { "name": "an openUrl step the URL policy refuses is the outcome's error", "action": "open", "args": { "url": "javascript:alert(1)" }, "opened": [], "error": "openUrl was not allowed" }
    ]
  }
}
