{
  "$comment": "EXP-1605: dotLottie state machines in eUI Motion (apps/desktop/crates/eui-motion/src/state_machine.rs), the ONE interpreter every renderer uses. A case = a machine (the dotLottie 2 JSON a Motion's `stateMachine` prop or a .lottie `s/` file carries) + steps; each step: `post` an interaction (click|pointerDown|pointerUp|pointerEnter|pointerExit|complete|loopComplete, `layer` = the hit layer) and/or `set` inputs (a bound eUI `inputs` value) and/or `complete` (the state's playback finished: its guard-less transition), then the expected `state`, the states `entered` since the previous step (hosts send each as the Motion's `on.state` action, context {state}), `final`, the state's playback `range` [from, to) in frames and `autoplay` on the timeline 30 fps / ip 0 / op 30 with markers low = 0..10 and high = 10..30, and the `inputs` after the step. Replayed by eui-motion tests/state_machine.rs (UPDATE_MOTION_FIXTURES=1 rewrites), over WASM (TS) and uniffi (Swift, Kotlin).",
  "lottie": {
    "v": "5.12.0",
    "fr": 30,
    "ip": 0,
    "op": 30,
    "w": 10,
    "h": 10,
    "layers": [],
    "markers": [
      {
        "cm": "low",
        "tm": 0,
        "dr": 10
      },
      {
        "cm": "high",
        "tm": 10,
        "dr": 20
      }
    ]
  },
  "cases": [
    {
      "id": "toggle-on-click",
      "covers": "a button that plays `on` / `off` segments, toggled by clicks",
      "machine": {
        "initial": "off",
        "inputs": [
          {
            "type": "Boolean",
            "name": "on",
            "value": false
          }
        ],
        "interactions": [
          {
            "type": "Click",
            "actions": [
              {
                "type": "Toggle",
                "inputName": "on"
              }
            ]
          }
        ],
        "states": [
          {
            "name": "off",
            "type": "PlaybackState",
            "segment": [
              0,
              10
            ],
            "loop": false,
            "autoplay": true,
            "transitions": [
              {
                "type": "Transition",
                "toState": "on",
                "guards": [
                  {
                    "type": "Boolean",
                    "inputName": "on",
                    "conditionType": "Equal",
                    "compareTo": true
                  }
                ]
              }
            ]
          },
          {
            "name": "on",
            "type": "PlaybackState",
            "segment": [
              10,
              20
            ],
            "loop": false,
            "autoplay": true,
            "transitions": [
              {
                "type": "Transition",
                "toState": "off",
                "guards": [
                  {
                    "type": "Boolean",
                    "inputName": "on",
                    "conditionType": "Equal",
                    "compareTo": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "initial": {
        "state": "off",
        "entered": [
          "off"
        ],
        "final": false,
        "range": [
          0.0,
          10.0
        ],
        "autoplay": true,
        "inputs": {
          "on": false
        }
      },
      "steps": [
        {
          "state": "on",
          "entered": [
            "on"
          ],
          "final": false,
          "range": [
            10.0,
            20.0
          ],
          "autoplay": true,
          "inputs": {
            "on": true
          },
          "step": {
            "post": "click"
          }
        },
        {
          "state": "off",
          "entered": [
            "off"
          ],
          "final": false,
          "range": [
            0.0,
            10.0
          ],
          "autoplay": true,
          "inputs": {
            "on": false
          },
          "step": {
            "post": "click"
          }
        },
        {
          "state": "off",
          "entered": [],
          "final": false,
          "range": [
            0.0,
            10.0
          ],
          "autoplay": true,
          "inputs": {
            "on": false
          },
          "step": {
            "post": "pointerEnter"
          }
        }
      ]
    },
