    {
      "id": "progress-thresholds",
      "covers": "a bound numeric input picks a state by threshold (eUI `inputs` binding)",
      "machine": {
        "initial": "low",
        "inputs": [
          {
            "type": "Numeric",
            "name": "level",
            "value": 0
          }
        ],
        "states": [
          {
            "name": "low",
            "type": "PlaybackState",
            "marker": "low",
            "transitions": [
              {
                "type": "Transition",
                "toState": "high",
                "guards": [
                  {
                    "type": "Numeric",
                    "inputName": "level",
                    "conditionType": "GreaterThanOrEqual",
                    "compareTo": 50
                  }
                ]
              }
            ]
          },
          {
            "name": "high",
            "type": "PlaybackState",
            "marker": "high",
            "transitions": [
              {
                "type": "Transition",
                "toState": "done",
                "guards": [
                  {
                    "type": "Numeric",
                    "inputName": "level",
                    "conditionType": "Equal",
                    "compareTo": 100
                  }
                ]
              },
              {
                "type": "Transition",
                "toState": "low",
                "guards": [
                  {
                    "type": "Numeric",
                    "inputName": "level",
                    "conditionType": "LessThan",
                    "compareTo": 50
                  }
                ]
              }
            ]
          },
          {
            "name": "done",
            "type": "PlaybackState",
            "segment": [
              29,
              30
            ],
            "final": true,
            "transitions": [
              {
                "type": "Transition",
                "toState": "low",
                "guards": [
                  {
                    "type": "Numeric",
                    "inputName": "level",
                    "conditionType": "LessThan",
                    "compareTo": 50
                  }
                ]
              }
            ]
          }
        ]
      },
