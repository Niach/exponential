    {
      "id": "counter-actions",
      "covers": "clicks increment a counter; three clicks reach `burst`; a layer-scoped interaction ignores other layers",
      "machine": {
        "initial": "rest",
        "inputs": [
          {
            "type": "Numeric",
            "name": "n",
            "value": 0
          }
        ],
        "interactions": [
          {
            "type": "Click",
            "layerName": "button",
            "actions": [
              {
                "type": "Increment",
                "inputName": "n",
                "value": 1
              }
            ]
          }
        ],
        "states": [
          {
            "name": "rest",
            "type": "PlaybackState",
            "segment": [
              0,
              5
