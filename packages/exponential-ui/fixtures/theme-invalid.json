{
  "$comment": "VAPP-92: themes that must FAIL to load with a readable issue list, never a crash. The generator fills `issues` from the TS validator; every renderer's loader reports the same paths (the wording may differ on a native, the paths may not). A case's `theme` is any JSON value.",
  "cases": [
    {
      "name": "not an object",
      "theme": "neutral",
      "issues": [
        {
          "path": "theme",
          "message": "expected a theme object {id, name, modes, tokens, recipes}"
        }
      ]
    },
    {
      "name": "missing id and name",
      "theme": {
        "$schema": "https://ui.exponential.at/schemas/theme/v1.json",
        "modes": {}
      },
      "issues": [
        {
          "path": "id",
          "message": "expected a kebab-case id"
        },
        {
          "path": "name",
          "message": "expected a name"
        }
      ]
    },
    {
      "name": "Round 4: no $schema",
      "theme": {
        "id": "t",
        "name": "T",
        "extends": "neutral"
      },
      "issues": [
        {
          "path": "$schema",
          "message": "expected \"https://ui.exponential.at/schemas/theme/v1.json\""
        }
      ]
    },
    {
      "name": "Round 4: another $schema",
      "theme": {
        "$schema": "https://ui.exponential.at/schemas/theme/v0.json",
        "id": "t",
        "name": "T",
        "extends": "neutral"
      },
      "issues": [
        {
          "path": "$schema",
          "message": "expected \"https://ui.exponential.at/schemas/theme/v1.json\""
        }
      ]
    },
