{
  "$comment": "VAPP-92: the RECIPE contract. A theme styles a component PART under a `when` selector (the node's recipe props + the interaction `state`); this file fixes what a theme may name. `states` = the interaction states a painter reports (`default` is the absence of all); `keys` = the whitelist a recipe style may set: a SUBSET of style.json's visual keys plus the padding/gap/size keys a part's box needs and `native` (true = the painter may use the platform's own control for this part, geometry still from the tokens). `native` lists every native component's PARTS (the painter paints each part with its resolved recipe) and the PROPS a `when` may key on (the component's enum/boolean props; the catalog default fills an unset one, so a theme always sees a concrete value). Macro parts come from macros.json (every template `part`) and their `when` props from the macro's `recipeProps` (+ a part's `$recipe` keys); src/recipes.ts derives them. Both lists are append-only.",
  "states": ["hover", "pressed", "focus", "disabled", "checked", "open", "selected"],
  "keys": [
    "backgroundColor", "color", "borderColor", "borderWidth", "borderRadius",
    "padding", "paddingHorizontal", "paddingVertical", "gap",
    "width", "height", "minWidth", "minHeight",
    "fontSize", "fontWeight", "lineHeight", "fontFamily",
    "boxShadow", "opacity", "native"
  ],
  "native": {
    "Box": { "parts": ["root"], "props": ["pressable"] },
    "List": { "parts": ["root", "divider"], "props": ["direction", "divided"] },
    "Text": { "parts": ["root"], "props": ["variant", "tone"] },
    "Markdown": { "parts": ["root", "paragraph", "heading", "link", "code", "codeBlock", "quote", "table", "listItem"], "props": [] },
    "Image": { "parts": ["root"], "props": ["fit"] },
    "Icon": { "parts": ["root"], "props": ["size", "tone"] },
    "Video": { "parts": ["root", "controls", "poster"], "props": ["autoplay"] },
    "AudioPlayer": { "parts": ["root", "controls", "track"], "props": [] },
    "Avatar": { "parts": ["root", "image", "fallback"], "props": ["size"] },
    "Carousel": { "parts": ["root", "page", "indicator"], "props": ["loop", "indicators"] },
    "Tabs": { "parts": ["root", "list", "tab", "indicator", "content"], "props": ["fill"] },
    "ToggleGroup": { "parts": ["root", "item"], "props": ["type", "variant", "size", "fill"] },
    "Accordion": { "parts": ["root", "item", "trigger", "content"], "props": ["type"] },
    "Dialog": { "parts": ["overlay", "content", "title", "description", "footer", "close"], "props": ["dismissible"] },
    "Drawer": { "parts": ["overlay", "content", "handle", "title", "description", "footer"], "props": ["side"] },
    "Popover": { "parts": ["content", "arrow"], "props": ["side"] },
    "Tooltip": { "parts": ["content", "arrow"], "props": ["side"] },
    "DropdownMenu": { "parts": ["trigger", "content", "item", "separator", "label"], "props": [] },
    "Ring": { "parts": ["root", "track", "fill", "label"], "props": ["size", "tone"] },
    "Spinner": { "parts": ["root"], "props": ["size"] },
    "Skeleton": { "parts": ["root"], "props": ["rounded"] },
    "Chart": { "parts": ["root", "axis", "grid", "legend", "tooltip"], "props": ["kind"] },
    "Button": { "parts": ["root", "icon", "label", "spinner"], "props": ["variant", "size", "disabled", "loading"] },
    "Link": { "parts": ["root"], "props": ["external"] },
    "Toggle": { "parts": ["root", "icon", "label"], "props": ["variant", "size", "pressed"] },
    "Input": { "parts": ["root", "label", "field", "placeholder", "description", "error"], "props": ["type", "disabled"] },
    "Textarea": { "parts": ["root", "label", "field", "placeholder", "description", "error"], "props": ["disabled"] },
    "Checkbox": { "parts": ["root", "box", "check", "label", "description"], "props": ["checked", "disabled"] },
    "Radio": { "parts": ["root", "item", "dot", "label"], "props": ["orientation"] },
    "Switch": { "parts": ["root", "track", "thumb", "label", "description"], "props": ["checked", "disabled"] },
    "Slider": { "parts": ["root", "track", "range", "thumb", "label", "value"], "props": [] },
    "Select": { "parts": ["root", "label", "trigger", "placeholder", "content", "item", "check"], "props": ["multiple", "searchable", "disabled"] },
    "DatePicker": { "parts": ["root", "label", "trigger", "calendar", "day"], "props": [] },
    "Composer": { "parts": ["root", "field", "placeholder", "attachment", "send"], "props": ["attachments", "busy"] },
    "TreeGuides": { "parts": ["root", "line"], "props": ["tee"] },
    "Unknown": { "parts": ["root", "label"], "props": [] }
  }
}
