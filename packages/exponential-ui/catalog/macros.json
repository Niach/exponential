          { "part": "guides", "component": "TreeGuides", "$if": { "$lt": [0, "{props.depth|0}"] }, "props": { "depth": "{props.depth}" } },
          "$slot:leading",
          { "part": "icon", "component": "Icon", "$if": "props.icon", "props": { "name": "{props.icon}", "size": "sm" } },
          { "part": "identifier", "component": "Text", "$if": "props.identifier", "props": { "text": "{props.identifier}", "variant": "code", "lines": 1 }, "style": { "flexShrink": 0 } },
          {
            "part": "body", "component": "Box",
            "style": { "display": "flex", "flexDirection": "column", "gap": "$spacing.xxs", "flexGrow": 1, "minWidth": 0 },
            "children": [
              { "part": "title", "component": "Text", "props": { "text": "{props.title}", "variant": "body", "lines": 1 } },
              { "part": "subtitle", "component": "Text", "$if": "props.subtitle", "props": { "text": "{props.subtitle}", "variant": "muted", "lines": 1 } }
            ]
          },
          { "part": "meta", "component": "Text", "$if": "props.meta", "props": { "text": "{props.meta}", "variant": "muted", "lines": 1 } },
          { "part": "value", "component": "Text", "$any": ["props.value", "props.placeholder"], "props": { "text": { "$coalesce": ["{props.value}", "{props.placeholder}"] }, "variant": { "$cond": ["props.value", "body", "muted"] }, "lines": 1, "align": "end" } },
          "$slot:trailing",
          { "part": "chevron", "component": "Icon", "$if": { "$not": { "$eq": ["{props.chevron|none}", "none"] } }, "props": { "name": { "$map": { "from": "props.chevron", "cases": { "selector": "ui-selector" }, "default": "ui-chevron-right" } }, "size": "sm", "tone": "neutral" } }
        ]
      }
    },
    "ListRow": {
      "recipeProps": [],
      "root": { "part": "root", "component": "Row", "props": { "title": "{props.title}", "subtitle": "{props.subtitle}", "meta": "{props.meta}", "icon": "{props.icon}", "selected": "{props.selected|false}", "density": "{props.density|default}", "chevron": { "$cond": ["props.chevron", "right", "none"] }, "pressable": true }, "$on": { "press": "press" } }
    },
    "CardRow": {
      "recipeProps": [],
      "root": { "part": "root", "component": "Row", "props": { "title": "{props.title}", "subtitle": "{props.subtitle}", "meta": "{props.meta}", "icon": "{props.icon}", "surface": "card", "pressable": true }, "$on": { "press": "press" } }
    },
    "PropertyRow": {
      "recipeProps": [],
      "root": { "part": "root", "component": "Row", "props": { "title": "{props.label}", "value": "{props.value}", "icon": "{props.icon}" } }
    },
    "PickerRow": {
      "recipeProps": [],
      "root": { "part": "root", "component": "Row", "props": { "title": "{props.label}", "value": "{props.value}", "placeholder": "{props.placeholder|$string.choose}", "icon": "{props.icon}", "chevron": "selector", "pressable": true }, "$on": { "press": "press" } }
    },
    "NavRow": {
      "recipeProps": [],
      "root": {
        "part": "root", "component": "Row", "$a11y": { "role": "link", "current": { "$cond": ["props.selected", "page", false] } },
        "props": { "title": "{props.label}", "icon": "{props.icon}", "selected": "{props.selected|false}", "pressable": true },
        "slots": { "trailing": { "part": "count", "component": "Badge", "$if": "props.count", "props": { "text": { "$text": "props.count" }, "variant": "secondary" } } },
        "$on": { "press": "press" }
      }
    },
    "EntityChip": {
      "recipeProps": [],
      "root": { "part": "root", "component": "Chip", "props": { "label": "{props.label}", "shape": "rect", "icon": "{props.icon}", "image": "{props.image}", "detail": "{props.detail}", "removable": "{props.removable|false}", "pressable": true }, "$on": { "press": "press", "remove": "remove" } }
    },
    "ScrollArea": {
      "recipeProps": [],
      "root": {
        "part": "root", "component": "Box", "$a11y": { "role": "region" },
        "style": {
          "display": "flex",
          "flexDirection": { "$map": { "from": "props.direction", "cases": { "horizontal": "row" }, "default": "column" } },
          "overflowX": { "$map": { "from": "props.direction", "cases": { "horizontal": "auto", "both": "auto" }, "default": "hidden" } },
          "overflowY": { "$map": { "from": "props.direction", "cases": { "vertical": "auto", "both": "auto" }, "default": "hidden" } },
          "minWidth": 0, "minHeight": 0,
          "maxHeight": "{props.maxHeight}"
        },
        "children": ["$children"]
      }
    },
    "Sidebar": {
      "recipeProps": ["side"],
      "root": {
        "part": "root", "component": "Box",
        "style": { "display": "flex", "flexDirection": { "$map": { "from": "props.side", "cases": { "right": "row-reverse" }, "default": "row" } }, "alignItems": "stretch", "width": "100%", "minHeight": 0 },
        "children": [
          {
            "part": "sidebar", "component": "Box", "$if": "!props.collapsed", "$a11y": { "role": "navigation" },
            "style": {
              "display": "flex", "flexDirection": "column", "width": "{props.width|240}", "flexShrink": 0, "minHeight": 0,
              "@media (max-width: $breakpoint.{props.collapseBelow|md})": { "$cond": [{ "$not": { "$eq": ["{props.collapseBelow|md}", "never"] } }, { "display": "none" }] }
            },
            "children": ["$slot:sidebar"]
          },
          { "part": "main", "component": "Box", "$a11y": { "role": "main" }, "style": { "display": "flex", "flexDirection": "column", "flexGrow": 1, "minWidth": 0, "minHeight": 0 }, "children": ["$children"] }
        ]
      }
    },
    "AppBar": {
      "recipeProps": [],
      "root": {
        "part": "root", "component": "Box", "$a11y": { "role": "banner" },
        "style": { "display": "flex", "flexDirection": "row", "alignItems": "center", "gap": "$spacing.sm", "height": "$control.appBar", "paddingHorizontal": "$spacing.md", "width": "100%" },
        "children": [
          { "part": "back", "component": "Button", "$if": "props.back", "props": { "icon": "ui-back", "variant": "ghost", "size": "icon", "label": "$string.back" }, "$on": { "press": "back" } },
          "$slot:leading",
          {
            "part": "body", "component": "Box", "style": { "display": "flex", "flexDirection": "column", "flexGrow": 1, "minWidth": 0 },
            "children": [
              { "part": "title", "component": "Text", "props": { "text": "{props.title}", "variant": "title", "lines": 1 }, "$a11y": { "role": "heading", "level": 1 } },
              { "part": "subtitle", "component": "Text", "$if": "props.subtitle", "props": { "text": "{props.subtitle}", "variant": "muted", "lines": 1 } }
            ]
          },
          "$slot:trailing"
        ]
      }
    },
    "Kbd": {
      "recipeProps": [],
      "root": {
        "part": "root", "component": "Box",
        "style": { "display": "flex", "flexDirection": "row", "alignItems": "center", "height": "$control.badge", "paddingHorizontal": "$spacing.xs", "borderRadius": "$radius.sm", "alignSelf": "flex-start" },
        "children": [
          { "part": "label", "component": "Text", "props": { "text": "{props.keys}", "variant": "code", "lines": 1 } }
        ]
      }
    },
    "Label": {
      "recipeProps": ["required"],
      "root": {
        "part": "root", "component": "Box",
        "style": { "display": "flex", "flexDirection": "row", "alignItems": "center", "gap": "$spacing.xxs" },
        "children": [
          { "part": "text", "component": "Text", "props": { "text": "{props.text}", "variant": "label" } },
          { "part": "mark", "component": "Text", "$if": "props.required", "props": { "text": "*", "variant": "label", "tone": "danger" } }
        ]
      }
    },
    "Breadcrumb": {
      "recipeProps": [],
      "root": {
        "part": "root", "component": "Box", "$a11y": { "role": "navigation", "label": "$string.breadcrumb" },
        "style": { "display": "flex", "flexDirection": "row", "alignItems": "center", "flexWrap": "wrap", "gap": "$spacing.xs" },
        "children": [
          {
            "part": "item", "component": "Box", "$each": "props.items", "$as": "item",
            "style": { "display": "flex", "flexDirection": "row", "alignItems": "center", "gap": "$spacing.xs" },
            "$recipe": { "current": { "$eq": ["{index}", { "$sub": ["{len(props.items)}", 1] }] } },
            "children": [
              { "part": "separator", "component": "Icon", "$if": { "$lt": [0, "{index}"] }, "props": { "name": "ui-chevron-right", "size": "sm", "tone": "neutral" }, "$a11y": { "hidden": true } },
              { "part": "link", "component": "Button", "$if": { "$not": { "$eq": ["{index}", { "$sub": ["{len(props.items)}", 1] }] } }, "props": { "label": "{item.label}", "icon": "{item.icon}", "variant": "link", "size": "sm" }, "$on": { "press": "select" }, "$context": { "value": "{item.value}" } },
              { "part": "current", "component": "Text", "$if": { "$eq": ["{index}", { "$sub": ["{len(props.items)}", 1] }] }, "props": { "text": "{item.label}", "variant": "label", "lines": 1 }, "$a11y": { "current": "page" } }
            ]
          }
        ]
      }
    },
    "ToggleGroup": {
      "recipeProps": [],
      "root": { "part": "root", "component": "Segmented", "props": { "items": "{props.items}", "type": "{props.type|single}", "value": "{props.value}", "variant": { "$map": { "from": "props.variant", "cases": { "outline": "outline", "segmented": "segmented" }, "default": "toggles" } }, "size": "{props.size|default}", "fill": "{props.fill|false}" }, "$on": { "change": "change" } }
    },
    "TabBar": {
      "recipeProps": [],
      "root": { "part": "root", "component": "Segmented", "props": { "items": "{props.items}", "value": "{props.value}", "variant": "bar", "fill": true }, "$on": { "change": "change" } }
    },
    "Stepper": {
      "recipeProps": ["orientation"],
      "root": {
        "part": "root", "component": "Box", "$a11y": { "role": "list" },
        "style": {
          "display": "flex",
          "flexDirection": { "$map": { "from": "props.orientation", "cases": { "vertical": "column" }, "default": "row" } },
          "alignItems": { "$map": { "from": "props.orientation", "cases": { "vertical": "stretch" }, "default": "flex-start" } },
          "gap": "$spacing.md", "width": "100%"
        },
        "children": [
          {
            "part": "step", "component": "Box", "$each": "props.steps", "$as": "step",
            "style": {
              "display": "flex",
              "flexDirection": { "$map": { "from": "props.orientation", "cases": { "vertical": "row" }, "default": "column" } },
              "alignItems": { "$map": { "from": "props.orientation", "cases": { "vertical": "flex-start" }, "default": "center" } },
              "gap": "$spacing.xs", "flexGrow": 1, "flexBasis": 0, "minWidth": 0
            },
            "$recipe": { "status": { "$cond": [{ "$lt": ["{index}", "{props.current|0}"] }, "done", { "$cond": [{ "$eq": ["{index}", "{props.current|0}"] }, "current", "upcoming"] }] } },
            "$a11y": {
              "role": "listitem",
              "current": { "$cond": [{ "$eq": ["{index}", "{props.current|0}"] }, "step", false] },
              "label": { "$fill": [{ "$cond": [{ "$lt": ["{index}", "{props.current|0}"] }, "$string.stepDone", { "$cond": [{ "$eq": ["{index}", "{props.current|0}"] }, "$string.stepCurrent", "$string.stepUpcoming"] }] }, { "step": { "$add": ["{index}", 1] }, "total": "{len(props.steps)}", "label": "{step.label}" }] }
            },
            "children": [
              {
                "part": "marker", "component": "Box", "$a11y": { "hidden": true },
                "style": { "display": "flex", "alignItems": "center", "justifyContent": "center", "width": "$control.iconLg", "height": "$control.iconLg", "borderRadius": "$radius.full", "flexShrink": 0 },
                "$recipe": { "status": { "$cond": [{ "$lt": ["{index}", "{props.current|0}"] }, "done", { "$cond": [{ "$eq": ["{index}", "{props.current|0}"] }, "current", "upcoming"] }] } },
                "children": [
                  { "part": "check", "component": "Icon", "$if": { "$lt": ["{index}", "{props.current|0}"] }, "props": { "name": "ui-check", "size": "sm" } },
                  { "part": "number", "component": "Text", "$if": { "$not": { "$lt": ["{index}", "{props.current|0}"] } }, "props": { "text": { "$text": { "$add": ["{index}", 1] } }, "variant": "caption" }, "$recipe": { "status": { "$cond": [{ "$eq": ["{index}", "{props.current|0}"] }, "current", "upcoming"] } } }
                ]
              },
              {
                "part": "body", "component": "Box", "style": { "display": "flex", "flexDirection": "column", "gap": "$spacing.xxs", "minWidth": 0 },
                "children": [
                  { "part": "label", "component": "Text", "props": { "text": "{step.label}", "variant": "label", "lines": 1 }, "$recipe": { "status": { "$cond": [{ "$lt": ["{index}", "{props.current|0}"] }, "done", { "$cond": [{ "$eq": ["{index}", "{props.current|0}"] }, "current", "upcoming"] }] } } },
                  { "part": "description", "component": "Text", "$if": "step.description", "props": { "text": "{step.description}", "variant": "muted", "lines": 2 } }
                ]
              }
            ]
          }
        ]
      }
    },
    "Rating": {
      "recipeProps": ["size", "readOnly"],
      "root": {
        "part": "root", "component": "Box", "$a11y": { "role": { "$cond": ["props.readOnly", "img", "group"] }, "label": { "$cond": ["props.readOnly", { "$fill": ["$string.ratingValue", { "value": "{props.value|0}", "max": "{props.max|5}" }] }] } },
        "style": { "display": "flex", "flexDirection": "row", "alignItems": "center", "gap": "$spacing.xxs", "alignSelf": "flex-start" },
        "children": [
          {
            "part": "star", "component": "Box", "$each": "range(props.max|5)", "$as": "star", "props": { "pressable": { "$not": "props.readOnly" } },
            "style": { "display": "flex", "alignItems": "center", "justifyContent": "center" },
            "$recipe": { "filled": { "$lt": ["{index}", "{props.value|0}"] } },
            "$a11y": { "role": { "$cond": ["props.readOnly", "hidden", "button"] }, "label": { "$fill": ["$string.ratingStar", { "value": { "$add": ["{index}", 1] }, "max": "{props.max|5}" }] }, "pressed": { "$eq": [{ "$add": ["{index}", 1] }, "{props.value|0}"] } },
            "$on": { "press": "change" }, "$context": { "value": { "$add": ["{index}", 1] } }, "$set": { "press": { "prop": "value", "value": { "$add": ["{index}", 1] } } },
            "children": [
              { "part": "icon", "component": "Icon", "props": { "name": "star", "size": "{props.size|default}" }, "$recipe": { "filled": { "$lt": ["{index}", "{props.value|0}"] } } }
            ]
          }
        ]
      }
    },
    "AlertDialog": {
      "recipeProps": ["destructive"],
      "root": {
        "part": "root", "component": "Dialog", "$a11y": { "role": "alertdialog" },
        "props": { "title": "{props.title}", "description": "{props.description}", "open": "{props.open|false}", "dismissible": false },
        "slots": {
          "trigger": "$slot:trigger",
          "footer": {
            "part": "footer", "component": "Box",
            "style": { "display": "flex", "flexDirection": "row", "justifyContent": "flex-end", "flexWrap": "wrap", "gap": "$spacing.sm" },
            "children": [
              { "part": "cancel", "component": "Button", "props": { "label": "{props.cancelLabel|$string.cancel}", "variant": "outline" }, "$a11y": { "autoFocus": true }, "$on": { "press": "cancel" }, "$set": { "press": { "prop": "open", "value": false } } },
              { "part": "confirm", "component": "Button", "props": { "label": "{props.confirmLabel|$string.confirm}", "variant": { "$cond": ["props.destructive", "destructive", "default"] } }, "$on": { "press": "confirm" }, "$set": { "press": { "prop": "open", "value": false } } }
            ]
          }
        },
        "$on": { "change": "change" },
        "children": ["$children"]
      }
    },
    "DropdownMenu": {
      "recipeProps": [],
      "root": { "part": "root", "component": "Menu", "props": { "label": "{props.label}", "icon": "{props.icon}", "items": "{props.items}", "openOn": "press" }, "$on": { "select": "select" }, "children": ["$slot:trigger"] }
    },
    "ContextMenu": {
      "recipeProps": [],
      "root": { "part": "root", "component": "Menu", "props": { "items": "{props.items}", "openOn": "contextmenu" }, "$on": { "select": "select" }, "children": ["$children"] }
    },
    "HoverCard": {
      "recipeProps": [],
      "root": {
        "part": "root", "component": "Popover",
        "props": { "open": "{props.open|false}", "side": "{props.side|bottom}", "openOn": "hover" },
        "slots": { "trigger": "$slot:trigger" },
        "$on": { "change": "change" },
        "children": ["$children"]
      }
    },
    "Sparkline": {
      "recipeProps": ["tone"],
      "root": {
        "part": "root", "component": "Chart",
        "props": { "kind": "sparkline", "series": [{ "name": "", "values": "{props.values}", "tone": "{props.tone|primary}" }], "height": "{props.height|24}", "showAxes": false, "showGrid": false, "showLegend": false },
        "style": { "width": "100%" }
      }
    }
  }
}
