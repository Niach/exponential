      "root": {
        "part": "root", "component": "Box", "$a11y": { "role": { "$cond": ["props.pressable", "button", "none"] }, "pressed": { "$cond": ["props.pressable", "{props.selected|false}"] } },
        "props": { "pressable": "{props.pressable|false}" },
        "style": {
