    "Row": {
      "recipeProps": ["selected", "density", "surface", "depth"],
      "root": {
        "part": "root", "component": "Box",
        "$a11y": { "role": { "$cond": ["props.pressable", "button", "none"] }, "selected": { "$cond": ["props.pressable", "{props.selected|false}"] } },
