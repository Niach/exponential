      "type": "token",
      "group": "blur"
    },
    "animation": {
      "enum": [
        "pulse",
        "spin",
        "fade-in",
        "slide-in-up",
        "slide-in-down",
        "slide-in-left",
        "slide-in-right",
        "shimmer"
      ]
    },
    "animationDuration": {
      "type": "token",
      "group": "motion"
    }
  },
  "animations": {
    "pulse": {
      "duration": "$motion.slow",
      "factor": 7,
      "easing": "$ease.standard",
      "iterations": "infinite",
      "rest": 0,
      "keyframes": [
        {
          "offset": 0,
          "opacity": 1
        },
        {
          "offset": 0.5,
          "opacity": 0.5
        },
        {
          "offset": 1,
          "opacity": 1
        }
      ]
    },
    "spin": {
      "duration": "$motion.slow",
      "factor": 4,
      "easing": "linear",
      "iterations": "infinite",
      "rest": 0,
      "keyframes": [
        {
          "offset": 0,
          "rotate": 0
        },
        {
          "offset": 1,
          "rotate": 360
        }
      ]
    },
    "fade-in": {
      "duration": "$motion.standard",
      "factor": 1,
      "easing": "$ease.decelerate",
      "iterations": 1,
      "rest": 1,
      "keyframes": [
        {
          "offset": 0,
          "opacity": 0
        },
        {
          "offset": 1,
          "opacity": 1
        }
      ]
    },
    "slide-in-up": {
      "duration": "$motion.standard",
      "factor": 1,
      "easing": "$ease.decelerate",
      "iterations": 1,
      "rest": 1,
      "keyframes": [
        {
          "offset": 0,
          "opacity": 0,
          "translateY": 8
        },
        {
          "offset": 1,
          "opacity": 1,
          "translateY": 0
        }
      ]
    },
    "slide-in-down": {
      "duration": "$motion.standard",
      "factor": 1,
      "easing": "$ease.decelerate",
      "iterations": 1,
      "rest": 1,
      "keyframes": [
        {
          "offset": 0,
          "opacity": 0,
          "translateY": -8
        },
        {
          "offset": 1,
          "opacity": 1,
          "translateY": 0
        }
      ]
    },
    "slide-in-left": {
      "duration": "$motion.standard",
      "factor": 1,
      "easing": "$ease.decelerate",
      "iterations": 1,
      "rest": 1,
      "keyframes": [
        {
          "offset": 0,
          "opacity": 0,
          "translateX": 8
        },
        {
          "offset": 1,
          "opacity": 1,
          "translateX": 0
        }
      ]
    },
    "slide-in-right": {
      "duration": "$motion.standard",
      "factor": 1,
      "easing": "$ease.decelerate",
      "iterations": 1,
      "rest": 1,
      "keyframes": [
        {
          "offset": 0,
          "opacity": 0,
          "translateX": -8
        },
        {
          "offset": 1,
          "opacity": 1,
          "translateX": 0
        }
      ]
    },
    "shimmer": {
      "duration": "$motion.slow",
      "factor": 5,
      "easing": "linear",
      "iterations": "infinite",
      "rest": 0,
      "keyframes": [
        {
          "offset": 0,
          "band": -1
        },
        {
          "offset": 1,
          "band": 1
        }
      ],
      "band": {
        "color": "$color.background",
        "stops": [
          {
            "offset": 0,
            "alpha": 0
          },
          {
            "offset": 0.5,
            "alpha": 0.5
          },
          {
            "offset": 1,
            "alpha": 0
          }
        ]
      }
    }
  },
  "conditions": {
    "media": "^@media \\((min-width|max-width|min-height|max-height): (\\d+(\\.\\d+)?px|\\$breakpoint\\.[a-zA-Z0-9]+)\\)$|^@media \\(orientation: (portrait|landscape)\\)$|^@media \\(hover: (hover|none)\\)$|^@media \\(prefers-reduced-motion: (reduce|no-preference)\\)$|^@media \\(form-factor: (phone|wide)\\)$|^@container \\((min-width|max-width): (\\d+(\\.\\d+)?px|\\$breakpoint\\.[a-zA-Z0-9]+)\\)$",
    "states": [
      ":hover",
      ":focus-visible",
      ":pressed"
    ],
    "transform": "^((translate\\(-?\\d+(\\.\\d+)?px, -?\\d+(\\.\\d+)?px\\)|scale\\(-?\\d+(\\.\\d+)?\\)|rotate\\(-?\\d+(\\.\\d+)?deg\\))( (?=\\S)|$))+$"
  },
