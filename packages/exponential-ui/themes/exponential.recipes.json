{
  "$comment": "VAPP-92: the hand-authored HALF of the built-in `exponential` theme — the glass look's recipes, layered over the neutral (shadcn) set. scripts/generate.ts composes themes/exponential.theme.json from this file plus the token VALUES of packages/design-tokens/tokens.json and the light/dark palettes of packages/ui/src/styles.css, so the app and the SDK cannot drift. Edit this file, run generate; never edit exponential.theme.json.",
  "recipes": {
    "Card": { "root": [ { "style": { "boxShadow": "$shadow.none" } } ] },
    "Markdown": { "root": [ { "style": { "gap": "$spacing.sm", "lineHeight": 22.75 } }, { "when": { "density": "chat" }, "style": { "lineHeight": 22 } } ], "heading": [ { "style": { "fontSize": 17.6, "lineHeight": 28.6, "marginTop": 8, "marginBottom": 4 } }, { "when": { "level": 1 }, "style": { "fontSize": 20, "lineHeight": 32.5, "marginTop": 8, "marginBottom": 4 } }, { "when": { "level": 2 }, "style": { "fontSize": 17.6, "lineHeight": 28.6, "marginTop": 8, "marginBottom": 4 } }, { "when": { "level": 3 }, "style": { "fontSize": 16, "lineHeight": 26, "marginTop": 6, "marginBottom": 4 } }, { "when": { "level": 4 }, "style": { "fontSize": 14, "lineHeight": 22.75, "marginTop": 0, "marginBottom": 0 } }, { "when": { "level": 5 }, "style": { "fontSize": 14, "lineHeight": 22.75, "marginTop": 0, "marginBottom": 0 } }, { "when": { "level": 6 }, "style": { "fontSize": 14, "lineHeight": 22.75, "marginTop": 0, "marginBottom": 0 } }, { "when": { "density": "chat" }, "style": { "fontSize": 16, "lineHeight": 26 } }, { "when": { "density": "chat", "level": 1 }, "style": { "fontSize": 16.8, "lineHeight": 27.3 } }, { "when": { "density": "chat", "level": 2 }, "style": { "fontSize": 16, "lineHeight": 26 } }, { "when": { "density": "chat", "level": 3 }, "style": { "fontSize": 15, "lineHeight": 24.4 } }, { "when": { "density": "chat", "level": 4 }, "style": { "fontSize": 14, "lineHeight": 22 } }, { "when": { "density": "chat", "level": 5 }, "style": { "fontSize": 14, "lineHeight": 22 } }, { "when": { "density": "chat", "level": 6 }, "style": { "fontSize": 14, "lineHeight": 22 } } ], "link": [ { "style": { "color": "$color.link" } } ], "code": [ { "style": { "fontSize": 12.8, "paddingHorizontal": 5.6, "paddingVertical": 1.6, "borderRadius": 3, "backgroundColor": "$color.accent" } } ], "codeBlock": [ { "style": { "fontSize": 12.8, "lineHeight": 20.8, "padding": 12, "paddingHorizontal": 16, "backgroundColor": "$color.accent", "borderWidth": "$border.hairline", "borderColor": "$color.border", "borderRadius": 6 } } ], "listItem": [ { "style": { "marginTop": 8, "marginBottom": 8 } } ], "table": [ { "style": { "borderRadius": 0 } } ], "headerCell": [ { "style": { "backgroundColor": "#fafafa0a", "fontWeight": "$type.weight.semibold", "paddingVertical": 4.8, "paddingHorizontal": 9.6 } }, { "when": { "density": "chat" }, "style": { "paddingVertical": 3.2, "paddingHorizontal": 7.2 } } ], "cell": [ { "style": { "paddingVertical": 4.8, "paddingHorizontal": 9.6 } }, { "when": { "density": "chat" }, "style": { "paddingVertical": 3.2, "paddingHorizontal": 7.2 } } ], "chip": [ { "when": { "chip": "issue" }, "style": { "backgroundColor": "$color.accent", "borderColor": "$color.border", "borderWidth": "$border.hairline", "borderRadius": 6, "paddingHorizontal": 6 } }, { "when": { "chip": "entity" }, "style": { "backgroundColor": "$color.accent", "borderColor": "$color.border", "borderWidth": "$border.hairline", "borderRadius": 6, "paddingHorizontal": 6 } }, { "when": { "chip": "mention" }, "style": { "backgroundColor": "$color.accent", "borderColor": "$color.border", "borderWidth": "$border.hairline", "borderRadius": "$radius.full", "paddingHorizontal": 6.4 } } ], "chipLabel": [ { "when": { "chip": "issue" }, "style": { "color": "$color.foreground", "fontSize": 13, "fontWeight": "$type.weight.medium" } }, { "when": { "chip": "entity" }, "style": { "color": "$color.foreground", "fontSize": 13, "fontWeight": "$type.weight.medium" } }, { "when": { "chip": "mention" }, "style": { "color": "$color.accentForeground", "fontSize": 13, "fontWeight": "$type.weight.medium" } } ], "chipIdent": [ { "when": { "chip": "issue" }, "style": { "fontFamily": "$type.family.mono", "fontSize": 12, "lineHeight": 16, "color": "$color.mutedForeground" } }, { "when": { "chip": "entity" }, "style": { "fontFamily": "$type.family.mono", "fontSize": 12, "lineHeight": 16, "color": "$color.mutedForeground" } } ] },
    "Group": { "body": [ { "style": { "backgroundColor": "$color.card" } } ] },
    "Section": { "header": [ { "style": { "backgroundColor": "$color.muted" } } ] },
    "Button": {
      "root": [
        { "style": { "boxShadow": "$shadow.none", "fontWeight": "$type.weight.medium" } },
        { "when": { "variant": "outline" }, "style": { "backgroundColor": "$color.secondary", "borderColor": "$color.border", "boxShadow": "$shadow.none" } },
        { "when": { "variant": "outline", "state": "hover" }, "style": { "backgroundColor": "$color.accent" } },
        { "when": { "variant": "secondary" }, "style": { "backgroundColor": "$color.secondary" } }
      ]
    },
    "Input": { "field": [ { "style": { "backgroundColor": "$color.card", "borderColor": "$color.input", "boxShadow": "$shadow.none" } } ] },
    "Textarea": { "field": [ { "style": { "backgroundColor": "$color.card", "borderColor": "$color.input", "boxShadow": "$shadow.none" } } ] },
    "Select": { "trigger": [ { "style": { "backgroundColor": "$color.card", "borderColor": "$color.input", "boxShadow": "$shadow.none" } }, { "when": { "state": "hover", "triggerVariant": "row" }, "style": { "backgroundColor": "$color.secondary" } } ], "content": [ { "style": { "padding": "$spacing.xs", "borderRadius": "$radius.lg", "borderColor": "$color.border" } } ], "search": [ { "style": { "height": 40, "gap": "$spacing.sm" } } ], "item": [ { "style": { "height": "$control.row", "borderRadius": "$radius.md" } }, { "when": { "state": "selected", "multiple": false }, "style": { "backgroundColor": "#00000000", "color": "$color.popoverForeground" } }, { "when": { "state": "hover", "multiple": false }, "style": { "backgroundColor": "$color.accent", "color": "$color.accentForeground" } }, { "when": { "state": "hover", "multiple": true }, "style": { "backgroundColor": "$color.accent" } } ] },
    "DatePicker": { "trigger": [ { "style": { "backgroundColor": "$color.card", "borderColor": "$color.input", "boxShadow": "$shadow.none" } } ] },
    "Composer": { "root": [ { "style": { "backgroundColor": "$color.card", "borderColor": "$color.border", "boxShadow": "$shadow.none" } } ] },
    "Tabs": {
      "list": [ { "style": { "backgroundColor": "$color.muted" } }, { "when": { "variant": "strip" }, "style": { "backgroundColor": "#00000000" } } ],
      "tab": [ { "when": { "state": "selected" }, "style": { "backgroundColor": "$color.accent", "boxShadow": "$shadow.none" } }, { "when": { "variant": "strip", "state": "selected" }, "style": { "backgroundColor": "#00000000" } } ],
      "item": [ { "when": { "variant": "strip" }, "style": { "height": "$control.buttonMd" } } ],
      "more": [ { "when": { "variant": "strip" }, "style": { "height": "$control.buttonMd" } } ]
    },
    "Segmented": { "root": [ { "when": { "variant": "bar" }, "style": { "backgroundColor": "$color.card" } } ], "item": [ { "when": { "variant": "segmented", "state": "selected" }, "style": { "backgroundColor": "$color.accent", "boxShadow": "$shadow.none" } } ] },
    "Chip": {
      "root": [
        { "style": { "backgroundColor": "$color.secondary", "borderColor": "$color.border" } },
        { "when": { "shape": "rect" }, "style": { "backgroundColor": "$color.secondary" } },
        { "when": { "selected": true }, "style": { "backgroundColor": "$color.accent", "borderColor": "$color.ring" } }
      ]
    },
    "Row": { "root": [ { "when": { "state": "hover" }, "style": { "backgroundColor": "$color.secondary" } }, { "when": { "selected": true }, "style": { "backgroundColor": "$color.accent" } } ] },
    "Menu": { "item": [ { "when": { "state": "hover" }, "style": { "backgroundColor": "$color.secondary" } }, { "when": { "state": "selected" }, "style": { "backgroundColor": "$color.accent" } } ] },
    "Alert": { "root": [ { "style": { "backgroundColor": "$color.card" } } ] },
    "Dialog": { "content": [ { "style": { "backgroundColor": "$color.popover", "borderRadius": "$radius.xl" } } ] },
    "Drawer": { "content": [ { "style": { "backgroundColor": "$color.popover", "borderRadius": "$radius.xl3" } } ] },
    "Checkbox": { "box": [ { "style": { "backgroundColor": "$color.card", "boxShadow": "$shadow.none" } } ], "check": [ { "style": { "width": 14, "height": 14 } } ] },
    "Radio": { "item": [ { "style": { "backgroundColor": "$color.card", "boxShadow": "$shadow.none" } } ] },
    "ChoiceTiles": { "tile": [ { "style": { "backgroundColor": "$color.card" } }, { "when": { "state": "hover" }, "style": { "backgroundColor": "$color.secondary" } }, { "when": { "state": "selected" }, "style": { "backgroundColor": "$color.accent" } } ] },
    "Switch": { "track": [ { "style": { "width": 36, "backgroundColor": "$color.accent" } } ], "thumb": [ { "style": { "backgroundColor": "$color.foreground", "boxShadow": "$shadow.none" } } ] },
    "Skeleton": { "root": [ { "style": { "backgroundColor": "$color.secondary" } } ] },
    "NumberField": { "field": [ { "style": { "backgroundColor": "$color.card", "borderColor": "$color.input", "boxShadow": "$shadow.none" } } ] },
    "ChipInput": { "field": [ { "style": { "backgroundColor": "$color.card", "borderColor": "$color.input", "boxShadow": "$shadow.none" } } ], "chip": [ { "style": { "backgroundColor": "$color.accent", "color": "$color.foreground" } } ] },
    "TimePicker": { "trigger": [ { "style": { "backgroundColor": "$color.card", "borderColor": "$color.input", "boxShadow": "$shadow.none" } } ], "item": [ { "when": { "state": "hover" }, "style": { "backgroundColor": "$color.secondary" } } ] },
    "DateRangePicker": { "trigger": [ { "style": { "backgroundColor": "$color.card", "borderColor": "$color.input", "boxShadow": "$shadow.none" } } ] },
    "Toast": { "root": [ { "style": { "backgroundColor": "$color.popover", "borderColor": "$color.border", "borderRadius": "$radius.xl" } } ] },
    "CodeBlock": { "root": [ { "style": { "backgroundColor": "$color.muted" } } ] },
    "Table": { "row": [ { "when": { "state": "hover" }, "style": { "backgroundColor": "$color.secondary" } }, { "when": { "striped": true }, "style": { "backgroundColor": "$color.card" } } ] },
    "FileUpload": { "dropzone": [ { "style": { "backgroundColor": "$color.card", "borderColor": "$color.border" } }, { "when": { "state": "dragover" }, "style": { "backgroundColor": "$color.accent", "borderColor": "$color.ring" } } ] },
    "Sidebar": { "sidebar": [ { "style": { "backgroundColor": "$color.card" } } ] },
    "KeyRecorder": {
      "field": [ { "style": { "paddingHorizontal": 7, "paddingVertical": 3.5, "borderRadius": 5.25 } } ],
      "none": [ { "style": { "fontSize": 12.25, "lineHeight": 19.82 } } ],
      "placeholder": [ { "style": { "fontSize": 12.25, "lineHeight": 19.82 } } ],
      "ellipsis": [ { "style": { "fontSize": 12.25, "lineHeight": 19.82 } } ],
      "error": [ { "style": { "fontSize": 13, "lineHeight": 20 } } ]
    }
  }
}
