{
  "name": "@exponential_app/ui",
  "version": "0.2.0",
  "private": true,
  "description": "Exponential UI: the core A2UI catalog (components, macros, model descriptions, token names), the A2UI basic catalog map, the TypeScript reference reducer, the runtime theme format with the built-in themes, and the theme builder.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./prompt": "./src/entries/prompt.ts",
    "./schema": "./src/entries/schema.ts",
    "./conformance": "./src/conformance.ts",
    "./host": "./src/host/index.ts",
    "./web": "./src/web/index.ts",
    "./web/primitives": "./src/web/primitives/index.ts",
    "./web/primitives/*": "./src/web/primitives/*.ts",
    "./catalog/*": "./catalog/*",
    "./fixtures/*": "./fixtures/*",
    "./docs/*": "./docs/*",
    "./vendor/*": "./vendor/*",
    "./themes/*": "./themes/*",
    "./generated/*": "./generated/*",
    "./conformance/*": "./conformance/*",
    "./eval/*": "./eval/*"
  },
  "scripts": {
    "generate": "bun run ./scripts/generate.ts",
    "test": "bun test ./src ./conformance ./release ./eval",
    "conformance": "bun run ./conformance/run.ts",
    "typecheck": "tsc --noEmit",
    "build:builder": "bun build ./builder/main.ts --outdir ./builder/dist --target browser --format esm --define process.env.NODE_ENV='\"production\"'",
    "dev:builder": "bun ./builder/serve.ts",
    "conformance:check": "bun run ./scripts/conformance-check.ts",
    "conformance:parity": "bun run ./scripts/parity-run.ts",
    "parity:check": "bun run ./scripts/parity-check.ts",
    "eval": "bun run ./eval/score.ts",
    "eval:record": "bun run ./eval/record.ts",
    "eval:render": "bun run ./eval/render.ts",
    "eval:natives": "bun run ./eval/natives.ts",
    "eval:parity": "bun run ./eval/parity.ts",
    "size": "bun run ./release/size.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@exp/tsconfig": "workspace:*",
    "@exponential_app/ui-react": "workspace:*",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fast-check": "^4.3.0",
    "lucide-react": "^0.544.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.54.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.4",
    "typescript": "^5.7.2"
  }
}
