{
  "name": "@exponential-at/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Exponential UI: the core A2UI catalog (components, macros, model descriptions, token names), the A2UI basic catalog map and the TypeScript reference reducer.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./catalog/*": "./catalog/*",
    "./fixtures/*": "./fixtures/*",
    "./docs/*": "./docs/*",
    "./vendor/*": "./vendor/*"
  },
  "scripts": {
    "generate": "bun run ./scripts/generate.ts",
    "test": "bun test ./src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@exp/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  }
}
