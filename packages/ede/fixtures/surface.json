  "documentCases": [
    {
      "name": "the factory panel applies",
      "document": {
        "surface": {
          "anchor": [
            "top",
            "left",
            "right"
          ],
          "size": {
            "height": 40
          },
          "exclusiveZone": 40
        },
        "root": {
          "id": "panel",
          "component": "Box",
          "children": [
            {
              "id": "clock",
              "component": "Text",
              "props": {
                "text": {
                  "path": "/time"
                }
              }
            }
          ]
        },
        "data": {
          "time": "12:00"
        }
      },
      "expected": {
        "issues": []
      }
    },
    {
      "name": "a flat component list applies too",
      "document": {
        "surface": {
          "size": {
            "width": 10,
            "height": 10
          }
        },
        "components": [
          {
            "id": "root",
            "component": "Text",
            "text": "hi"
          }
        ]
      },
      "expected": {
        "issues": []
      }
    },
    {
      "name": "no surface header",
      "document": {
        "root": {
          "id": "panel",
          "component": "Box"
        }
      },
      "expected": {
        "issues": [
          {
            "path": "surface",
            "message": "required: how the surface sits on the screen"
          }
        ]
      }
    },
    {
      "name": "a header that does not normalize refuses the document",
      "document": {
        "surface": {
          "layer": "middle",
          "size": {
            "width": 1,
            "height": 1
          }
        },
        "root": {
          "id": "panel",
          "component": "Box"
        }
      },
      "expected": {
        "issues": [
          {
            "path": "surface.layer",
            "message": "expected one of background|bottom|top|overlay"
          }
        ]
      }
    },
    {
      "name": "a password field is refused",
      "document": {
        "surface": {
          "size": {
            "width": 10,
            "height": 10
          }
        },
        "root": {
          "id": "login",
          "component": "Box",
          "children": [
            {
              "id": "user",
              "component": "Input",
              "props": {
                "name": "user"
              }
            },
            {
              "id": "secret",
              "component": "Input",
              "props": {
                "name": "pw",
                "type": "password"
              }
            }
          ]
        }
      },
      "expected": {
        "issues": [
          {
            "path": "#secret",
            "message": "password inputs are refused in a shell document (a sealed surface asks for passwords)"
          }
        ]
      }
    },
    {
      "name": "a function call outside the allowlist is refused",
      "document": {
        "surface": {
          "size": {
            "width": 10,
            "height": 10
          },
          "functions": [
            "launch"
          ]
        },
        "root": {
          "id": "menu",
          "component": "Box",
          "children": [
            {
              "id": "term",
              "component": "Button",
              "props": {
                "label": "Terminal"
              },
              "on": {
                "press": {
                  "functionCall": {
                    "call": "launch",
                    "args": {
                      "command": "xterm"
                    }
                  }
                }
              }
            },
            {
              "id": "off",
              "component": "Button",
              "props": {
                "label": "Power off"
              },
              "on": {
                "press": {
                  "functionCall": {
                    "call": "poweroff"
                  }
                }
              }
            }
          ]
        }
      },
      "expected": {
        "issues": [
          {
            "path": "#off",
            "message": "function poweroff is not in surface.functions"
          }
        ]
      }
    },
    {
      "name": "without an allowlist every function call is refused",
      "document": {
        "surface": {
          "size": {
            "width": 10,
            "height": 10
          }
        },
        "components": [
          {
            "id": "root",
            "component": "Button",
            "label": "Go",
            "on": {
              "press": {
                "functionCall": {
                  "call": "launch"
                }
              }
            }
          }
        ]
      },
      "expected": {
        "issues": [
          {
            "path": "#root",
            "message": "function launch is not in surface.functions"
          }
        ]
      }
    },
    {
      "name": "an id used twice",
      "document": {
        "surface": {
          "size": {
            "width": 10,
            "height": 10
          }
        },
        "root": {
          "id": "a",
          "component": "Box",
          "children": [
            {
              "id": "b",
              "component": "Text",
              "props": {
                "text": "1"
              }
            },
            {
              "id": "b",
              "component": "Text",
              "props": {
                "text": "2"
              }
            }
          ]
        }
      },
      "expected": {
        "issues": [
          {
            "path": "#b",
            "message": "id used more than once"
          }
        ]
      }
    },
    {
      "name": "root and components together",
      "document": {
        "surface": {
          "size": {
            "width": 10,
            "height": 10
          }
        },
        "root": {
          "id": "a",
          "component": "Box"
        },
        "components": []
      },
      "expected": {
        "issues": [
          {
            "path": "file",
            "message": "expected root OR components, not both"
          }
        ]
      }
    },
    {
      "name": "neither root nor components",
      "document": {
        "surface": {
          "size": {
            "width": 10,
            "height": 10
          }
        },
        "data": {}
      },
      "expected": {
        "issues": [
          {
            "path": "file",
            "message": "expected root (a nested tree) or components (a flat list)"
          }
        ]
      }
    },
    {
      "name": "an unknown top-level key",
      "document": {
        "surface": {
          "size": {
            "width": 10,
            "height": 10
          }
        },
        "root": {
          "id": "a",
          "component": "Box"
        },
        "theme": "dark"
      },
      "expected": {
        "issues": [
          {
            "path": "theme",
            "message": "unknown key; known: $schema|$comment|catalogId|surface|root|components|data"
          }
        ]
      }
    },
    {
      "name": "not an object",
      "document": [],
      "expected": {
        "issues": [
          {
            "path": "file",
            "message": "expected a document object {surface, root | components, data}"
          }
        ]
      }
    }
  ]
}
