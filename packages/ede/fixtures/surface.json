  "layers": [
    "background",
    "bottom",
    "top",
    "overlay"
  ],
  "edges": [
    "top",
    "bottom",
    "left",
    "right"
  ],
  "keyboard": [
    "none",
    "on-demand",
    "exclusive"
  ],
  "placements": [
    "bottom-start",
    "bottom-end",
    "top-start",
    "top-end",
    "left-start",
    "right-start"
  ],
  "defaults": {
    "layer": "top",
    "anchor": [],
    "exclusiveZone": 0,
    "margin": {
      "top": 0,
      "right": 0,
      "bottom": 0,
      "left": 0
    },
    "keyboard": "none",
    "functions": [],
    "onDemand": false
  },
